<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portefeuille - Crypto Exchange</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .balance-card {
            background: linear-gradient(135deg, #1a237e 0%, #0d47a1 100%);
            color: white;
        }
        .crypto-holding {
            transition: transform 0.2s;
        }
        .crypto-holding:hover {
            transform: translateY(-5px);
        }
    </style>
</head>
<body class="bg-light">
    <%- include('partials/header') %>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <div class="row">
            <!-- Solde actuel -->
            <div class="col-md-12 mb-4">
                <div class="card">
                    <div class="card-body text-center">
                        <h5 class="card-title">Solde actuel</h5>
                        <h2 id="euroBalance" class="display-4 text-primary">€ 0.00</h2>
                        <div class="mt-4">
                            <button class="btn btn-success btn-lg me-3" data-bs-toggle="modal" data-bs-target="#depositModal">
                                <i class="fas fa-plus-circle"></i> Dépôt
                            </button>
                            <button class="btn btn-warning btn-lg" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                                <i class="fas fa-minus-circle"></i> Retrait
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card balance-card">
                        <div class="card-body">
                            <h5 class="card-title">Valeur totale du portefeuille</h5>
                            <h2 class="card-text" id="totalValue">€ 0.00</h2>
                            <p class="text-muted">Inclut toutes vos cryptomonnaies</p>
                        </div>
                    </div>
                </div>
            </div>

            <h3>Vos Cryptomonnaies</h3>
            <div class="row mt-4" id="cryptoHoldings">
                <!-- Les holdings seront ajoutés ici dynamiquement -->
            </div>
        </div>
    </div>

    <!-- Modal Dépôt -->
    <div class="modal fade" id="depositModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Dépôt d'argent</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="depositForm">
                        <div class="mb-3">
                            <label for="depositAmount" class="form-label">Montant à déposer</label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input type="number" class="form-control" id="depositAmount" min="0.01" step="0.01" required>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Confirmer le dépôt</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Retrait -->
    <div class="modal fade" id="withdrawModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Retrait d'argent</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="withdrawForm">
                        <div class="mb-3">
                            <label for="withdrawAmount" class="form-label">Montant à retirer</label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input type="number" class="form-control" id="withdrawAmount" min="0.01" step="0.01" required>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-warning w-100">Confirmer le retrait</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/wallet.js"></script>
    <%- include('partials/footer') %>
</body>
</html>
