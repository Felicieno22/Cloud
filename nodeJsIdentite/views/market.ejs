<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marché - Crypto Exchange</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chart.js@3.7.0/dist/chart.min.css">
    <style>
        .crypto-card {
            transition: transform 0.2s;
        }
        .crypto-card:hover {
            transform: translateY(-5px);
        }
        .price-up {
            color: #28a745;
        }
        .price-down {
            color: #dc3545;
        }
    </style>
</head>
<body class="bg-light">
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h2>Marché des Cryptomonnaies</h2>
        
        <div class="row mt-4" id="cryptoList">
            <!-- Les cartes de cryptomonnaies seront ajoutées ici dynamiquement -->
        </div>

        <!-- Modal pour les transactions -->
        <div class="modal fade" id="transactionModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Transaction</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="transactionForm">
                            <input type="hidden" id="cryptoId" name="cryptoId">
                            <input type="hidden" id="transactionType" name="transactionType">
                            
                            <div class="mb-3">
                                <label for="amount" class="form-label">Montant</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" id="amount" name="amount" step="0.000001" required>
                                    <span class="input-group-text" id="cryptoSymbol"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Prix estimé</label>
                                <div class="input-group">
                                    <span class="input-group-text">€</span>
                                    <input type="text" class="form-control" id="estimatedPrice" readonly>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Confirmer la transaction</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.0/dist/chart.min.js"></script>
    <script src="/js/market.js"></script>
</body>
</html>
