<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vérification de Transaction - Crypto Exchange</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.0.7/css/boxicons.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #2962ff;
            --secondary-color: #82b1ff;
            --success-color: #00c853;
            --danger-color: #ff1744;
            --background-color: #f8f9fa;
        }

        body {
            background-color: var(--background-color);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .verification-container {
            max-width: 500px;
            width: 100%;
            padding: 2rem;
        }

        .card {
            border-radius: 15px;
            border: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .card-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 1.5rem;
        }

        .transaction-details {
            background-color: rgba(0, 0, 0, 0.03);
            padding: 1rem;
            border-radius: 10px;
            margin: 1rem 0;
        }

        .verification-code {
            letter-spacing: 0.5em;
            font-size: 1.5em;
            text-align: center;
            background-color: #f8f9fa;
            padding: 1rem;
            border-radius: 10px;
            margin: 1rem 0;
        }
    </style>
</head>
<body>
    <div class="verification-container">
        <div class="card">
            <div class="card-header text-center">
                <h4 class="mb-0">
                    <i class='bx bx-check-shield me-2'></i>
                    Vérification de Transaction
                </h4>
            </div>
            <div class="card-body">
                <% if (transaction) { %>
                    <div class="text-center mb-4">
                        <p class="mb-0">Veuillez vérifier les détails de votre transaction :</p>
                    </div>
                    
                    <div class="transaction-details">
                        <div class="row mb-2">
                            <div class="col-6 text-muted">Type :</div>
                            <div class="col-6 text-end fw-bold">
                                <%= transaction.type === 'deposit' ? 'Dépôt' : 'Retrait' %>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-6 text-muted">Montant :</div>
                            <div class="col-6 text-end fw-bold">
                                <%= transaction.amount %> <%= transaction.symbol %>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6 text-muted">Date :</div>
                            <div class="col-6 text-end">
                                <%= new Date(transaction.created_at).toLocaleString() %>
                            </div>
                        </div>
                    </div>

                    <div class="text-center">
                        <p class="mb-2">Entrez le code de vérification envoyé à votre email :</p>
                        <form action="/api/wallet/verify-transaction" method="POST" class="mb-3">
                            <input type="hidden" name="transactionId" value="<%= transaction.id %>">
                            <div class="mb-3">
                                <input type="text" name="verificationCode" class="form-control text-center" required
                                       pattern="[0-9]{6}" maxlength="6" placeholder="Code à 6 chiffres">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class='bx bx-check me-2'></i>
                                Vérifier la Transaction
                            </button>
                        </form>
                        <small class="text-muted">
                            Le code expire dans 15 minutes. Si vous ne l'avez pas reçu,
                            <a href="/api/wallet/resend-verification/<%= transaction.id %>">cliquez ici pour le renvoyer</a>
                        </small>
                    </div>
                <% } else { %>
                    <div class="text-center">
                        <i class='bx bx-error-circle text-danger' style="font-size: 4rem;"></i>
                        <h5 class="mt-3">Transaction non trouvée</h5>
                        <p class="text-muted">Cette transaction n'existe pas ou a déjà été traitée.</p>
                        <a href="/dashboard" class="btn btn-primary">
                            <i class='bx bx-home me-2'></i>
                            Retour au tableau de bord
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
