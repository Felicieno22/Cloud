<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Crypto Exchange</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.0.7/css/boxicons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #2962ff;
            --secondary-color: #82b1ff;
            --success-color: #00c853;
            --danger-color: #ff1744;
            --background-color: #f8f9fa;
            --card-background: #ffffff;
            --text-color: #333333;
            --border-radius: 12px;
            --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        body {
            background-color: var(--background-color);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }

        .navbar {
            backdrop-filter: blur(10px);
            background: rgba(41, 98, 255, 0.95) !important;
            box-shadow: var(--box-shadow);
        }

        .dashboard-container {
            max-width: 1400px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .card {
            background: var(--card-background);
            border-radius: var(--border-radius);
            border: none;
            box-shadow: var(--box-shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .card-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            border-bottom: none;
            padding: 1.25rem;
            font-weight: 600;
        }

        .card-body {
            padding: 1.5rem;
        }

        .crypto-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem;
            border-bottom: 1px solid rgba(0,0,0,0.1);
            transition: background-color 0.2s ease;
        }

        .crypto-item:last-child {
            border-bottom: none;
        }

        .crypto-item:hover {
            background-color: rgba(0,0,0,0.02);
        }

        .crypto-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .crypto-icon {
            width: 32px;
            height: 32px;
            background-color: var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
        }

        .crypto-details h6 {
            margin: 0;
            font-weight: 600;
        }

        .crypto-price {
            text-align: right;
        }

        .price-value {
            font-size: 1.1rem;
            font-weight: 600;
            margin: 0;
        }

        .price-change {
            font-size: 0.9rem;
            font-weight: 500;
        }

        .price-change.positive {
            color: var(--success-color);
        }

        .price-change.negative {
            color: var(--danger-color);
        }

        .wallet-balance {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--primary-color);
        }

        .action-button {
            border-radius: var(--border-radius);
            padding: 0.5rem 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .action-button:hover {
            transform: translateY(-2px);
        }

        .transaction-item {
            padding: 1rem;
            border-left: 4px solid transparent;
            margin-bottom: 0.5rem;
            background-color: rgba(0,0,0,0.02);
            border-radius: var(--border-radius);
        }

        .transaction-item.deposit {
            border-left-color: var(--success-color);
        }

        .transaction-item.withdraw {
            border-left-color: var(--danger-color);
        }

        .loading-spinner {
            color: var(--primary-color);
        }

        .modal-content {
            border-radius: var(--border-radius);
            border: none;
        }

        .modal-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            border-radius: var(--border-radius) var(--border-radius) 0 0;
        }

        .btn-close {
            filter: brightness(0) invert(1);
        }

        .form-control {
            border-radius: var(--border-radius);
            padding: 0.75rem 1rem;
        }

        .total-balance {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 2rem;
            border-radius: var(--border-radius);
            margin-bottom: 1.5rem;
        }

        .total-balance h3 {
            margin: 0;
            font-weight: 700;
        }

        .total-balance p {
            margin: 0;
            opacity: 0.8;
        }

        @media (max-width: 768px) {
            .dashboard-container {
                padding: 1rem;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class='bx bx-bitcoin me-2'></i>
                Crypto Exchange
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <span class="nav-link">
                            <i class='bx bx-user me-1'></i>
                            <%= user.prenom %>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/api/auth/logout">
                            <i class='bx bx-log-out me-1'></i>
                            Déconnexion
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        <div class="row">
            <!-- Portefeuille -->
            <div class="col-md-4">
                <div class="total-balance">
                    <p>Solde Total</p>
                    <h3 id="total-balance">Chargement...</h3>
                </div>
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class='bx bx-wallet me-2'></i>
                            Mon Portefeuille
                        </h5>
                    </div>
                    <div class="card-body">
                        <div id="wallet-balances">
                            <div class="text-center">
                                <div class="spinner-border loading-spinner" role="status">
                                    <span class="visually-hidden">Chargement...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Prix des cryptos -->
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class='bx bx-line-chart me-2'></i>
                            Prix des Cryptomonnaies
                        </h5>
                    </div>
                    <div class="card-body">
                        <div id="crypto-prices">
                            <div class="text-center">
                                <div class="spinner-border loading-spinner" role="status">
                                    <span class="visually-hidden">Chargement...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Transactions -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class='bx bx-transfer-alt me-2'></i>
                            Dernières Transactions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div id="transactions" class="transaction-list">
                            <div class="text-center">
                                <div class="spinner-border loading-spinner" role="status">
                                    <span class="visually-hidden">Chargement...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <div class="modal fade" id="depositModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class='bx bx-plus-circle me-2'></i>
                        Dépôt
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="depositForm">
                        <div class="mb-3">
                            <label for="depositAmount" class="form-label">Montant</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class='bx bx-money'></i>
                                </span>
                                <input type="number" class="form-control" id="depositAmount" min="0" step="0.01" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="depositSymbol" class="form-label">Cryptomonnaie</label>
                            <select class="form-control" id="depositSymbol" required>
                                <option value="BTC">Bitcoin (BTC)</option>
                                <option value="ETH">Ethereum (ETH)</option>
                                <option value="USDT">Tether (USDT)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary action-button w-100">
                            <i class='bx bx-check me-2'></i>
                            Déposer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="withdrawModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class='bx bx-minus-circle me-2'></i>
                        Retrait
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="withdrawForm">
                        <div class="mb-3">
                            <label for="withdrawAmount" class="form-label">Montant</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class='bx bx-money'></i>
                                </span>
                                <input type="number" class="form-control" id="withdrawAmount" min="0" step="0.01" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="withdrawSymbol" class="form-label">Cryptomonnaie</label>
                            <select class="form-control" id="withdrawSymbol" required>
                                <option value="BTC">Bitcoin (BTC)</option>
                                <option value="ETH">Ethereum (ETH)</option>
                                <option value="USDT">Tether (USDT)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-danger action-button w-100">
                            <i class='bx bx-check me-2'></i>
                            Retirer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Fonction pour formater les nombres
        function formatNumber(number) {
            return new Intl.NumberFormat('fr-FR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 8
            }).format(number);
        }

        // Fonction pour mettre à jour les soldes
        async function updateBalances() {
            try {
                const response = await fetch('/api/wallet/balance');
                if (!response.ok) throw new Error('Erreur réseau');
                
                const balances = await response.json();
                let totalBalance = 0;
                
                const walletHtml = balances.map(wallet => {
                    const balance = parseFloat(wallet.balance);
                    totalBalance += balance;
                    return `
                        <div class="crypto-item">
                            <div class="crypto-info">
                                <div class="crypto-icon">${wallet.symbol[0]}</div>
                                <div class="crypto-details">
                                    <h6>${wallet.symbol}</h6>
                                    <small class="text-muted">Balance</small>
                                </div>
                            </div>
                            <div class="crypto-price">
                                <div class="wallet-balance">${formatNumber(balance)}</div>
                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn btn-primary btn-sm action-button" 
                                            onclick="showDepositModal('${wallet.symbol}')">
                                        <i class='bx bx-plus-circle'></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm action-button" 
                                            onclick="showWithdrawModal('${wallet.symbol}')">
                                        <i class='bx bx-minus-circle'></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');

                document.getElementById('total-balance').textContent = formatNumber(totalBalance) + ' €';
                document.getElementById('wallet-balances').innerHTML = walletHtml;
            } catch (error) {
                console.error('Erreur lors de la récupération des soldes:', error);
            }
        }

        // Fonction pour mettre à jour les prix
        async function updatePrices() {
            try {
                const response = await fetch('/api/crypto/prices');
                if (!response.ok) throw new Error('Erreur réseau');
                
                const prices = await response.json();
                const pricesHtml = prices.map(price => `
                    <div class="crypto-item">
                        <div class="crypto-info">
                            <div class="crypto-icon">${price.symbol[0]}</div>
                            <div class="crypto-details">
                                <h6>${price.symbol}</h6>
                                <small class="text-muted">${price.name}</small>
                            </div>
                        </div>
                        <div class="crypto-price">
                            <div class="price-value">${formatNumber(price.price)} €</div>
                            <div class="price-change ${price.change_24h >= 0 ? 'positive' : 'negative'}">
                                <i class='bx ${price.change_24h >= 0 ? 'bx-up-arrow-alt' : 'bx-down-arrow-alt'}'></i>
                                ${Math.abs(price.change_24h).toFixed(2)}%
                            </div>
                        </div>
                    </div>
                `).join('');

                document.getElementById('crypto-prices').innerHTML = pricesHtml;
            } catch (error) {
                console.error('Erreur lors de la récupération des prix:', error);
            }
        }

        // Fonction pour mettre à jour les transactions
        async function updateTransactions() {
            try {
                const response = await fetch('/api/wallet/transactions');
                if (!response.ok) throw new Error('Erreur réseau');
                
                const transactions = await response.json();
                const transactionsHtml = transactions.length > 0 ? transactions.map(tx => `
                    <div class="transaction-item ${tx.type === 'deposit' ? 'deposit' : 'withdraw'}">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">
                                    <i class='bx ${tx.type === 'deposit' ? 'bx-plus-circle' : 'bx-minus-circle'} me-2'></i>
                                    ${tx.type === 'deposit' ? 'Dépôt' : 'Retrait'} ${tx.symbol}
                                </h6>
                                <small class="text-muted">
                                    <i class='bx bx-time-five me-1'></i>
                                    ${new Date(tx.created_at).toLocaleString()}
                                </small>
                            </div>
                            <div class="text-${tx.type === 'deposit' ? 'success' : 'danger'} fw-bold">
                                ${tx.type === 'deposit' ? '+' : '-'}${formatNumber(tx.amount)}
                            </div>
                        </div>
                    </div>
                `).join('') : '<p class="text-center text-muted">Aucune transaction</p>';

                document.getElementById('transactions').innerHTML = transactionsHtml;
            } catch (error) {
                console.error('Erreur lors de la récupération des transactions:', error);
            }
        }

        // Fonctions pour les modals
        function showDepositModal(symbol) {
            document.getElementById('depositSymbol').value = symbol;
            new bootstrap.Modal(document.getElementById('depositModal')).show();
        }

        function showWithdrawModal(symbol) {
            document.getElementById('withdrawSymbol').value = symbol;
            new bootstrap.Modal(document.getElementById('withdrawModal')).show();
        }

        // Gestionnaires d'événements pour les formulaires
        document.getElementById('depositForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            try {
                const amount = parseFloat(document.getElementById('depositAmount').value);
                const symbol = document.getElementById('depositSymbol').value;

                const response = await fetch('/api/wallet/deposit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ amount, symbol })
                });

                if (!response.ok) throw new Error('Erreur réseau');

                const result = await response.json();
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('depositModal')).hide();
                    document.getElementById('depositAmount').value = '';
                    if (result.redirectTo) {
                        window.location.href = result.redirectTo;
                    }
                }
            } catch (error) {
                console.error('Erreur lors du dépôt:', error);
                alert('Erreur lors du dépôt. Veuillez réessayer.');
            }
        });

        document.getElementById('withdrawForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            try {
                const amount = parseFloat(document.getElementById('withdrawAmount').value);
                const symbol = document.getElementById('withdrawSymbol').value;

                const response = await fetch('/api/wallet/withdraw', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ amount, symbol })
                });

                if (!response.ok) throw new Error('Erreur réseau');

                const result = await response.json();
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('withdrawModal')).hide();
                    document.getElementById('withdrawAmount').value = '';
                    if (result.redirectTo) {
                        window.location.href = result.redirectTo;
                    }
                }
            } catch (error) {
                console.error('Erreur lors du retrait:', error);
                alert('Erreur lors du retrait. Veuillez réessayer.');
            }
        });

        // Mise à jour initiale
        updateBalances();
        updatePrices();
        updateTransactions();

        // Mise à jour périodique
        setInterval(updatePrices, 5000);
        setInterval(updateBalances, 10000);
        setInterval(updateTransactions, 30000);
    </script>
</body>
</html>
