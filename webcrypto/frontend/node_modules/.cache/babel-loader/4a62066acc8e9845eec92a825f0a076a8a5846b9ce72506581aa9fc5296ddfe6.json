{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nexport default {\n  name: 'Trade',\n  setup() {\n    const route = useRoute();\n    const router = useRouter();\n    const cryptoSymbol = route.params.symbol?.toUpperCase();\n    const cryptoData = ref(null);\n    const operationType = ref('buy');\n    const amount = ref(0);\n\n    // Formatage des prix\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const formatPriceChange = change => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion du trading\n    const handleTrade = () => {\n      // TODO: Implémenter la logique de trading\n      console.log('Trading:', {\n        type: operationType.value,\n        symbol: cryptoSymbol,\n        amount: amount.value,\n        price: cryptoData.value?.price\n      });\n    };\n\n    // Mise à jour des prix en temps réel\n    socket.on('priceUpdate', data => {\n      const crypto = data.find(c => c.symbol === cryptoSymbol);\n      if (crypto) {\n        cryptoData.value = crypto;\n      }\n    });\n    onMounted(() => {\n      if (!cryptoSymbol) {\n        router.push('/dashboard');\n        return;\n      }\n      socket.connect();\n    });\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n    return {\n      cryptoSymbol,\n      cryptoData,\n      operationType,\n      amount,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      handleTrade\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","useRoute","useRouter","socket","name","setup","route","router","cryptoSymbol","params","symbol","toUpperCase","cryptoData","operationType","amount","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatPriceChange","change","toFixed","getPriceChangeClass","value","priceChange","handleTrade","console","log","type","on","data","crypto","find","c","push","connect","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Trade.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"max-w-3xl mx-auto\">\n      <div class=\"mb-8\">\n        <button @click=\"$router.back()\" class=\"text-indigo-600 hover:text-indigo-800\">\n          ← Retour\n        </button>\n        <h1 class=\"text-3xl font-bold text-gray-900 mt-4\">\n          Trader {{ cryptoData?.name || cryptoSymbol }}\n        </h1>\n      </div>\n\n      <div class=\"bg-white rounded-lg shadow-lg p-6\">\n        <!-- Prix actuel -->\n        <div class=\"mb-8\">\n          <h2 class=\"text-lg text-gray-600\">Prix actuel</h2>\n          <div class=\"text-4xl font-bold text-gray-900\">\n            {{ formatPrice(cryptoData?.price) }}\n          </div>\n          <div :class=\"getPriceChangeClass()\" class=\"mt-2 text-sm font-medium\">\n            {{ formatPriceChange(cryptoData?.priceChange) }}% sur 24h\n          </div>\n        </div>\n\n        <!-- Formulaire de trading -->\n        <form @submit.prevent=\"handleTrade\">\n          <div class=\"space-y-6\">\n            <!-- Type d'opération -->\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700\">Type d'opération</label>\n              <div class=\"mt-2 grid grid-cols-2 gap-4\">\n                <button\n                  type=\"button\"\n                  :class=\"[\n                    'px-4 py-2 rounded-md text-sm font-medium w-full',\n                    operationType === 'buy'\n                      ? 'bg-green-600 text-white'\n                      : 'bg-gray-100 text-gray-900 hover:bg-gray-200'\n                  ]\"\n                  @click=\"operationType = 'buy'\"\n                >\n                  Acheter\n                </button>\n                <button\n                  type=\"button\"\n                  :class=\"[\n                    'px-4 py-2 rounded-md text-sm font-medium w-full',\n                    operationType === 'sell'\n                      ? 'bg-red-600 text-white'\n                      : 'bg-gray-100 text-gray-900 hover:bg-gray-200'\n                  ]\"\n                  @click=\"operationType = 'sell'\"\n                >\n                  Vendre\n                </button>\n              </div>\n            </div>\n\n            <!-- Montant -->\n            <div>\n              <label for=\"amount\" class=\"block text-sm font-medium text-gray-700\">\n                Montant ({{ cryptoSymbol }})\n              </label>\n              <div class=\"mt-2\">\n                <input\n                  type=\"number\"\n                  id=\"amount\"\n                  v-model=\"amount\"\n                  step=\"0.000001\"\n                  min=\"0\"\n                  class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\n                  required\n                />\n              </div>\n              <p class=\"mt-2 text-sm text-gray-500\">\n                ≈ {{ formatPrice(amount * (cryptoData?.price || 0)) }}\n              </p>\n            </div>\n\n            <!-- Bouton de soumission -->\n            <div>\n              <button\n                type=\"submit\"\n                :class=\"[\n                  'w-full rounded-md px-4 py-2 text-sm font-medium text-white',\n                  operationType === 'buy'\n                    ? 'bg-green-600 hover:bg-green-700'\n                    : 'bg-red-600 hover:bg-red-700'\n                ]\"\n              >\n                {{ operationType === 'buy' ? 'Acheter' : 'Vendre' }}\n                {{ cryptoSymbol }}\n              </button>\n            </div>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { socket } from '@/socket';\n\nexport default {\n  name: 'Trade',\n\n  setup() {\n    const route = useRoute();\n    const router = useRouter();\n    const cryptoSymbol = route.params.symbol?.toUpperCase();\n    const cryptoData = ref(null);\n    const operationType = ref('buy');\n    const amount = ref(0);\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const formatPriceChange = (change) => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion du trading\n    const handleTrade = () => {\n      // TODO: Implémenter la logique de trading\n      console.log('Trading:', {\n        type: operationType.value,\n        symbol: cryptoSymbol,\n        amount: amount.value,\n        price: cryptoData.value?.price\n      });\n    };\n\n    // Mise à jour des prix en temps réel\n    socket.on('priceUpdate', (data) => {\n      const crypto = data.find(c => c.symbol === cryptoSymbol);\n      if (crypto) {\n        cryptoData.value = crypto;\n      }\n    });\n\n    onMounted(() => {\n      if (!cryptoSymbol) {\n        router.push('/dashboard');\n        return;\n      }\n      socket.connect();\n    });\n\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n\n    return {\n      cryptoSymbol,\n      cryptoData,\n      operationType,\n      amount,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      handleTrade\n    };\n  }\n};\n</script>\n"],"mappings":"AAsGA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AACjD,SAASC,QAAQ,EAAEC,SAAQ,QAAS,YAAY;AAChD,SAASC,MAAK,QAAS,UAAU;AAEjC,eAAe;EACbC,IAAI,EAAE,OAAO;EAEbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC,CAAC;IACxB,MAAMM,MAAK,GAAIL,SAAS,CAAC,CAAC;IAC1B,MAAMM,YAAW,GAAIF,KAAK,CAACG,MAAM,CAACC,MAAM,EAAEC,WAAW,CAAC,CAAC;IACvD,MAAMC,UAAS,GAAId,GAAG,CAAC,IAAI,CAAC;IAC5B,MAAMe,aAAY,GAAIf,GAAG,CAAC,KAAK,CAAC;IAChC,MAAMgB,MAAK,GAAIhB,GAAG,CAAC,CAAC,CAAC;;IAErB;IACA,MAAMiB,WAAU,GAAKC,KAAK,IAAK;MAC7B,IAAI,OAAOA,KAAI,KAAM,QAAQ,EAAE,OAAO,OAAO;MAC7C,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE,KAAK;QACfC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACP,KAAK,CAAC;IAClB,CAAC;IAED,MAAMQ,iBAAgB,GAAKC,MAAM,IAAK;MACpC,IAAI,OAAOA,MAAK,KAAM,QAAQ,EAAE,OAAO,MAAM;MAC7C,OAAOA,MAAM,CAACC,OAAO,CAAC,CAAC,CAAC;IAC1B,CAAC;IAED,MAAMC,mBAAkB,GAAIA,CAAA,KAAM;MAChC,IAAI,CAACf,UAAU,CAACgB,KAAK,EAAE,OAAO,eAAe;MAC7C,OAAO;QACL,gBAAgB,EAAEhB,UAAU,CAACgB,KAAK,CAACC,WAAU,GAAI,CAAC;QAClD,cAAc,EAAEjB,UAAU,CAACgB,KAAK,CAACC,WAAU,GAAI,CAAC;QAChD,eAAe,EAAEjB,UAAU,CAACgB,KAAK,CAACC,WAAU,KAAM;MACpD,CAAC;IACH,CAAC;;IAED;IACA,MAAMC,WAAU,GAAIA,CAAA,KAAM;MACxB;MACAC,OAAO,CAACC,GAAG,CAAC,UAAU,EAAE;QACtBC,IAAI,EAAEpB,aAAa,CAACe,KAAK;QACzBlB,MAAM,EAAEF,YAAY;QACpBM,MAAM,EAAEA,MAAM,CAACc,KAAK;QACpBZ,KAAK,EAAEJ,U