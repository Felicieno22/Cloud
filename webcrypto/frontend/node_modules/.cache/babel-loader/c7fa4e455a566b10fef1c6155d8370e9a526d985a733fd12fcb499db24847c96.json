{"ast":null,"code":"import { ref, onMounted, onUnmounted, watch } from 'vue';\nimport { socket } from '@/socket';\nimport { useRouter } from 'vue-router';\nimport AdminHeader from '@/components/AdminHeader.vue';\nexport default {\n  name: 'UserTransactionsSummary',\n  components: {\n    AdminHeader\n  },\n  setup() {\n    const router = useRouter();\n    const userSummaries = ref([]);\n    const filters = ref({\n      dateMax: new Date().toISOString().slice(0, 16) // Format YYYY-MM-DDTHH:mm\n    });\n    const formatPrice = price => {\n      if (!price) return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const fetchUserSummaries = () => {\n      console.log('Envoi de la requête getUserTransactionsSummary avec date:', filters.value.dateMax);\n      socket.emit('getUserTransactionsSummary', {\n        dateMax: filters.value.dateMax\n      });\n    };\n    onMounted(async () => {\n      try {\n        console.log('Connexion au socket...');\n        socket.connect();\n        const token = localStorage.getItem('token');\n        if (!token) {\n          console.log('Pas de token trouvé, redirection vers login');\n          router.push('/admin/login');\n          return;\n        }\n        console.log('Envoi du token pour authentification');\n        socket.emit('authenticate', token);\n        socket.on('authenticated', () => {\n          console.log('Socket authentifié avec succès');\n          fetchUserSummaries(); // Chargement initial des données\n        });\n        socket.on('userTransactionsSummary', data => {\n          console.log('Données reçues du serveur:', data);\n          if (!data) {\n            console.log('Aucune donnée reçue');\n            userSummaries.value = [];\n            return;\n          }\n          userSummaries.value = data.map(summary => {\n            console.log('Traitement des données pour utilisateur:', summary.username);\n            return {\n              ...summary,\n              total_buy_amount: parseFloat(summary.total_buy_amount) || 0,\n              total_sell_amount: parseFloat(summary.total_sell_amount) || 0,\n              current_portfolio_value: parseFloat(summary.current_portfolio_value) || 0\n            };\n          });\n          console.log('Données traitées:', userSummaries.value);\n        });\n        socket.on('connect', () => {\n          console.log('Socket connecté');\n        });\n        socket.on('disconnect', () => {\n          console.log('Socket déconnecté');\n        });\n        socket.on('error', error => {\n          console.error('Erreur socket reçue:', error);\n          if (error.message.includes('authentification') || error.message.includes('droits insuffisants')) {\n            console.log('Erreur d\\'authentification, redirection vers login');\n            localStorage.removeItem('token');\n            localStorage.removeItem('isAdmin');\n            router.push('/admin/login');\n          } else {\n            alert(error.message);\n          }\n        });\n      } catch (error) {\n        console.error('Erreur lors de l\\'initialisation:', error);\n        router.push('/admin/login');\n      }\n    });\n    onUnmounted(() => {\n      console.log('Démontage du composant, nettoyage des listeners');\n      socket.off('userTransactionsSummary');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.off('connect');\n      socket.off('disconnect');\n      socket.disconnect();\n    });\n    return {\n      userSummaries,\n      filters,\n      formatPrice,\n      fetchUserSummaries\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","watch","socket","useRouter","AdminHeader","name","components","setup","router","userSummaries","filters","dateMax","Date","toISOString","slice","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","fetchUserSummaries","console","log","value","emit","connect","token","localStorage","getItem","push","on","data","map","summary","username","total_buy_amount","parseFloat","total_sell_amount","current_portfolio_value","error","message","includes","removeItem","alert","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\UserTransactionsSummary.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-gray-50\">\n    <AdminHeader />\n    \n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n      <h1 class=\"text-3xl font-extrabold text-gray-900 mb-8\">Récapitulatif des Transactions par Utilisateur</h1>\n\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-200 hover:shadow-md\">\n        <!-- Filtres -->\n        <div class=\"p-6 border-b border-gray-100 bg-white\">\n          <div class=\"grid grid-cols-1 gap-6\">\n            <div class=\"flex items-end space-x-4\">\n              <div class=\"flex-grow\">\n                <label class=\"block text-sm font-medium text-gray-700 mb-2\">Date et heure max</label>\n                <input\n                  type=\"datetime-local\"\n                  v-model=\"filters.dateMax\"\n                  class=\"w-full rounded-lg border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors duration-200\"\n                />\n              </div>\n              <button\n                @click=\"fetchUserSummaries\"\n                class=\"px-6 py-2.5 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all duration-200\"\n              >\n                Valider\n              </button>\n            </div>\n          </div>\n        </div>\n\n        <!-- Tableau récapitulatif -->\n        <div class=\"overflow-x-auto\">\n          <table class=\"min-w-full divide-y divide-gray-200\">\n            <thead>\n              <tr class=\"bg-gray-50\">\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Utilisateur</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Total Achat</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Total Vente</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Valeur portefeuille</th>\n              </tr>\n            </thead>\n            <tbody class=\"bg-white divide-y divide-gray-100\">\n              <tr v-for=\"summary in userSummaries\" \n                  :key=\"summary.username\" \n                  class=\"hover:bg-gray-50 transition-colors duration-150\">\n                <td class=\"px-6 py-4 whitespace-nowrap\">\n                  <div class=\"flex items-center\">\n                    <div class=\"h-8 w-8 rounded-full bg-indigo-100 flex items-center justify-center\">\n                      <span class=\"text-sm font-medium text-indigo-700\">\n                        {{ summary.username?.[0]?.toUpperCase() }}\n                      </span>\n                    </div>\n                    <span class=\"ml-3 text-sm text-gray-900\">{{ summary.username }}</span>\n                  </div>\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\n                  {{ formatPrice(summary.total_buy_amount) }}\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\n                  {{ formatPrice(summary.total_sell_amount) }}\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900\">\n                  {{ formatPrice(summary.current_portfolio_value) }}\n                </td>\n              </tr>\n              <tr v-if=\"userSummaries.length === 0\">\n                <td colspan=\"4\" class=\"px-6 py-4 text-center text-gray-500\">\n                  Aucune donnée disponible\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted, watch } from 'vue';\nimport { socket } from '@/socket';\nimport { useRouter } from 'vue-router';\nimport AdminHeader from '@/components/AdminHeader.vue';\n\nexport default {\n  name: 'UserTransactionsSummary',\n  components: {\n    AdminHeader\n  },\n  \n  setup() {\n    const router = useRouter();\n    const userSummaries = ref([]);\n    const filters = ref({\n      dateMax: new Date().toISOString().slice(0, 16) // Format YYYY-MM-DDTHH:mm\n    });\n\n    const formatPrice = (price) => {\n      if (!price) return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const fetchUserSummaries = () => {\n      console.log('Envoi de la requête getUserTransactionsSummary avec date:', filters.value.dateMax);\n      socket.emit('getUserTransactionsSummary', {\n        dateMax: filters.value.dateMax\n      });\n    };\n\n    onMounted(async () => {\n      try {\n        console.log('Connexion au socket...');\n        socket.connect();\n\n        const token = localStorage.getItem('token');\n        if (!token) {\n          console.log('Pas de token trouvé, redirection vers login');\n          router.push('/admin/login');\n          return;\n        }\n\n        console.log('Envoi du token pour authentification');\n        socket.emit('authenticate', token);\n\n        socket.on('authenticated', () => {\n          console.log('Socket authentifié avec succès');\n          fetchUserSummaries(); // Chargement initial des données\n        });\n\n        socket.on('userTransactionsSummary', (data) => {\n          console.log('Données reçues du serveur:', data);\n          if (!data) {\n            console.log('Aucune donnée reçue');\n            userSummaries.value = [];\n            return;\n          }\n          \n          userSummaries.value = data.map(summary => {\n            console.log('Traitement des données pour utilisateur:', summary.username);\n            return {\n              ...summary,\n              total_buy_amount: parseFloat(summary.total_buy_amount) || 0,\n              total_sell_amount: parseFloat(summary.total_sell_amount) || 0,\n              current_portfolio_value: parseFloat(summary.current_portfolio_value) || 0\n            };\n          });\n          console.log('Données traitées:', userSummaries.value);\n        });\n\n        socket.on('connect', () => {\n          console.log('Socket connecté');\n        });\n\n        socket.on('disconnect', () => {\n          console.log('Socket déconnecté');\n        });\n\n        socket.on('error', (error) => {\n          console.error('Erreur socket reçue:', error);\n          if (error.message.includes('authentification') || error.message.includes('droits insuffisants')) {\n            console.log('Erreur d\\'authentification, redirection vers login');\n            localStorage.removeItem('token');\n            localStorage.removeItem('isAdmin');\n            router.push('/admin/login');\n          } else {\n            alert(error.message);\n          }\n        });\n\n      } catch (error) {\n        console.error('Erreur lors de l\\'initialisation:', error);\n        router.push('/admin/login');\n      }\n    });\n\n    onUnmounted(() => {\n      console.log('Démontage du composant, nettoyage des listeners');\n      socket.off('userTransactionsSummary');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.off('connect');\n      socket.off('disconnect');\n      socket.disconnect();\n    });\n\n    return {\n      userSummaries,\n      filters,\n      formatPrice,\n      fetchUserSummaries\n    };\n  }\n};\n</script>\n\n<style scoped>\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: #f1f1f1;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #ddd;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #cdcdcd;\n}\n</style> "],"mappings":"AA+EA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAW,EAAEC,KAAI,QAAS,KAAK;AACxD,SAASC,MAAK,QAAS,UAAU;AACjC,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,WAAU,MAAO,8BAA8B;AAEtD,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVF;EACF,CAAC;EAEDG,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIL,SAAS,CAAC,CAAC;IAC1B,MAAMM,aAAY,GAAIX,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAMY,OAAM,GAAIZ,GAAG,CAAC;MAClBa,OAAO,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAE,EAAE,EAAE;IACjD,CAAC,CAAC;IAEF,MAAMC,WAAU,GAAKC,KAAK,IAAK;MAC7B,IAAI,CAACA,KAAK,EAAE,OAAO,OAAO;MAC1B,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE,KAAK;QACfC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACP,KAAK,CAAC;IAClB,CAAC;IAED,MAAMQ,kBAAiB,GAAIA,CAAA,KAAM;MAC/BC,OAAO,CAACC,GAAG,CAAC,2DAA2D,EAAEhB,OAAO,CAACiB,KAAK,CAAChB,OAAO,CAAC;MAC/FT,MAAM,CAAC0B,IAAI,CAAC,4BAA4B,EAAE;QACxCjB,OAAO,EAAED,OAAO,CAACiB,KAAK,CAAChB;MACzB,CAAC,CAAC;IACJ,CAAC;IAEDZ,SAAS,CAAC,YAAY;MACpB,IAAI;QACF0B,OAAO,CAACC,GAAG,CAAC,wBAAwB,CAAC;QACrCxB,MAAM,CAAC2B,OAAO,CAAC,CAAC;QAEhB,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACVL,OAAO,CAACC,GAAG,CAAC,6CAA6C,CAAC;UAC1DlB,MAAM,CAACyB,IAAI,CAAC,cAAc,CAAC;UAC3B;QACF;QAEAR,OAAO,CAACC,GAAG,CAAC,sCAAsC,CAAC;QACnDxB,MAAM,CAAC0B,IAAI,CAAC,cAAc,EAAEE,KAAK,CAAC;QAElC5B,MAAM,CAACgC,EAAE,CAAC,eAAe,EAAE,MAAM;UAC/BT,OAAO,CAACC,GAAG,CAAC,gCAAgC,CAAC;UAC7CF,kBA