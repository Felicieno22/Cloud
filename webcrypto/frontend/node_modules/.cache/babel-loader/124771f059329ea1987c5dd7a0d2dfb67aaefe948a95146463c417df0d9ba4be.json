{"ast":null,"code":"import { ref, onMounted, onUnmounted, computed } from 'vue';\nimport { useRoute } from 'vue-router';\nimport { socket } from '@/socket';\nimport { Chart as ChartJS, CategoryScale, LinearScale, PointElement, LineElement, TimeScale, Title, Tooltip, Legend } from 'chart.js';\nimport 'chartjs-adapter-date-fns';\nimport { fr } from 'date-fns/locale';\nimport { Line } from 'vue-chartjs';\nChartJS.register(CategoryScale, LinearScale, PointElement, LineElement, TimeScale, Title, Tooltip, Legend);\nexport default {\n  name: 'CryptoDetail',\n  components: {\n    Line\n  },\n  setup() {\n    const route = useRoute();\n    const cryptoSymbol = route.params.symbol;\n    const cryptoData = ref(null);\n    const priceHistory = ref([]);\n    const isLoading = ref(true);\n    const selectedPeriod = ref('day');\n    const latestOHLC = ref(null);\n    const periods = [{\n      value: 'day',\n      label: '24h'\n    }, {\n      value: 'week',\n      label: '7j'\n    }, {\n      value: 'month',\n      label: '1m'\n    }, {\n      value: 'year',\n      label: '1a'\n    }];\n\n    // Charger l'historique des prix\n    const loadPriceHistory = async (period = 'day') => {\n      isLoading.value = true;\n      try {\n        const response = await fetch(`http://localhost:3000/api/cryptocurrencies/${cryptoSymbol}/history?period=${period}`);\n        if (!response.ok) throw new Error('Erreur lors du chargement de l\\'historique');\n        const data = await response.json();\n        priceHistory.value = data.map(item => ({\n          ...item,\n          timestamp: new Date(item.created_at)\n        }));\n        if (priceHistory.value.length > 0) {\n          latestOHLC.value = priceHistory.value[priceHistory.value.length - 1];\n        }\n      } catch (error) {\n        console.error('Erreur:', error);\n      } finally {\n        isLoading.value = false;\n      }\n    };\n    const changePeriod = period => {\n      selectedPeriod.value = period;\n      loadPriceHistory(period);\n    };\n\n    // Configuration du graphique\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      scales: {\n        x: {\n          type: 'time',\n          adapters: {\n            date: {\n              locale: fr\n            }\n          },\n          time: {\n            unit: computed(() => {\n              switch (selectedPeriod.value) {\n                case 'week':\n                  return 'day';\n                case 'month':\n                  return 'week';\n                case 'year':\n                  return 'month';\n                default:\n                  return 'hour';\n              }\n            }),\n            displayFormats: {\n              hour: 'HH:mm',\n              day: 'dd/MM',\n              week: 'dd/MM',\n              month: 'MM/yyyy'\n            }\n          },\n          title: {\n            display: true,\n            text: 'Date'\n          }\n        },\n        y: {\n          beginAtZero: false,\n          ticks: {\n            callback: value => formatPrice(value)\n          },\n          title: {\n            display: true,\n            text: 'Prix'\n          }\n        }\n      },\n      plugins: {\n        legend: {\n          display: false\n        },\n        tooltip: {\n          callbacks: {\n            label: context => {\n              const dataPoint = priceHistory.value[context.dataIndex];\n              return [`Prix: ${formatPrice(dataPoint.price)}`, `Ouverture: ${formatPrice(dataPoint.open_price)}`, `Plus haut: ${formatPrice(dataPoint.high_price)}`, `Plus bas: ${formatPrice(dataPoint.low_price)}`];\n            },\n            title: tooltipItems => {\n              const date = new Date(tooltipItems[0].parsed.x);\n              return date.toLocaleString('fr-FR', {\n                dateStyle: 'short',\n                timeStyle: 'short'\n              });\n            }\n          }\n        }\n      },\n      interaction: {\n        intersect: false,\n        mode: 'index'\n      }\n    };\n    const chartData = computed(() => ({\n      labels: priceHistory.value.map(item => item.timestamp),\n      datasets: [{\n        label: cryptoSymbol,\n        data: priceHistory.value.map(item => item.price),\n        borderColor: '#4F46E5',\n        tension: 0.1,\n        pointRadius: 2\n      }]\n    }));\n\n    // Formatage des prix\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const formatPriceChange = change => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion des mises à jour en temps réel\n    socket.on('priceUpdate', data => {\n      const crypto = data.find(c => c.symbol === cryptoSymbol);\n      if (crypto) {\n        cryptoData.value = crypto;\n        // Mettre à jour seulement si on est en vue journalière\n        if (selectedPeriod.value === 'day') {\n          priceHistory.value.push({\n            price: crypto.price,\n            timestamp: new Date(),\n            open_price: crypto.price,\n            high_price: crypto.price,\n            low_price: crypto.price\n          });\n        }\n      }\n    });\n    onMounted(() => {\n      socket.connect();\n      loadPriceHistory(selectedPeriod.value);\n    });\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n    return {\n      cryptoSymbol,\n      cryptoData,\n      chartData,\n      chartOptions,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      isLoading,\n      periods,\n      selectedPeriod,\n      changePeriod,\n      latestOHLC\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","computed","useRoute","socket","Chart","ChartJS","CategoryScale","LinearScale","PointElement","LineElement","TimeScale","Title","Tooltip","Legend","fr","Line","register","name","components","setup","route","cryptoSymbol","params","symbol","cryptoData","priceHistory","isLoading","selectedPeriod","latestOHLC","periods","value","label","loadPriceHistory","period","response","fetch","ok","Error","data","json","map","item","timestamp","Date","created_at","length","error","console","changePeriod","chartOptions","responsive","maintainAspectRatio","scales","x","type","adapters","date","locale","time","unit","displayFormats","hour","day","week","month","title","display","text","y","beginAtZero","ticks","callback","formatPrice","plugins","legend","tooltip","callbacks","context","dataPoint","dataIndex","price","open_price","high_price","low_price","tooltipItems","parsed","toLocaleString","dateStyle","timeStyle","interaction","intersect","mode","chartData","labels","datasets","borderColor","tension","pointRadius","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatPriceChange","change","toFixed","getPriceChangeClass","priceChange","on","crypto","find","c","push","connect","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\CryptoDetail.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"mb-8 flex items-center justify-between\">\n      <div class=\"flex items-center\">\n        <button @click=\"$router.push('/dashboard')\" class=\"mr-4 text-indigo-600 hover:text-indigo-800\">\n          ← Retour\n        </button>\n        <h1 class=\"text-3xl font-bold text-gray-900\">{{ cryptoSymbol }}</h1>\n      </div>\n      \n      <!-- Sélecteur de période -->\n      <div class=\"flex space-x-2\">\n        <button v-for=\"p in periods\" :key=\"p.value\"\n                @click=\"changePeriod(p.value)\"\n                :class=\"[\n                  'px-4 py-2 rounded-lg font-medium',\n                  selectedPeriod === p.value\n                    ? 'bg-indigo-600 text-white'\n                    : 'bg-gray-100 text-gray-700 hover:bg-gray-200'\n                ]\">\n          {{ p.label }}\n        </button>\n      </div>\n    </div>\n\n    <div class=\"bg-white rounded-lg shadow-lg p-6\">\n      <div class=\"flex justify-between items-center mb-6\">\n        <div>\n          <h2 class=\"text-2xl font-bold\">{{ cryptoData?.name }}</h2>\n          <p class=\"text-gray-600\">Prix actuel: {{ formatPrice(cryptoData?.price) }}</p>\n        </div>\n        <div :class=\"getPriceChangeClass()\" class=\"text-lg font-semibold\">\n          {{ formatPriceChange(cryptoData?.priceChange) }}%\n        </div>\n      </div>\n\n      <div v-if=\"isLoading\" class=\"h-96 flex items-center justify-center\">\n        <div class=\"text-gray-500\">Chargement...</div>\n      </div>\n\n      <div v-else class=\"h-96\">\n        <Line v-if=\"chartData\" :data=\"chartData\" :options=\"chartOptions\" />\n      </div>\n\n      <!-- Statistiques -->\n      <div v-if=\"latestOHLC\" class=\"mt-6 grid grid-cols-4 gap-4\">\n        <div class=\"p-4 bg-gray-50 rounded-lg\">\n          <div class=\"text-sm text-gray-500\">Ouverture</div>\n          <div class=\"text-lg font-semibold\">{{ formatPrice(latestOHLC.open_price) }}</div>\n        </div>\n        <div class=\"p-4 bg-gray-50 rounded-lg\">\n          <div class=\"text-sm text-gray-500\">Plus haut</div>\n          <div class=\"text-lg font-semibold text-green-600\">{{ formatPrice(latestOHLC.high_price) }}</div>\n        </div>\n        <div class=\"p-4 bg-gray-50 rounded-lg\">\n          <div class=\"text-sm text-gray-500\">Plus bas</div>\n          <div class=\"text-lg font-semibold text-red-600\">{{ formatPrice(latestOHLC.low_price) }}</div>\n        </div>\n        <div class=\"p-4 bg-gray-50 rounded-lg\">\n          <div class=\"text-sm text-gray-500\">Fermeture</div>\n          <div class=\"text-lg font-semibold\">{{ formatPrice(latestOHLC.price) }}</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted, computed } from 'vue';\nimport { useRoute } from 'vue-router';\nimport { socket } from '@/socket';\nimport {\n  Chart as ChartJS,\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  TimeScale,\n  Title,\n  Tooltip,\n  Legend\n} from 'chart.js';\nimport 'chartjs-adapter-date-fns';\nimport { fr } from 'date-fns/locale';\nimport { Line } from 'vue-chartjs';\n\nChartJS.register(\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  TimeScale,\n  Title,\n  Tooltip,\n  Legend\n);\n\nexport default {\n  name: 'CryptoDetail',\n  components: { Line },\n\n  setup() {\n    const route = useRoute();\n    const cryptoSymbol = route.params.symbol;\n    const cryptoData = ref(null);\n    const priceHistory = ref([]);\n    const isLoading = ref(true);\n    const selectedPeriod = ref('day');\n    const latestOHLC = ref(null);\n\n    const periods = [\n      { value: 'day', label: '24h' },\n      { value: 'week', label: '7j' },\n      { value: 'month', label: '1m' },\n      { value: 'year', label: '1a' }\n    ];\n\n    // Charger l'historique des prix\n    const loadPriceHistory = async (period = 'day') => {\n      isLoading.value = true;\n      try {\n        const response = await fetch(`http://localhost:3000/api/cryptocurrencies/${cryptoSymbol}/history?period=${period}`);\n        if (!response.ok) throw new Error('Erreur lors du chargement de l\\'historique');\n        \n        const data = await response.json();\n        priceHistory.value = data.map(item => ({\n          ...item,\n          timestamp: new Date(item.created_at)\n        }));\n\n        if (priceHistory.value.length > 0) {\n          latestOHLC.value = priceHistory.value[priceHistory.value.length - 1];\n        }\n      } catch (error) {\n        console.error('Erreur:', error);\n      } finally {\n        isLoading.value = false;\n      }\n    };\n\n    const changePeriod = (period) => {\n      selectedPeriod.value = period;\n      loadPriceHistory(period);\n    };\n\n    // Configuration du graphique\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      scales: {\n        x: {\n          type: 'time',\n          adapters: {\n            date: {\n              locale: fr\n            }\n          },\n          time: {\n            unit: computed(() => {\n              switch (selectedPeriod.value) {\n                case 'week': return 'day';\n                case 'month': return 'week';\n                case 'year': return 'month';\n                default: return 'hour';\n              }\n            }),\n            displayFormats: {\n              hour: 'HH:mm',\n              day: 'dd/MM',\n              week: 'dd/MM',\n              month: 'MM/yyyy'\n            }\n          },\n          title: {\n            display: true,\n            text: 'Date'\n          }\n        },\n        y: {\n          beginAtZero: false,\n          ticks: {\n            callback: value => formatPrice(value)\n          },\n          title: {\n            display: true,\n            text: 'Prix'\n          }\n        }\n      },\n      plugins: {\n        legend: {\n          display: false\n        },\n        tooltip: {\n          callbacks: {\n            label: (context) => {\n              const dataPoint = priceHistory.value[context.dataIndex];\n              return [\n                `Prix: ${formatPrice(dataPoint.price)}`,\n                `Ouverture: ${formatPrice(dataPoint.open_price)}`,\n                `Plus haut: ${formatPrice(dataPoint.high_price)}`,\n                `Plus bas: ${formatPrice(dataPoint.low_price)}`\n              ];\n            },\n            title: (tooltipItems) => {\n              const date = new Date(tooltipItems[0].parsed.x);\n              return date.toLocaleString('fr-FR', {\n                dateStyle: 'short',\n                timeStyle: 'short'\n              });\n            }\n          }\n        }\n      },\n      interaction: {\n        intersect: false,\n        mode: 'index'\n      }\n    };\n\n    const chartData = computed(() => ({\n      labels: priceHistory.value.map(item => item.timestamp),\n      datasets: [{\n        label: cryptoSymbol,\n        data: priceHistory.value.map(item => item.price),\n        borderColor: '#4F46E5',\n        tension: 0.1,\n        pointRadius: 2\n      }]\n    }));\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const formatPriceChange = (change) => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion des mises à jour en temps réel\n    socket.on('priceUpdate', (data) => {\n      const crypto = data.find(c => c.symbol === cryptoSymbol);\n      if (crypto) {\n        cryptoData.value = crypto;\n        // Mettre à jour seulement si on est en vue journalière\n        if (selectedPeriod.value === 'day') {\n          priceHistory.value.push({\n            price: crypto.price,\n            timestamp: new Date(),\n            open_price: crypto.price,\n            high_price: crypto.price,\n            low_price: crypto.price\n          });\n        }\n      }\n    });\n\n    onMounted(() => {\n      socket.connect();\n      loadPriceHistory(selectedPeriod.value);\n    });\n\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n\n    return {\n      cryptoSymbol,\n      cryptoData,\n      chartData,\n      chartOptions,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      isLoading,\n      periods,\n      selectedPeriod,\n      changePeriod,\n      latestOHLC\n    };\n  }\n};\n</script>\n"],"mappings":"AAoEA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAW,EAAEC,QAAO,QAAS,KAAK;AAC3D,SAASC,QAAO,QAAS,YAAY;AACrC,SAASC,MAAK,QAAS,UAAU;AACjC,SACEC,KAAI,IAAKC,OAAO,EAChBC,aAAa,EACbC,WAAW,EACXC,YAAY,EACZC,WAAW,EACXC,SAAS,EACTC,KAAK,EACLC,OAAO,EACPC,MAAK,QACA,UAAU;AACjB,OAAO,0BAA0B;AACjC,SAASC,EAAC,QAAS,iBAAiB;AACpC,SAASC,IAAG,QAAS,aAAa;AAElCV,OAAO,CAACW,QAAQ,CACdV,aAAa,EACbC,WAAW,EACXC,YAAY,EACZC,WAAW,EACXC,SAAS,EACTC,KAAK,EACLC,OAAO,EACPC,MACF,CAAC;AAED,eAAe;EACbI,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IAAEH;EAAK,CAAC;EAEpBI,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIlB,QAAQ,CAAC,CAAC;IACxB,MAAMmB,YAAW,GAAID,KAAK,CAACE,MAAM,CAACC,MAAM;IACxC,MAAMC,UAAS,GAAI1B,GAAG,CAAC,IAAI,CAAC;IAC5B,MAAM2B,YAAW,GAAI3B,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAM4B,SAAQ,GAAI5B,GAAG,CAAC,IAAI,CAAC;IAC3B,MAAM6B,cAAa,GAAI7B,GAAG,CAAC,KAAK,CAAC;IACjC,MAAM8B,UAAS,GAAI9B,GAAG,CAAC,IAAI,CAAC;IAE5B,MAAM+B,OAAM,GAAI,CACd;MAAEC,KAAK,EAAE,KAAK;MAAEC,KAAK,EAAE;IAAM,CAAC,EAC9B;MAAED,KAAK,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAK,CAAC,EAC9B;MAAED,KAAK,EAAE,OAAO;MAAEC,KAAK,EAAE;IAAK,CAAC,EAC/B;MAAED,KAAK,EAAE,MAAM;MAAEC,KAAK,EAAE;IAAK,EAC9B;;IAED;IACA,MAAMC,gBAAe,GAAI,MAAAA,CAAOC,MAAK,GAAI,KAAK,KAAK;MACjDP,SAAS,CAACI,KAAI,GAAI,IAAI;MACtB,IAAI;QACF,MAAMI,QAAO,GAAI,MAAMC,KAAK,CAAC,8CAA8Cd,YAAY,mBAAmBY,MAAM,EAAE,CAAC;QACnH,IAAI,CAACC,QAAQ,CAACE,EAAE,EAAE,MAAM,IAAIC,KAAK,CAAC,4CAA4C,CAAC;QAE/E,MAAMC,IAAG,GAAI,MAAMJ,QAAQ,CAACK,IAAI,CAAC,CAAC;QAClCd,YAAY,CAACK,KAAI,G