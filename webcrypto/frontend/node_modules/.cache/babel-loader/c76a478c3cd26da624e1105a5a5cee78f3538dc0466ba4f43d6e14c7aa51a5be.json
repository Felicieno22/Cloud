{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport axios from 'axios';\nimport { socket } from '@/socket';\nexport default {\n  name: 'Wallet',\n  setup() {\n    const wallet = ref(null);\n    const positions = ref([]);\n    const transactions = ref([]);\n    const depositAmount = ref('');\n    const withdrawalAmount = ref('');\n    const fetchWallet = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        const response = await axios.get('/api/wallet', {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        wallet.value = response.data;\n      } catch (error) {\n        console.error('Error fetching wallet:', error);\n      }\n    };\n    const fetchPositions = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        const response = await axios.get('/api/wallet/positions', {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        positions.value = response.data;\n      } catch (error) {\n        console.error('Error fetching positions:', error);\n      }\n    };\n    const fetchTransactions = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        const response = await axios.get('/api/wallet/transactions', {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        transactions.value = response.data;\n      } catch (error) {\n        console.error('Error fetching transactions:', error);\n      }\n    };\n    const requestDeposit = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        await axios.post('/api/wallet/deposit-request', {\n          amount: parseFloat(depositAmount.value)\n        }, {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        alert('Deposit request sent to admin for approval');\n        depositAmount.value = '';\n        await fetchWallet();\n        await fetchTransactions();\n      } catch (error) {\n        console.error('Error requesting deposit:', error);\n        alert('Failed to send deposit request');\n      }\n    };\n    const requestWithdrawal = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        await axios.post('/api/wallet/withdrawal-request', {\n          amount: parseFloat(withdrawalAmount.value)\n        }, {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        alert('Withdrawal request sent to admin for approval');\n        withdrawalAmount.value = '';\n        await fetchWallet();\n        await fetchTransactions();\n      } catch (error) {\n        console.error('Error requesting withdrawal:', error);\n        alert('Failed to send withdrawal request');\n      }\n    };\n\n    // Socket.io event handlers\n    socket.on('walletUpdate', data => {\n      wallet.value = data;\n    });\n    socket.on('positionsUpdate', data => {\n      positions.value = data;\n    });\n    socket.on('transactionsUpdate', data => {\n      transactions.value = data;\n    });\n    onMounted(() => {\n      socket.connect();\n      fetchWallet();\n      fetchPositions();\n      fetchTransactions();\n    });\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n    return {\n      wallet,\n      positions,\n      transactions,\n      depositAmount,\n      withdrawalAmount,\n      requestDeposit,\n      requestWithdrawal\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","axios","socket","name","setup","wallet","positions","transactions","depositAmount","withdrawalAmount","fetchWallet","token","localStorage","getItem","response","get","headers","Authorization","value","data","error","console","fetchPositions","fetchTransactions","requestDeposit","post","amount","parseFloat","alert","requestWithdrawal","on","connect","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Wallet.vue"],"sourcesContent":["<template>\n\t<div class=\"wallet\">\n\t\t<h1>Wallet</h1>\n\t\t<div v-if=\"wallet\" class=\"wallet-info\">\n\t\t\t<div class=\"balance\">\n\t\t\t\tBalance: {{ wallet.balance }}\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"transaction-forms\">\n\t\t\t<div class=\"deposit-form\">\n\t\t\t\t<h3>Request Deposit</h3>\n\t\t\t\t<form @submit.prevent=\"requestDeposit\">\n\t\t\t\t\t<input \n\t\t\t\t\t\ttype=\"number\" \n\t\t\t\t\t\tv-model=\"depositAmount\" \n\t\t\t\t\t\tplaceholder=\"Amount to deposit\"\n\t\t\t\t\t\tmin=\"0\"\n\t\t\t\t\t\tstep=\"0.01\"\n\t\t\t\t\t\trequired\n\t\t\t\t\t/>\n\t\t\t\t\t<button type=\"submit\">Request Deposit</button>\n\t\t\t\t</form>\n\t\t\t</div>\n\n\t\t\t<div class=\"withdrawal-form\">\n\t\t\t\t<h3>Request Withdrawal</h3>\n\t\t\t\t<form @submit.prevent=\"requestWithdrawal\">\n\t\t\t\t\t<input \n\t\t\t\t\t\ttype=\"number\" \n\t\t\t\t\t\tv-model=\"withdrawalAmount\" \n\t\t\t\t\t\tplaceholder=\"Amount to withdraw\"\n\t\t\t\t\t\tmin=\"0\"\n\t\t\t\t\t\tstep=\"0.01\"\n\t\t\t\t\t\trequired\n\t\t\t\t\t/>\n\t\t\t\t\t<button type=\"submit\">Request Withdrawal</button>\n\t\t\t\t</form>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div v-if=\"positions.length\" class=\"positions\">\n\t\t\t<h2>Positions</h2>\n\t\t\t<ul>\n\t\t\t\t<li v-for=\"position in positions\" :key=\"position.id\">\n\t\t\t\t\t{{ position.asset }}: {{ position.amount }}\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</div>\n\t\t<div v-if=\"transactions.length\" class=\"transactions\">\n\t\t\t<h2>Recent Transactions</h2>\n\t\t\t<ul>\n\t\t\t\t<li v-for=\"tx in transactions\" :key=\"tx.id\">\n\t\t\t\t\t{{ tx.type }}: {{ tx.amount }}\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</div>\n\t</div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted } from 'vue';\nimport axios from 'axios';\nimport { socket } from '@/socket';\n\nexport default {\n\tname: 'Wallet',\n\tsetup() {\n\t\tconst wallet = ref(null);\n\t\tconst positions = ref([]);\n\t\tconst transactions = ref([]);\n\t\tconst depositAmount = ref('');\n\t\tconst withdrawalAmount = ref('');\n\n\t\tconst fetchWallet = async () => {\n\t\t\ttry {\n\t\t\t\tconst token = localStorage.getItem('token');\n\t\t\t\tconst response = await axios.get('/api/wallet', {\n\t\t\t\t\theaders: { Authorization: `Bearer ${token}` }\n\t\t\t\t});\n\t\t\t\twallet.value = response.data;\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error fetching wallet:', error);\n\t\t\t}\n\t\t};\n\n\t\tconst fetchPositions = async () => {\n\t\t\ttry {\n\t\t\t\tconst token = localStorage.getItem('token');\n\t\t\t\tconst response = await axios.get('/api/wallet/positions', {\n\t\t\t\t\theaders: { Authorization: `Bearer ${token}` }\n\t\t\t\t});\n\t\t\t\tpositions.value = response.data;\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error fetching positions:', error);\n\t\t\t}\n\t\t};\n\n\t\tconst fetchTransactions = async () => {\n\t\t\ttry {\n\t\t\t\tconst token = localStorage.getItem('token');\n\t\t\t\tconst response = await axios.get('/api/wallet/transactions', {\n\t\t\t\t\theaders: { Authorization: `Bearer ${token}` }\n\t\t\t\t});\n\t\t\t\ttransactions.value = response.data;\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error fetching transactions:', error);\n\t\t\t}\n\t\t};\n\n\t\tconst requestDeposit = async () => {\n\t\t\ttry {\n\t\t\t\tconst token = localStorage.getItem('token');\n\t\t\t\tawait axios.post('/api/wallet/deposit-request', \n\t\t\t\t\t{ amount: parseFloat(depositAmount.value) },\n\t\t\t\t\t{ headers: { Authorization: `Bearer ${token}` } }\n\t\t\t\t);\n\t\t\t\talert('Deposit request sent to admin for approval');\n\t\t\t\tdepositAmount.value = '';\n\t\t\t\tawait fetchWallet();\n\t\t\t\tawait fetchTransactions();\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error requesting deposit:', error);\n\t\t\t\talert('Failed to send deposit request');\n\t\t\t}\n\t\t};\n\n\t\tconst requestWithdrawal = async () => {\n\t\t\ttry {\n\t\t\t\tconst token = localStorage.getItem('token');\n\t\t\t\tawait axios.post('/api/wallet/withdrawal-request', \n\t\t\t\t\t{ amount: parseFloat(withdrawalAmount.value) },\n\t\t\t\t\t{ headers: { Authorization: `Bearer ${token}` } }\n\t\t\t\t);\n\t\t\t\talert('Withdrawal request sent to admin for approval');\n\t\t\t\twithdrawalAmount.value = '';\n\t\t\t\tawait fetchWallet();\n\t\t\t\tawait fetchTransactions();\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error requesting withdrawal:', error);\n\t\t\t\talert('Failed to send withdrawal request');\n\t\t\t}\n\t\t};\n\n\t\t// Socket.io event handlers\n\t\tsocket.on('walletUpdate', (data) => {\n\t\t\twallet.value = data;\n\t\t});\n\n\t\tsocket.on('positionsUpdate', (data) => {\n\t\t\tpositions.value = data;\n\t\t});\n\n\t\tsocket.on('transactionsUpdate', (data) => {\n\t\t\ttransactions.value = data;\n\t\t});\n\n\t\tonMounted(() => {\n\t\t\tsocket.connect();\n\t\t\tfetchWallet();\n\t\t\tfetchPositions();\n\t\t\tfetchTransactions();\n\t\t});\n\n\t\tonUnmounted(() => {\n\t\t\tsocket.disconnect();\n\t\t});\n\n\t\treturn {\n\t\t\twallet,\n\t\t\tpositions,\n\t\t\ttransactions,\n\t\t\tdepositAmount,\n\t\t\twithdrawalAmount,\n\t\t\trequestDeposit,\n\t\t\trequestWithdrawal\n\t\t};\n\t}\n};\n</script>\n\n<style scoped>\n.wallet {\n\tpadding: 20px;\n}\n\n.wallet-info {\n\tmargin: 20px 0;\n\tpadding: 15px;\n\tborder: 1px solid #ddd;\n\tborder-radius: 4px;\n}\n\n.transaction-forms {\n\tdisplay: flex;\n\tgap: 20px;\n\tmargin: 20px 0;\n}\n\n.deposit-form, .withdrawal-form {\n\tflex: 1;\n\tpadding: 15px;\n\tborder: 1px solid #ddd;\n\tborder-radius: 4px;\n}\n\nform {\n\tdisplay: flex;\n\tflex-direction: column;\n\tgap: 10px;\n}\n\ninput {\n\tpadding: 8px;\n\tborder: 1px solid #ddd;\n\tborder-radius: 4px;\n}\n\nbutton {\n\tpadding: 8px;\n\tbackground-color: #4CAF50;\n\tcolor: white;\n\tborder: none;\n\tborder-radius: 4px;\n\tcursor: pointer;\n}\n\nbutton:hover {\n\tbackground-color: #45a049;\n}\n\n.positions, .transactions {\n\tmargin-top: 20px;\n}\n\nul {\n\tlist-style: none;\n\tpadding: 0;\n}\n\nli {\n\tpadding: 10px;\n\tborder-bottom: 1px solid #eee;\n}\n\nli:last-child {\n\tborder-bottom: none;\n}\n</style>"],"mappings":"AA6DA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AACjD,OAAOC,KAAI,MAAO,OAAO;AACzB,SAASC,MAAK,QAAS,UAAU;AAEjC,eAAe;EACdC,IAAI,EAAE,QAAQ;EACdC,KAAKA,CAAA,EAAG;IACP,MAAMC,MAAK,GAAIP,GAAG,CAAC,IAAI,CAAC;IACxB,MAAMQ,SAAQ,GAAIR,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMS,YAAW,GAAIT,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMU,aAAY,GAAIV,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAMW,gBAAe,GAAIX,GAAG,CAAC,EAAE,CAAC;IAEhC,MAAMY,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACH,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,MAAMC,QAAO,GAAI,MAAMb,KAAK,CAACc,GAAG,CAAC,aAAa,EAAE;UAC/CC,OAAO,EAAE;YAAEC,aAAa,EAAE,UAAUN,KAAK;UAAG;QAC7C,CAAC,CAAC;QACFN,MAAM,CAACa,KAAI,GAAIJ,QAAQ,CAACK,IAAI;MAC7B,EAAE,OAAOC,KAAK,EAAE;QACfC,OAAO,CAACD,KAAK,CAAC,wBAAwB,EAAEA,KAAK,CAAC;MAC/C;IACD,CAAC;IAED,MAAME,cAAa,GAAI,MAAAA,CAAA,KAAY;MAClC,IAAI;QACH,MAAMX,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,MAAMC,QAAO,GAAI,MAAMb,KAAK,CAACc,GAAG,CAAC,uBAAuB,EAAE;UACzDC,OAAO,EAAE;YAAEC,aAAa,EAAE,UAAUN,KAAK;UAAG;QAC7C,CAAC,CAAC;QACFL,SAAS,CAACY,KAAI,GAAIJ,QAAQ,CAACK,IAAI;MAChC,EAAE,OAAOC,KAAK,EAAE;QACfC,OAAO,CAACD,KAAK,CAAC,2BAA2B,EAAEA,KAAK,CAAC;MAClD;IACD,CAAC;IAED,MAAMG,iBAAgB,GAAI,MAAAA,CAAA,KAAY;MACrC,IAAI;QACH,MAAMZ,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,MAAMC,QAAO,GAAI,MAAMb,KAAK,CAACc,GAAG,CAAC,0BAA0B,EAAE;UAC5DC,OAAO,EAAE;YAAEC,aAAa,EAAE,UAAUN,KAAK;UAAG;QAC7C,CAAC,CAAC;QACFJ,YAAY,CAACW,KAAI,GAAIJ,QAAQ,CAACK,IAAI;MACnC,EAAE,OAAOC,KAAK,EAAE;QACfC,OAAO,CAACD,KAAK,CAAC,8BAA8B,EAAEA,KAAK,CAAC;MACrD;IACD,CAAC;IAED,MAAMI,cAAa,GAAI,MAAAA,CAAA,KAAY;MAClC,IAAI;QACH,MAAMb,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,MAAMZ,KAAK,CAACwB,IAAI,CAAC,6BAA6B,EAC7C;UAAEC,MAAM,EAAEC,UAAU,CAACnB,aAAa,CAACU,KAAK;QAAE,CAAC,EAC3C;UAAEF,OAAO,EAAE;YAAEC,aAAa,EAAE,UAAUN,KAAK;UAAG;QAAE,CACjD,CAAC;QACDiB,KAAK,CAAC,4CAA4C,CAAC;QACnDpB,aAAa,CAACU,KAAI,GAAI,EAAE;QACxB,MAA