{"ast":null,"code":"import { ref, computed, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nexport default {\n  name: 'Wallet',\n  setup() {\n    const store = useStore();\n\n    // État local\n    const showDepositModal = ref(false);\n    const showWithdrawModal = ref(false);\n    const depositAmount = ref('');\n    const withdrawAmount = ref('');\n    const paymentMethod = ref('card');\n    const bankDetails = ref('');\n\n    // Données du store\n    const balance = computed(() => store.getters['wallet/getBalance']);\n    const cryptoHoldings = computed(() => store.getters['wallet/getCryptoHoldings']);\n    const transactions = computed(() => store.getters['wallet/getTransactions']);\n    const totalPortfolioValue = computed(() => store.getters['wallet/getTotalPortfolioValue']);\n\n    // Formattage des prix\n    const formatPrice = price => {\n      return Number(price).toLocaleString(undefined, {\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      });\n    };\n\n    // Prix des cryptos\n    const getCryptoPrice = crypto => {\n      return store.getters['crypto/getPrices'][crypto] || 0;\n    };\n\n    // Gestion des transactions\n    const formatTransactionType = type => {\n      const types = {\n        deposit: 'Dépôt',\n        withdrawal: 'Retrait',\n        buy: 'Achat',\n        sell: 'Vente'\n      };\n      return types[type] || type;\n    };\n    const formatTransactionAmount = transaction => {\n      const amount = Math.abs(transaction.amount);\n      const symbol = transaction.type === 'deposit' || transaction.type === 'buy' ? '+' : '-';\n      return `${symbol} ${transaction.crypto ? amount + ' ' + transaction.crypto : '$' + formatPrice(amount)}`;\n    };\n    const getTransactionAmountClass = transaction => {\n      return {\n        'text-green-600': transaction.type === 'deposit' || transaction.type === 'sell',\n        'text-red-600': transaction.type === 'withdrawal' || transaction.type === 'buy'\n      };\n    };\n\n    // Actions\n    const handleDeposit = async () => {\n      try {\n        await store.dispatch('wallet/requestDeposit', {\n          amount: parseFloat(depositAmount.value),\n          paymentMethod: paymentMethod.value\n        });\n        showDepositModal.value = false;\n        depositAmount.value = '';\n        alert('Demande de dépôt envoyée. Vérifiez votre email pour confirmer.');\n      } catch (error) {\n        alert(error.message || 'Erreur lors du dépôt');\n      }\n    };\n    const handleWithdraw = async () => {\n      try {\n        await store.dispatch('wallet/requestWithdrawal', {\n          amount: parseFloat(withdrawAmount.value),\n          bankDetails: bankDetails.value\n        });\n        showWithdrawModal.value = false;\n        withdrawAmount.value = '';\n        bankDetails.value = '';\n        alert('Demande de retrait envoyée. Vérifiez votre email pour confirmer.');\n      } catch (error) {\n        alert(error.message || 'Erreur lors du retrait');\n      }\n    };\n\n    // Chargement initial des données\n    onMounted(async () => {\n      try {\n        await store.dispatch('wallet/fetchWalletData');\n      } catch (error) {\n        console.error('Erreur lors du chargement des données du portefeuille:', error);\n      }\n    });\n    return {\n      // État\n      showDepositModal,\n      showWithdrawModal,\n      depositAmount,\n      withdrawAmount,\n      paymentMethod,\n      bankDetails,\n      // Données calculées\n      balance,\n      cryptoHoldings,\n      transactions,\n      totalPortfolioValue,\n      // Méthodes\n      formatPrice,\n      getCryptoPrice,\n      formatTransactionType,\n      formatTransactionAmount,\n      getTransactionAmountClass,\n      handleDeposit,\n      handleWithdraw\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","useStore","name","setup","store","showDepositModal","showWithdrawModal","depositAmount","withdrawAmount","paymentMethod","bankDetails","balance","getters","cryptoHoldings","transactions","totalPortfolioValue","formatPrice","price","Number","toLocaleString","undefined","minimumFractionDigits","maximumFractionDigits","getCryptoPrice","crypto","formatTransactionType","type","types","deposit","withdrawal","buy","sell","formatTransactionAmount","transaction","amount","Math","abs","symbol","getTransactionAmountClass","handleDeposit","dispatch","parseFloat","value","alert","error","message","handleWithdraw","console"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\Wallet.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <!-- En-tête du portefeuille -->\n    <div class=\"mb-8\">\n      <h1 class=\"text-3xl font-bold text-gray-900\">Mon Portefeuille</h1>\n      <p class=\"text-gray-600\">Gérez vos fonds et vos cryptomonnaies</p>\n    </div>\n\n    <!-- Résumé du portefeuille -->\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8\">\n      <div class=\"bg-white rounded-lg shadow p-6\">\n        <h2 class=\"text-lg text-gray-600\">Solde disponible</h2>\n        <p class=\"text-3xl font-bold text-gray-900\">${{ formatPrice(balance) }}</p>\n      </div>\n      <div class=\"bg-white rounded-lg shadow p-6\">\n        <h2 class=\"text-lg text-gray-600\">Valeur du portefeuille</h2>\n        <p class=\"text-3xl font-bold text-gray-900\">${{ formatPrice(totalPortfolioValue) }}</p>\n      </div>\n      <div class=\"bg-white rounded-lg shadow p-6\">\n        <h2 class=\"text-lg text-gray-600\">Nombre de cryptos</h2>\n        <p class=\"text-3xl font-bold text-gray-900\">{{ Object.keys(cryptoHoldings).length }}</p>\n      </div>\n    </div>\n\n    <!-- Actions principales -->\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-8\">\n      <button\n        @click=\"showDepositModal = true\"\n        class=\"bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition-colors\"\n      >\n        Déposer des fonds\n      </button>\n      <button\n        @click=\"showWithdrawModal = true\"\n        class=\"bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition-colors\"\n      >\n        Retirer des fonds\n      </button>\n    </div>\n\n    <!-- Liste des cryptomonnaies -->\n    <div class=\"bg-white rounded-lg shadow overflow-hidden\">\n      <div class=\"px-6 py-4 border-b\">\n        <h2 class=\"text-xl font-semibold\">Mes Cryptomonnaies</h2>\n      </div>\n      <div class=\"divide-y\">\n        <div\n          v-for=\"(amount, crypto) in cryptoHoldings\"\n          :key=\"crypto\"\n          class=\"px-6 py-4 hover:bg-gray-50\"\n        >\n          <div class=\"flex justify-between items-center\">\n            <div>\n              <h3 class=\"text-lg font-medium\">{{ crypto }}</h3>\n              <p class=\"text-gray-600\">{{ amount }} {{ crypto }}</p>\n            </div>\n            <div class=\"text-right\">\n              <p class=\"text-lg font-medium\">${{ formatPrice(amount * getCryptoPrice(crypto)) }}</p>\n              <p class=\"text-sm text-gray-500\">\n                ${{ formatPrice(getCryptoPrice(crypto)) }} / {{ crypto }}\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Historique des transactions -->\n    <div class=\"mt-8 bg-white rounded-lg shadow overflow-hidden\">\n      <div class=\"px-6 py-4 border-b\">\n        <h2 class=\"text-xl font-semibold\">Historique des transactions</h2>\n      </div>\n      <div class=\"divide-y\">\n        <div\n          v-for=\"transaction in transactions\"\n          :key=\"transaction.id\"\n          class=\"px-6 py-4 hover:bg-gray-50\"\n        >\n          <div class=\"flex justify-between items-center\">\n            <div>\n              <p class=\"font-medium\">\n                {{ formatTransactionType(transaction.type) }}\n                {{ transaction.crypto ? transaction.crypto : '' }}\n              </p>\n              <p class=\"text-sm text-gray-500\">\n                {{ new Date(transaction.timestamp).toLocaleString() }}\n              </p>\n            </div>\n            <div :class=\"getTransactionAmountClass(transaction)\">\n              {{ formatTransactionAmount(transaction) }}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Modal de dépôt -->\n    <div v-if=\"showDepositModal\" class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center\">\n      <div class=\"bg-white rounded-lg p-6 max-w-md w-full\">\n        <h2 class=\"text-xl font-bold mb-4\">Déposer des fonds</h2>\n        <form @submit.prevent=\"handleDeposit\">\n          <div class=\"mb-4\">\n            <label class=\"block text-sm font-medium text-gray-700\">Montant (USD)</label>\n            <input\n              v-model=\"depositAmount\"\n              type=\"number\"\n              min=\"0\"\n              step=\"0.01\"\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\n              required\n            />\n          </div>\n          <div class=\"mb-4\">\n            <label class=\"block text-sm font-medium text-gray-700\">Méthode de paiement</label>\n            <select\n              v-model=\"paymentMethod\"\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\n              required\n            >\n              <option value=\"card\">Carte bancaire</option>\n              <option value=\"bank\">Virement bancaire</option>\n            </select>\n          </div>\n          <div class=\"flex justify-end space-x-4\">\n            <button\n              type=\"button\"\n              @click=\"showDepositModal = false\"\n              class=\"px-4 py-2 border rounded-md hover:bg-gray-50\"\n            >\n              Annuler\n            </button>\n            <button\n              type=\"submit\"\n              class=\"px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700\"\n            >\n              Déposer\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n\n    <!-- Modal de retrait -->\n    <div v-if=\"showWithdrawModal\" class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center\">\n      <div class=\"bg-white rounded-lg p-6 max-w-md w-full\">\n        <h2 class=\"text-xl font-bold mb-4\">Retirer des fonds</h2>\n        <form @submit.prevent=\"handleWithdraw\">\n          <div class=\"mb-4\">\n            <label class=\"block text-sm font-medium text-gray-700\">Montant (USD)</label>\n            <input\n              v-model=\"withdrawAmount\"\n              type=\"number\"\n              min=\"0\"\n              :max=\"balance\"\n              step=\"0.01\"\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\n              required\n            />\n          </div>\n          <div class=\"mb-4\">\n            <label class=\"block text-sm font-medium text-gray-700\">Coordonnées bancaires</label>\n            <textarea\n              v-model=\"bankDetails\"\n              rows=\"3\"\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\n              required\n            ></textarea>\n          </div>\n          <div class=\"flex justify-end space-x-4\">\n            <button\n              type=\"button\"\n              @click=\"showWithdrawModal = false\"\n              class=\"px-4 py-2 border rounded-md hover:bg-gray-50\"\n            >\n              Annuler\n            </button>\n            <button\n              type=\"submit\"\n              class=\"px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700\"\n            >\n              Retirer\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed, onMounted } from 'vue'\nimport { useStore } from 'vuex'\n\nexport default {\n  name: 'Wallet',\n\n  setup() {\n    const store = useStore()\n    \n    // État local\n    const showDepositModal = ref(false)\n    const showWithdrawModal = ref(false)\n    const depositAmount = ref('')\n    const withdrawAmount = ref('')\n    const paymentMethod = ref('card')\n    const bankDetails = ref('')\n\n    // Données du store\n    const balance = computed(() => store.getters['wallet/getBalance'])\n    const cryptoHoldings = computed(() => store.getters['wallet/getCryptoHoldings'])\n    const transactions = computed(() => store.getters['wallet/getTransactions'])\n    const totalPortfolioValue = computed(() => store.getters['wallet/getTotalPortfolioValue'])\n\n    // Formattage des prix\n    const formatPrice = (price) => {\n      return Number(price).toLocaleString(undefined, {\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      })\n    }\n\n    // Prix des cryptos\n    const getCryptoPrice = (crypto) => {\n      return store.getters['crypto/getPrices'][crypto] || 0\n    }\n\n    // Gestion des transactions\n    const formatTransactionType = (type) => {\n      const types = {\n        deposit: 'Dépôt',\n        withdrawal: 'Retrait',\n        buy: 'Achat',\n        sell: 'Vente'\n      }\n      return types[type] || type\n    }\n\n    const formatTransactionAmount = (transaction) => {\n      const amount = Math.abs(transaction.amount)\n      const symbol = transaction.type === 'deposit' || transaction.type === 'buy' ? '+' : '-'\n      return `${symbol} ${transaction.crypto ? amount + ' ' + transaction.crypto : '$' + formatPrice(amount)}`\n    }\n\n    const getTransactionAmountClass = (transaction) => {\n      return {\n        'text-green-600': transaction.type === 'deposit' || transaction.type === 'sell',\n        'text-red-600': transaction.type === 'withdrawal' || transaction.type === 'buy'\n      }\n    }\n\n    // Actions\n    const handleDeposit = async () => {\n      try {\n        await store.dispatch('wallet/requestDeposit', {\n          amount: parseFloat(depositAmount.value),\n          paymentMethod: paymentMethod.value\n        })\n        showDepositModal.value = false\n        depositAmount.value = ''\n        alert('Demande de dépôt envoyée. Vérifiez votre email pour confirmer.')\n      } catch (error) {\n        alert(error.message || 'Erreur lors du dépôt')\n      }\n    }\n\n    const handleWithdraw = async () => {\n      try {\n        await store.dispatch('wallet/requestWithdrawal', {\n          amount: parseFloat(withdrawAmount.value),\n          bankDetails: bankDetails.value\n        })\n        showWithdrawModal.value = false\n        withdrawAmount.value = ''\n        bankDetails.value = ''\n        alert('Demande de retrait envoyée. Vérifiez votre email pour confirmer.')\n      } catch (error) {\n        alert(error.message || 'Erreur lors du retrait')\n      }\n    }\n\n    // Chargement initial des données\n    onMounted(async () => {\n      try {\n        await store.dispatch('wallet/fetchWalletData')\n      } catch (error) {\n        console.error('Erreur lors du chargement des données du portefeuille:', error)\n      }\n    })\n\n    return {\n      // État\n      showDepositModal,\n      showWithdrawModal,\n      depositAmount,\n      withdrawAmount,\n      paymentMethod,\n      bankDetails,\n      \n      // Données calculées\n      balance,\n      cryptoHoldings,\n      transactions,\n      totalPortfolioValue,\n      \n      // Méthodes\n      formatPrice,\n      getCryptoPrice,\n      formatTransactionType,\n      formatTransactionAmount,\n      getTransactionAmountClass,\n      handleDeposit,\n      handleWithdraw\n    }\n  }\n}\n</script>\n"],"mappings":"AA8LA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAI;AAC7C,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,IAAI,EAAE,QAAQ;EAEdC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIH,QAAQ,CAAC;;IAEvB;IACA,MAAMI,gBAAe,GA