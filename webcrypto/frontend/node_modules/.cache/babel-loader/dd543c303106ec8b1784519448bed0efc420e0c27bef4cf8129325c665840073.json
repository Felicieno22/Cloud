{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport axios from 'axios';\nimport { socket } from '@/socket';\nconst API_URL = 'http://localhost:3000';\nexport default {\n  name: 'Wallet',\n  setup() {\n    const wallet = ref(null);\n    const positions = ref([]);\n    const transactions = ref([]);\n    const depositAmount = ref('');\n    const withdrawalAmount = ref('');\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const fetchWallet = async () => {\n      try {\n        const response = await axios.get(`${API_URL}/api/wallet`);\n        wallet.value = response.data;\n      } catch (error) {\n        console.error('Error fetching wallet:', error);\n      }\n    };\n    const fetchPositions = async () => {\n      try {\n        const response = await axios.get(`${API_URL}/api/wallet/positions`);\n        positions.value = response.data;\n      } catch (error) {\n        console.error('Error fetching positions:', error);\n      }\n    };\n    const fetchTransactions = async () => {\n      try {\n        const response = await axios.get(`${API_URL}/api/wallet/transactions`);\n        transactions.value = response.data;\n      } catch (error) {\n        console.error('Error fetching transactions:', error);\n      }\n    };\n    const requestDeposit = async () => {\n      try {\n        await axios.post(`${API_URL}/api/wallet/request`, {\n          type: 'deposit',\n          amount: parseFloat(depositAmount.value)\n        });\n        alert('Demande de dépôt envoyée pour approbation');\n        depositAmount.value = '';\n        await fetchWallet();\n        await fetchTransactions();\n      } catch (error) {\n        console.error('Error requesting deposit:', error);\n        alert('Échec de la demande de dépôt');\n      }\n    };\n    const requestWithdrawal = async () => {\n      try {\n        await axios.post(`${API_URL}/api/wallet/request`, {\n          type: 'withdrawal',\n          amount: parseFloat(withdrawalAmount.value)\n        });\n        alert('Demande de retrait envoyée pour approbation');\n        withdrawalAmount.value = '';\n        await fetchWallet();\n        await fetchTransactions();\n      } catch (error) {\n        console.error('Error requesting withdrawal:', error);\n        alert('Échec de la demande de retrait');\n      }\n    };\n\n    // Socket.io event handlers\n    socket.on('walletUpdate', data => {\n      wallet.value = data;\n    });\n    socket.on('positionsUpdate', data => {\n      positions.value = data;\n    });\n    socket.on('transactionsUpdate', data => {\n      transactions.value = data;\n    });\n    onMounted(() => {\n      socket.connect();\n      fetchWallet();\n      fetchPositions();\n      fetchTransactions();\n    });\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n    return {\n      wallet,\n      positions,\n      transactions,\n      depositAmount,\n      withdrawalAmount,\n      requestDeposit,\n      requestWithdrawal,\n      formatPrice\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","axios","socket","API_URL","name","setup","wallet","positions","transactions","depositAmount","withdrawalAmount","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","fetchWallet","response","get","value","data","error","console","fetchPositions","fetchTransactions","requestDeposit","post","type","amount","parseFloat","alert","requestWithdrawal","on","connect","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Wallet.vue"],"sourcesContent":["<template>\n\t<div class=\"container mx-auto px-4 py-8\">\n\t\t<h1 class=\"text-3xl font-bold text-gray-900 mb-8\">Mon Portefeuille</h1>\n\t\t<div v-if=\"wallet\" class=\"bg-white rounded-lg shadow-lg p-6 mb-8\">\n\t\t\t<div class=\"text-2xl font-bold text-gray-900\">\n\t\t\t\tSolde: {{ formatPrice(wallet.balance) }}\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 mb-8\">\n\t\t\t<div class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h3 class=\"text-xl font-semibold text-gray-900 mb-4\">Demande de Dépôt</h3>\n\t\t\t\t<form @submit.prevent=\"requestDeposit\" class=\"space-y-4\">\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<label class=\"block text-sm font-medium text-gray-700\">Montant</label>\n\t\t\t\t\t\t<input \n\t\t\t\t\t\t\ttype=\"number\" \n\t\t\t\t\t\t\tv-model=\"depositAmount\" \n\t\t\t\t\t\t\tplaceholder=\"Montant à déposer\"\n\t\t\t\t\t\t\tmin=\"0\"\n\t\t\t\t\t\t\tstep=\"0.01\"\n\t\t\t\t\t\t\trequired\n\t\t\t\t\t\t\tclass=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t</div>\n\t\t\t\t\t<button type=\"submit\" class=\"w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition-colors\">\n\t\t\t\t\t\tDemander un Dépôt\n\t\t\t\t\t</button>\n\t\t\t\t</form>\n\t\t\t</div>\n\n\t\t\t<div class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h3 class=\"text-xl font-semibold text-gray-900 mb-4\">Demande de Retrait</h3>\n\t\t\t\t<form @submit.prevent=\"requestWithdrawal\" class=\"space-y-4\">\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<label class=\"block text-sm font-medium text-gray-700\">Montant</label>\n\t\t\t\t\t\t<input \n\t\t\t\t\t\t\ttype=\"number\" \n\t\t\t\t\t\t\tv-model=\"withdrawalAmount\" \n\t\t\t\t\t\t\tplaceholder=\"Montant à retirer\"\n\t\t\t\t\t\t\tmin=\"0\"\n\t\t\t\t\t\t\tstep=\"0.01\"\n\t\t\t\t\t\t\trequired\n\t\t\t\t\t\t\tclass=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t</div>\n\t\t\t\t\t<button type=\"submit\" class=\"w-full bg-red-600 text-white py-2 px-4 rounded-md hover:bg-red-700 transition-colors\">\n\t\t\t\t\t\tDemander un Retrait\n\t\t\t\t\t</button>\n\t\t\t\t</form>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n\t\t\t<div v-if=\"positions.length\" class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h2 class=\"text-xl font-semibold text-gray-900 mb-4\">Positions</h2>\n\t\t\t\t<ul class=\"divide-y divide-gray-200\">\n\t\t\t\t\t<li v-for=\"position in positions\" :key=\"position.id\" class=\"py-3\">\n\t\t\t\t\t\t<div class=\"flex justify-between\">\n\t\t\t\t\t\t\t<span class=\"font-medium\">{{ position.asset }}</span>\n\t\t\t\t\t\t\t<span>{{ formatPrice(position.amount) }}</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\n\t\t\t<div v-if=\"transactions.length\" class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h2 class=\"text-xl font-semibold text-gray-900 mb-4\">Transactions Récentes</h2>\n\t\t\t\t<ul class=\"divide-y divide-gray-200\">\n\t\t\t\t\t<li v-for=\"tx in transactions\" :key=\"tx.id\" class=\"py-3\">\n\t\t\t\t\t\t<div class=\"flex justify-between\">\n\t\t\t\t\t\t\t<span class=\"font-medium\">{{ tx.type === 'deposit' ? 'Dépôt' : 'Retrait' }}</span>\n\t\t\t\t\t\t\t<span :class=\"tx.type === 'deposit' ? 'text-green-600' : 'text-red-600'\">\n\t\t\t\t\t\t\t\t{{ formatPrice(tx.amount) }}\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"text-sm text-gray-500\">\n\t\t\t\t\t\t\t{{ new Date(tx.created_at).toLocaleDateString('fr-FR') }}\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted } from 'vue';\nimport axios from 'axios';\nimport { socket } from '@/socket';\n\nconst API_URL = 'http://localhost:3000';\n\nexport default {\n\tname: 'Wallet',\n\tsetup() {\n\t\tconst wallet = ref(null);\n\t\tconst positions = ref([]);\n\t\tconst transactions = ref([]);\n\t\tconst depositAmount = ref('');\n\t\tconst withdrawalAmount = ref('');\n\n\t\tconst formatPrice = (price) => {\n\t\t\tif (typeof price !== 'number') return '$0.00';\n\t\t\treturn new Intl.NumberFormat('fr-FR', {\n\t\t\t\tstyle: 'currency',\n\t\t\t\tcurrency: 'USD',\n\t\t\t\tminimumFractionDigits: 2,\n\t\t\t\tmaximumFractionDigits: 2\n\t\t\t}).format(price);\n\t\t};\n\n\t\tconst fetchWallet = async () => {\n\t\t\ttry {\n\t\t\t\tconst response = await axios.get(`${API_URL}/api/wallet`);\n\t\t\t\twallet.value = response.data;\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error fetching wallet:', error);\n\t\t\t}\n\t\t};\n\n\t\tconst fetchPositions = async () => {\n\t\t\ttry {\n\t\t\t\tconst response = await axios.get(`${API_URL}/api/wallet/positions`);\n\t\t\t\tpositions.value = response.data;\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error fetching positions:', error);\n\t\t\t}\n\t\t};\n\n\t\tconst fetchTransactions = async () => {\n\t\t\ttry {\n\t\t\t\tconst response = await axios.get(`${API_URL}/api/wallet/transactions`);\n\t\t\t\ttransactions.value = response.data;\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error fetching transactions:', error);\n\t\t\t}\n\t\t};\n\n\t\tconst requestDeposit = async () => {\n\t\t\ttry {\n\t\t\t\tawait axios.post(`${API_URL}/api/wallet/request`, {\n\t\t\t\t\ttype: 'deposit',\n\t\t\t\t\tamount: parseFloat(depositAmount.value)\n\t\t\t\t});\n\t\t\t\talert('Demande de dépôt envoyée pour approbation');\n\t\t\t\tdepositAmount.value = '';\n\t\t\t\tawait fetchWallet();\n\t\t\t\tawait fetchTransactions();\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error requesting deposit:', error);\n\t\t\t\talert('Échec de la demande de dépôt');\n\t\t\t}\n\t\t};\n\n\t\tconst requestWithdrawal = async () => {\n\t\t\ttry {\n\t\t\t\tawait axios.post(`${API_URL}/api/wallet/request`, {\n\t\t\t\t\ttype: 'withdrawal',\n\t\t\t\t\tamount: parseFloat(withdrawalAmount.value)\n\t\t\t\t});\n\t\t\t\talert('Demande de retrait envoyée pour approbation');\n\t\t\t\twithdrawalAmount.value = '';\n\t\t\t\tawait fetchWallet();\n\t\t\t\tawait fetchTransactions();\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error requesting withdrawal:', error);\n\t\t\t\talert('Échec de la demande de retrait');\n\t\t\t}\n\t\t};\n\n\t\t// Socket.io event handlers\n\t\tsocket.on('walletUpdate', (data) => {\n\t\t\twallet.value = data;\n\t\t});\n\n\t\tsocket.on('positionsUpdate', (data) => {\n\t\t\tpositions.value = data;\n\t\t});\n\n\t\tsocket.on('transactionsUpdate', (data) => {\n\t\t\ttransactions.value = data;\n\t\t});\n\n\t\tonMounted(() => {\n\t\t\tsocket.connect();\n\t\t\tfetchWallet();\n\t\t\tfetchPositions();\n\t\t\tfetchTransactions();\n\t\t});\n\n\t\tonUnmounted(() => {\n\t\t\tsocket.disconnect();\n\t\t});\n\n\t\treturn {\n\t\t\twallet,\n\t\t\tpositions,\n\t\t\ttransactions,\n\t\t\tdepositAmount,\n\t\t\twithdrawalAmount,\n\t\t\trequestDeposit,\n\t\t\trequestWithdrawal,\n\t\t\tformatPrice\n\t\t};\n\t}\n};\n</script>\n\n<style scoped>\n.wallet {\n\tpadding: 20px;\n}\n\n.wallet-info {\n\tmargin: 20px 0;\n\tpadding: 15px;\n\tborder: 1px solid #ddd;\n\tborder-radius: 4px;\n}\n\n.transaction-forms {\n\tdisplay: flex;\n\tgap: 20px;\n\tmargin: 20px 0;\n}\n\n.deposit-form, .withdrawal-form {\n\tflex: 1;\n\tpadding: 15px;\n\tborder: 1px solid #ddd;\n\tborder-radius: 4px;\n}\n\nform {\n\tdisplay: flex;\n\tflex-direction: column;\n\tgap: 10px;\n}\n\ninput {\n\tpadding: 8px;\n\tborder: 1px solid #ddd;\n\tborder-radius: 4px;\n}\n\nbutton {\n\tpadding: 8px;\n\tbackground-color: #4CAF50;\n\tcolor: white;\n\tborder: none;\n\tborder-radius: 4px;\n\tcursor: pointer;\n}\n\nbutton:hover {\n\tbackground-color: #45a049;\n}\n\n.positions, .transactions {\n\tmargin-top: 20px;\n}\n\nul {\n\tlist-style: none;\n\tpadding: 0;\n}\n\nli {\n\tpadding: 10px;\n\tborder-bottom: 1px solid #eee;\n}\n\nli:last-child {\n\tborder-bottom: none;\n}\n</style>"],"mappings":"AAuFA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AACjD,OAAOC,KAAI,MAAO,OAAO;AACzB,SAASC,MAAK,QAAS,UAAU;AAEjC,MAAMC,OAAM,GAAI,uBAAuB;