{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted, watch } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nimport AdminHeader from '@/components/AdminHeader.vue';\nexport default {\n  name: 'UserTransactionsSummary',\n  components: {\n    AdminHeader\n  },\n  setup() {\n    const userSummaries = ref([]);\n    const filters = ref({\n      dateMax: new Date().toISOString().slice(0, 16)\n    });\n    const formatPrice = price => {\n      if (!price) return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const fetchUserSummaries = () => {\n      console.log('Demande des données de transactions...');\n      socket.emit('getUserTransactionsSummary');\n    };\n\n    // Initialiser la connexion socket\n    if (!socket.connected) {\n      socket.connect();\n    }\n\n    // Écouter les événements socket\n    socket.on('userTransactionsSummary', data => {\n      console.log('Données reçues:', data);\n      userSummaries.value = data.map(summary => ({\n        username: summary.username,\n        totalBuy: parseFloat(summary.totalBuy) || 0,\n        totalSell: parseFloat(summary.totalSell) || 0,\n        portfolioValue: parseFloat(summary.portfolioValue) || 0\n      }));\n    });\n\n    // Initialiser au montage du composant\n    onMounted(() => {\n      console.log('Composant monté, récupération des données...');\n      fetchUserSummaries();\n    });\n\n    // Nettoyer à la destruction du composant\n    onUnmounted(() => {\n      socket.off('userTransactionsSummary');\n      socket.disconnect();\n    });\n    return {\n      userSummaries,\n      filters,\n      formatPrice,\n      fetchUserSummaries\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","watch","useStore","useRouter","socket","AdminHeader","name","components","setup","userSummaries","filters","dateMax","Date","toISOString","slice","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","fetchUserSummaries","console","log","emit","connected","connect","on","data","value","map","summary","username","totalBuy","parseFloat","totalSell","portfolioValue","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\UserTransactionsSummary.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-gray-50\">\n    <AdminHeader />\n    \n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n      <h1 class=\"text-3xl font-extrabold text-gray-900 mb-8\">Récapitulatif des Transactions par Utilisateur</h1>\n\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-200 hover:shadow-md\">\n        <!-- Filtres -->\n        <div class=\"p-6 border-b border-gray-100 bg-white\">\n          <div class=\"grid grid-cols-1 gap-6\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-2\">Date et heure max</label>\n              <input\n                type=\"datetime-local\"\n                v-model=\"filters.dateMax\"\n                class=\"w-full rounded-lg border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors duration-200\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Tableau récapitulatif -->\n        <div class=\"overflow-x-auto\">\n          <table class=\"min-w-full divide-y divide-gray-200\">\n            <thead>\n              <tr class=\"bg-gray-50\">\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Utilisateur</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Total Achat</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Total Vente</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Valeur portefeuille</th>\n              </tr>\n            </thead>\n            <tbody class=\"bg-white divide-y divide-gray-100\">\n              <tr v-for=\"summary in userSummaries\" \n                  :key=\"summary.username\" \n                  class=\"hover:bg-gray-50 transition-colors duration-150\">\n                <td class=\"px-6 py-4 whitespace-nowrap\">\n                  <div class=\"flex items-center\">\n                    <div class=\"h-8 w-8 rounded-full bg-indigo-100 flex items-center justify-center\">\n                      <span class=\"text-sm font-medium text-indigo-700\">\n                        {{ summary.username[0]?.toUpperCase() }}\n                      </span>\n                    </div>\n                    <span class=\"ml-3 text-sm text-gray-900\">{{ summary.username }}</span>\n                  </div>\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\n                  {{ formatPrice(summary.totalBuy) }}\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\n                  {{ formatPrice(summary.totalSell) }}\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900\">\n                  {{ formatPrice(summary.portfolioValue) }}\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed, onMounted, onUnmounted, watch } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\nimport { socket } from '@/socket'\nimport AdminHeader from '@/components/AdminHeader.vue'\n\nexport default {\n  name: 'UserTransactionsSummary',\n  components: {\n    AdminHeader\n  },\n  \n  setup() {\n    const userSummaries = ref([])\n    const filters = ref({\n      dateMax: new Date().toISOString().slice(0, 16)\n    })\n\n    const formatPrice = (price) => {\n      if (!price) return '$0.00'\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price)\n    }\n\n    const fetchUserSummaries = () => {\n      console.log('Demande des données de transactions...')\n      socket.emit('getUserTransactionsSummary')\n    }\n\n    // Initialiser la connexion socket\n    if (!socket.connected) {\n      socket.connect()\n    }\n\n    // Écouter les événements socket\n    socket.on('userTransactionsSummary', (data) => {\n      console.log('Données reçues:', data)\n      userSummaries.value = data.map(summary => ({\n        username: summary.username,\n        totalBuy: parseFloat(summary.totalBuy) || 0,\n        totalSell: parseFloat(summary.totalSell) || 0,\n        portfolioValue: parseFloat(summary.portfolioValue) || 0\n      }))\n    })\n\n    // Initialiser au montage du composant\n    onMounted(() => {\n      console.log('Composant monté, récupération des données...')\n      fetchUserSummaries()\n    })\n\n    // Nettoyer à la destruction du composant\n    onUnmounted(() => {\n      socket.off('userTransactionsSummary')\n      socket.disconnect()\n    })\n\n    return {\n      userSummaries,\n      filters,\n      formatPrice,\n      fetchUserSummaries\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: #f1f1f1;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #ddd;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #cdcdcd;\n}\n</style> "],"mappings":"AAkEA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAW,EAAEC,KAAI,QAAS,KAAI;AACjE,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,MAAK,QAAS,UAAS;AAChC,OAAOC,WAAU,MAAO,8BAA6B;AAErD,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVF;EACF,CAAC;EAEDG,KAAKA,CAAA,EAAG;IACN,MAAMC,aAAY,GAAIZ,GAAG,CAAC,EAAE;IAC5B,MAAMa,OAAM,GAAIb,GAAG,CAAC;MAClBc,OAAO,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAE,EAAE;IAC/C,CAAC;IAED,MAAMC,WAAU,GAAKC,KAAK,IAAK;MAC7B,IAAI,CAACA,KAAK,EAAE,OAAO,OAAM;MACzB,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE,KAAK;QACfC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACP,KAAK;IACjB;IAEA,MAAMQ,kBAAiB,GAAIA,CAAA,KAAM;MAC/BC,OAAO,CAACC,GAAG,CAAC,wCAAwC;MACpDtB,MAAM,CAACuB,IAAI,CAAC,4BAA4B;IAC1C;;IAEA;IACA,IAAI,CAACvB,MAAM,CAACwB,SAAS,EAAE;MACrBxB,MAAM,CAACyB,OAAO,CAAC;IACjB;;IAEA;IACAzB,MAAM,CAAC0B,EAAE,CAAC,yBAAyB,EAAGC,IAAI,IAAK;MAC7CN,OAAO,CAACC,GAAG,CAAC,iBAAiB,EAAEK,IAAI;MACnCtB,aAAa,CAACuB,KAAI,GAAID,IAAI,CAACE,GAAG,CAACC,OAAM,KAAM;QACzCC,QAAQ,EAAED,OAAO,CAACC,QAAQ;QAC1BC,QAAQ,EAAEC,UAAU,CAACH,OAAO,CAACE,QAAQ,KAAK,CAAC;QAC3CE,SAAS,EAAED,UAAU,CAACH,OAAO,CAACI,SAAS,KAAK,CAAC;QAC7CC,cAAc,EAAEF,UAAU,CAACH,OAAO,CAACK,cAAc,KAAK;MACxD,CAAC,CAAC;IACJ,CAAC;;IAED;IACAxC,SAAS,CAAC,MAAM;MACd0B,OAAO,CAACC,GAAG,CAAC,8CAA8C;MAC1DF,kBAAkB,CAAC;IACrB,CAAC;;IAED;IACAxB,WAAW,CAAC,MAAM;MAChBI,MAAM,CAACoC,GAAG,CAAC,yBAAyB;MACpCpC,MAAM,CAACqC,UAAU,CAAC;IACpB,CAAC;IAED,OAAO;MACLhC,aAAa;MACbC,OAAO;MACPK,WAAW;MACXS;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}