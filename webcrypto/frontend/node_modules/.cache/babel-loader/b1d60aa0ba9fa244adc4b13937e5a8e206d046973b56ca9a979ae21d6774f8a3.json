{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Account',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const error = ref('');\n    const form = ref({\n      username: '',\n      firstName: '',\n      lastName: '',\n      birthDate: '',\n      email: ''\n    });\n    const initForm = () => {\n      const user = store.getters['auth/user'];\n      if (user) {\n        form.value = {\n          username: user.username || '',\n          firstName: user.firstName || '',\n          lastName: user.lastName || '',\n          birthDate: user.birthDate || '',\n          email: user.email || ''\n        };\n      }\n    };\n    const resetForm = () => {\n      initForm();\n      error.value = '';\n    };\n    const handleSubmit = async () => {\n      try {\n        loading.value = true;\n        error.value = '';\n        await store.dispatch('auth/updateProfile', {\n          username: form.value.username,\n          firstName: form.value.firstName,\n          lastName: form.value.lastName,\n          birthDate: form.value.birthDate\n        });\n\n        // Afficher un message de succès\n        alert('Profil mis à jour avec succès');\n      } catch (err) {\n        error.value = err.message || 'Une erreur est survenue lors de la mise à jour du profil';\n      } finally {\n        loading.value = false;\n      }\n    };\n    onMounted(() => {\n      initForm();\n    });\n    return {\n      form,\n      loading,\n      error,\n      handleSubmit,\n      resetForm\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","useStore","useRouter","name","setup","store","router","loading","error","form","username","firstName","lastName","birthDate","email","initForm","user","getters","value","resetForm","handleSubmit","dispatch","alert","err","message"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Account.vue"],"sourcesContent":["<template>\r\n  <div class=\"min-h-screen bg-gray-50 py-12\">\r\n    <div class=\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\">\r\n      <div class=\"bg-white rounded-lg shadow-sm overflow-hidden\">\r\n        <!-- En-tête -->\r\n        <div class=\"px-6 py-4 border-b border-gray-200\">\r\n          <h2 class=\"text-xl font-semibold text-gray-900\">Gérer mon compte</h2>\r\n          <p class=\"mt-1 text-sm text-gray-500\">Modifiez vos informations personnelles</p>\r\n        </div>\r\n\r\n        <!-- Formulaire -->\r\n        <form @submit.prevent=\"handleSubmit\" class=\"p-6 space-y-6\">\r\n          <!-- Nom d'utilisateur -->\r\n          <div>\r\n            <label for=\"username\" class=\"block text-sm font-medium text-gray-700\">\r\n              Nom d'utilisateur\r\n            </label>\r\n            <input\r\n              id=\"username\"\r\n              v-model=\"form.username\"\r\n              type=\"text\"\r\n              required\r\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\r\n            />\r\n          </div>\r\n\r\n          <!-- Prénom -->\r\n          <div>\r\n            <label for=\"firstName\" class=\"block text-sm font-medium text-gray-700\">\r\n              Prénom\r\n            </label>\r\n            <input\r\n              id=\"firstName\"\r\n              v-model=\"form.firstName\"\r\n              type=\"text\"\r\n              required\r\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\r\n            />\r\n          </div>\r\n\r\n          <!-- Nom -->\r\n          <div>\r\n            <label for=\"lastName\" class=\"block text-sm font-medium text-gray-700\">\r\n              Nom\r\n            </label>\r\n            <input\r\n              id=\"lastName\"\r\n              v-model=\"form.lastName\"\r\n              type=\"text\"\r\n              required\r\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\r\n            />\r\n          </div>\r\n\r\n          <!-- Date de naissance -->\r\n          <div>\r\n            <label for=\"birthDate\" class=\"block text-sm font-medium text-gray-700\">\r\n              Date de naissance\r\n            </label>\r\n            <input\r\n              id=\"birthDate\"\r\n              v-model=\"form.birthDate\"\r\n              type=\"date\"\r\n              required\r\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\r\n            />\r\n          </div>\r\n\r\n          <!-- Email (désactivé) -->\r\n          <div>\r\n            <label for=\"email\" class=\"block text-sm font-medium text-gray-700\">\r\n              Email\r\n            </label>\r\n            <input\r\n              id=\"email\"\r\n              v-model=\"form.email\"\r\n              type=\"email\"\r\n              disabled\r\n              class=\"mt-1 block w-full rounded-md border-gray-300 bg-gray-50 text-gray-500 shadow-sm sm:text-sm cursor-not-allowed\"\r\n            />\r\n            <p class=\"mt-1 text-xs text-gray-500\">L'email ne peut pas être modifié</p>\r\n          </div>\r\n\r\n          <!-- Message d'erreur -->\r\n          <div v-if=\"error\" class=\"rounded-md bg-red-50 p-4\">\r\n            <div class=\"flex\">\r\n              <div class=\"ml-3\">\r\n                <h3 class=\"text-sm font-medium text-red-800\">\r\n                  Erreur lors de la mise à jour\r\n                </h3>\r\n                <div class=\"mt-2 text-sm text-red-700\">\r\n                  <p>{{ error }}</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Boutons -->\r\n          <div class=\"flex justify-end space-x-3\">\r\n            <button\r\n              type=\"button\"\r\n              @click=\"resetForm\"\r\n              class=\"px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\r\n            >\r\n              Annuler\r\n            </button>\r\n            <button\r\n              type=\"submit\"\r\n              :disabled=\"loading\"\r\n              class=\"px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50\"\r\n            >\r\n              {{ loading ? 'Enregistrement...' : 'Enregistrer' }}\r\n            </button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { useRouter } from 'vue-router'\r\n\r\nexport default {\r\n  name: 'Account',\r\n  \r\n  setup() {\r\n    const store = useStore()\r\n    const router = useRouter()\r\n    const loading = ref(false)\r\n    const error = ref('')\r\n    \r\n    const form = ref({\r\n      username: '',\r\n      firstName: '',\r\n      lastName: '',\r\n      birthDate: '',\r\n      email: ''\r\n    })\r\n\r\n    const initForm = () => {\r\n      const user = store.getters['auth/user']\r\n      if (user) {\r\n        form.value = {\r\n          username: user.username || '',\r\n          firstName: user.firstName || '',\r\n          lastName: user.lastName || '',\r\n          birthDate: user.birthDate || '',\r\n          email: user.email || ''\r\n        }\r\n      }\r\n    }\r\n\r\n    const resetForm = () => {\r\n      initForm()\r\n      error.value = ''\r\n    }\r\n\r\n    const handleSubmit = async () => {\r\n      try {\r\n        loading.value = true\r\n        error.value = ''\r\n\r\n        await store.dispatch('auth/updateProfile', {\r\n          username: form.value.username,\r\n          firstName: form.value.firstName,\r\n          lastName: form.value.lastName,\r\n          birthDate: form.value.birthDate\r\n        })\r\n\r\n        // Afficher un message de succès\r\n        alert('Profil mis à jour avec succès')\r\n      } catch (err) {\r\n        error.value = err.message || 'Une erreur est survenue lors de la mise à jour du profil'\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    onMounted(() => {\r\n      initForm()\r\n    })\r\n\r\n    return {\r\n      form,\r\n      loading,\r\n      error,\r\n      handleSubmit,\r\n      resetForm\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\ninput[type=\"date\"]::-webkit-calendar-picker-indicator {\r\n  cursor: pointer;\r\n  border-radius: 4px;\r\n  margin-right: 2px;\r\n  opacity: 0.6;\r\n  filter: invert(0.8);\r\n}\r\n\r\ninput[type=\"date\"]::-webkit-calendar-picker-indicator:hover {\r\n  opacity: 1\r\n}\r\n</style> "],"mappings":"AAyHA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAI;AACnC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,SAAS;EAEfC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,OAAM,GAAIR,GAAG,CAAC,KAAK;IACzB,MAAMS,KAAI,GAAIT,GAAG,CAAC,EAAE;IAEpB,MAAMU,IAAG,GAAIV,GAAG,CAAC;MACfW,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,EAAE;MACbC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,EAAE;MACbC,KAAK,EAAE;IACT,CAAC;IAED,MAAMC,QAAO,GAAIA,CAAA,KAAM;MACrB,MAAMC,IAAG,GAAIX,KAAK,CAACY,OAAO,CAAC,WAAW;MACtC,IAAID,IAAI,EAAE;QACRP,IAAI,CAACS,KAAI,GAAI;UACXR,QAAQ,EAAEM,IAAI,CAACN,QAAO,IAAK,EAAE;UAC7BC,SAAS,EAAEK,IAAI,CAACL,SAAQ,IAAK,EAAE;UAC/BC,QAAQ,EAAEI,IAAI,CAACJ,QAAO,IAAK,EAAE;UAC7BC,SAAS,EAAEG,IAAI,CAACH,SAAQ,IAAK,EAAE;UAC/BC,KAAK,EAAEE,IAAI,CAACF,KAAI,IAAK;QACvB;MACF;IACF;IAEA,MAAMK,SAAQ,GAAIA,CAAA,KAAM;MACtBJ,QAAQ,CAAC;MACTP,KAAK,CAACU,KAAI,GAAI,EAAC;IACjB;IAEA,MAAME,