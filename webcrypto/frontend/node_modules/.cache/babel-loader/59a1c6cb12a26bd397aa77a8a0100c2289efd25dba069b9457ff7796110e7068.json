{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport { socket } from '@/socket';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport api from '@/api';\nexport default {\n  name: 'Wallet',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const wallet = ref(null);\n    const positions = ref([]);\n    const transactions = ref([]);\n    const depositAmount = ref('');\n    const withdrawalAmount = ref('');\n    const fetchWallet = async () => {\n      try {\n        const response = await api.get('/wallet');\n        wallet.value = response.data;\n      } catch (error) {\n        console.error('Error fetching wallet:', error);\n      }\n    };\n    const fetchPositions = async () => {\n      try {\n        const response = await api.get('/wallet/positions');\n        positions.value = response.data;\n      } catch (error) {\n        console.error('Error fetching positions:', error);\n      }\n    };\n    const fetchTransactions = async () => {\n      try {\n        const response = await api.get('/wallet/transactions');\n        transactions.value = response.data;\n      } catch (error) {\n        console.error('Error fetching transactions:', error);\n      }\n    };\n    const requestDeposit = async () => {\n      try {\n        await api.post('/wallet/deposit-request', {\n          amount: parseFloat(depositAmount.value)\n        });\n        alert('Deposit request sent to admin for approval');\n        depositAmount.value = '';\n        await fetchWallet();\n        await fetchTransactions();\n      } catch (error) {\n        console.error('Error requesting deposit:', error);\n        alert('Failed to send deposit request');\n      }\n    };\n    const requestWithdrawal = async () => {\n      try {\n        await api.post('/wallet/withdrawal-request', {\n          amount: parseFloat(withdrawalAmount.value)\n        });\n        alert('Withdrawal request sent to admin for approval');\n        withdrawalAmount.value = '';\n        await fetchWallet();\n        await fetchTransactions();\n      } catch (error) {\n        console.error('Error requesting withdrawal:', error);\n        alert('Failed to send withdrawal request');\n      }\n    };\n\n    // Socket event handlers\n    socket.on('connect', () => {\n      console.log('Socket connected, fetching data...');\n      fetchWallet();\n      fetchPositions();\n      fetchTransactions();\n    });\n    socket.on('connect_error', error => {\n      console.error('Socket connection error:', error);\n      if (error.message === 'Authentication error') {\n        router.push('/login');\n      }\n    });\n\n    // Socket data update handlers\n    socket.on('walletUpdate', data => {\n      wallet.value = data;\n    });\n    socket.on('positionsUpdate', data => {\n      positions.value = data;\n    });\n    socket.on('transactionsUpdate', data => {\n      transactions.value = data;\n    });\n    onMounted(() => {\n      socket.connect();\n      fetchWallet();\n      fetchPositions();\n      fetchTransactions();\n    });\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n    return {\n      wallet,\n      positions,\n      transactions,\n      depositAmount,\n      withdrawalAmount,\n      requestDeposit,\n      requestWithdrawal\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","socket","useStore","useRouter","api","name","setup","store","router","wallet","positions","transactions","depositAmount","withdrawalAmount","fetchWallet","response","get","value","data","error","console","fetchPositions","fetchTransactions","requestDeposit","post","amount","parseFloat","alert","requestWithdrawal","on","log","message","push","connect","disconnect"],"sources":["d:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Wallet.vue"],"sourcesContent":["<template>\r\n\t<div class=\"wallet\">\r\n\t\t<h1>Wallet</h1>\r\n\t\t<div v-if=\"wallet\" class=\"wallet-info\">\r\n\t\t\t<div class=\"balance\">\r\n\t\t\t\tBalance: {{ wallet.balance }}\r\n\t\t\t</div>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"transaction-forms\">\r\n\t\t\t<div class=\"deposit-form\">\r\n\t\t\t\t<h3>Request Deposit</h3>\r\n\t\t\t\t<form @submit.prevent=\"requestDeposit\">\r\n\t\t\t\t\t<input \r\n\t\t\t\t\t\ttype=\"number\" \r\n\t\t\t\t\t\tv-model=\"depositAmount\" \r\n\t\t\t\t\t\tplaceholder=\"Amount to deposit\"\r\n\t\t\t\t\t\tmin=\"0\"\r\n\t\t\t\t\t\tstep=\"0.01\"\r\n\t\t\t\t\t\trequired\r\n\t\t\t\t\t/>\r\n\t\t\t\t\t<button type=\"submit\">Request Deposit</button>\r\n\t\t\t\t</form>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"withdrawal-form\">\r\n\t\t\t\t<h3>Request Withdrawal</h3>\r\n\t\t\t\t<form @submit.prevent=\"requestWithdrawal\">\r\n\t\t\t\t\t<input \r\n\t\t\t\t\t\ttype=\"number\" \r\n\t\t\t\t\t\tv-model=\"withdrawalAmount\" \r\n\t\t\t\t\t\tplaceholder=\"Amount to withdraw\"\r\n\t\t\t\t\t\tmin=\"0\"\r\n\t\t\t\t\t\tstep=\"0.01\"\r\n\t\t\t\t\t\trequired\r\n\t\t\t\t\t/>\r\n\t\t\t\t\t<button type=\"submit\">Request Withdrawal</button>\r\n\t\t\t\t</form>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\r\n\t\t<div v-if=\"positions.length\" class=\"positions\">\r\n\t\t\t<h2>Positions</h2>\r\n\t\t\t<ul>\r\n\t\t\t\t<li v-for=\"position in positions\" :key=\"position.id\">\r\n\t\t\t\t\t{{ position.asset }}: {{ position.amount }}\r\n\t\t\t\t</li>\r\n\t\t\t</ul>\r\n\t\t</div>\r\n\t\t<div v-if=\"transactions.length\" class=\"transactions\">\r\n\t\t\t<h2>Recent Transactions</h2>\r\n\t\t\t<ul>\r\n\t\t\t\t<li v-for=\"tx in transactions\" :key=\"tx.id\">\r\n\t\t\t\t\t{{ tx.type }}: {{ tx.amount }}\r\n\t\t\t\t</li>\r\n\t\t\t</ul>\r\n\t\t</div>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted } from 'vue';\r\nimport { socket } from '@/socket';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport api from '@/api';\r\n\r\nexport default {\r\n\tname: 'Wallet',\r\n\tsetup() {\r\n\t\tconst store = useStore();\r\n\t\tconst router = useRouter();\r\n\t\tconst wallet = ref(null);\r\n\t\tconst positions = ref([]);\r\n\t\tconst transactions = ref([]);\r\n\t\tconst depositAmount = ref('');\r\n\t\tconst withdrawalAmount = ref('');\r\n\r\n\t\tconst fetchWallet = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tconst response = await api.get('/wallet');\r\n\t\t\t\twallet.value = response.data;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error fetching wallet:', error);\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst fetchPositions = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tconst response = await api.get('/wallet/positions');\r\n\t\t\t\tpositions.value = response.data;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error fetching positions:', error);\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst fetchTransactions = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tconst response = await api.get('/wallet/transactions');\r\n\t\t\t\ttransactions.value = response.data;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error fetching transactions:', error);\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst requestDeposit = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tawait api.post('/wallet/deposit-request', {\r\n\t\t\t\t\tamount: parseFloat(depositAmount.value)\r\n\t\t\t\t});\r\n\t\t\t\talert('Deposit request sent to admin for approval');\r\n\t\t\t\tdepositAmount.value = '';\r\n\t\t\t\tawait fetchWallet();\r\n\t\t\t\tawait fetchTransactions();\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error requesting deposit:', error);\r\n\t\t\t\talert('Failed to send deposit request');\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst requestWithdrawal = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tawait api.post('/wallet/withdrawal-request', {\r\n\t\t\t\t\tamount: parseFloat(withdrawalAmount.value)\r\n\t\t\t\t});\r\n\t\t\t\talert('Withdrawal request sent to admin for approval');\r\n\t\t\t\twithdrawalAmount.value = '';\r\n\t\t\t\tawait fetchWallet();\r\n\t\t\t\tawait fetchTransactions();\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error requesting withdrawal:', error);\r\n\t\t\t\talert('Failed to send withdrawal request');\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\t// Socket event handlers\r\n\t\tsocket.on('connect', () => {\r\n\t\t\tconsole.log('Socket connected, fetching data...');\r\n\t\t\tfetchWallet();\r\n\t\t\tfetchPositions();\r\n\t\t\tfetchTransactions();\r\n\t\t});\r\n\r\n\t\tsocket.on('connect_error', (error) => {\r\n\t\t\tconsole.error('Socket connection error:', error);\r\n\t\t\tif (error.message === 'Authentication error') {\r\n\t\t\t\trouter.push('/login');\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\t// Socket data update handlers\r\n\t\tsocket.on('walletUpdate', (data) => {\r\n\t\t\twallet.value = data;\r\n\t\t});\r\n\r\n\t\tsocket.on('positionsUpdate', (data) => {\r\n\t\t\tpositions.value = data;\r\n\t\t});\r\n\r\n\t\tsocket.on('transactionsUpdate', (data) => {\r\n\t\t\ttransactions.value = data;\r\n\t\t});\r\n\r\n\t\tonMounted(() => {\r\n\t\t\tsocket.connect();\r\n\t\t\tfetchWallet();\r\n\t\t\tfetchPositions();\r\n\t\t\tfetchTransactions();\r\n\t\t});\r\n\r\n\t\tonUnmounted(() => {\r\n\t\t\tsocket.disconnect();\r\n\t\t});\r\n\r\n\t\treturn {\r\n\t\t\twallet,\r\n\t\t\tpositions,\r\n\t\t\ttransactions,\r\n\t\t\tdepositAmount,\r\n\t\t\twithdrawalAmount,\r\n\t\t\trequestDeposit,\r\n\t\t\trequestWithdrawal\r\n\t\t};\r\n\t}\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.wallet {\r\n\tpadding: 20px;\r\n}\r\n\r\n.wallet-info {\r\n\tmargin: 20px 0;\r\n\tpadding: 15px;\r\n\tborder: 1px solid #ddd;\r\n\tborder-radius: 4px;\r\n}\r\n\r\n.transaction-forms {\r\n\tdisplay: flex;\r\n\tgap: 20px;\r\n\tmargin: 20px 0;\r\n}\r\n\r\n.deposit-form, .withdrawal-form {\r\n\tflex: 1;\r\n\tpadding: 15px;\r\n\tborder: 1px solid #ddd;\r\n\tborder-radius: 4px;\r\n}\r\n\r\nform {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\tgap: 10px;\r\n}\r\n\r\ninput {\r\n\tpadding: 8px;\r\n\tborder: 1px solid #ddd;\r\n\tborder-radius: 4px;\r\n}\r\n\r\nbutton {\r\n\tpadding: 8px;\r\n\tbackground-color: #4CAF50;\r\n\tcolor: white;\r\n\tborder: none;\r\n\tborder-radius: 4px;\r\n\tcursor: pointer;\r\n}\r\n\r\nbutton:hover {\r\n\tbackground-color: #45a049;\r\n}\r\n\r\n.positions, .transactions {\r\n\tmargin-top: 20px;\r\n}\r\n\r\nul {\r\n\tlist-style: none;\r\n\tpadding: 0;\r\n}\r\n\r\nli {\r\n\tpadding: 10px;\r\n\tborder-bottom: 1px solid #eee;\r\n}\r\n\r\nli:last-child {\r\n\tborder-bottom: none;\r\n}\r\n</style>"],"mappings":"AA6DA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AACjD,SAASC,MAAK,QAAS,UAAU;AACjC,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,GAAE,MAAO,OAAO;AAEvB,eAAe;EACdC,IAAI,EAAE,QAAQ;EACdC,KAAKA,CAAA,EAAG;IACP,MAAMC,KAAI,GAAIL,QAAQ,CAAC,CAAC;IACxB,MAAMM,MAAK,GAAIL,SAAS,CAAC,CAAC;IAC1B,MAAMM,MAAK,GAAIX,GAAG,CAAC,IAAI,CAAC;IACxB,MAAMY,SAAQ,GAAIZ,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMa,YAAW,GAAIb,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMc,aAAY,GAAId,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAMe,gBAAe,GAAIf,GAAG,CAAC,EAAE,CAAC;IAEhC,MAAMgB,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACH,MAAMC,QAAO,GAAI,MAAMX,GAAG,CAACY,GAAG,CAAC,SAAS,CAAC;QACzCP,MAAM,CAACQ,KAAI,GAAIF,QAAQ,CAACG,IAAI;MAC7B,EAAE,OAAOC,KAAK,EAAE;QACfC,OAAO,CAACD,KAAK,CAAC,wBAAwB,EAAEA,KAAK,CAAC;MAC/C;IACD,CAAC;IAED,MAAME,cAAa,GAAI,MAAAA,CAAA,KAAY;MAClC,IAAI;QACH,MAAMN,QAAO,GAAI,MAAMX,GAAG,CAACY,GAAG,CAAC,mBAAmB,CAAC;QACnDN,SAAS,CAACO,KAAI,GAAIF,QAAQ,CAACG,IAAI;MAChC,EAAE,OAAOC,KAAK,EAAE;QACfC,OAAO,CAACD,KAAK,CAAC,2BAA2B,EAAEA,KAAK,CAAC;MAClD;IACD,CAAC;IAED,MAAMG,iBAAgB,GAAI,MAAAA,CAAA,KAAY;MACrC,IAAI;QACH,MAAMP,QAAO,GAAI,MAAMX,GAAG,CAACY,GAAG,CAAC,sBAAsB,CAAC;QACtDL,YAAY,CAACM,KAAI,GAAIF,QAAQ,CAACG,IAAI;MACnC,EAAE,OAAOC,KAAK,EAAE;QACfC,OAAO,CAACD,KAAK,CAAC,8BAA8B,EAAEA,KAAK,CAAC;MACrD;IACD,CAAC;IAED,MAAMI,cAAa,GAAI,MAAAA,CAAA,KAAY;MAClC,IAAI;QACH,MAAMnB,GAAG,CAACoB,IAAI,CAAC,yBAAyB,EAAE;UACzCC,MAAM,EAAEC,UAAU,CAACd,aAAa,CAACK,KAAK;QACvC,CAAC,CAAC;QACFU,KAAK,CAAC,4CAA4C,CAAC;QACnDf,aAAa,CAACK,KAAI,GAAI,EAAE;QACxB,MAAMH,WAAW,CAAC,CAAC;QACnB,MAAMQ,iBAAiB,CAAC,CAAC;MAC1B,EAAE,OAAOH,KAAK,EAAE;QACfC,OAAO,CAACD,KAAK,CAAC,2BAA2B,EAAEA,KAAK,CAAC;QACjDQ,KAAK,CAA