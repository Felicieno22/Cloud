{"ast":null,"code":"import { computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'App',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated']);\n    const currentUser = computed(() => store.getters['auth/user']);\n    const handleLogout = async () => {\n      await store.dispatch('auth/logout');\n      router.push('/login');\n    };\n\n    // Vérifier l'authentification au démarrage\n    store.dispatch('auth/init');\n    return {\n      isAuthenticated,\n      currentUser,\n      handleLogout\n    };\n  }\n};","map":{"version":3,"names":["computed","useStore","useRouter","name","setup","store","router","isAuthenticated","getters","currentUser","handleLogout","dispatch","push"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-gray-100\">\n    <nav class=\"bg-white shadow-lg\">\n      <div class=\"max-w-7xl mx-auto px-4\">\n        <div class=\"flex justify-between h-16\">\n          <div class=\"flex\">\n            <router-link to=\"/\" class=\"flex-shrink-0 flex items-center\">\n              CryptoTrade\n            </router-link>\n          </div>\n          <div class=\"flex items-center\">\n            <template v-if=\"!isAuthenticated\">\n              <router-link to=\"/login\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n                Connexion\n              </router-link>\n              <router-link to=\"/register\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n                Inscription\n              </router-link>\n              <router-link to=\"/admin/login\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n                Admin\n              </router-link>\n            </template>\n            <template v-else>\n              <span class=\"text-gray-700 px-3 py-2 text-sm font-medium\">\n                {{ currentUser ? currentUser.username : '' }}\n              </span>\n              <router-link to=\"/dashboard\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n                Dashboard\n              </router-link>\n              <router-link to=\"/wallet\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n                Portefeuille\n              </router-link>\n              <button @click=\"handleLogout\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n                Déconnexion\n              </button>\n            </template>\n          </div>\n        </div>\n      </div>\n    </nav>\n\n    <main class=\"max-w-7xl mx-auto py-6 sm:px-6 lg:px-8\">\n      <router-view></router-view>\n    </main>\n  </div>\n</template>\n\n<script>\nimport { computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  name: 'App',\n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    \n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated'])\n    const currentUser = computed(() => store.getters['auth/user'])\n    \n    const handleLogout = async () => {\n      await store.dispatch('auth/logout')\n      router.push('/login')\n    }\n\n    // Vérifier l'authentification au démarrage\n    store.dispatch('auth/init')\n\n    return {\n      isAuthenticated,\n      currentUser,\n      handleLogout\n    }\n  }\n}\n</script>\n"],"mappings":"AAgDA,SAASA,QAAO,QAAS,KAAI;AAC7B,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IAEzB,MAAMK,eAAc,GAAIP,QAAQ,CAAC,MAAMK,KAAK,CAACG,OAAO,CAAC,sBAAsB,CAAC;IAC5E,MAAMC,WA