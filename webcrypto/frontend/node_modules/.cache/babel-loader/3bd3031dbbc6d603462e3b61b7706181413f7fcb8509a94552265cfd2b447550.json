{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nimport { LineChart } from 'vue-chartjs';\nexport default {\n  name: 'Dashboard',\n  components: {\n    LineChart\n  },\n  setup() {\n    const router = useRouter();\n    const isConnected = ref(false);\n    const cryptoList = ref([]);\n    const selectedCrypto = ref(null);\n\n    // Connexion socket\n    socket.on('connect', () => {\n      console.log('Connecté au serveur');\n      isConnected.value = true;\n    });\n    socket.on('disconnect', () => {\n      console.log('Déconnecté du serveur');\n      isConnected.value = false;\n    });\n\n    // Mise à jour des prix\n    socket.on('priceUpdate', data => {\n      console.log('Données reçues:', data);\n      cryptoList.value = data;\n    });\n\n    // Formatage des prix\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    // Formatage de la variation de prix\n    const formatPriceChange = change => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    // Classe CSS pour la variation de prix\n    const getPriceChangeClass = symbol => {\n      const crypto = cryptoList.value.find(c => c.symbol === symbol);\n      if (!crypto) return 'text-gray-500';\n      return {\n        'text-green-500': crypto.priceChange > 0,\n        'text-red-500': crypto.priceChange < 0,\n        'text-gray-500': crypto.priceChange === 0\n      };\n    };\n\n    // Sélection d'une crypto\n    const selectCrypto = symbol => {\n      selectedCrypto.value = symbol;\n    };\n\n    // Ajout à la watchlist\n    const addToWatchlist = symbol => {\n      // TODO: Implémenter l'ajout à la watchlist\n      console.log('Ajout à la watchlist:', symbol);\n    };\n    onMounted(() => {\n      socket.connect();\n    });\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n    return {\n      isConnected,\n      cryptoList,\n      selectedCrypto,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      selectCrypto,\n      addToWatchlist\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","useRouter","socket","LineChart","name","components","setup","router","isConnected","cryptoList","selectedCrypto","on","console","log","value","data","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatPriceChange","change","toFixed","getPriceChangeClass","symbol","crypto","find","c","priceChange","selectCrypto","addToWatchlist","connect","disconnect"],"sources":["d:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"mb-8\">\n      <h1 class=\"text-3xl font-bold text-gray-900\">Tableau de bord</h1>\n      <p class=\"text-gray-600\">\n        Cours des cryptomonnaies mis à jour en temps réel\n        <span :class=\"{'text-green-500': isConnected, 'text-red-500': !isConnected}\">\n          ●\n        </span>\n      </p>\n    </div>\n\n    <!-- Grille des cryptomonnaies -->\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n      <div v-for=\"crypto in cryptoList\" :key=\"crypto.symbol\" \n           class=\"bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow duration-200\">\n        <div class=\"flex justify-between items-center\">\n          <div>\n            <h2 class=\"text-xl font-semibold\">{{ crypto.symbol }}</h2>\n            <p class=\"text-gray-600\">{{ crypto.name }}</p>\n          </div>\n          <div class=\"text-right\">\n            <div class=\"text-2xl font-bold\">{{ formatPrice(crypto.price) }}</div>\n            <div :class=\"getPriceChangeClass(crypto.symbol)\" class=\"text-sm\">\n              {{ formatPriceChange(crypto.priceChange) }}%\n            </div>\n          </div>\n        </div>\n        <div class=\"mt-4 flex justify-end space-x-2\">\n          <button @click=\"$router.push(`/crypto/${crypto.symbol}`)\" \n                  class=\"px-4 py-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors\">\n            Voir détails\n          </button>\n          <button @click=\"$router.push(`/trade/${crypto.symbol}`)\"\n                  class=\"px-4 py-2 bg-indigo-600 text-white hover:bg-indigo-700 rounded-lg transition-colors\">\n            Trader\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- Graphique pour la crypto sélectionnée -->\n    <div v-if=\"selectedCrypto\" class=\"mt-8\">\n      <div class=\"bg-white rounded-lg shadow-lg p-6\">\n        <div class=\"flex justify-between items-center mb-4\">\n          <h2 class=\"text-2xl font-bold\">{{ selectedCrypto }}</h2>\n          <div class=\"space-x-2\">\n            <button @click=\"$router.push({ name: 'Trade', params: { crypto: selectedCrypto }})\"\n                    class=\"bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition-colors\">\n              Trader\n            </button>\n            <button @click=\"addToWatchlist(selectedCrypto)\"\n                    class=\"border border-gray-300 px-4 py-2 rounded hover:bg-gray-50 transition-colors\">\n              Suivre\n            </button>\n          </div>\n        </div>\n        <div class=\"h-96\">\n          <!-- TODO: Ajouter le graphique -->\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nimport { LineChart } from 'vue-chartjs';\n\nexport default {\n  name: 'Dashboard',\n  components: { LineChart },\n  \n  setup() {\n    const router = useRouter();\n    const isConnected = ref(false);\n    const cryptoList = ref([]);\n    const selectedCrypto = ref(null);\n    \n    // Connexion socket\n    socket.on('connect', () => {\n      console.log('Connecté au serveur');\n      isConnected.value = true;\n    });\n\n    socket.on('disconnect', () => {\n      console.log('Déconnecté du serveur');\n      isConnected.value = false;\n    });\n\n    // Mise à jour des prix\n    socket.on('priceUpdate', (data) => {\n      console.log('Données reçues:', data);\n      cryptoList.value = data;\n    });\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    // Formatage de la variation de prix\n    const formatPriceChange = (change) => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    // Classe CSS pour la variation de prix\n    const getPriceChangeClass = (symbol) => {\n      const crypto = cryptoList.value.find(c => c.symbol === symbol);\n      if (!crypto) return 'text-gray-500';\n      \n      return {\n        'text-green-500': crypto.priceChange > 0,\n        'text-red-500': crypto.priceChange < 0,\n        'text-gray-500': crypto.priceChange === 0\n      };\n    };\n\n    // Sélection d'une crypto\n    const selectCrypto = (symbol) => {\n      selectedCrypto.value = symbol;\n    };\n\n    // Ajout à la watchlist\n    const addToWatchlist = (symbol) => {\n      // TODO: Implémenter l'ajout à la watchlist\n      console.log('Ajout à la watchlist:', symbol);\n    };\n\n    onMounted(() => {\n      socket.connect();\n    });\n\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n\n    return {\n      isConnected,\n      cryptoList,\n      selectedCrypto,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      selectCrypto,\n      addToWatchlist\n    };\n  }\n};\n</script>\n"],"mappings":"AAkEA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AACjD,SAASC,SAAQ,QAAS,YAAY;AACtC,SAASC,MAAK,QAAS,UAAU;AACjC,SAASC,SAAQ,QAAS,aAAa;AAEvC,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IAAEF;EAAU,CAAC;EAEzBG,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIN,SAAS,CAAC,CAAC;IAC1B,MAAMO,WAAU,GAAIV,GAAG,CAAC,KAAK,CAAC;IAC9B,MAAMW,UAAS,GAAIX,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMY,cAAa,GAAIZ,GAAG,CAAC,IAAI,CAAC;;IAEhC;IACAI,MAAM,CAACS,EAAE,CAAC,SAAS,EAAE,MAAM;MACzBC,OAAO,CAACC,GAAG,CAAC,qBAAqB,CAAC;MAClCL,WAAW,CAACM,KAAI,GAAI,IAAI;IAC1B,CAAC,CAAC;IAEFZ,MAAM,CAACS,EAAE,CAAC,YAAY,EAAE,MAAM;MAC5BC,OAAO,CAACC,GAAG,CAAC,uBAAuB,CAAC;MACpCL,WAAW,CAACM,KAAI,GAAI,KAAK;IAC3B,CAAC,CAAC;;IAEF;IACAZ,MAAM,CAACS,EAAE,CAAC,aAAa,EAAGI,IAAI,IAAK;MACjCH,OAAO,CAACC,GAAG,CAAC,iBAAiB,EAAEE,IAAI,CAAC;MACpCN,UAAU,CAACK,KAAI,GAAIC,IAAI;IACzB,CAAC,CAAC;;IAEF;IACA,MAAMC,WAAU,GAAKC,KAAK,IAAK;MAC7B,IAAI,OAAOA,KAAI,KAAM,QAAQ,EAAE,OAAO,OAAO;MAC7C,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE,KAAK;QACfC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACP,KAAK,CAAC;IAClB,CAAC;;IAED;IACA,MAAMQ,iBAAgB,GAAKC,MAAM,IAAK;MACpC,IAAI,OAAOA,MAAK,KAAM,QAAQ,EAAE,OAAO,MAAM;MAC7C,OAAOA,MAAM,CAACC,OAAO,CAAC,CAAC,CAAC;IAC1B,CAAC;;IAED;IACA,MAAMC,mBAAkB,GAAKC,MAAM,IAAK;MACtC,MAAMC,MAAK,GAAIrB,UAAU,CAACK,KAAK,CAACiB,IAAI,CAACC,CAAA,IAAKA,CAAC,CAACH,MAAK,KAAMA,MAAM,CAAC;MAC9D,IAAI,CAACC,MAAM,EAAE,OAAO,eAAe;MAEnC,OAAO;QACL,gBAAgB,EAAEA,MAAM,CAACG,WAAU,GAAI,CAAC;QACxC,cAAc,EAAEH,MAAM,CAACG,WAAU,GAAI,CAAC;QACtC,eAAe,EAAEH,MAAM,CAACG,WAAU,KAAM;MAC1C,CAAC;IACH,CAAC;;IAED;IACA,MAAMC,YAAW,GAAKL,MAAM,IAAK;MAC/BnB,cAAc,CAACI,KAAI,GAAIe,MAAM;IAC/B,CAAC;;IAED;IACA,MAAMM,cAAa,GAAKN,MAAM,IAAK;MACjC;MACAjB,OAAO,CAACC,GAAG,CAAC,uBAAuB,EAAEgB,MAAM,CAAC;IAC9C,CAAC;IAED9B,SAAS,CAAC,MAAM;MACdG,MAAM,CAACkC,OAAO,CAAC,CAAC;IAClB,CAAC,CAA