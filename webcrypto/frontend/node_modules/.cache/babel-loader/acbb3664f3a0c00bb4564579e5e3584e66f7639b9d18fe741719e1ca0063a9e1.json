{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Register',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const form = ref({\n      nom: '',\n      prenom: '',\n      username: '',\n      email: '',\n      ville: '',\n      date_naissance: '',\n      password: '',\n      photo: null\n    });\n    const verificationCode = ref('');\n    const showPassword = ref(false);\n    const photoInput = ref(null);\n    const photoPreview = ref(null);\n    const handlePhotoChange = async event => {\n      const file = event.target.files[0];\n      if (file) {\n        // Vérifier le type de fichier\n        if (!file.type.startsWith('image/')) {\n          alert('Veuillez sélectionner une image');\n          return;\n        }\n\n        // Vérifier la taille du fichier (max 5MB)\n        if (file.size > 5 * 1024 * 1024) {\n          alert('La taille de l\\'image ne doit pas dépasser 5MB');\n          return;\n        }\n\n        // Créer un aperçu de l'image\n        const reader = new FileReader();\n        reader.onload = e => {\n          photoPreview.value = e.target.result;\n          form.value.photo = e.target.result; // Stocker l'image en base64\n        };\n        reader.readAsDataURL(file);\n      }\n    };\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification']);\n    console.log('État pendingVerification:', pendingVerification.value); // Debug log\n\n    const handleSubmit = async () => {\n      try {\n        loading.value = true;\n        const response = await store.dispatch('auth/register', form.value);\n        // Rediriger vers la page de vérification avec l'email\n        router.push({\n          name: 'verify-email',\n          query: {\n            email: form.value.email\n          }\n        });\n      } catch (error) {\n        alert(error.message || \"Erreur lors de l'inscription\");\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handleVerification = async () => {\n      try {\n        loading.value = true;\n        await store.dispatch('auth/verifyEmail', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        });\n        router.push('/login');\n      } catch (error) {\n        alert(error.message || 'Erreur de vérification');\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      form,\n      loading,\n      verificationCode,\n      pendingVerification,\n      showPassword,\n      photoInput,\n      photoPreview,\n      handleSubmit,\n      handleVerification,\n      handlePhotoChange\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRouter","name","setup","store","router","loading","form","nom","prenom","username","email","ville","date_naissance","password","photo","verificationCode","showPassword","photoInput","photoPreview","handlePhotoChange","event","file","target","files","type","startsWith","alert","size","reader","FileReader","onload","e","value","result","readAsDataURL","pendingVerification","getters","console","log","handleSubmit","response","dispatch","push","query","error","message","handleVerification","code"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Register.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-md w-full space-y-8\">\n      <div>\n        <h2 class=\"mt-6 text-center text-3xl font-extrabold text-gray-900\">\n          {{ pendingVerification ? 'Vérification du compte' : 'Inscription' }}\n        </h2>\n      </div>\n\n      <!-- Formulaire de vérification -->\n      <form v-if=\"pendingVerification\" class=\"mt-8 space-y-6\" @submit.prevent=\"handleVerification\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"verification-code\" class=\"sr-only\">Code de vérification</label>\n            <input\n              id=\"verification-code\"\n              v-model=\"verificationCode\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Entrez le code reçu par email\"\n            />\n          </div>\n        </div>\n\n        <div class=\"text-sm text-center\">\n          <p class=\"text-gray-600\">\n            Un code de vérification a été envoyé à {{ pendingVerification.email }}\n          </p>\n          <p class=\"text-gray-500 mt-2\">\n            {{ pendingVerification.message }}\n          </p>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-indigo-500\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Vérification...' : 'Vérifier le code' }}\n          </button>\n        </div>\n      </form>\n\n      <!-- Formulaire d'inscription -->\n      <form v-else class=\"mt-8 space-y-6\" @submit.prevent=\"handleSubmit\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"nom\" class=\"sr-only\">Nom</label>\n            <input\n              id=\"nom\"\n              v-model=\"form.nom\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Nom\"\n            />\n          </div>\n          <div>\n            <label for=\"prenom\" class=\"sr-only\">Prénom</label>\n            <input\n              id=\"prenom\"\n              v-model=\"form.prenom\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Prénom\"\n            />\n          </div>\n          <div>\n            <label for=\"username\" class=\"sr-only\">Nom d'utilisateur</label>\n            <input\n              id=\"username\"\n              v-model=\"form.username\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Nom d'utilisateur\"\n            />\n          </div>\n          <div>\n            <label for=\"email\" class=\"sr-only\">Email</label>\n            <input\n              id=\"email\"\n              v-model=\"form.email\"\n              type=\"email\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Email\"\n            />\n          </div>\n          <div>\n            <label for=\"ville\" class=\"sr-only\">Ville</label>\n            <input\n              id=\"ville\"\n              v-model=\"form.ville\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Ville\"\n            />\n          </div>\n          <div>\n            <label for=\"date_naissance\" class=\"sr-only\">Date de naissance</label>\n            <input\n              id=\"date_naissance\"\n              v-model=\"form.date_naissance\"\n              type=\"date\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n            />\n          </div>\n          <div>\n            <label for=\"photo\" class=\"sr-only\">Photo de profil</label>\n            <div class=\"relative\">\n              <input\n                id=\"photo\"\n                ref=\"photoInput\"\n                type=\"file\"\n                accept=\"image/*\"\n                @change=\"handlePhotoChange\"\n                class=\"hidden\"\n              />\n              <div class=\"flex items-center space-x-2\">\n                <button\n                  type=\"button\"\n                  @click=\"$refs.photoInput.click()\"\n                  class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n                >\n                  {{ form.photo ? 'Changer la photo' : 'Ajouter une photo de profil' }}\n                </button>\n                <img\n                  v-if=\"photoPreview\"\n                  :src=\"photoPreview\"\n                  class=\"h-10 w-10 rounded-full object-cover\"\n                  alt=\"Photo preview\"\n                />\n              </div>\n            </div>\n          </div>\n          <div>\n            <label for=\"password\" class=\"sr-only\">Mot de passe</label>\n            <div class=\"relative\">\n              <input\n                id=\"password\"\n                v-model=\"form.password\"\n                :type=\"showPassword ? 'text' : 'password'\"\n                required\n                class=\"appearance-none rounded-none relative block w-full px-3 py-2 pr-10 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n                placeholder=\"Mot de passe\"\n              />\n              <div\n                @click=\"showPassword = !showPassword\"\n                class=\"absolute inset-y-0 right-0 flex items-center pr-3 cursor-pointer\"\n              >\n                <svg\n                  v-if=\"showPassword\"\n                  class=\"h-5 w-5 text-gray-400 hover:text-gray-500 transition-colors\"\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 20 20\"\n                  fill=\"currentColor\"\n                  aria-hidden=\"true\"\n                >\n                  <path d=\"M10 12a2 2 0 100-4 2 2 0 000 4z\" />\n                  <path fill-rule=\"evenodd\" d=\"M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z\" clip-rule=\"evenodd\" />\n                </svg>\n                <svg\n                  v-else\n                  class=\"h-5 w-5 text-gray-400 hover:text-gray-500 transition-colors\"\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 20 20\"\n                  fill=\"currentColor\"\n                  aria-hidden=\"true\"\n                >\n                  <path fill-rule=\"evenodd\" d=\"M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z\" clip-rule=\"evenodd\" />\n                  <path d=\"M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.065 7 9.542 7 .847 0 1.669-.105 2.454-.303z\" />\n                </svg>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path d=\"M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6z\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-white\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Inscription...' : \"S'inscrire\" }}\n          </button>\n        </div>\n\n        <div class=\"text-sm text-center\">\n          <router-link to=\"/login\" class=\"font-medium text-indigo-600 hover:text-indigo-500\">\n            Déjà un compte ? Se connecter\n          </router-link>\n        </div>\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  name: 'Register',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const loading = ref(false)\n    const form = ref({\n      nom: '',\n      prenom: '',\n      username: '',\n      email: '',\n      ville: '',\n      date_naissance: '',\n      password: '',\n      photo: null\n    })\n    const verificationCode = ref('')\n    const showPassword = ref(false)\n    const photoInput = ref(null)\n    const photoPreview = ref(null)\n\n    const handlePhotoChange = async (event) => {\n      const file = event.target.files[0]\n      if (file) {\n        // Vérifier le type de fichier\n        if (!file.type.startsWith('image/')) {\n          alert('Veuillez sélectionner une image')\n          return\n        }\n        \n        // Vérifier la taille du fichier (max 5MB)\n        if (file.size > 5 * 1024 * 1024) {\n          alert('La taille de l\\'image ne doit pas dépasser 5MB')\n          return\n        }\n\n        // Créer un aperçu de l'image\n        const reader = new FileReader()\n        reader.onload = (e) => {\n          photoPreview.value = e.target.result\n          form.value.photo = e.target.result // Stocker l'image en base64\n        }\n        reader.readAsDataURL(file)\n      }\n    }\n\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification'])\n    console.log('État pendingVerification:', pendingVerification.value) // Debug log\n\n    const handleSubmit = async () => {\n      try {\n        loading.value = true\n        const response = await store.dispatch('auth/register', form.value)\n        // Rediriger vers la page de vérification avec l'email\n        router.push({\n          name: 'verify-email',\n          query: { email: form.value.email }\n        })\n      } catch (error) {\n        alert(error.message || \"Erreur lors de l'inscription\")\n      } finally {\n        loading.value = false\n      }\n    }\n\n    const handleVerification = async () => {\n      try {\n        loading.value = true\n        await store.dispatch('auth/verifyEmail', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        })\n        router.push('/login')\n      } catch (error) {\n        alert(error.message || 'Erreur de vérification')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    return {\n      form,\n      loading,\n      verificationCode,\n      pendingVerification,\n      showPassword,\n      photoInput,\n      photoPreview,\n      handleSubmit,\n      handleVerification,\n      handlePhotoChange\n    }\n  }\n}\n</script>\n\n<style scoped>\n.min-h-screen {\n  background: linear-gradient(135deg, #f6f9fc 0%, #edf2f7 100%);\n  position: relative;\n  overflow: hidden;\n  min-height: 100vh;\n  displa