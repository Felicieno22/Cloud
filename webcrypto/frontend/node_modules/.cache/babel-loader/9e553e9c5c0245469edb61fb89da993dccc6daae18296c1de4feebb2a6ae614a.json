{"ast":null,"code":"import { ref, computed, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Account',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const error = ref('');\n    const user = computed(() => store.getters['auth/user']);\n    const form = ref({\n      username: '',\n      firstName: '',\n      lastName: '',\n      dateNaissance: '',\n      currentPassword: ''\n    });\n\n    // Initialiser le formulaire avec les données de l'utilisateur\n    onMounted(() => {\n      if (user.value) {\n        form.value = {\n          username: user.value.username || '',\n          firstName: user.value.firstName || '',\n          lastName: user.value.lastName || '',\n          dateNaissance: user.value.dateNaissance ? new Date(user.value.dateNaissance).toISOString().split('T')[0] : '',\n          currentPassword: ''\n        };\n      }\n    });\n    const handleSubmit = async () => {\n      try {\n        loading.value = true;\n        error.value = '';\n\n        // Appel à l'API pour mettre à jour les informations\n        const response = await fetch('http://localhost:8080/api/users/update', {\n          method: 'PUT',\n          headers: {\n            'Content-Type': 'application/json',\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          },\n          body: JSON.stringify({\n            username: form.value.username,\n            firstName: form.value.firstName,\n            lastName: form.value.lastName,\n            dateNaissance: form.value.dateNaissance,\n            currentPassword: form.value.currentPassword\n          })\n        });\n        const data = await response.json();\n        if (!response.ok) {\n          throw new Error(data.message || 'Erreur lors de la mise à jour');\n        }\n\n        // Mettre à jour le store avec les nouvelles informations\n        await store.dispatch('auth/updateUser', data.user);\n\n        // Rediriger vers le dashboard avec un message de succès\n        router.push('/dashboard');\n      } catch (err) {\n        error.value = err.message;\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      user,\n      form,\n      loading,\n      error,\n      handleSubmit\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","useStore","useRouter","name","setup","store","router","loading","error","user","getters","form","username","firstName","lastName","dateNaissance","currentPassword","value","Date","toISOString","split","handleSubmit","response","fetch","method","headers","localStorage","getItem","body","JSON","stringify","data","json","ok","Error","message","dispatch","push","err"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Account.vue"],"sourcesContent":["<template>\r\n  <div class=\"min-h-screen bg-gray-50 py-12\">\r\n    <div class=\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\">\r\n      <div class=\"bg-white rounded-lg shadow-sm overflow-hidden\">\r\n        <!-- En-tête -->\r\n        <div class=\"px-6 py-4 border-b border-gray-200\">\r\n          <h2 class=\"text-2xl font-bold text-gray-900\">Gérer mon compte</h2>\r\n          <p class=\"mt-1 text-sm text-gray-500\">Modifiez vos informations personnelles</p>\r\n        </div>\r\n\r\n        <!-- Formulaire -->\r\n        <form @submit.prevent=\"handleSubmit\" class=\"p-6 space-y-6\">\r\n          <!-- Avatar et nom d'utilisateur -->\r\n          <div class=\"flex items-center space-x-6\">\r\n            <div class=\"w-20 h-20 rounded-full bg-indigo-100 flex items-center justify-center\">\r\n              <span class=\"text-2xl font-medium text-indigo-700\">\r\n                {{ user?.username?.[0]?.toUpperCase() || 'U' }}\r\n              </span>\r\n            </div>\r\n            <div class=\"flex-1\">\r\n              <label class=\"block text-sm font-medium text-gray-700\">\r\n                Nom d'utilisateur\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                v-model=\"form.username\"\r\n                class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n                required\r\n              />\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Informations personnelles -->\r\n          <div class=\"grid grid-cols-1 gap-6 sm:grid-cols-2\">\r\n            <div>\r\n              <label class=\"block text-sm font-medium text-gray-700\">\r\n                Prénom\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                v-model=\"form.firstName\"\r\n                class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n                required\r\n              />\r\n            </div>\r\n            <div>\r\n              <label class=\"block text-sm font-medium text-gray-700\">\r\n                Nom\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                v-model=\"form.lastName\"\r\n                class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n                required\r\n              />\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Date de naissance -->\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700\">\r\n              Date de naissance\r\n            </label>\r\n            <input\r\n              type=\"date\"\r\n              v-model=\"form.dateNaissance\"\r\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n              required\r\n            />\r\n          </div>\r\n\r\n          <!-- Email (désactivé) -->\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700\">\r\n              Email\r\n            </label>\r\n            <input\r\n              type=\"email\"\r\n              :value=\"user?.email\"\r\n              class=\"mt-1 block w-full rounded-md border-gray-300 bg-gray-50 text-gray-500 cursor-not-allowed\"\r\n              disabled\r\n            />\r\n            <p class=\"mt-1 text-xs text-gray-500\">L'adresse email ne peut pas être modifiée</p>\r\n          </div>\r\n\r\n          <!-- Mot de passe actuel -->\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700\">\r\n              Mot de passe actuel\r\n            </label>\r\n            <input\r\n              type=\"password\"\r\n              v-model=\"form.currentPassword\"\r\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n              required\r\n            />\r\n          </div>\r\n\r\n          <!-- Message d'erreur -->\r\n          <div v-if=\"error\" class=\"rounded-md bg-red-50 p-4\">\r\n            <div class=\"flex\">\r\n              <div class=\"flex-shrink-0\">\r\n                <svg class=\"h-5 w-5 text-red-400\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\r\n                  <path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z\" clip-rule=\"evenodd\" />\r\n                </svg>\r\n              </div>\r\n              <div class=\"ml-3\">\r\n                <p class=\"text-sm text-red-700\">{{ error }}</p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Boutons -->\r\n          <div class=\"flex justify-end space-x-3\">\r\n            <button\r\n              type=\"button\"\r\n              @click=\"$router.push('/dashboard')\"\r\n              class=\"px-4 py-2 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 rounded-md shadow-sm border border-gray-300\"\r\n            >\r\n              Annuler\r\n            </button>\r\n            <button\r\n              type=\"submit\"\r\n              :disabled=\"loading\"\r\n              class=\"px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 rounded-md shadow-sm disabled:opacity-50\"\r\n            >\r\n              {{ loading ? 'Enregistrement...' : 'Enregistrer les modifications' }}\r\n            </button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { useRouter } from 'vue-router'\r\n\r\nexport default {\r\n  name: 'Account',\r\n  \r\n  setup() {\r\n    const store = useStore()\r\n    const router = useRouter()\r\n    const loading = ref(false)\r\n    const error = ref('')\r\n    \r\n    const user = computed(() => store.getters['auth/user'])\r\n    \r\n    const form = ref({\r\n      username: '',\r\n      firstName: '',\r\n      lastName: '',\r\n      dateNaissance: '',\r\n      currentPassword: ''\r\n    })\r\n\r\n    // Initialiser le formulaire avec les données de l'utilisateur\r\n    onMounted(() => {\r\n      if (user.value) {\r\n        form.value = {\r\n          username: user.value.username || '',\r\n          firstName: user.value.firstName || '',\r\n          lastName: user.value.lastName || '',\r\n          dateNaissance: user.value.dateNaissance ? new Date(user.value.dateNaissance).toISOString().split('T')[0] : '',\r\n          currentPassword: ''\r\n        }\r\n      }\r\n    })\r\n\r\n    const handleSubmit = async () => {\r\n      try {\r\n        loading.value = true\r\n        error.value = ''\r\n\r\n        // Appel à l'API pour mettre à jour les informations\r\n        const response = await fetch('http://localhost:8080/api/users/update', {\r\n          method: 'PUT',\r\n          headers: {\r\n            'Content-Type': 'application/json',\r\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\r\n          },\r\n          body: JSON.stringify({\r\n            username: form.value.username,\r\n            firstName: form.value.firstName,\r\n            lastName: form.value.lastName,\r\n            dateNaissance: form.value.dateNaissance,\r\n            currentPassword: form.value.currentPassword\r\n          })\r\n        })\r\n\r\n        const data = await response.json()\r\n\r\n        if (!response.ok) {\r\n          throw new Error(data.message || 'Erreur lors de la mise à jour')\r\n        }\r\n\r\n        // Mettre à jour le store avec les nouvelles informations\r\n        await store.dispatch('auth/updateUser', data.user)\r\n        \r\n        // Rediriger vers le dashboard avec un message de succès\r\n        router.push('/dashboard')\r\n      } catch (err) {\r\n        error.value = err.message\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    return {\r\n      user,\r\n      form,\r\n      loading,\r\n      error,\r\n      handleSubmit\r\n    }\r\n  }\r\n}\r\n</script> "],"mappings":"AAwIA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAI;AAC7C,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,SAAS;EAEfC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,OAAM,GAAIT,GAAG,CAAC,KAAK;IACzB,MAAMU,KAAI,GAAIV,GAAG,CAAC,EAAE;IAEpB,MAAMW,IAAG,GAAIV,QAAQ,CAAC,MAAMM,KAAK,CAACK,OAAO,CAAC,WAAW,CAAC;IAEtD,MAAMC,IAAG,GAAIb,GAAG,CAAC;MACfc,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,EAAE;MACbC,QAAQ,EAAE,EAAE;MACZC,aAAa,EAAE,EAAE;MACjBC,eAAe,EAAE;IACnB,CAAC;;IAED;IACAhB,SAAS,CAAC,MAAM;MACd,IAAIS,IAAI,CAACQ,KAAK,EAAE;QACdN,IAAI,CAACM,