{"ast":null,"code":"import { createElementVNode as _createElementVNode, toDisplayString as _toDisplayString, normalizeClass as _normalizeClass, resolveComponent as _resolveComponent, openBlock as _openBlock, createBlock as _createBlock, createCommentVNode as _createCommentVNode, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  class: \"container mx-auto px-4 py-8\"\n};\nconst _hoisted_2 = {\n  class: \"mb-8 flex items-center\"\n};\nconst _hoisted_3 = {\n  class: \"text-3xl font-bold text-gray-900\"\n};\nconst _hoisted_4 = {\n  class: \"bg-white rounded-lg shadow-lg p-6\"\n};\nconst _hoisted_5 = {\n  class: \"flex justify-between items-center mb-6\"\n};\nconst _hoisted_6 = {\n  class: \"text-2xl font-bold\"\n};\nconst _hoisted_7 = {\n  class: \"text-gray-600\"\n};\nconst _hoisted_8 = {\n  class: \"h-96\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  const _component_Line = _resolveComponent(\"Line\");\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [_createElementVNode(\"div\", _hoisted_2, [_createElementVNode(\"button\", {\n    onClick: _cache[0] || (_cache[0] = $event => _ctx.$router.push('/dashboard')),\n    class: \"mr-4 text-indigo-600 hover:text-indigo-800\"\n  }, \" ← Retour \"), _createElementVNode(\"h1\", _hoisted_3, _toDisplayString($setup.cryptoSymbol), 1 /* TEXT */)]), _createElementVNode(\"div\", _hoisted_4, [_createElementVNode(\"div\", _hoisted_5, [_createElementVNode(\"div\", null, [_createElementVNode(\"h2\", _hoisted_6, _toDisplayString($setup.cryptoData?.name), 1 /* TEXT */), _createElementVNode(\"p\", _hoisted_7, \"Prix actuel: \" + _toDisplayString($setup.formatPrice($setup.cryptoData?.price)), 1 /* TEXT */)]), _createElementVNode(\"div\", {\n    class: _normalizeClass([$setup.getPriceChangeClass(), \"text-lg font-semibold\"])\n  }, _toDisplayString($setup.formatPriceChange($setup.cryptoData?.priceChange)) + \"% \", 3 /* TEXT, CLASS */)]), _createElementVNode(\"div\", _hoisted_8, [$setup.chartData ? (_openBlock(), _createBlock(_component_Line, {\n    key: 0,\n    data: $setup.chartData,\n    options: $setup.chartOptions\n  }, null, 8 /* PROPS */, [\"data\", \"options\"])) : _createCommentVNode(\"v-if\", true)])])]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","onClick","_cache","$event","_ctx","$router","push","_hoisted_3","_toDisplayString","$setup","cryptoSymbol","_hoisted_4","_hoisted_5","_hoisted_6","cryptoData","name","_hoisted_7","formatPrice","price","_normalizeClass","getPriceChangeClass","formatPriceChange","priceChange","_hoisted_8","chartData","_createBlock","_component_Line","key","data","options","chartOptions","_createCommentVNode"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\CryptoDetail.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"mb-8 flex items-center\">\n      <button @click=\"$router.push('/dashboard')\" class=\"mr-4 text-indigo-600 hover:text-indigo-800\">\n        ← Retour\n      </button>\n      <h1 class=\"text-3xl font-bold text-gray-900\">{{ cryptoSymbol }}</h1>\n    </div>\n\n    <div class=\"bg-white rounded-lg shadow-lg p-6\">\n      <div class=\"flex justify-between items-center mb-6\">\n        <div>\n          <h2 class=\"text-2xl font-bold\">{{ cryptoData?.name }}</h2>\n          <p class=\"text-gray-600\">Prix actuel: {{ formatPrice(cryptoData?.price) }}</p>\n        </div>\n        <div :class=\"getPriceChangeClass()\" class=\"text-lg font-semibold\">\n          {{ formatPriceChange(cryptoData?.priceChange) }}%\n        </div>\n      </div>\n\n      <div class=\"h-96\">\n        <Line v-if=\"chartData\" :data=\"chartData\" :options=\"chartOptions\" />\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted, computed } from 'vue';\nimport { useRoute } from 'vue-router';\nimport { socket } from '@/socket';\nimport {\n  Chart as ChartJS,\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  TimeScale,\n  Title,\n  Tooltip,\n  Legend\n} from 'chart.js';\nimport 'chartjs-adapter-date-fns';\nimport { fr } from 'date-fns/locale';\nimport { Line } from 'vue-chartjs';\n\nChartJS.register(\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  TimeScale,\n  Title,\n  Tooltip,\n  Legend\n);\n\nexport default {\n  name: 'CryptoDetail',\n  components: { Line },\n\n  setup() {\n    const route = useRoute();\n    const cryptoSymbol = route.params.symbol;\n    const cryptoData = ref(null);\n    const priceHistory = ref([]);\n    const isLoading = ref(true);\n\n    // Charger l'historique des prix\n    const loadPriceHistory = async () => {\n      try {\n        const response = await fetch(`http://localhost:3000/api/cryptocurrencies/${cryptoSymbol}/history`);\n        if (!response.ok) throw new Error('Erreur lors du chargement de l\\'historique');\n        \n        const data = await response.json();\n        priceHistory.value = data.map(item => ({\n          price: parseFloat(item.price),\n          timestamp: new Date(item.created_at)\n        })).reverse(); // Inverser pour avoir l'ordre chronologique\n      } catch (error) {\n        console.error('Erreur:', error);\n      } finally {\n        isLoading.value = false;\n      }\n    };\n\n    // Configuration du graphique\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      scales: {\n        x: {\n          type: 'time',\n          adapters: {\n            date: {\n              locale: fr\n            }\n          },\n          time: {\n            unit: 'minute',\n            displayFormats: {\n              minute: 'HH:mm',\n              hour: 'HH:mm',\n              day: 'dd/MM'\n            }\n          },\n          title: {\n            display: true,\n            text: 'Heure'\n          }\n        },\n        y: {\n          beginAtZero: false,\n          ticks: {\n            callback: value => formatPrice(value)\n          },\n          title: {\n            display: true,\n            text: 'Prix'\n          }\n        }\n      },\n      plugins: {\n        legend: {\n          display: false\n        },\n        tooltip: {\n          callbacks: {\n            label: (context) => formatPrice(context.raw),\n            title: (tooltipItems) => {\n              const date = new Date(tooltipItems[0].parsed.x);\n              return date.toLocaleString('fr-FR', {\n                dateStyle: 'short',\n                timeStyle: 'short'\n              });\n            }\n          }\n        }\n      },\n      interaction: {\n        intersect: false,\n        mode: 'index'\n      }\n    };\n\n    const chartData = computed(() => ({\n      labels: priceHistory.value.map(item => item.timestamp),\n      datasets: [{\n        label: cryptoSymbol,\n        data: priceHistory.value.map(item => item.price),\n        borderColor: '#4F46E5',\n        tension: 0.1,\n        pointRadius: 2\n      }]\n    }));\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const formatPriceChange = (change) => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion des mises à jour en temps réel\n    socket.on('priceUpdate', (data) => {\n      const crypto = data.find(c => c.symbol === cryptoSymbol);\n      if (crypto) {\n        cryptoData.value = crypto;\n        // Ajouter le nouveau prix à l'historique\n        priceHistory.value.push({\n          price: crypto.price,\n          timestamp: new Date()\n        });\n      }\n    });\n\n    onMounted(() => {\n      socket.connect();\n      loadPriceHistory();\n    });\n\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n\n    return {\n      cryptoSymbol,\n      cryptoData,\n      chartData,\n      chartOptions,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      isLoading\n    };\n  }\n};\n</script>\n"],"mappings":";;EACOA,KAAK,EAAC;AAA6B;;EACjCA,KAAK,EAAC;AAAwB;;EAI7BA,KAAK,EAAC;AAAkC;;EAGzCA,KAAK,EAAC;AAAmC;;EACvCA,KAAK,EAAC;AAAwC;;EAE3CA,KAAK,EAAC;AAAoB;;EAC3BA,KAAK,EAAC;AAAe;;EAOvBA,KAAK,EAAC;AAAM;;;uBAnBrBC,mBAAA,CAuBM,OAvBNC,UAuBM,GAtBJC,mBAAA,CAKM,OALNC,UAKM,GAJJD,mBAAA,CAES;IAFAE,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEC,IAAA,CAAAC,OAAO,CAACC,IAAI;IAAgBV,KAAK,EAAC;KAA6C,YAE/F,GACAG,mBAAA,CAAoE,MAApEQ,UAAoE,EAAAC,gBAAA,CAApBC,MAAA,CAAAC,YAAY,iB,GAG9DX,mBAAA,CAcM,OAdNY,UAcM,GAbJZ,mBAAA,CAQM,OARNa,UAQM,GAPJb,mBAAA,CAGM,cAFJA,mBAAA,CAA0D,MAA1Dc,UAA0D,EAAAL,gBAAA,CAAxBC,MAAA,CAAAK,UAAU,EAAEC,IAAI,kBAClDhB,mBAAA,CAA8E,KAA9EiB,UAA8E,EAArD,eAAa,GAAAR,gBAAA,CAAGC,MAAA,CAAAQ,WAAW,CAACR,MAAA,CAAAK,UAAU,EAAEI,KAAK,kB,GAExEnB,mBAAA,CAEM;IAFAH,KAAK,EAfnBuB,eAAA,EAeqBV,MAAA,CAAAW,mBAAmB,IAAU,uBAAuB;sBAC5DX,MAAA,CAAAY,iBAAiB,CAACZ,MAAA,CAAAK,UAAU,EAAEQ,WAAW,KAAI,IAClD,uB,GAGFvB,mBAAA,CAEM,OAFNwB,UAEM,GADQd,MAAA,CAAAe,SAAS,I,cAArBC,YAAA,CAAmEC,eAAA;IArB3EC,GAAA;IAqBgCC,IAAI,EAAEnB,MAAA,CAAAe,SAAS;IAAGK,OAAO,EAAEpB,MAAA,CAAAqB;kDArB3DC,mBAAA,e","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}