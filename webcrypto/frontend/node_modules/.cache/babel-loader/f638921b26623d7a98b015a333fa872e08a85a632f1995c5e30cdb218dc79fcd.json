{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nimport { LineChart } from 'vue-chartjs';\nexport default {\n  name: 'Dashboard',\n  components: {\n    LineChart\n  },\n  setup() {\n    const router = useRouter();\n    const isConnected = ref(false);\n    const cryptoList = ref([]);\n    const selectedCrypto = ref(null);\n    const isLoading = ref(true);\n\n    // Connexion socket\n    socket.on('connect', () => {\n      console.log('Connecté au serveur');\n      isConnected.value = true;\n\n      // Authentification socket\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken');\n      if (token) {\n        socket.emit('authenticate', token);\n      }\n    });\n    socket.on('disconnect', () => {\n      console.log('Déconnecté du serveur');\n      isConnected.value = false;\n    });\n    socket.on('authenticated', () => {\n      console.log('Socket authentifié, demande des prix...');\n      socket.emit('getPriceUpdate');\n    });\n\n    // Mise à jour des prix\n    socket.on('priceUpdate', data => {\n      console.log('Données reçues:', data);\n      cryptoList.value = data;\n      isLoading.value = false;\n    });\n\n    // Formatage des prix\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    // Formatage de la variation de prix\n    const formatPriceChange = change => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    // Classe CSS pour la variation de prix\n    const getPriceChangeClass = symbol => {\n      const crypto = cryptoList.value.find(c => c.symbol === symbol);\n      if (!crypto) return 'text-gray-500';\n      return {\n        'text-green-500': crypto.priceChange > 0,\n        'text-red-500': crypto.priceChange < 0,\n        'text-gray-500': crypto.priceChange === 0\n      };\n    };\n\n    // Sélection d'une crypto\n    const selectCrypto = symbol => {\n      selectedCrypto.value = symbol;\n    };\n\n    // Ajout à la watchlist\n    const addToWatchlist = symbol => {\n      // TODO: Implémenter l'ajout à la watchlist\n      console.log('Ajout à la watchlist:', symbol);\n    };\n    onMounted(() => {\n      if (!socket.connected) {\n        socket.connect();\n      } else {\n        // Si déjà connecté, authentifier et demander les données\n        const token = localStorage.getItem('token') || localStorage.getItem('sessionToken');\n        if (token) {\n          socket.emit('authenticate', token);\n        }\n      }\n\n      // Timeout de sécurité pour le chargement\n      setTimeout(() => {\n        if (isLoading.value) {\n          isLoading.value = false;\n        }\n      }, 10000); // 10 secondes maximum de chargement\n    });\n    onUnmounted(() => {\n      socket.off('connect');\n      socket.off('disconnect');\n      socket.off('priceUpdate');\n      socket.off('authenticated');\n      socket.disconnect();\n    });\n    return {\n      isConnected,\n      cryptoList,\n      selectedCrypto,\n      isLoading,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      selectCrypto,\n      addToWatchlist\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","useRouter","socket","LineChart","name","components","setup","router","isConnected","cryptoList","selectedCrypto","isLoading","on","console","log","value","token","localStorage","getItem","emit","data","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatPriceChange","change","toFixed","getPriceChangeClass","symbol","crypto","find","c","priceChange","selectCrypto","addToWatchlist","connected","connect","setTimeout","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"mb-8\">\n      <h1 class=\"text-3xl font-bold text-gray-900\">Tableau de bord</h1>\n      <p class=\"text-gray-600\">\n        Cours des cryptomonnaies mis à jour en temps réel\n        <span :class=\"{'text-green-500': isConnected, 'text-red-500': !isConnected}\">\n          ●\n        </span>\n      </p>\n    </div>\n\n    <!-- État de chargement -->\n    <div v-if=\"isLoading\" class=\"flex justify-center items-center min-h-[400px]\">\n      <div class=\"flex flex-col items-center space-y-4\">\n        <div class=\"w-12 h-12 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin\"></div>\n        <p class=\"text-gray-600\">Chargement des données...</p>\n      </div>\n    </div>\n\n    <!-- Grille des cryptomonnaies -->\n    <div v-else class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n      <div v-for=\"crypto in cryptoList\" :key=\"crypto.symbol\" \n           class=\"bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow duration-200\">\n        <div class=\"flex justify-between items-center\">\n          <div>\n            <h2 class=\"text-xl font-semibold\">{{ crypto.symbol }}</h2>\n            <p class=\"text-gray-600\">{{ crypto.name }}</p>\n          </div>\n          <div class=\"text-right\">\n            <div class=\"text-2xl font-bold\">{{ formatPrice(crypto.price) }}</div>\n            <div :class=\"getPriceChangeClass(crypto.symbol)\" class=\"text-sm\">\n              {{ formatPriceChange(crypto.priceChange) }}%\n            </div>\n          </div>\n        </div>\n        <div class=\"mt-4 flex justify-end space-x-2\">\n          <button @click=\"$router.push(`/crypto/${crypto.symbol}`)\" \n                  class=\"px-4 py-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors\">\n            Voir détails\n          </button>\n          <button @click=\"$router.push(`/trade/${crypto.symbol}`)\"\n                  class=\"px-4 py-2 bg-indigo-600 text-white hover:bg-indigo-700 rounded-lg transition-colors\">\n            Trader\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- Graphique pour la crypto sélectionnée -->\n    <div v-if=\"selectedCrypto\" class=\"mt-8\">\n      <div class=\"bg-white rounded-lg shadow-lg p-6\">\n        <div class=\"flex justify-between items-center mb-4\">\n          <h2 class=\"text-2xl font-bold\">{{ selectedCrypto }}</h2>\n          <div class=\"space-x-2\">\n            <button @click=\"$router.push({ name: 'Trade', params: { crypto: selectedCrypto }})\"\n                    class=\"bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition-colors\">\n              Trader\n            </button>\n            <button @click=\"addToWatchlist(selectedCrypto)\"\n                    class=\"border border-gray-300 px-4 py-2 rounded hover:bg-gray-50 transition-colors\">\n              Suivre\n            </button>\n          </div>\n        </div>\n        <div class=\"h-96\">\n          <!-- TODO: Ajouter le graphique -->\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nimport { LineChart } from 'vue-chartjs';\n\nexport default {\n  name: 'Dashboard',\n  components: { LineChart },\n  \n  setup() {\n    const router = useRouter();\n    const isConnected = ref(false);\n    const cryptoList = ref([]);\n    const selectedCrypto = ref(null);\n    const isLoading = ref(true);\n    \n    // Connexion socket\n    socket.on('connect', () => {\n      console.log('Connecté au serveur');\n      isConnected.value = true;\n      \n      // Authentification socket\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken');\n      if (token) {\n        socket.emit('authenticate', token);\n      }\n    });\n\n    socket.on('disconnect', () => {\n      console.log('Déconnecté du serveur');\n      isConnected.value = false;\n    });\n\n    socket.on('authenticated', () => {\n      console.log('Socket authentifié, demande des prix...');\n      socket.emit('getPriceUpdate');\n    });\n\n    // Mise à jour des prix\n    socket.on('priceUpdate', (data) => {\n      console.log('Données reçues:', data);\n      cryptoList.value = data;\n      isLoading.value = false;\n    });\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    // Formatage de la variation de prix\n    const formatPriceChange = (change) => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    // Classe CSS pour la variation de prix\n    const getPriceChangeClass = (symbol) => {\n      const crypto = cryptoList.value.find(c => c.symbol === symbol);\n      if (!crypto) return 'text-gray-500';\n      \n      return {\n        'text-green-500': crypto.priceChange > 0,\n        'text-red-500': crypto.priceChange < 0,\n        'text-gray-500': crypto.priceChange === 0\n      };\n    };\n\n    // Sélection d'une crypto\n    const selectCrypto = (symbol) => {\n      selectedCrypto.value = symbol;\n    };\n\n    // Ajout à la watchlist\n    const addToWatchlist = (symbol) => {\n      // TODO: Implémenter l'ajout à la watchlist\n      console.log('Ajout à la watchlist:', symbol);\n    };\n\n    onMounted(() => {\n      if (!socket.connected) {\n        socket.connect();\n      } else {\n        // Si déjà connecté, authentifier et demander les données\n        const token = localStorage.getItem('token') || localStorage.getItem('sessionToken');\n        if (token) {\n          socket.emit('authenticate', token);\n        }\n      }\n\n      // Timeout de sécurité pour le chargement\n      setTimeout(() => {\n        if (isLoading.value) {\n          isLoading.value = false;\n        }\n      }, 10000); // 10 secondes maximum de chargement\n    });\n\n    onUnmounted(() => {\n      socket.off('connect');\n      socket.off('disconnect');\n      socket.off('priceUpdate');\n      socket.off('authenticated');\n      socket.disconnect();\n    });\n\n    return {\n      isConnected,\n      cryptoList,\n      selectedCrypto,\n      isLoading,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      selectCrypto,\n      addToWatchlist\n    };\n  }\n};\n</script>\n"],"mappings":"AA0EA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AACjD,SAASC,SAAQ,QAAS,YAAY;AACtC,SAASC,MAAK,QAAS,UAAU;AACjC,SAASC,SAAQ,QAAS,aAAa;AAEvC,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IAAEF;EAAU,CAAC;EAEzBG,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIN,SAAS,CAAC,CAAC;IAC1B,MAAMO,WAAU,GAAIV,GAAG,CAAC,KAAK,CAAC;IAC9B,MAAMW,UAAS,GAAIX,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMY,cAAa,GAAIZ,GAAG,CAAC,IAAI,CAAC;IAChC,MAAMa,SAAQ,GAAIb,GAAG,CAAC,IAAI,CAAC;;IAE3B;IACAI,MAAM,CAACU,EAAE,CAAC,SAAS,EAAE,MAAM;MACzBC,OAAO,CAACC,GAAG,CAAC,qBAAqB,CAAC;MAClCN,WAAW,CAACO,KAAI,GAAI,IAAI;;MAExB;MACA,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,KAAKD,YAAY,CAACC,OAAO,CAAC,cAAc,CAAC;MACnF,IAAIF,KAAK,EAAE;QACTd,MAAM,CAACiB,IAAI,CAAC,cAAc,EAAEH,KAAK,CAAC;MACpC;IACF,CAAC,CAAC;IAEFd,MAAM,CAACU,EAAE,CAAC,YAAY,EAAE,MAAM;MAC5BC,OAAO,CAACC,GAAG,CAAC,uBAAuB,CAAC;MACpCN,WAAW,CAACO,KAAI,GAAI,KAAK;IAC3B,CAAC,CAAC;IAEFb,MAAM,CAACU,EAAE,CAAC,eAAe,EAAE,MAAM;MAC/BC,OAAO,CAACC,GAAG,CAAC,yCAAyC,CAAC;MACtDZ,MAAM,CAACiB,IAAI,CAAC,gBAAgB,CAAC;IAC/B,CAAC,CAAC;;IAEF;IACAjB,MAAM,CAACU,EAAE,CAAC,aAAa,EAAGQ,IAAI,IAAK;MACjCP,OAAO,CAACC,GAAG,CAAC,iBAAiB,EAAEM,IAAI,CAAC;MACpCX,UAAU,CAACM,KAAI,GAAIK,IAAI;MACvBT,SAAS,CAACI,KAAI,GAAI,