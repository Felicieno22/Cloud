{"ast":null,"code":"import { computed, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nexport default {\n  name: 'Account',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const user = computed(() => store.getters['auth/user']);\n    onMounted(() => {\n      if (!user.value) {\n        router.push('/login');\n        return;\n      }\n\n      // Connexion socket pour récupérer les infos à jour\n      socket.connect();\n      const token = localStorage.getItem('token');\n      if (token) {\n        socket.emit('authenticate', token);\n        socket.on('authenticated', () => {\n          socket.emit('getUserInfo');\n        });\n      }\n\n      // Mise à jour des infos utilisateur\n      socket.on('userInfo', data => {\n        if (data) {\n          store.dispatch('auth/updateUser', data);\n        }\n      });\n    });\n    return {\n      user\n    };\n  }\n};","map":{"version":3,"names":["computed","onMounted","useStore","useRouter","socket","name","setup","store","router","user","getters","value","push","connect","token","localStorage","getItem","emit","on","data","dispatch"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Account.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-gray-50 py-8\">\n    <div class=\"max-w-3xl mx-auto px-4\">\n      <h1 class=\"text-3xl font-bold text-center mb-8\">Mon Compte</h1>\n      \n      <div class=\"bg-white rounded-lg shadow p-6\">\n        <!-- Avatar et email -->\n        <div class=\"flex items-center mb-6 pb-6 border-b\">\n          <div class=\"w-16 h-16 rounded-full bg-indigo-600 flex items-center justify-center text-white text-xl font-bold\">\n            {{ user?.username?.[0]?.toUpperCase() || 'U' }}\n          </div>\n          <div class=\"ml-4\">\n            <h2 class=\"text-xl font-semibold\">{{ user?.email }}</h2>\n          </div>\n        </div>\n\n        <!-- Informations utilisateur -->\n        <div class=\"space-y-4\">\n          <div class=\"grid grid-cols-2 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600\">Nom d'utilisateur</label>\n              <div class=\"mt-1 p-2 bg-gray-50 rounded-md\">{{ user?.username || '-' }}</div>\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-gray-600\">Email</label>\n              <div class=\"mt-1 p-2 bg-gray-50 rounded-md\">{{ user?.email || '-' }}</div>\n            </div>\n\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600\">Nom</label>\n              <div class=\"mt-1 p-2 bg-gray-50 rounded-md\">{{ user?.nom || '-' }}</div>\n            </div>\n\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600\">Prénom</label>\n              <div class=\"mt-1 p-2 bg-gray-50 rounded-md\">{{ user?.prenom || '-' }}</div>\n            </div>\n\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600\">Date de naissance</label>\n              <div class=\"mt-1 p-2 bg-gray-50 rounded-md\">{{ user?.date_naissance || '-' }}</div>\n            </div>\n\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600\">Ville</label>\n              <div class=\"mt-1 p-2 bg-gray-50 rounded-md\">{{ user?.ville || '-' }}</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { computed, onMounted } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\nimport { socket } from '@/socket'\n\nexport default {\n  name: 'Account',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const user = computed(() => store.getters['auth/user'])\n\n    onMounted(() => {\n      if (!user.value) {\n        router.push('/login')\n        return\n      }\n\n      // Connexion socket pour récupérer les infos à jour\n      socket.connect()\n      const token = localStorage.getItem('token')\n      if (token) {\n        socket.emit('authenticate', token)\n        socket.on('authenticated', () => {\n          socket.emit('getUserInfo')\n        })\n      }\n\n      // Mise à jour des infos utilisateur\n      socket.on('userInfo', (data) => {\n        if (data) {\n          store.dispatch('auth/updateUser', data)\n        }\n      })\n    })\n\n    return {\n      user\n    }\n  }\n}\n</script>\n\n<style scoped>\n.min-h-screen {\n  background-image: \n    radial-gradient(circle at 0% 0%, rgba(79, 70, 229, 0.1) 0%, transparent 50%),\n    radial-gradient(circle at 100% 100%, rgba(99, 102, 241, 0.1) 0%, transparent 50%);\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes slideIn {\n  from {\n    opacity: 0;\n    transform: translateY(-20px) scale(0.95);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n.animate-fadeIn {\n  animation: fadeIn 0.3s ease-out;\n}\n\n.animate-slideIn {\n  animation: slideIn 0.3s ease-out;\n}\n\n.bg-white {\n  backdrop-filter: blur(10px);\n  box-shadow: \n    0 10px 15px -3px rgba(0, 0, 0, 0.1),\n    0 4px 6px -2px rgba(0, 0, 0, 0.05),\n    0 0 0 1px rgba(0, 0, 0, 0.05);\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\ninput {\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\ninput:hover:not(:disabled) {\n  border-color: #818cf8;\n}\n\ninput:focus:not(:disabled) {\n  border-color: #6366f1;\n  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);\n  transform: translateY(-1px);\n}\n\nbutton {\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  position: relative;\n  overflow: hidden;\n}\n\nbutton:hover:not(:disabled) {\n  transform: translateY(-1px);\n}\n\nbutton:active:not(:disabled) {\n  transform: translateY(0);\n}\n\nbutton::after {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 0;\n  height: 0;\n  background: rgba(255, 255, 255, 0.2);\n  border-radius: 50%;\n  transform: translate(-50%, -50%);\n  transition: width 0.6s ease, height 0.6s ease;\n}\n\nbutton:active::after {\n  width: 200px;\n  height: 200px;\n  opacity: 0;\n}\n\n.text-transparent.bg-clip-text {\n  -webkit-background-clip: text;\n  background-clip: text;\n}\n\n/* Dark mode support */\n@media (prefers-color-scheme: dark) {\n  .min-h-screen {\n    background-color: #1a1b23;\n  }\n  \n  .bg-white {\n    background-color: rgba(30, 31, 42, 0.95);\n  }\n  \n  input {\n    background-color: rgba(30, 31, 42, 0.9);\n    color: #e5e7eb;\n  }\n}\n</style> "],"mappings":"AAwDA,SAASA,QAAQ,EAAEC,SAAQ,QAAS,KAAI;AACxC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,MAAK,QAAS,UAAS;AAEhC,eAAe;EACbC,IAAI,EAAE,SAAS;EAEfC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC;IACvB,MAAMM,MAAK,GAAIL,SAAS,CAAC;IACzB,MAAMM,IAAG,GAAIT,QAAQ,CAAC,MAAMO,KAAK,CAACG,OAAO,CAAC,WAAW,CAAC;IAEtDT,SAAS,CAAC,MAAM;MACd,IAAI,CAACQ,IAAI,CAACE,KAAK,EAAE;QACfH,MAAM,CAACI,IAAI,CAAC,QAAQ;QACpB;MACF;;MAEA;MACAR,MAAM,CAACS,OAAO,CAAC;MACf,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO;MAC1C,IAAIF,KAAK,EAAE;QACTV,MAAM,CAACa,IAAI,CAAC,cAAc,EAAEH,KAAK;QACjCV,MAAM,CAACc,EAAE,CAAC,eAAe,EAAE,MAAM;UAC/Bd,MAAM,CAACa,IAAI,CAAC,aAAa;QAC3B,CAAC;MACH;;MAEA;MACAb,MAAM,CAACc,EAAE,CAAC,UAAU,EAAGC,IAAI,IAAK;QAC9B,IAAIA,IAAI,EAAE;UACRZ,KAAK,CAACa,QAAQ,CAAC,iBAAiB,EAAED,IAAI;QACxC;MACF,CAAC;IACH,CAAC;IAED,OAAO;MACLV;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}