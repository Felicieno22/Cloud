{"ast":null,"code":"import { computed, ref, onMounted, onUnmounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter, useRoute } from 'vue-router';\nimport { socket } from '@/socket';\nexport default {\n  name: 'App',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const route = useRoute();\n    const notifications = ref([]);\n    const showNotifications = ref(false);\n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated']);\n    const isAdminRoute = computed(() => {\n      return route.path.startsWith('/admin') && route.name !== 'AdminLogin' || route.path === '/commission-settings' || route.path === '/transactions-summary';\n    });\n    const isAdmin = computed(() => store.getters['auth/isAdmin']);\n    const unreadNotifications = computed(() => notifications.value.filter(n => !n.read));\n    const handleLogout = async () => {\n      await store.dispatch('auth/logout');\n      router.push('/login');\n    };\n    onMounted(() => {\n      // Vérifier l'authentification au démarrage\n      store.dispatch('auth/init');\n\n      // Connexion socket pour les notifications\n      socket.connect();\n\n      // Écouter les notifications\n      socket.on('notificationsUpdate', data => {\n        notifications.value = data;\n      });\n\n      // Demander les notifications initiales\n      if (isAuthenticated.value) {\n        socket.emit('getNotifications');\n      }\n    });\n    onUnmounted(() => {\n      socket.off('notificationsUpdate');\n      socket.disconnect();\n    });\n    return {\n      isAuthenticated,\n      isAdminRoute,\n      isAdmin,\n      handleLogout,\n      notifications,\n      showNotifications,\n      unreadNotifications,\n      route\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","onUnmounted","useStore","useRouter","useRoute","socket","name","setup","store","router","route","notifications","showNotifications","isAuthenticated","getters","isAdminRoute","path","startsWith","isAdmin","unreadNotifications","value","filter","n","read","handleLogout","dispatch","push","connect","on","data","emit","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div>\n    <!-- Navigation principale - cachée pour les pages admin -->\n    <nav v-if=\"!isAdminRoute\" class=\"bg-white shadow\">\n      <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"flex justify-between h-16\">\n          <div class=\"flex\">\n            <div class=\"flex-shrink-0 flex items-center\">\n              <router-link to=\"/\" class=\"text-xl font-bold text-indigo-600\">\n                CryptoTrade\n              </router-link>\n            </div>\n          </div>\n          <div class=\"flex items-center space-x-4\">\n            <!-- Liens pour utilisateur non authentifié -->\n            <template v-if=\"!isAuthenticated\">\n              <router-link\n                to=\"/login\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Connexion\n              </router-link>\n              <router-link\n                to=\"/register\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Inscription\n              </router-link>\n              <router-link\n                to=\"/admin/login\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Admin\n              </router-link>\n            </template>\n            <!-- Liens pour utilisateur authentifié -->\n            <template v-else>\n              <router-link\n                to=\"/dashboard\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Dashboard\n              </router-link>\n              <router-link\n                to=\"/wallet\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Portefeuille\n              </router-link>\n              <router-link\n                to=\"/transactions\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Transactions\n              </router-link>\n              <router-link\n                to=\"/analysis\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Analyses\n              </router-link>\n              <router-link\n                to=\"/commission-analysis\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Commissions\n              </router-link>\n              <template v-if=\"isAdmin\">\n                <router-link\n                  to=\"/commission-settings\"\n                  class=\"text-gray-700 hover:text-indigo-600\"\n                >\n                  Paramètres Commissions\n                </router-link>\n              </template>\n\n              <!-- Bouton Notifications -->\n              <div class=\"relative\">\n                <button \n                  @click=\"showNotifications = !showNotifications\"\n                  class=\"relative text-gray-700 hover:text-indigo-600\"\n                >\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9\" />\n                  </svg>\n                  <span v-if=\"unreadNotifications.length\" class=\"absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-4 w-4 flex items-center justify-center\">\n                    {{ unreadNotifications.length }}\n                  </span>\n                </button>\n\n                <!-- Menu déroulant des notifications -->\n                <div v-if=\"showNotifications\" class=\"absolute right-0 mt-2 w-80 bg-white rounded-md shadow-lg py-1 z-50\">\n                  <div class=\"max-h-96 overflow-y-auto\">\n                    <div v-if=\"notifications.length === 0\" class=\"px-4 py-2 text-sm text-gray-500\">\n                      Aucune notification\n                    </div>\n                    <div v-for=\"notif in notifications\" :key=\"notif.id\" class=\"px-4 py-2 hover:bg-gray-50\">\n                      <div class=\"text-sm font-medium text-gray-900\">{{ notif.title }}</div>\n                      <div class=\"text-sm text-gray-500\">{{ notif.message }}</div>\n                      <div class=\"text-xs text-gray-400 mt-1\">\n                        {{ new Date(notif.created_at).toLocaleString('fr-FR') }}\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <button\n                @click=\"handleLogout\"\n                class=\"text-red-600 hover:text-red-800\"\n              >\n                Déconnexion\n              </button>\n            </template>\n          </div>\n        </div>\n      </div>\n    </nav>\n\n    <router-view />\n  </div>\n</template>\n\n<script>\nimport { computed, ref, onMounted, onUnmounted } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter, useRoute } from 'vue-router'\nimport { socket } from '@/socket'\n\nexport default {\n  name: 'App',\n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const route = useRoute()\n    const notifications = ref([])\n    const showNotifications = ref(false)\n    \n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated'])\n    const isAdminRoute = computed(() => {\n      return (route.path.startsWith('/admin') && route.name !== 'AdminLogin') || \n             route.path === '/commission-settings' || \n             route.path === '/transactions-summary'\n    })\n    const isAdmin = computed(() => store.getters['auth/isAdmin'])\n    const unreadNotifications = computed(() => notifications.value.filter(n => !n.read))\n    \n    const handleLogout = async () => {\n      await store.dispatch('auth/logout')\n      router.push('/login')\n    }\n\n    onMounted(() => {\n      // Vérifier l'authentification au démarrage\n      store.dispatch('auth/init')\n\n      // Connexion socket pour les notifications\n      socket.connect()\n\n      // Écouter les notifications\n      socket.on('notificationsUpdate', (data) => {\n        notifications.value = data\n      })\n\n      // Demander les notifications initiales\n      if (isAuthenticated.value) {\n        socket.emit('getNotifications')\n      }\n    })\n\n    onUnmounted(() => {\n      socket.off('notificationsUpdate')\n      socket.disconnect()\n    })\n\n    return {\n      isAuthenticated,\n      isAdminRoute,\n      isAdmin,\n      handleLogout,\n      notifications,\n      showNotifications,\n      unreadNotifications,\n      route\n    }\n  }\n}\n</script>\n\n<style>\n/* Styles pour la scrollbar des notifications */\n.overflow-y-auto::-webkit-scrollbar {\n  width: 4px;\n}\n\n.overflow-y-auto::-webkit-scrollbar-track {\n  background: #f1f1f1;\n}\n\n.overflow-y-auto::-webkit-scrollbar-thumb {\n  background: #888;\n  border-radius: 2px;\n}\n\n.overflow-y-auto::-webkit-scrollbar-thumb:hover {\n  background: #555;\n}\n</style>\n"],"mappings":"AA4HA,SAASA,QAAQ,EAAEC,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AAC1D,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAS,EAAEC,QAAO,QAAS,YAAW;AAC/C,SAASC,MAAK,QAAS,UAAS;AAEhC,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC;IACvB,MAAMO,MAAK,GAAIN,SAAS,CAAC;IACzB,MAAMO,KAAI,GAAIN,QAAQ,CAAC;IACvB,MAAMO,aAAY,GAAIZ,GAAG,CAAC,EAAE;IAC5B,MAAMa,iBAAgB,GAAIb,GAAG,CAAC,KAAK;IAEnC,MAAMc,eAAc,GAAIf,QAAQ,CAAC,MAAMU,KAAK,CAACM,OAAO,CAAC