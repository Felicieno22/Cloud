{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter, useRoute } from 'vue-router';\nexport default {\n  name: 'VerifyEmail',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const route = useRoute();\n    const loading = ref(false);\n    const error = ref(null);\n    const code = ref(Array(6).fill(''));\n    const codeInputs = ref([]);\n    const resendTimer = ref(0);\n    let resendInterval = null;\n    const email = computed(() => route.query.email);\n    const isCodeComplete = computed(() => code.value.every(digit => digit !== ''));\n    const startResendTimer = () => {\n      resendTimer.value = 60;\n      resendInterval = setInterval(() => {\n        if (resendTimer.value > 0) {\n          resendTimer.value--;\n        } else {\n          clearInterval(resendInterval);\n        }\n      }, 1000);\n    };\n    const handleInput = index => {\n      const value = code.value[index];\n      if (value && index < 5) {\n        codeInputs.value[index + 1]?.focus();\n      }\n    };\n    const handleKeydown = (event, index) => {\n      if (event.key === 'Backspace' && !code.value[index] && index > 0) {\n        code.value[index - 1] = '';\n        codeInputs.value[index - 1]?.focus();\n      }\n    };\n    const handlePaste = event => {\n      event.preventDefault();\n      const pastedText = event.clipboardData.getData('text');\n      const digits = pastedText.replace(/\\D/g, '').slice(0, 6).split('');\n      code.value = [...digits, ...Array(6 - digits.length).fill('')];\n      if (digits.length > 0) {\n        codeInputs.value[Math.min(digits.length, 5)]?.focus();\n      }\n    };\n    const handleVerification = async () => {\n      if (!isCodeComplete.value) return;\n      try {\n        loading.value = true;\n        error.value = null;\n        await store.dispatch('auth/verifyEmail', {\n          email: email.value,\n          code: code.value.join('')\n        });\n        router.push('/login');\n      } catch (err) {\n        error.value = err.message || 'Erreur lors de la vérification';\n      } finally {\n        loading.value = false;\n      }\n    };\n    const resendCode = async () => {\n      try {\n        loading.value = true;\n        error.value = null;\n        await store.dispatch('auth/resendVerificationCode', {\n          email: email.value\n        });\n        startResendTimer();\n      } catch (err) {\n        error.value = err.message || 'Erreur lors du renvoi du code';\n      } finally {\n        loading.value = false;\n      }\n    };\n    onMounted(() => {\n      if (!email.value) {\n        router.push('/register');\n      }\n      startResendTimer();\n    });\n    onUnmounted(() => {\n      if (resendInterval) {\n        clearInterval(resendInterval);\n      }\n    });\n    return {\n      loading,\n      error,\n      code,\n      codeInputs,\n      resendTimer,\n      isCodeComplete,\n      handleInput,\n      handleKeydown,\n      handlePaste,\n      handleVerification,\n      resendCode\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","useStore","useRouter","useRoute","name","setup","store","router","route","loading","error","code","Array","fill","codeInputs","resendTimer","resendInterval","email","query","isCodeComplete","value","every","digit","startResendTimer","setInterval","clearInterval","handleInput","index","focus","handleKeydown","event","key","handlePaste","preventDefault","pastedText","clipboardData","getData","digits","replace","slice","split","length","Math","min","handleVerification","dispatch","join","push","err","message","resendCode"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\VerifyEmail.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-md w-full space-y-8\">\n      <div>\n        <h2 class=\"mt-6 text-center text-3xl font-extrabold text-gray-900\">\n          Vérification de votre compte\n        </h2>\n        <p class=\"mt-2 text-center text-sm text-gray-600\">\n          Veuillez entrer le code de vérification reçu par email\n        </p>\n      </div>\n\n      <form class=\"mt-8 space-y-6\" @submit.prevent=\"handleVerification\">\n        <div class=\"rounded-md shadow-sm space-y-4\">\n          <div class=\"flex justify-center\">\n            <div v-for=\"(digit, index) in 6\" :key=\"index\" class=\"mx-1\">\n              <input\n                :ref=\"el => codeInputs[index] = el\"\n                v-model=\"code[index]\"\n                type=\"text\"\n                maxlength=\"1\"\n                class=\"w-12 h-12 text-center text-2xl border-2 rounded-lg focus:border-indigo-500 focus:ring-indigo-500\"\n                @input=\"handleInput(index)\"\n                @keydown=\"handleKeydown($event, index)\"\n                @paste=\"handlePaste\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <div v-if=\"error\" class=\"rounded-md bg-red-50 p-4\">\n          <div class=\"flex\">\n            <div class=\"flex-shrink-0\">\n              <svg class=\"h-5 w-5 text-red-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z\" clip-rule=\"evenodd\" />\n              </svg>\n            </div>\n            <div class=\"ml-3\">\n              <p class=\"text-sm text-red-700\">{{ error }}</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"text-center text-sm\">\n          <p class=\"text-gray-600 mb-4\">\n            Vous n'avez pas reçu le code ?\n          </p>\n          <button\n            type=\"button\"\n            :disabled=\"resendTimer > 0\"\n            @click=\"resendCode\"\n            class=\"text-indigo-600 hover:text-indigo-500 font-medium focus:outline-none focus:underline\"\n          >\n            {{ resendTimer > 0 ? `Réessayer dans ${resendTimer}s` : 'Renvoyer le code' }}\n          </button>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading || !isCodeComplete\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-indigo-500\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Vérification...' : 'Vérifier' }}\n          </button>\n        </div>\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed, onMounted, onUnmounted } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter, useRoute } from 'vue-router'\n\nexport default {\n  name: 'VerifyEmail',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const route = useRoute()\n    const loading = ref(false)\n    const error = ref(null)\n    const code = ref(Array(6).fill(''))\n    const codeInputs = ref([])\n    const resendTimer = ref(0)\n    let resendInterval = null\n\n    const email = computed(() => route.query.email)\n    const isCodeComplete = computed(() => code.value.every(digit => digit !== ''))\n\n    const startResendTimer = () => {\n      resendTimer.value = 60\n      resendInterval = setInterval(() => {\n        if (resendTimer.value > 0) {\n          resendTimer.value--\n        } else {\n          clearInterval(resendInterval)\n        }\n      }, 1000)\n    }\n\n    const handleInput = (index) => {\n      const value = code.value[index]\n      if (value && index < 5) {\n        codeInputs.value[index + 1]?.focus()\n      }\n    }\n\n    const handleKeydown = (event, index) => {\n      if (event.key === 'Backspace' && !code.value[index] && index > 0) {\n        code.value[index - 1] = ''\n        codeInputs.value[index - 1]?.focus()\n      }\n    }\n\n    const handlePaste = (event) => {\n      event.preventDefault()\n      const pastedText = event.clipboardData.getData('text')\n      const digits = pastedText.replace(/\\D/g, '').slice(0, 6).split('')\n      code.value = [...digits, ...Array(6 - digits.length).fill('')]\n      if (digits.length > 0) {\n        codeInputs.value[Math.min(digits.length, 5)]?.focus()\n      }\n    }\n\n    const handleVerification = async () => {\n      if (!isCodeComplete.value) return\n\n      try {\n        loading.value = true\n        error.value = null\n        \n        await store.dispatch('auth/verifyEmail', {\n          email: email.value,\n          code: code.value.join('')\n        })\n\n        router.push('/login')\n      } catch (err) {\n        error.value = err.message || 'Erreur lors de la vérification'\n      } finally {\n        loading.value = false\n      }\n    }\n\n    const resendCode = async () => {\n      try {\n        loading.value = true\n        error.value = null\n        \n        await store.dispatch('auth/resendVerificationCode', { email: email.value })\n        \n        startResendTimer()\n      } catch (err) {\n        error.value = err.message || 'Erreur lors du renvoi du code'\n      } finally {\n        loading.value = false\n      }\n    }\n\n    onMounted(() => {\n      if (!email.value) {\n        router.push('/register')\n      }\n      startResendTimer()\n    })\n\n    onUnmounted(() => {\n      if (resendInterval) {\n        clearInterval(resendInterval)\n      }\n    })\n\n    return {\n      loading,\n      error,\n      code,\n      codeInputs,\n      resendTimer,\n      isCodeComplete,\n      handleInput,\n      handleKeydown,\n      handlePaste,\n      handleVerification,\n      resendCode\n    }\n  }\n}\n</script>\n"],"mappings":"AAiFA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AAC1D,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAS,EAAEC,QAAO,QAAS,YAAW;AAE/C,eAAe;EACbC,IAAI,EAAE,aAAa;EAEnBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC;IACvB,MAAMM,MAAK,GAAIL,SAAS,CAAC;IACzB,MAAMM,KAAI,GAAIL,QAAQ,CAAC;IACvB,MAAMM,OAAM,GAAIZ,GAAG,CAAC,KAAK;IACzB,MAAMa,KAAI,GAAIb,GAAG,CAAC,IAAI;IACtB,MAAMc,IAAG,GAAId,GAAG,CAACe,KAAK,CAAC,CAAC,CAAC,CAACC,IAAI,CAAC,EAAE,CAAC;IAClC,MAAMC,UAAS,GAAIjB,GAAG,CAAC,EAAE;IACzB,MAAMkB,WAAU,GAAIlB,GAAG,CAAC,CAAC;IACzB,IAAImB,cAAa,GAAI,IAAG;IAExB,MAAMC,KAAI,GAAInB,QAAQ,CAAC,MAAMU,KAAK,CAACU,KAAK,CAACD,KAAK;IAC9C,MAAME,cAAa,GAAIrB,QAAQ,CAAC,MAAMa,IAAI,CAACS,KAAK,CAACC,KAAK,CAACC,KAAI,IAAKA,KAAI,KAAM,EAAE,CAAC;IAE7E,MAAMC,gBAAe,GAAIA,CAAA,KAAM;MAC7BR,WAAW,CAACK,KAAI,GAAI,EAAC;MACrBJ,cAAa,GAAIQ,WAAW,CAAC,MAAM;QACjC,IAAIT,WAAW,CAACK,KAAI,GAAI,CAAC,EAAE;UACzBL,WAAW,CAACK,KAAK,EAAC;QACpB,OAAO;UACLK,aAAa,CAACT,cAAc;QAC9B;MACF,CAAC,EAAE,IAAI;IACT;IAEA,MAAMU,WAAU,GAAKC,KAAK,IAAK;MAC7B,MAA