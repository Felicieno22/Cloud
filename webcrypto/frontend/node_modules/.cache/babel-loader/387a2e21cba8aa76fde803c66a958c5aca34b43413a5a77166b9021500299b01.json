{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Register',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const form = ref({\n      nom: '',\n      prenom: '',\n      username: '',\n      email: '',\n      ville: '',\n      date_naissance: '',\n      password: ''\n    });\n    const verificationCode = ref('');\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification']);\n    const handleSubmit = async () => {\n      try {\n        loading.value = true;\n        // Pas besoin de reformater la date, l'API s'en charge\n        await store.dispatch('auth/register', form.value);\n      } catch (error) {\n        alert(error.message || \"Erreur lors de l'inscription\");\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handleVerification = async () => {\n      try {\n        loading.value = true;\n        await store.dispatch('auth/verifyEmail', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        });\n        router.push('/login');\n      } catch (error) {\n        alert(error.message || 'Erreur de vérification');\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      form,\n      loading,\n      verificationCode,\n      pendingVerification,\n      handleSubmit,\n      handleVerification\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRouter","name","setup","store","router","loading","form","nom","prenom","username","email","ville","date_naissance","password","verificationCode","pendingVerification","getters","handleSubmit","value","dispatch","error","alert","message","handleVerification","code","push"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\Register.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-md w-full space-y-8\">\n      <div>\n        <h2 class=\"mt-6 text-center text-3xl font-extrabold text-gray-900\">\n          Créer un compte\n        </h2>\n      </div>\n\n      <!-- Formulaire d'inscription -->\n      <form v-if=\"!pendingVerification\" class=\"mt-8 space-y-6\" @submit.prevent=\"handleSubmit\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"nom\" class=\"sr-only\">Nom</label>\n            <input\n              id=\"nom\"\n              v-model=\"form.nom\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Nom\"\n            />\n          </div>\n          <div>\n            <label for=\"prenom\" class=\"sr-only\">Prénom</label>\n            <input\n              id=\"prenom\"\n              v-model=\"form.prenom\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Prénom\"\n            />\n          </div>\n          <div>\n            <label for=\"username\" class=\"sr-only\">Nom d'utilisateur</label>\n            <input\n              id=\"username\"\n              v-model=\"form.username\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Nom d'utilisateur\"\n            />\n          </div>\n          <div>\n            <label for=\"email\" class=\"sr-only\">Email</label>\n            <input\n              id=\"email\"\n              v-model=\"form.email\"\n              type=\"email\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Email\"\n            />\n          </div>\n          <div>\n            <label for=\"ville\" class=\"sr-only\">Ville</label>\n            <input\n              id=\"ville\"\n              v-model=\"form.ville\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Ville\"\n            />\n          </div>\n          <div>\n            <label for=\"date_naissance\" class=\"sr-only\">Date de naissance</label>\n            <input\n              id=\"date_naissance\"\n              v-model=\"form.date_naissance\"\n              type=\"date\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n            />\n          </div>\n          <div>\n            <label for=\"password\" class=\"sr-only\">Mot de passe</label>\n            <input\n              id=\"password\"\n              v-model=\"form.password\"\n              type=\"password\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Mot de passe\"\n            />\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path d=\"M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6z\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-white\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Inscription...' : \"S'inscrire\" }}\n          </button>\n        </div>\n\n        <div class=\"text-sm text-center\">\n          <router-link to=\"/login\" class=\"font-medium text-indigo-600 hover:text-indigo-500\">\n            Déjà un compte ? Se connecter\n          </router-link>\n        </div>\n      </form>\n\n      <!-- Formulaire de vérification -->\n      <form v-else class=\"mt-8 space-y-6\" @submit.prevent=\"handleVerification\">\n        <div class=\"rounded-md bg-blue-50 p-4 mb-4\">\n          <div class=\"flex\">\n            <div class=\"flex-shrink-0\">\n              <svg class=\"h-5 w-5 text-blue-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z\" clip-rule=\"evenodd\" />\n              </svg>\n            </div>\n            <div class=\"ml-3\">\n              <p class=\"text-sm text-blue-700\">\n                {{ pendingVerification.message }}\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <div>\n          <label for=\"verificationCode\" class=\"sr-only\">Code de vérification</label>\n          <input\n            id=\"verificationCode\"\n            v-model=\"verificationCode\"\n            type=\"text\"\n            required\n            class=\"appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n            placeholder=\"Entrez le code de vérification\"\n          />\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            {{ loading ? 'Vérification...' : 'Vérifier' }}\n          </button>\n        </div>\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  name: 'Register',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const loading = ref(false)\n    const form = ref({\n      nom: '',\n      prenom: '',\n      username: '',\n      email: '',\n      ville: '',\n      date_naissance: '',\n      password: ''\n    })\n    const verificationCode = ref('')\n\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification'])\n\n    const handleSubmit = async () => {\n      try {\n        loading.value = true\n        // Pas besoin de reformater la date, l'API s'en charge\n        await store.dispatch('auth/register', form.value)\n      } catch (error) {\n        alert(error.message || \"Erreur lors de l'inscription\")\n      } finally {\n        loading.value = false\n      }\n    }\n\n    const handleVerification = async () => {\n      try {\n        loading.value = true\n        await store.dispatch('auth/verifyEmail', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        })\n        router.push('/login')\n      } catch (error) {\n        alert(error.message || 'Erreur de vérification')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    return {\n      form,\n      loading,\n      verificationCode,\n      pendingVerification,\n      handleSubmit,\n      handleVerification\n    }\n  }\n}\n</script>\n"],"mappings":"AAgKA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,UAAU;EAEhBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,OAAM,GAAIR,GAAG,CAAC,KAAK;IACzB,MAAMS,IAAG,GAAIT,GAAG,CAAC;MACfU,GAAG,EAAE,EAAE;MACPC,MAAM,EAAE,EAAE;MACVC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE,EAAE;MACTC,cAAc,EAAE,EAAE;MAClBC,QAAQ,EAAE;IACZ,CAAC;IACD,MAAMC,gBAAe,GAAIjB,GAAG,CAAC,EAAE;IAE/B,MAAMkB,mBAAkB,GAAIjB,QAAQ,CAAC,MAAMK,KAAK,CAACa,OAAO,CAAC,0BAA0B,CAAC;IAEpF,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACFZ,OAAO,CAACa,KAAI,GAAI,IAAG;QACnB;QACA,MAAMf,KA