{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nexport default {\n  name: 'Account',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const error = ref('');\n    const successMessage = ref('');\n    const showPasswordModal = ref(false);\n    const password = ref('');\n    const currentEditingField = ref(null);\n    const isAuthenticated = ref(false);\n    const user = computed(() => store.getters['auth/user']);\n    const form = ref({\n      username: '',\n      nom: '',\n      prenom: '',\n      date_naissance: '',\n      ville: '',\n      email: ''\n    });\n    const editingField = ref({\n      username: false,\n      nom: false,\n      prenom: false,\n      date_naissance: false,\n      ville: false,\n      email: false\n    });\n    const formFields = {\n      username: {\n        label: 'Nom d\\'utilisateur',\n        type: 'text'\n      },\n      email: {\n        label: 'Email',\n        type: 'email'\n      },\n      nom: {\n        label: 'Nom',\n        type: 'text'\n      },\n      prenom: {\n        label: 'Prénom',\n        type: 'text'\n      },\n      date_naissance: {\n        label: 'Date de naissance',\n        type: 'date'\n      },\n      ville: {\n        label: 'Ville',\n        type: 'text'\n      }\n    };\n    const initForm = () => {\n      if (user.value) {\n        Object.keys(form.value).forEach(key => {\n          form.value[key] = user.value[key] || '';\n        });\n      }\n    };\n    const startEditing = field => {\n      editingField.value[field] = true;\n    };\n    const cancelEditing = field => {\n      editingField.value[field] = false;\n      form.value[field] = user.value?.[field] || '';\n    };\n    const promptPasswordAndSave = field => {\n      currentEditingField.value = field;\n      showPasswordModal.value = true;\n      password.value = '';\n      setTimeout(() => {\n        document.querySelector('input[type=\"password\"]')?.focus();\n      }, 100);\n    };\n    const cancelPasswordModal = () => {\n      showPasswordModal.value = false;\n      password.value = '';\n      currentEditingField.value = null;\n    };\n    const confirmPasswordAndSave = async () => {\n      if (!password.value) {\n        error.value = 'Veuillez entrer votre mot de passe';\n        return;\n      }\n      try {\n        loading.value = true;\n        error.value = '';\n        successMessage.value = '';\n        const field = currentEditingField.value;\n        const value = form.value[field];\n        if (!isAuthenticated.value) {\n          throw new Error('Non authentifié');\n        }\n        socket.emit('updateUserField', {\n          field,\n          value,\n          password: password.value\n        });\n        showPasswordModal.value = false;\n        password.value = '';\n        currentEditingField.value = null;\n      } catch (err) {\n        error.value = err.message || 'Une erreur est survenue';\n      } finally {\n        loading.value = false;\n      }\n    };\n    const initializeSocket = () => {\n      // Déconnexion si déjà connecté\n      if (socket.connected) {\n        socket.disconnect();\n      }\n\n      // Écouter l'événement de connexion\n      socket.on('connect', () => {\n        console.log('Socket connecté, authentification...');\n      });\n\n      // Écouter l'événement d'authentification réussie\n      socket.on('authenticated', () => {\n        console.log('Socket authentifié, récupération des informations...');\n        isAuthenticated.value = true;\n        socket.emit('getUserInfo');\n      });\n\n      // Écouter les mises à jour des informations utilisateur\n      socket.on('userInfo', data => {\n        console.log('Informations utilisateur reçues:', data);\n        if (data && typeof data === 'object') {\n          // Mettre à jour le store avec les nouvelles informations\n          store.dispatch('auth/updateUser', data);\n          // Mettre à jour le formulaire\n          Object.keys(form.value).forEach(key => {\n            if (data[key] !== undefined) {\n              form.value[key] = data[key];\n            }\n          });\n        }\n      });\n\n      // Écouter les succès de mise à jour\n      socket.on('userUpdateSuccess', data => {\n        console.log('Mise à jour réussie:', data);\n        if (data && typeof data === 'object') {\n          // Mettre à jour le store et le formulaire\n          store.dispatch('auth/updateUser', data);\n          Object.keys(form.value).forEach(key => {\n            if (data[key] !== undefined) {\n              form.value[key] = data[key];\n            }\n          });\n\n          // Réinitialiser l'état d'édition\n          Object.keys(editingField.value).forEach(key => {\n            editingField.value[key] = false;\n          });\n\n          // Afficher le message de succès\n          successMessage.value = 'Informations mises à jour avec succès';\n          setTimeout(() => {\n            successMessage.value = '';\n          }, 3000);\n        }\n      });\n\n      // Écouter les erreurs\n      socket.on('error', error => {\n        console.error('Erreur socket:', error);\n        error.value = error.message || 'Une erreur est survenue';\n        if (error.message?.includes('authentification')) {\n          isAuthenticated.value = false;\n          router.push('/login');\n        }\n      });\n\n      // Se connecter au socket\n      socket.connect();\n    };\n    onMounted(() => {\n      if (!user.value) {\n        router.push('/login');\n        return;\n      }\n\n      // Initialiser le formulaire avec les données existantes\n      initForm();\n\n      // Initialiser la connexion socket\n      initializeSocket();\n    });\n    onUnmounted(() => {\n      // Nettoyage des écouteurs d'événements\n      const events = ['connect', 'disconnect', 'authenticated', 'userInfo', 'userUpdateSuccess', 'error'];\n      events.forEach(event => {\n        socket.off(event);\n      });\n\n      // Déconnexion du socket\n      if (socket.connected) {\n        socket.disconnect();\n      }\n    });\n    return {\n      loading,\n      error,\n      successMessage,\n      form,\n      editingField,\n      formFields,\n      showPasswordModal,\n      password,\n      startEditing,\n      cancelEditing,\n      promptPasswordAndSave,\n      cancelPasswordModal,\n      confirmPasswordAndSave\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","useStore","useRouter","socket","name","setup","store","router","loading","error","successMessage","showPasswordModal","password","currentEditingField","isAuthenticated","user","getters","form","username","nom","prenom","date_naissance","ville","email","editingField","formFields","label","type","initForm","value","Object","keys","forEach","key","startEditing","field","cancelEditing","promptPasswordAndSave","setTimeout","document","querySelector","focus","cancelPasswordModal","confirmPasswordAndSave","Error","emit","err","message","initializeSocket","connected","disconnect","on","console","log","data","dispatch","undefined","includes","push","connect","events","event","off"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Account.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12\">\n    <div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"text-center mb-12\">\n        <h1 class=\"text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-blue-500\">\n          Mon Compte\n        </h1>\n        <p class=\"mt-2 text-gray-600\">Gérez vos informations personnelles</p>\n      </div>\n\n      <div class=\"bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-gray-100 overflow-hidden transition-all duration-300 hover:shadow-2xl\">\n        <div class=\"p-8 space-y-8\">\n          <!-- Avatar et informations principales -->\n          <div class=\"flex items-center space-x-6 pb-6 border-b border-gray-100\">\n            <div class=\"w-20 h-20 rounded-full bg-gradient-to-r from-indigo-500 to-blue-500 flex items-center justify-center text-white text-2xl font-bold\">\n              {{ form.username?.[0]?.toUpperCase() || 'U' }}\n            </div>\n            <div>\n              <h2 class=\"text-2xl font-bold text-gray-900\">{{ form.username }}</h2>\n              <p class=\"text-gray-500\">{{ form.email }}</p>\n            </div>\n          </div>\n\n          <!-- Champs du formulaire -->\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            <div v-for=\"(field, key) in formFields\" :key=\"key\" \n                 class=\"space-y-2 transition-all duration-300 transform hover:scale-[1.02]\">\n              <div class=\"flex justify-between items-center\">\n                <label :for=\"key\" class=\"block text-sm font-semibold text-gray-700\">\n                  {{ field.label }}\n                </label>\n                <button\n                  v-if=\"!editingField[key]\"\n                  @click=\"startEditing(key)\"\n                  class=\"text-indigo-600 hover:text-indigo-800 text-sm font-medium flex items-center space-x-1 hover:bg-indigo-50 px-2 py-1 rounded-md transition-all duration-200\"\n                >\n                  <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z\" />\n                  </svg>\n                  <span>Modifier</span>\n                </button>\n              </div>\n              \n              <div class=\"relative\">\n                <input\n                  :id=\"key\"\n                  v-model=\"form[key]\"\n                  :type=\"field.type\"\n                  :disabled=\"!editingField[key]\"\n                  :class=\"[\n                    'block w-full rounded-lg border shadow-sm transition-all duration-200 px-4 py-3',\n                    editingField[key] \n                      ? 'bg-white border-indigo-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200' \n                      : 'bg-gray-50 border-gray-200'\n                  ]\"\n                />\n                \n                <div v-if=\"editingField[key]\" \n                     class=\"absolute right-0 top-0 h-full flex items-center pr-3 space-x-2\">\n                  <button\n                    @click=\"promptPasswordAndSave(key)\"\n                    class=\"text-green-600 hover:text-green-800 p-1 hover:bg-green-50 rounded-full transition-all duration-200\"\n                    :disabled=\"loading\"\n                  >\n                    <svg class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </button>\n                  <button\n                    @click=\"cancelEditing(key)\"\n                    class=\"text-red-600 hover:text-red-800 p-1 hover:bg-red-50 rounded-full transition-all duration-200\"\n                  >\n                    <svg class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\" />\n                    </svg>\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Message d'erreur -->\n          <div v-if=\"error\" \n               class=\"mt-4 p-4 bg-red-50 border border-red-200 rounded-lg flex items-center space-x-2 text-red-700\">\n            <svg class=\"h-5 w-5 text-red-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n            </svg>\n            <span class=\"text-sm\">{{ error }}</span>\n          </div>\n\n          <!-- Message de succès -->\n          <div v-if=\"successMessage\" \n               class=\"mt-4 p-4 bg-green-50 border border-green-200 rounded-lg flex items-center space-x-2 text-green-700\">\n            <svg class=\"h-5 w-5 text-green-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\" />\n            </svg>\n            <span class=\"text-sm\">{{ successMessage }}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Modal de mot de passe -->\n    <div v-if=\"showPasswordModal\" \n         class=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50 animate-fadeIn\">\n      <div class=\"bg-white rounded-xl p-6 w-full max-w-md transform transition-all duration-300 scale-100 animate-slideIn\">\n        <h3 class=\"text-lg font-bold text-gray-900 mb-4\">Confirmation requise</h3>\n        <p class=\"text-sm text-gray-600 mb-4\">\n          Veuillez entrer votre mot de passe pour confirmer la modification\n        </p>\n        <input \n          type=\"password\" \n          v-model=\"password\"\n          class=\"w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 mb-4\"\n          placeholder=\"Votre mot de passe\"\n          @keyup.enter=\"confirmPasswordAndSave\"\n        />\n        <div class=\"flex justify-end space-x-3\">\n          <button\n            @click=\"cancelPasswordModal\"\n            class=\"px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors duration-200\"\n          >\n            Annuler\n          </button>\n          <button\n            @click=\"confirmPasswordAndSave\"\n            class=\"px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors duration-200\"\n            :disabled=\"loading\"\n          >\n            {{ loading ? 'Modification...' : 'Confirmer' }}\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed, onMounted, onUnmounted } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\nimport { socket } from '@/socket'\n\nexport default {\n  name: 'Account',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const loading = ref(false)\n    const error = ref('')\n    const successMessage = ref('')\n    const showPasswordModal = ref(false)\n    const password = ref('')\n    const currentEditingField = ref(null)\n    const isAuthenticated = ref(false)\n    \n    const user = computed(() => store.getters['auth/user'])\n    \n    const form = ref({\n      username: '',\n      nom: '',\n      prenom: '',\n      date_naissance: '',\n      ville: '',\n      email: ''\n    })\n\n    const editingField = ref({\n      username: false,\n      nom: false,\n      prenom: false,\n      date_naissance: false,\n      ville: false,\n      email: false\n    })\n\n    const formFields = {\n      username: { label: 'Nom d\\'utilisateur', type: 'text' },\n      email: { label: 'Email', type: 'email' },\n      nom: { label: 'Nom', type: 'text' },\n      prenom: { label: 'Prénom', type: 'text' },\n      date_naissance: { label: 'Date de naissance', type: 'date' },\n      ville: { label: 'Ville', type: 'text' }\n    }\n\n    const initForm = () => {\n      if (user.value) {\n        Object.keys(form.value).forEach(key => {\n          form.value[key] = user.value[key] || ''\n        })\n      }\n    }\n\n    const startEditing = (field) => {\n      editingField.value[field] = true\n    }\n\n    const cancelEditing = (field) => {\n      editingField.value[field] = false\n      form.value[field] = user.value?.[field] || ''\n    }\n\n    const promptPasswordAndSave = (field) => {\n      currentEditingField.value = field\n      showPasswordModal.value = true\n      password.value = ''\n      setTimeout(() => {\n        document.querySelector('input[type=\"password\"]')?.focus()\n      }, 100)\n    }\n\n    const cancelPasswordModal = () => {\n      showPasswordModal.value = false\n      password.value = ''\n      currentEditingField.value = null\n    }\n\n    const confirmPasswordAndSave = async () => {\n      if (!password.value) {\n        error.value = 'Veuillez entrer votre mot de passe'\n        return\n      }\n\n      try {\n        loading.value = true\n        error.value = ''\n        successMessage.value = ''\n\n        const field = currentEditingField.value\n        const value = form.value[field]\n\n        if (!isAuthenticated.value) {\n          throw new Error('Non authentifié')\n        }\n\n        socket.emit('updateUserField', {\n          field,\n          value,\n          password: password.value\n        })\n\n        showPasswordModal.value = false\n        password.value = ''\n        currentEditingField.value = null\n      } catch (err) {\n        error.value = err.message || 'Une erreur est survenue'\n      } finally {\n        loading.value = false\n      }\n    }\n\n    const initializeSocket = () => {\n      // Déconnexion si déjà connecté\n      if (socket.connected) {\n        socket.disconnect();\n      }\n\n      // Écouter l'événement de connexion\n      socket.on('connect', () => {\n        console.log('Socket connecté, authentification...');\n      });\n\n      // Écouter l'événement d'authentification réussie\n      socket.on('authenticated', () => {\n        console.log('Socket authentifié, récupération des informations...');\n        isAuthenticated.value = true;\n        socket.emit('getUserInfo');\n      });\n\n      // Écouter les mises à jour des informations utilisateur\n      socket.on('userInfo', (data) => {\n        console.log('Informations utilisateur reçues:', data);\n        if (data && typeof data === 'object') {\n          // Mettre à jour le store avec les nouvelles informations\n          store.dispatch('auth/updateUser', data);\n          // Mettre à jour le formulaire\n          Object.keys(form.value).forEach(key => {\n            if (data[key] !== undefined) {\n              form.value[key] = data[key];\n            }\n          });\n        }\n      });\n\n      // Écouter les succès de mise à jour\n      socket.on('userUpdateSuccess', (data) => {\n        console.log('Mise à jour réussie:', data);\n        if (data && typeof data === 'object') {\n          // Mettre à jour le store et le formulaire\n          store.dispatch('auth/updateUser', data);\n          Object.keys(form.value).forEach(key => {\n            if (data[key] !== undefined) {\n              form.value[key] = data[key];\n            }\n          });\n          \n          // Réinitialiser l'état d'édition\n          Object.keys(editingField.value).forEach(key => {\n            editingField.value[key] = false;\n          });\n          \n          // Afficher le message de succès\n          successMessage.value = 'Informations mises à jour avec succès';\n          setTimeout(() => {\n            successMessage.value = '';\n          }, 3000);\n        }\n      });\n\n      // Écouter les erreurs\n      socket.on('error', (error) => {\n        console.error('Erreur socket:', error);\n        error.value = error.message || 'Une erreur est survenue';\n        if (error.message?.includes('authentification')) {\n          isAuthenticated.value = false;\n          router.push('/login');\n        }\n      });\n\n      // Se connecter au socket\n      socket.connect();\n    };\n\n    onMounted(() => {\n      if (!user.value) {\n        router.push('/login');\n        return;\n      }\n\n      // Initialiser le formulaire avec les données existantes\n      initForm();\n      \n      // Initialiser la connexion socket\n      initializeSocket();\n    });\n\n    onUnmounted(() => {\n      // Nettoyage des écouteurs d'événements\n      const events = [\n        'connect',\n        'disconnect',\n        'authenticated',\n        'userInfo',\n        'userUpdateSuccess',\n        'error'\n      ];\n      \n      events.forEach(event => {\n        socket.off(event);\n      });\n\n      // Déconnexion du socket\n      if (socket.connected) {\n        socket.disconnect();\n      }\n    });\n\n    return {\n      loading,\n      error,\n      successMessage,\n      form,\n      editingField,\n      formFields,\n      showPasswordModal,\n      password,\n      startEditing,\n      cancelEditing,\n      promptPasswordAndSave,\n      cancelPasswordModal,\n      confirmPasswordAndSave\n    }\n  }\n}\n</script>\n\n<style scoped>\n.min-h-screen {\n  background-image: \n    radial-gradient(circle at 0% 0%, rgba(79, 70, 229, 0.1) 0%, transparent 50%),\n    radial-gradient(circle at 100% 100%, rgba(99, 102, 241, 0.1) 0%, transparent 50%);\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes slideIn {\n  from {\n    opacity: 0;\n    transform: translateY(-20px) scale(0.95);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n.animate-fadeIn {\n  animation: fadeIn 0.3s ease-out;\n}\n\n.animate-slideIn {\n  animation: slideIn 0.3s ease-out;\n}\n\n.bg-white {\n  backdrop-filter: blur(10px);\n  box-shadow: \n    0 10px 15px -3px rgba(0, 0, 0, 0.1),\n    0 4px 6px -2px rgba(0, 0, 0, 0.05),\n    0 0 0 1px rgba(0, 0, 0, 0.05);\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\ninput {\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\ninput:hover:not(:disabled) {\n  border-color: #818cf8;\n}\n\ninput:focus:not(:disabled) {\n  border-color: #6366f1;\n  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);\n  transform: translateY(-1px);\n}\n\nbutton {\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  position: relative;\n  overflow: hidden;\n}\n\nbutton:hover:not(:disabled) {\n  transform: translateY(-1px);\n}\n\nbutton:active:not(:disabled) {\n  transform: translateY(0);\n}\n\nbutton::after {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 0;\n  height: 0;\n  background: rgba(255, 255, 255, 0.2);\n  border-radius: 50%;\n  transform: translate(-50%, -50%);\n  transition: width 0.6s ease, height 0.6s ease;\n}\n\nbutton:active::after {\n  width: 200px;\n  height: 200px;\n  opacity: 0;\n}\n\n.text-transparent.bg-clip-text {\n  -webkit-background-clip: text;\n  background-clip: text;\n}\n\n/* Dark mode support */\n@media (prefers-color-scheme: dark) {\n  .min-h-screen {\n    background-color: #1a1b23;\n  }\n  \n  .bg-white {\n    background-color: rgba(30, 31, 42, 0.95);\n  }\n  \n  input {\n    background-color: rgba(30, 31, 42, 0.9);\n    color: #e5e7eb;\n  }\n}\n</style> "],"mappings":"AA0IA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AAC1D,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,MAAK,QAAS,UAAS;AAEhC,eAAe;EACbC,IAAI,EAAE,SAAS;EAEfC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC;IACvB,MAAMM,MAAK,GAAIL,SAAS,CAAC;IACzB,MAAMM,OAAM,GAAIX,GAAG,CAAC,KAAK;IACzB,MAAMY,KAAI,GAAIZ,GAAG,CAAC,EAAE;IACpB,MAAMa,cAAa,GAAIb,GAAG,CAAC,EAAE;IAC7B,MAAMc,iBAAgB,GAAId,GAAG,CAAC,KAAK;IACnC,MAAMe,QAAO,GAAIf,GAAG,CAAC,EAAE;IACvB,MAAMgB,mBAAkB,GAAIhB,GAAG,CAAC,IAAI;IACpC,MAAMiB,eAAc,GAAIjB,GAAG,CAAC,KAAK;IAEjC,MAAMkB,IAAG,GAAIjB,QAAQ,CAAC,MAAMQ,KAAK,CAACU,OAAO,CAAC,WAAW,CAAC;IAEtD,MAAMC,IAAG,GAAIpB,GAAG,CAAC;MACfqB,QAAQ,EAAE,EAAE;MACZC,GAAG,EAAE,EAAE;MACPC,MAAM,EAAE,EAAE;MACVC,cAAc,EAAE,EAAE;MAClBC,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE;IACT,CAAC;IAED,MAAMC,YAAW,GAAI3B,GAAG,CAAC;MACvBqB,QAAQ,E