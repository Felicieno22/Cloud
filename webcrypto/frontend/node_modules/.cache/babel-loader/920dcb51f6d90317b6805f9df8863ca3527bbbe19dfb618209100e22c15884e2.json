@/socket';\nimport {\n  Chart as ChartJS,\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  Title,\n  Tooltip,\n  Legend\n} from 'chart.js';\nimport { Line } from 'vue-chartjs';\n\nChartJS.register(\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  Title,\n  Tooltip,\n  Legend\n);\n\nexport default {\n  name: 'CryptoDetail',\n  components: { Line },\n\n  setup() {\n    const route = useRoute();\n    const cryptoSymbol = route.params.symbol;\n    const cryptoData = ref(null);\n    const priceHistory = ref([]);\n\n    // Configuration du graphique\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      scales: {\n        y: {\n          beginAtZero: false,\n          ticks: {\n            callback: value => formatPrice(value)\n          }\n        }\n      },\n      plugins: {\n        legend: {\n          display: false\n        },\n        tooltip: {\n          callbacks: {\n            label: (context) => formatPrice(context.raw)\n          }\n        }\n      }\n    };\n\n    const chartData = computed(() => ({\n      labels: priceHistory.value.map(item => \n        new Date(item.timestamp).toLocaleTimeString()\n      ),\n      datasets: [{\n        label: cryptoSymbol,\n        data: priceHistory.value.map(item => item.price),\n        borderColor: '#4F46E5',\n        tension: 0.1\n      }]\n    }));\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const formatPriceChange = (change) => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion des mises à jour\n    socket.on('priceUpdate', (data) => {\n      const crypto = data.find(c => c.symbol === cryptoSymbol);\n      if (crypto) {\n        cryptoData.value = crypto;\n        priceHistory.value.push({\n          price: crypto.price,\n          timestamp: new Date()\n        });\n\n        // Garder seulement les 30 derniers points\n        if (priceHistory.value.length > 30) {\n          priceHistory.value.shift();\n        }\n      }\n    });\n\n    onMounted(() => {\n      socket.connect();\n    });\n\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n\n    return {\n      cryptoSymbol,\n      cryptoData,\n      chartData,\n      chartOptions,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass\n    };\n  }\n};\n</script>\n"],"mappings":";;EACOA,KAAK,EAAC;AAA6B;;EACjCA,KAAK,EAAC;AAAwB;;EAI7BA,KAAK,EAAC;AAAkC;;EAGzCA,KAAK,EAAC;AAAmC;;EACvCA,KAAK,EAAC;AAAwC;;EAE3CA,KAAK,EAAC;AAAoB;;EAC3BA,KAAK,EAAC;AAAe;;EAOvBA,KAAK,EAAC;AAAM;;;uBAnBrBC,mBAAA,CAuBM,OAvBNC,UAuBM,GAtBJC,mBAAA,CAKM,OALNC,UAKM,GAJJD,mBAAA,CAES;IAFAE,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEC,IAAA,CAAAC,OAAO,CAACC,IAAI;IAAgBV,KAAK,EAAC;KAA6C,YAE/F,GACAG,mBAAA,CAAoE,MAApEQ,UAAoE,EAAAC,gBAAA,CAApBC,MAAA,CAAAC,YAAY,iB,GAG9DX,mBAAA,CAcM,OAdNY,UAcM,GAbJZ,mBAAA,CAQM,OARNa,UAQM,GAPJb,mBAAA,CAGM,cAFJA,mBAAA,CAA0D,MAA1Dc,UAA0D,EAAAL,gBAAA,CAAxBC,MAAA,CAAAK,UAAU,EAAEC,IAAI,kBAClDhB,mBAAA,CAA8E,KAA9EiB,UAA8E,EAArD,eAAa,GAAAR,gBAAA,CAAGC,MAAA,CAAAQ,WAAW,CAACR,MAAA,CAAAK,UAAU,EAAEI,KAAK,kB,GAExEnB,mBAAA,CAEM;IAFAH,KAAK,EAfnBuB,eAAA,EAeqBV,MAAA,CAAAW,mBAAmB,IAAU,uBAAuB;sBAC5DX,MAAA,CAAAY,iBAAiB,CAACZ,MAAA,CAAAK,UAAU,EAAEQ,WAAW,KAAI,IAClD,uB,GAGFvB,mBAAA,CAEM,OAFNwB,UAEM,GADQd,MAAA,CAAAe,SAAS,I,cAArBC,YAAA,CAAmEC,eAAA;IArB3EC,GAAA;IAqBgCC,IAAI,EAAEnB,MAAA,CAAAe,SAAS;IAAGK,OA