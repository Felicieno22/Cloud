{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted } from 'vue';\nimport { socket } from '@/socket';\nexport default {\n  name: 'NotificationsDropdown',\n  setup() {\n    const notifications = ref([]);\n    const isOpen = ref(false);\n    const isAuthenticated = ref(false);\n    const unreadCount = computed(() => {\n      return notifications.value.filter(n => !n.read).length;\n    });\n    const toggleDropdown = () => {\n      isOpen.value = !isOpen.value;\n    };\n    const formatDate = date => {\n      return new Date(date).toLocaleString('fr-FR', {\n        day: 'numeric',\n        month: 'short',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    };\n    const markAsRead = notificationId => {\n      if (isAuthenticated.value) {\n        socket.emit('markNotificationAsRead', notificationId);\n      }\n    };\n    const markAllAsRead = () => {\n      if (isAuthenticated.value) {\n        socket.emit('markAllNotificationsAsRead');\n      }\n    };\n\n    // Fermer le dropdown quand on clique en dehors\n    const handleClickOutside = event => {\n      if (isOpen.value && !event.target.closest('.relative')) {\n        isOpen.value = false;\n      }\n    };\n    onMounted(() => {\n      document.addEventListener('click', handleClickOutside);\n      socket.on('authenticated', () => {\n        console.log('Socket authentifié, demande des notifications');\n        isAuthenticated.value = true;\n      });\n      socket.on('notificationsUpdate', data => {\n        notifications.value = data;\n      });\n      socket.on('error', error => {\n        console.error('Erreur socket:', error);\n        if (error.message === 'Non authentifié') {\n          isAuthenticated.value = false;\n        }\n      });\n    });\n    onUnmounted(() => {\n      document.removeEventListener('click', handleClickOutside);\n      socket.off('notificationsUpdate');\n      socket.off('authenticated');\n      socket.off('error');\n    });\n    return {\n      notifications,\n      isOpen,\n      unreadCount,\n      toggleDropdown,\n      formatDate,\n      markAsRead,\n      markAllAsRead\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","socket","name","setup","notifications","isOpen","isAuthenticated","unreadCount","value","filter","n","read","length","toggleDropdown","formatDate","date","Date","toLocaleString","day","month","hour","minute","markAsRead","notificationId","emit","markAllAsRead","handleClickOutside","event","target","closest","document","addEventListener","on","console","log","data","error","message","removeEventListener","off"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\components\\NotificationsDropdown.vue"],"sourcesContent":["<template>\r\n  <div class=\"relative\">\r\n    <!-- Bouton notifications -->\r\n    <button \r\n      @click=\"toggleDropdown\"\r\n      class=\"relative p-2 text-gray-600 hover:text-indigo-600 rounded-full hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500\"\r\n    >\r\n      <!-- Icône cloche -->\r\n      <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\r\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9\" />\r\n      </svg>\r\n      \r\n      <!-- Badge nombre de notifications -->\r\n      <span \r\n        v-if=\"unreadCount > 0\"\r\n        class=\"absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center\"\r\n      >\r\n        {{ unreadCount }}\r\n      </span>\r\n    </button>\r\n\r\n    <!-- Dropdown notifications -->\r\n    <div \r\n      v-if=\"isOpen\"\r\n      class=\"absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 z-50\"\r\n    >\r\n      <div class=\"p-4 border-b border-gray-100\">\r\n        <div class=\"flex items-center justify-between\">\r\n          <h3 class=\"text-lg font-semibold text-gray-900\">Notifications</h3>\r\n          <button \r\n            v-if=\"unreadCount > 0\"\r\n            @click=\"markAllAsRead\"\r\n            class=\"text-sm text-indigo-600 hover:text-indigo-800\"\r\n          >\r\n            Tout marquer comme lu\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"max-h-96 overflow-y-auto\">\r\n        <div v-if=\"notifications.length === 0\" class=\"p-4 text-center text-gray-500\">\r\n          Aucune notification\r\n        </div>\r\n        <div \r\n          v-for=\"notification in notifications\" \r\n          :key=\"notification.id\"\r\n          class=\"p-4 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-b-0\"\r\n          :class=\"{ 'bg-indigo-50': !notification.read }\"\r\n          @click=\"markAsRead(notification.id)\"\r\n        >\r\n          <div class=\"flex items-start\">\r\n            <div class=\"flex-shrink-0\">\r\n              <div \r\n                class=\"h-8 w-8 rounded-full bg-indigo-100 flex items-center justify-center\"\r\n                :class=\"{ 'bg-indigo-500': !notification.read }\"\r\n              >\r\n                <svg \r\n                  xmlns=\"http://www.w3.org/2000/svg\" \r\n                  class=\"h-4 w-4\" \r\n                  :class=\"notification.read ? 'text-indigo-600' : 'text-white'\"\r\n                  fill=\"none\" \r\n                  viewBox=\"0 0 24 24\" \r\n                  stroke=\"currentColor\"\r\n                >\r\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\r\n                </svg>\r\n              </div>\r\n            </div>\r\n            <div class=\"ml-3 flex-1\">\r\n              <p class=\"text-sm font-medium text-gray-900\">{{ notification.title }}</p>\r\n              <p class=\"mt-1 text-sm text-gray-500\">{{ notification.message }}</p>\r\n              <p class=\"mt-1 text-xs text-gray-400\">\r\n                {{ formatDate(notification.created_at) }}\r\n              </p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, onUnmounted } from 'vue';\r\nimport { socket } from '@/socket';\r\n\r\nexport default {\r\n  name: 'NotificationsDropdown',\r\n\r\n  setup() {\r\n    const notifications = ref([]);\r\n    const isOpen = ref(false);\r\n    const isAuthenticated = ref(false);\r\n\r\n    const unreadCount = computed(() => {\r\n      return notifications.value.filter(n => !n.read).length;\r\n    });\r\n\r\n    const toggleDropdown = () => {\r\n      isOpen.value = !isOpen.value;\r\n    };\r\n\r\n    const formatDate = (date) => {\r\n      return new Date(date).toLocaleString('fr-FR', {\r\n        day: 'numeric',\r\n        month: 'short',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      });\r\n    };\r\n\r\n    const markAsRead = (notificationId) => {\r\n      if (isAuthenticated.value) {\r\n        socket.emit('markNotificationAsRead', notificationId);\r\n      }\r\n    };\r\n\r\n    const markAllAsRead = () => {\r\n      if (isAuthenticated.value) {\r\n        socket.emit('markAllNotificationsAsRead');\r\n      }\r\n    };\r\n\r\n    // Fermer le dropdown quand on clique en dehors\r\n    const handleClickOutside = (event) => {\r\n      if (isOpen.value && !event.target.closest('.relative')) {\r\n        isOpen.value = false;\r\n      }\r\n    };\r\n\r\n    onMounted(() => {\r\n      document.addEventListener('click', handleClickOutside);\r\n\r\n      socket.on('authenticated', () => {\r\n        console.log('Socket authentifié, demande des notifications');\r\n        isAuthenticated.value = true;\r\n      });\r\n\r\n      socket.on('notificationsUpdate', (data) => {\r\n        notifications.value = data;\r\n      });\r\n\r\n      socket.on('error', (error) => {\r\n        console.error('Erreur socket:', error);\r\n        if (error.message === 'Non authentifié') {\r\n          isAuthenticated.value = false;\r\n        }\r\n      });\r\n    });\r\n\r\n    onUnmounted(() => {\r\n      document.removeEventListener('click', handleClickOutside);\r\n      socket.off('notificationsUpdate');\r\n      socket.off('authenticated');\r\n      socket.off('error');\r\n    });\r\n\r\n    return {\r\n      notifications,\r\n      isOpen,\r\n      unreadCount,\r\n      toggleDropdown,\r\n      formatDate,\r\n      markAsRead,\r\n      markAllAsRead\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Animation du dropdown */\r\n.absolute {\r\n  transition: all 0.2s ease-out;\r\n}\r\n\r\n/* Scrollbar personnalisée */\r\n.max-h-96 {\r\n  scrollbar-width: thin;\r\n  scrollbar-color: #cbd5e0 #f7fafc;\r\n}\r\n\r\n.max-h-96::-webkit-scrollbar {\r\n  width: 6px;\r\n}\r\n\r\n.max-h-96::-webkit-scrollbar-track {\r\n  background: #f7fafc;\r\n}\r\n\r\n.max-h-96::-webkit-scrollbar-thumb {\r\n  background-color: #cbd5e0;\r\n  border-radius: 3px;\r\n}\r\n</style> "],"mappings":"AAmFA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AAC3D,SAASC,MAAK,QAAS,UAAU;AAEjC,eAAe;EACbC,IAAI,EAAE,uBAAuB;EAE7BC,KAAKA,CAAA,EAAG;IACN,MAAMC,aAAY,GAAIP,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAMQ,MAAK,GAAIR,GAAG,CAAC,KAAK,CAAC;IACzB,MAAMS,eAAc,GAAIT,GAAG,CAAC,KAAK,CAAC;IAElC,MAAMU,WAAU,GAAIT,QAAQ,CAAC,MAAM;MACjC,OAAOM,aAAa,CAACI,KAAK,CAACC,MAAM,CAACC,CAAA,IAAK,CAACA,CAAC,CAACC,IAAI,CAAC,CAACC,MAAM;IACxD,CAAC,CAAC;IAEF,MAAMC,cAAa,GAAIA,CAAA,KAAM;MAC3BR,MAAM,CAACG,KAAI,GAAI,CAACH,MAAM,CAACG,KAAK;IAC9B,CAAC;IAED,MAAMM,UAAS,GAAKC,IAAI,IAAK;MAC3B,OAAO,IAAIC,IAAI,CAACD,IAAI,CAAC,CAACE,cAAc,CAAC,OAAO,EAAE;QAC5CC,GAAG,EAAE,SAAS;QACdC,KAAK,EAAE,OAAO;QACdC,IAAI,EAAE,SAAS;QACfC,MAAM,EAAE;MACV,CAAC,CAAC;IA