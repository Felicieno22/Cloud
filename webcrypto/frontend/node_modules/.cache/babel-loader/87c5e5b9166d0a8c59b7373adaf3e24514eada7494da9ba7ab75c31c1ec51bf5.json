{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nexport default {\n  name: 'Account',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const error = ref('');\n    const user = computed(() => store.getters['auth/user']);\n    const form = ref({\n      username: '',\n      nom: '',\n      prenom: '',\n      date_naissance: '',\n      ville: '',\n      email: ''\n    });\n    const editingField = ref({\n      username: false,\n      nom: false,\n      prenom: false,\n      date_naissance: false,\n      ville: false,\n      email: false\n    });\n    const formFields = {\n      username: {\n        label: 'Nom d\\'utilisateur',\n        type: 'text'\n      },\n      email: {\n        label: 'Email',\n        type: 'email'\n      },\n      nom: {\n        label: 'Nom',\n        type: 'text'\n      },\n      prenom: {\n        label: 'Prénom',\n        type: 'text'\n      },\n      date_naissance: {\n        label: 'Date de naissance',\n        type: 'date'\n      },\n      ville: {\n        label: 'Ville',\n        type: 'text'\n      }\n    };\n\n    // Initialiser le formulaire avec les données de l'utilisateur\n    const initForm = () => {\n      Object.keys(form.value).forEach(key => {\n        form.value[key] = user.value?.[key] || '';\n      });\n    };\n    const startEditing = field => {\n      editingField.value[field] = true;\n    };\n    const cancelEditing = field => {\n      editingField.value[field] = false;\n      form.value[field] = user.value?.[field] || '';\n    };\n    const saveField = async field => {\n      try {\n        loading.value = true;\n        error.value = '';\n        socket.emit('updateUserField', {\n          field,\n          value: form.value[field]\n        });\n      } catch (err) {\n        error.value = err.message || 'Une erreur est survenue';\n      } finally {\n        loading.value = false;\n      }\n    };\n    onMounted(() => {\n      if (!user.value) {\n        router.push('/login');\n        return;\n      }\n      socket.connect();\n\n      // Authentification socket\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken');\n      if (token) {\n        socket.emit('authenticate', token);\n      }\n      socket.on('authenticated', () => {\n        socket.emit('getUserInfo');\n      });\n      socket.on('userInfo', data => {\n        Object.keys(form.value).forEach(key => {\n          if (data[key]) {\n            form.value[key] = data[key];\n          }\n        });\n      });\n      socket.on('userUpdateSuccess', data => {\n        // Mettre à jour le store avec les nouvelles informations\n        store.dispatch('auth/updateUser', {\n          ...user.value,\n          ...data\n        });\n\n        // Réinitialiser l'état d'édition\n        Object.keys(editingField.value).forEach(key => {\n          editingField.value[key] = false;\n        });\n\n        // Afficher un message de succès\n        alert('Informations mises à jour avec succès');\n      });\n      socket.on('error', error => {\n        console.error('Erreur socket:', error);\n        error.value = error.message;\n        if (error.message?.includes('authentification')) {\n          router.push('/login');\n        }\n      });\n\n      // Initialiser le formulaire\n      initForm();\n    });\n    onUnmounted(() => {\n      socket.off('userInfo');\n      socket.off('userUpdateSuccess');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.disconnect();\n    });\n    return {\n      loading,\n      error,\n      form,\n      editingField,\n      formFields,\n      startEditing,\n      cancelEditing,\n      saveField\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","useStore","useRouter","socket","name","setup","store","router","loading","error","user","getters","form","username","nom","prenom","date_naissance","ville","email","editingField","formFields","label","type","initForm","Object","keys","value","forEach","key","startEditing","field","cancelEditing","saveField","emit","err","message","push","connect","token","localStorage","getItem","on","data","dispatch","alert","console","includes","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Account.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-gray-50 py-8\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <h1 class=\"text-3xl font-extrabold text-gray-900 mb-8\">Mon Compte</h1>\n\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-200 hover:shadow-md\">\n        <div class=\"p-6 space-y-6\">\n          <!-- Champs du formulaire -->\n          <div v-for=\"(field, key) in formFields\" :key=\"key\" class=\"space-y-2\">\n            <div class=\"flex justify-between items-center\">\n              <label :for=\"key\" class=\"block text-sm font-medium text-gray-700\">\n                {{ field.label }}\n              </label>\n              <button\n                v-if=\"!editingField[key]\"\n                @click=\"startEditing(key)\"\n                class=\"text-indigo-600 hover:text-indigo-800 text-sm font-medium\"\n              >\n                Modifier\n              </button>\n            </div>\n            \n            <div class=\"relative\">\n              <input\n                :id=\"key\"\n                v-model=\"form[key]\"\n                :type=\"field.type\"\n                :disabled=\"!editingField[key]\"\n                :class=\"[\n                  'block w-full rounded-lg border-gray-300 shadow-sm transition-all duration-200',\n                  editingField[key] ? 'bg-white focus:border-indigo-500 focus:ring-indigo-500' : 'bg-gray-50'\n                ]\"\n              />\n              \n              <div v-if=\"editingField[key]\" class=\"absolute right-0 top-0 h-full flex items-center pr-3 space-x-2\">\n                <button\n                  @click=\"saveField(key)\"\n                  class=\"text-green-600 hover:text-green-800\"\n                  :disabled=\"loading\"\n                >\n                  <svg class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                  </svg>\n                </button>\n                <button\n                  @click=\"cancelEditing(key)\"\n                  class=\"text-red-600 hover:text-red-800\"\n                >\n                  <svg class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\" />\n                  </svg>\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <!-- Message d'erreur -->\n          <div v-if=\"error\" class=\"text-red-600 text-sm mt-2\">\n            {{ error }}\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed, onMounted, onUnmounted } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\nimport { socket } from '@/socket'\n\nexport default {\n  name: 'Account',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const loading = ref(false)\n    const error = ref('')\n    \n    const user = computed(() => store.getters['auth/user'])\n    \n    const form = ref({\n      username: '',\n      nom: '',\n      prenom: '',\n      date_naissance: '',\n      ville: '',\n      email: ''\n    })\n\n    const editingField = ref({\n      username: false,\n      nom: false,\n      prenom: false,\n      date_naissance: false,\n      ville: false,\n      email: false\n    })\n\n    const formFields = {\n      username: { label: 'Nom d\\'utilisateur', type: 'text' },\n      email: { label: 'Email', type: 'email' },\n      nom: { label: 'Nom', type: 'text' },\n      prenom: { label: 'Prénom', type: 'text' },\n      date_naissance: { label: 'Date de naissance', type: 'date' },\n      ville: { label: 'Ville', type: 'text' }\n    }\n\n    // Initialiser le formulaire avec les données de l'utilisateur\n    const initForm = () => {\n      Object.keys(form.value).forEach(key => {\n        form.value[key] = user.value?.[key] || ''\n      })\n    }\n\n    const startEditing = (field) => {\n      editingField.value[field] = true\n    }\n\n    const cancelEditing = (field) => {\n      editingField.value[field] = false\n      form.value[field] = user.value?.[field] || ''\n    }\n\n    const saveField = async (field) => {\n      try {\n        loading.value = true\n        error.value = ''\n\n        socket.emit('updateUserField', {\n          field,\n          value: form.value[field]\n        })\n      } catch (err) {\n        error.value = err.message || 'Une erreur est survenue'\n      } finally {\n        loading.value = false\n      }\n    }\n\n    onMounted(() => {\n      if (!user.value) {\n        router.push('/login')\n        return\n      }\n\n      socket.connect()\n\n      // Authentification socket\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken')\n      if (token) {\n        socket.emit('authenticate', token)\n      }\n\n      socket.on('authenticated', () => {\n        socket.emit('getUserInfo')\n      })\n\n      socket.on('userInfo', (data) => {\n        Object.keys(form.value).forEach(key => {\n          if (data[key]) {\n            form.value[key] = data[key]\n          }\n        })\n      })\n\n      socket.on('userUpdateSuccess', (data) => {\n        // Mettre à jour le store avec les nouvelles informations\n        store.dispatch('auth/updateUser', { ...user.value, ...data })\n        \n        // Réinitialiser l'état d'édition\n        Object.keys(editingField.value).forEach(key => {\n          editingField.value[key] = false\n        })\n        \n        // Afficher un message de succès\n        alert('Informations mises à jour avec succès')\n      })\n\n      socket.on('error', (error) => {\n        console.error('Erreur socket:', error)\n        error.value = error.message\n        if (error.message?.includes('authentification')) {\n          router.push('/login')\n        }\n      })\n\n      // Initialiser le formulaire\n      initForm()\n    })\n\n    onUnmounted(() => {\n      socket.off('userInfo')\n      socket.off('userUpdateSuccess')\n      socket.off('authenticated')\n      socket.off('error')\n      socket.disconnect()\n    })\n\n    return {\n      loading,\n      error,\n      form,\n      editingField,\n      formFields,\n      startEditing,\n      cancelEditing,\n      saveField\n    }\n  }\n}\n</script>\n\n<style scoped>\n.min-h-screen {\n  background: linear-gradient(135deg, #f6f9fc 0%, #edf2f7 100%);\n}\n\n.bg-white {\n  backdrop-filter: blur(10px);\n  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.bg-white:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);\n}\n\ninput {\n  transition: all 0.3s ease;\n}\n\ninput:hover:not(:disabled) {\n  border-color: #cbd5e0;\n}\n\ninput:focus:not(:disabled) {\n  border-color: #4f46e5;\n  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);\n}\n\nbutton {\n  transition: all 0.2s ease;\n}\n\nbutton:hover:not(:disabled) {\n  transform: translateY(-1px);\n}\n\nbutton:active:not(:disabled) {\n  transform: translateY(0);\n}\n</style> "],"mappings":"AAmEA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AAC1D,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,MAAK,QAAS,UAAS;A