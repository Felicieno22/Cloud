{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Register',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const form = ref({\n      nom: '',\n      prenom: '',\n      username: '',\n      email: '',\n      ville: '',\n      date_naissance: '',\n      passwordHash: ''\n    });\n    const verificationCode = ref('');\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification']);\n    console.log('État pendingVerification:', pendingVerification.value); // Debug log\n\n    const handleSubmit = async () => {\n      try {\n        loading.value = true;\n        const response = await store.dispatch('auth/register', form.value);\n        // Rediriger vers la page de vérification avec l'email\n        router.push({\n          name: 'verify-email',\n          query: {\n            email: form.value.email\n          }\n        });\n      } catch (error) {\n        alert(error.message || \"Erreur lors de l'inscription\");\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handleVerification = async () => {\n      try {\n        loading.value = true;\n        await store.dispatch('auth/verifyEmail', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        });\n        router.push('/login');\n      } catch (error) {\n        alert(error.message || 'Erreur de vérification');\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      form,\n      loading,\n      verificationCode,\n      pendingVerification,\n      handleSubmit,\n      handleVerification\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRouter","name","setup","store","router","loading","form","nom","prenom","username","email","ville","date_naissance","passwordHash","verificationCode","pendingVerification","getters","console","log","value","handleSubmit","response","dispatch","push","query","error","alert","message","handleVerification","code"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Register.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-md w-full space-y-8\">\n      <div>\n        <h2 class=\"mt-6 text-center text-3xl font-extrabold text-gray-900\">\n          {{ pendingVerification ? 'Vérification du compte' : 'Inscription' }}\n        </h2>\n      </div>\n\n      <!-- Formulaire de vérification -->\n      <form v-if=\"pendingVerification\" class=\"mt-8 space-y-6\" @submit.prevent=\"handleVerification\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"verification-code\" class=\"sr-only\">Code de vérification</label>\n            <input\n              id=\"verification-code\"\n              v-model=\"verificationCode\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Entrez le code reçu par email\"\n            />\n          </div>\n        </div>\n\n        <div class=\"text-sm text-center\">\n          <p class=\"text-gray-600\">\n            Un code de vérification a été envoyé à {{ pendingVerification.email }}\n          </p>\n          <p class=\"text-gray-500 mt-2\">\n            {{ pendingVerification.message }}\n          </p>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-indigo-500\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Vérification...' : 'Vérifier le code' }}\n          </button>\n        </div>\n      </form>\n\n      <!-- Formulaire d'inscription -->\n      <form v-else class=\"mt-8 space-y-6\" @submit.prevent=\"handleSubmit\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"nom\" class=\"sr-only\">Nom</label>\n            <input\n              id=\"nom\"\n              v-model=\"form.nom\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Nom\"\n            />\n          </div>\n          <div>\n            <label for=\"prenom\" class=\"sr-only\">Prénom</label>\n            <input\n              id=\"prenom\"\n              v-model=\"form.prenom\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Prénom\"\n            />\n          </div>\n          <div>\n            <label for=\"username\" class=\"sr-only\">Nom d'utilisateur</label>\n            <input\n              id=\"username\"\n              v-model=\"form.username\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Nom d'utilisateur\"\n            />\n          </div>\n          <div>\n            <label for=\"email\" class=\"sr-only\">Email</label>\n            <input\n              id=\"email\"\n              v-model=\"form.email\"\n              type=\"email\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Email\"\n            />\n          </div>\n          <div>\n            <label for=\"ville\" class=\"sr-only\">Ville</label>\n            <input\n              id=\"ville\"\n              v-model=\"form.ville\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Ville\"\n            />\n          </div>\n          <div>\n            <label for=\"date_naissance\" class=\"sr-only\">Date de naissance</label>\n            <input\n              id=\"date_naissance\"\n              v-model=\"form.date_naissance\"\n              type=\"date\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n            />\n          </div>\n          <div>\n            <label for=\"password\" class=\"sr-only\">Mot de passe</label>\n            <input\n              id=\"password\"\n              v-model=\"form.passwordHash\"\n              type=\"password\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Mot de passe\"\n            />\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path d=\"M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6z\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-white\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Inscription...' : \"S'inscrire\" }}\n          </button>\n        </div>\n\n        <div class=\"text-sm text-center\">\n          <router-link to=\"/login\" class=\"font-medium text-indigo-600 hover:text-indigo-500\">\n            Déjà un compte ? Se connecter\n          </router-link>\n        </div>\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  name: 'Register',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const loading = ref(false)\n    const form = ref({\n      nom: '',\n      prenom: '',\n      username: '',\n      email: '',\n      ville: '',\n      date_naissance: '',\n      passwordHash: ''\n    })\n    const verificationCode = ref('')\n\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification'])\n    console.log('État pendingVerification:', pendingVerification.value) // Debug log\n\n    const handleSubmit = async () => {\n      try {\n        loading.value = true\n        const response = await store.dispatch('auth/register', form.value)\n        // Rediriger vers la page de vérification avec l'email\n        router.push({\n          name: 'verify-email',\n          query: { email: form.value.email }\n        })\n      } catch (error) {\n        alert(error.message || \"Erreur lors de l'inscription\")\n      } finally {\n        loading.value = false\n      }\n    }\n\n    const handleVerification = async () => {\n      try {\n        loading.value = true\n        await store.dispatch('auth/verifyEmail', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        })\n        router.push('/login')\n      } catch (error) {\n        alert(error.message || 'Erreur de vérification')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    return {\n      form,\n      loading,\n      verificationCode,\n      pendingVerification,\n      handleSubmit,\n      handleVerification\n    }\n  }\n}\n</script>\n\n<style scoped>\n.min-h-screen {\n  background: linear-gradient(135deg, #f6f9fc 0%, #edf2f7 100%);\n  position: relative;\n  overflow: hidden;\n}\n\n.min-h-screen::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: url(\"data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%234f46e5' fill-opacity='0.02' fill-rule='evenodd'/%3E%3C/svg%3E\");\n  z-index: 0;\n}\n\n.max-w-md {\n  position: relative;\n  z-index: 1;\n  backdrop-filter: blur(10px);\n  background: rgba(255, 255, 255, 0.95);\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  border-radius: 1rem;\n  padding: 2rem;\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.max-w-md:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 25px 30px -5px rgba(0, 0, 0, 0.15), 0 15px 15px -5px rgba(0, 0, 0, 0.08);\n}\n\ninput {\n  transition: all 0.3s ease;\n  border-radius: 0.5rem !important;\n  background: rgba(255, 255, 255, 0.9) !important;\n}\n\ninput:focus {\n  transform: translateY(-1px);\n  box-shadow: 0 2px 4px rgba(79, 70, 229, 0.1);\n  border-color: #4f46e5 !important;\n}\n\ninput[type=\"date\"] {\n  appearance: none;\n  padding: 0.5rem 1rem;\n  color: #4a5568;\n}\n\ninput[type=\"date\"]::-webkit-calendar-picker-indicator {\n  cursor: pointer;\n  opacity: 0.6;\n  transition: opacity 0.2s ease;\n}\n\ninput[type=\"date\"]::-webkit-calendar-picker-indicator:hover {\n  opacity: 1;\n}\n\nbutton {\n  position: relative;\n  overflow: hidden;\n  transition: all 0.3s ease;\n  background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%) !important;\n}\n\nbutton:hover {\n  transform: translateY(-1px);\n  background: linear-gradient(135deg, #4338ca 0%, #3730a3 100%) !important;\n}\n\nbutton::after {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 0;\n  height: 0;\n  background: rgba(255, 255, 255, 0.2);\n  border-radius: 50%;\n  transform: translate(-50%, -50%);\n  transition: width 0.6s ease, height 0.6s ease;\n}\n\nbutton:active::after {\n  width: 300px;\n  height: 300px;\n  opacity: 0;\n}\n\n.animate-spin {\n  animation: spin 1s linear infinite;\n}\n\n@keyframes spin {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* Animations pour les transitions */\n.fade-enter-active,\n.fade-leave-active {\n  transition: opacity 0.3s ease;\n}\n\n.fade-enter-from,\n.fade-leave-to {\n  opacity: 0;\n}\n\n/* Style pour les messages d'erreur */\n.text-red-600 {\n  animation: shake 0.5s ease-in-out;\n}\n\n@keyframes shake {\n  0%, 100% { transform: translateX(0); }\n  25% { transform: translateX(-5px); }\n  75% { transform: translateX(5px); }\n}\n\n/* Style pour le lien de connexion */\n.text-indigo-600 {\n  position: relative;\n  text-decoration: none;\n  transition: all 0.3s ease;\n}\n\n.text-indigo-600::after {\n  content: '';\n  position: absolute;\n  width: 100%;\n  height: 2px;\n  bottom: -2px;\n  left: 0;\n  background-color: #4f46e5;\n  transform: scaleX(0);\n  transform-origin: bottom right;\n  transition: transform 0.3s ease;\n}\n\n.text-indigo-600:hover::after {\n  transform: scaleX(1);\n  transform-origin: bottom left;\n}\n\n/* Style pour le formulaire de vérification */\n.verification-form {\n  animation: slideUp 0.5s ease-out;\n}\n\n@keyframes slideUp {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n</style>\n"],"mappings":"AAqKA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,UAAU;EAEhBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,OAAM,GAAIR,GAAG,CAAC,KAAK;IACzB,MAAMS,IAAG,GAAIT,GAAG,CAAC;MACfU,GAAG,EAAE,EAAE;MACPC,MAAM,EAAE,EAAE;MACVC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE,EAAE;MACTC,cAAc,EAAE,EAAE;MAClBC,YAAY,EAAE;IAChB,CAAC;IACD,MAAMC,gBAAe,GAAIjB,GAAG,CAAC,EAAE;IAE/B,MAAMkB,mBAAkB,GAAIjB,QAAQ,CAAC,MAAMK,KAAK,CAACa,OAAO,CAAC,0BAA0B,CAAC;IACpFC,OAAO,CAACC,GAAG,CAAC,2BAA2B,EAAEH,mBAAmB,CAACI,KAAK,GAAE;;IAEpE,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACFf,OAAO,CAACc,KAAI,GAAI,IAAG;QACnB,MAAME,QAAO,GAAI,M