{"ast":null,"code":"import { ref, computed, onMounted } from 'vue';\nimport { socket } from '@/socket';\nexport default {\n  name: 'OperationsHistory',\n  setup() {\n    const operations = ref([]);\n    const usersList = ref([]);\n    const cryptoList = ref([]);\n    const filters = ref({\n      startDate: '',\n      endDate: '',\n      crypto: '',\n      userId: ''\n    });\n\n    // Récupérer les opérations\n    const loadOperations = () => {\n      socket.emit('getOperationsHistory');\n    };\n\n    // Récupérer la liste des utilisateurs\n    const loadUsers = () => {\n      socket.emit('getUsersList');\n    };\n\n    // Récupérer la liste des cryptos\n    const loadCryptos = () => {\n      socket.emit('getCryptosList');\n    };\n\n    // Filtrer les opérations\n    const filteredOperations = computed(() => {\n      return operations.value.filter(op => {\n        const matchDate = (!filters.value.startDate || new Date(op.created_at) >= new Date(filters.value.startDate)) && (!filters.value.endDate || new Date(op.created_at) <= new Date(filters.value.endDate));\n        const matchCrypto = !filters.value.crypto || op.crypto_symbol === filters.value.crypto;\n        const matchUser = !filters.value.userId || op.user_id === filters.value.userId;\n        return matchDate && matchCrypto && matchUser;\n      });\n    });\n\n    // Formater les montants\n    const formatAmount = amount => {\n      return new Intl.NumberFormat('fr-FR', {\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(amount);\n    };\n\n    // Formater les dates\n    const formatDate = date => {\n      return new Date(date).toLocaleString('fr-FR', {\n        year: 'numeric',\n        month: 'long',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    };\n\n    // Gérer les erreurs d'image\n    const handleImageError = (event, operation) => {\n      event.target.style.display = 'none';\n      operation.user_photo = null;\n    };\n\n    // Sélectionner un utilisateur\n    const selectUser = userId => {\n      filters.value.userId = userId;\n      applyFilters();\n    };\n\n    // Réinitialiser les filtres\n    const resetFilters = () => {\n      filters.value = {\n        startDate: '',\n        endDate: '',\n        crypto: '',\n        userId: ''\n      };\n      applyFilters();\n    };\n\n    // Appliquer les filtres\n    const applyFilters = () => {\n      loadOperations();\n    };\n\n    // Socket listeners\n    onMounted(() => {\n      socket.on('operationsHistory', data => {\n        operations.value = data;\n      });\n      socket.on('usersList', data => {\n        usersList.value = data;\n      });\n      socket.on('cryptosList', data => {\n        cryptoList.value = data;\n      });\n\n      // Charger les données initiales\n      loadOperations();\n      loadUsers();\n      loadCryptos();\n    });\n    return {\n      operations,\n      usersList,\n      cryptoList,\n      filters,\n      filteredOperations,\n      formatAmount,\n      formatDate,\n      handleImageError,\n      selectUser,\n      resetFilters,\n      applyFilters\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","socket","name","setup","operations","usersList","cryptoList","filters","startDate","endDate","crypto","userId","loadOperations","emit","loadUsers","loadCryptos","filteredOperations","value","filter","op","matchDate","Date","created_at","matchCrypto","crypto_symbol","matchUser","user_id","formatAmount","amount","Intl","NumberFormat","minimumFractionDigits","maximumFractionDigits","format","formatDate","date","toLocaleString","year","month","day","hour","minute","handleImageError","event","operation","target","style","display","user_photo","selectUser","applyFilters","resetFilters","on","data"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\OperationsHistory.vue"],"sourcesContent":["<template>\r\n  <div class=\"min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12\">\r\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\r\n      <div class=\"text-center mb-8\">\r\n        <h1 class=\"text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-blue-500\">\r\n          Historique des Opérations\r\n        </h1>\r\n        <p class=\"mt-2 text-gray-600\">Consultez l'historique des transactions de tous les utilisateurs</p>\r\n      </div>\r\n\r\n      <!-- Filtres -->\r\n      <div class=\"bg-white rounded-xl shadow-md p-6 mb-8\">\r\n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\r\n          <!-- Filtre Date Début -->\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Date début</label>\r\n            <input\r\n              type=\"datetime-local\"\r\n              v-model=\"filters.startDate\"\r\n              class=\"w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n            />\r\n          </div>\r\n\r\n          <!-- Filtre Date Fin -->\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Date fin</label>\r\n            <input\r\n              type=\"datetime-local\"\r\n              v-model=\"filters.endDate\"\r\n              class=\"w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n            />\r\n          </div>\r\n\r\n          <!-- Filtre Crypto -->\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Crypto-monnaie</label>\r\n            <select\r\n              v-model=\"filters.crypto\"\r\n              class=\"w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n            >\r\n              <option value=\"\">Toutes les cryptos</option>\r\n              <option v-for=\"crypto in cryptoList\" :key=\"crypto.id\" :value=\"crypto.symbol\">\r\n                {{ crypto.name }}\r\n              </option>\r\n            </select>\r\n          </div>\r\n\r\n          <!-- Filtre Utilisateur -->\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Utilisateur</label>\r\n            <select\r\n              v-model=\"filters.userId\"\r\n              class=\"w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n            >\r\n              <option value=\"\">Tous les utilisateurs</option>\r\n              <option v-for=\"user in usersList\" :key=\"user.id\" :value=\"user.id\">\r\n                {{ user.username }}\r\n              </option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Boutons de filtrage -->\r\n        <div class=\"mt-4 flex justify-end space-x-3\">\r\n          <button\r\n            @click=\"resetFilters\"\r\n            class=\"px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors duration-200\"\r\n          >\r\n            Réinitialiser\r\n          </button>\r\n          <button\r\n            @click=\"applyFilters\"\r\n            class=\"px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors duration-200\"\r\n          >\r\n            Appliquer les filtres\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Liste des opérations -->\r\n      <div class=\"bg-white rounded-xl shadow-md overflow-hidden\">\r\n        <div class=\"overflow-x-auto\">\r\n          <table class=\"min-w-full divide-y divide-gray-200\">\r\n            <thead class=\"bg-gray-50\">\r\n              <tr>\r\n                <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\r\n                  Utilisateur\r\n                </th>\r\n                <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\r\n                  Opération\r\n                </th>\r\n                <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\r\n                  Crypto\r\n                </th>\r\n                <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\r\n                  Montant\r\n                </th>\r\n                <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\r\n                  Date\r\n                </th>\r\n              </tr>\r\n            </thead>\r\n            <tbody class=\"bg-white divide-y divide-gray-200\">\r\n              <tr v-for=\"operation in filteredOperations\" :key=\"operation.id\" \r\n                  class=\"hover:bg-gray-50 transition-colors duration-200 cursor-pointer\"\r\n                  @click=\"selectUser(operation.user_id)\">\r\n                <td class=\"px-6 py-4 whitespace-nowrap\">\r\n                  <div class=\"flex items-center\">\r\n                    <div class=\"h-10 w-10 flex-shrink-0\">\r\n                      <img v-if=\"operation.user_photo\" \r\n                           :src=\"operation.user_photo\" \r\n                           :alt=\"operation.username\"\r\n                           class=\"h-10 w-10 rounded-full object-cover\" \r\n                           @error=\"handleImageError($event, operation)\" />\r\n                      <div v-else \r\n                           class=\"h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center\">\r\n                        <span class=\"text-indigo-700 font-medium text-sm\">\r\n                          {{ operation.username?.[0]?.toUpperCase() || 'U' }}\r\n                        </span>\r\n                      </div>\r\n                    </div>\r\n                    <div class=\"ml-4\">\r\n                      <div class=\"text-sm font-medium text-gray-900\">\r\n                        {{ operation.username }}\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </td>\r\n                <td class=\"px-6 py-4 whitespace-nowrap\">\r\n                  <span :class=\"[\r\n                    'px-2 py-1 text-xs font-medium rounded-full',\r\n                    operation.type === 'achat' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'\r\n                  ]\">\r\n                    {{ operation.type }}\r\n                  </span>\r\n                </td>\r\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\r\n                  {{ operation.crypto_symbol }}\r\n                </td>\r\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\r\n                  {{ formatAmount(operation.amount) }} €\r\n                </td>\r\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">\r\n                  {{ formatDate(operation.created_at) }}\r\n                </td>\r\n              </tr>\r\n            </tbody>\r\n          </table>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted } from 'vue'\r\nimport { socket } from '@/socket'\r\n\r\nexport default {\r\n  name: 'OperationsHistory',\r\n  \r\n  setup() {\r\n    const operations = ref([])\r\n    const usersList = ref([])\r\n    const cryptoList = ref([])\r\n    const filters = ref({\r\n      startDate: '',\r\n      endDate: '',\r\n      crypto: '',\r\n      userId: ''\r\n    })\r\n\r\n    // Récupérer les opérations\r\n    const loadOperations = () => {\r\n      socket.emit('getOperationsHistory')\r\n    }\r\n\r\n    // Récupérer la liste des utilisateurs\r\n    const loadUsers = () => {\r\n      socket.emit('getUsersList')\r\n    }\r\n\r\n    // Récupérer la liste des cryptos\r\n    const loadCryptos = () => {\r\n      socket.emit('getCryptosList')\r\n    }\r\n\r\n    // Filtrer les opérations\r\n    const filteredOperations = computed(() => {\r\n      return operations.value.filter(op => {\r\n        const matchDate = (!filters.value.startDate || new Date(op.created_at) >= new Date(filters.value.startDate)) &&\r\n                         (!filters.value.endDate || new Date(op.created_at) <= new Date(filters.value.endDate))\r\n        const matchCrypto = !filters.value.crypto || op.crypto_symbol === filters.value.crypto\r\n        const matchUser = !filters.value.userId || op.user_id === filters.value.userId\r\n\r\n        return matchDate && matchCrypto && matchUser\r\n      })\r\n    })\r\n\r\n    // Formater les montants\r\n    const formatAmount = (amount) => {\r\n      return new Intl.NumberFormat('fr-FR', {\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2\r\n      }).format(amount)\r\n    }\r\n\r\n    // Formater les dates\r\n    const formatDate = (date) => {\r\n      return new Date(date).toLocaleString('fr-FR', {\r\n        year: 'numeric',\r\n        month: 'long',\r\n        day: 'numeric',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      })\r\n    }\r\n\r\n    // Gérer les erreurs d'image\r\n    const handleImageError = (event, operation) => {\r\n      event.target.style.display = 'none'\r\n      operation.user_photo = null\r\n    }\r\n\r\n    // Sélectionner un utilisateur\r\n    const selectUser = (userId) => {\r\n      filters.value.userId = userId\r\n      applyFilters()\r\n    }\r\n\r\n    // Réinitialiser les filtres\r\n    const resetFilters = () => {\r\n      filters.value = {\r\n        startDate: '',\r\n        endDate: '',\r\n        crypto: '',\r\n        userId: ''\r\n      }\r\n      applyFilters()\r\n    }\r\n\r\n    // Appliquer les filtres\r\n    const applyFilters = () => {\r\n      loadOperations()\r\n    }\r\n\r\n    // Socket listeners\r\n    onMounted(() => {\r\n      socket.on('operationsHistory', (data) => {\r\n        operations.value = data\r\n      })\r\n\r\n      socket.on('usersList', (data) => {\r\n        usersList.value = data\r\n      })\r\n\r\n      socket.on('cryptosList', (data) => {\r\n        cryptoList.value = data\r\n      })\r\n\r\n      // Charger les données initiales\r\n      loadOperations()\r\n      loadUsers()\r\n      loadCryptos()\r\n    })\r\n\r\n    return {\r\n      operations,\r\n      usersList,\r\n      cryptoList,\r\n      filters,\r\n      filteredOperations,\r\n      formatAmount,\r\n      formatDate,\r\n      handleImageError,\r\n      selectUser,\r\n      resetFilters,\r\n      applyFilters\r\n    }\r\n  }\r\n}\r\n</script> "],"mappings":"AA2JA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAI;AAC7C,SAASC,MAAK,QAAS,UAAS;AAEhC,eAAe;EACbC,IAAI,EAAE,mBAAmB;EAEzBC,KAAKA,CAAA,EAAG;IACN,MAAMC,UAAS,GAAIN,GAAG,CAAC,EAAE;IACzB,MAAMO,SAAQ,GAAIP,GAAG,CAAC,EAAE;IACxB,MAAMQ,UAAS,GAAIR,GAAG,CAAC,EAAE;IACzB,MAAMS,OAAM,GAAIT,GAAG,CAAC;MAClBU,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE,EAAE;MACXC,MAAM,EAAE,EAAE;MACVC,MAAM,EAAE;IACV,CAAC;;IAED;IACA,MAAMC,cAAa,GAAIA,CAAA,KAAM;MAC3BX,MAAM,CAACY,IAAI,CAAC,sBAAsB;IACpC;;IAEA;IACA,MAAMC,SAAQ,GAAIA,CAAA,KAAM;MACtBb,MAAM,CAACY,IAAI,CAAC,cAAc;IAC5B;;IAEA;IACA,MAAME,WAAU,GAAIA,CAAA,KAAM;MACxBd,MAAM,CAACY,IAAI,CAAC,gBAAgB;IAC9B;;IAEA;IACA,MAAMG,kBAAiB,GAAIjB,QAAQ,CAAC,MAAM;MACxC,OAAOK,UAAU,CAACa,KAAK,CAACC,MAAM,CAACC,EAAC,IAAK;QACnC,MAAMC,SAAQ,GAAI,CAAC,CAACb,OAAO,CAACU,KAAK,CAACT,SAAQ,IAAK,IAAIa,IAAI,CAACF,EAAE,CAACG,UAAU,KAAK,IAAID,IAAI,CAACd,OAAO,CAACU,KAAK,CAACT,SAAS,CAAC,MACzF,CAACD,OAAO,CAACU,KAAK,CAACR,OAAM,IAAK,IAAIY,IAAI,CAACF,EAAE,CAACG,UAAU,KAAK,IAAID,IAAI,CAACd,OAAO,CAACU,KAAK,CAACR,OAAO,CAAC;QACtG,MAAMc,WAAU,GAAI,CAAChB,OAAO,CAACU,KAAK,CAACP,MAAK,IAAKS,EAAE,CAACK,aAAY,KAAMjB,OAAO,CAACU,KAAK,CAACP,MAAK;QACrF,MAAMe,SAAQ,GAAI,CAAClB,OAAO,CAACU,KAAK,CAACN,MAAK,IAAKQ,EAAE,CAACO,OAAM,KAAMnB,OAAO,CAACU,KAAK,CAACN,MAAK;QAE7E,OAAOS,SAAQ,IAAKG,WAAU,IAAKE,SAAQ;MAC7C,CAAC;IACH,CAAC;;IAED;IACA,MAAME,YAAW,GAAKC,MAAM,IAAK;MAC/B,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACL,MAAM;IAClB;;IAEA;IACA,MAAMM,UAAS,GAAKC,IAAI,IAAK;MAC3B,OAAO,IAAId,IAAI,CAACc,IAAI,CAAC,CAACC,cAAc,CAAC,OAAO,EAAE;QAC5CC,IAAI,EAAE,SAAS;QACfC,KAAK,EAAE,MAAM;QACbC,GAAG,EAAE,SAAS;QACdC,IAAI,EAAE,SAAS;QACfC,MAAM,EAAE;MACV,CAAC;IACH;;IAEA;IACA,MAAMC,gBAAe,GAAIA,CAACC,KAAK,EAAEC,SAAS,KAAK;MAC7CD,KAAK,CAACE,MAAM,CAACC,KAAK,CAACC,OAAM,GAAI,MAAK;MAClCH,SAAS,CAACI,UAAS,GAAI,IAAG;IAC5B;;IAEA;IACA,MAAMC,UAAS,GAAKtC,MAAM,IAAK;MAC7BJ,OAAO,CAACU,KAAK,CAACN,MAAK,GAAIA,MAAK;MAC5BuC,YAAY,CAAC;IACf;;IAEA;IACA,MAAMC,YAAW,GAAIA,CAAA,KAAM;MACzB5C,OAAO,CAACU,KAAI,GAAI;QACdT,SAAS,EAAE,EAAE;QACbC,OAAO,EAAE,EAAE;QACXC,MAAM,EAAE,EAAE;QACVC,MAAM,EAAE;MACV;MACAuC,YAAY,CAAC;IACf;;IAEA;IACA,MAAMA,YAAW,GAAIA,CAAA,KAAM;MACzBtC,cAAc,CAAC;IACjB;;IAEA;IACAZ,SAAS,CAAC,MAAM;MACdC,MAAM,CAACmD,EAAE,CAAC,mBAAmB,EAAGC,IAAI,IAAK;QACvCjD,UAAU,CAACa,KAAI,GAAIoC,IAAG;MACxB,CAAC;MAEDpD,MAAM,CAACmD,EAAE,CAAC,WAAW,EAAGC,IAAI,IAAK;QAC/BhD,SAAS,CAACY,KAAI,GAAIoC,IAAG;MACvB,CAAC;MAEDpD,MAAM,CAACmD,EAAE,CAAC,aAAa,EAAGC,IAAI,IAAK;QACjC/C,UAAU,CAACW,KAAI,GAAIoC,IAAG;MACxB,CAAC;;MAED;MACAzC,cAAc,CAAC;MACfE,SAAS,CAAC;MACVC,WAAW,CAAC;IACd,CAAC;IAED,OAAO;MACLX,UAAU;MACVC,SAAS;MACTC,UAAU;MACVC,OAAO;MACPS,kBAAkB;MAClBW,YAAY;MACZO,UAAU;MACVQ,gBAAgB;MAChBO,UAAU;MACVE,YAAY;MACZD;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}