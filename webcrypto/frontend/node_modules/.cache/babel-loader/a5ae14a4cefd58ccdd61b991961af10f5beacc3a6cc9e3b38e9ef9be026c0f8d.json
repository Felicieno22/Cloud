{"ast":null,"code":"import { computed, ref, onMounted, onUnmounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter, useRoute } from 'vue-router';\nimport { socket } from '@/socket';\nexport default {\n  name: 'App',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const route = useRoute();\n    const notifications = ref([]);\n    const showNotifications = ref(false);\n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated']);\n    const isAdminRoute = computed(() => {\n      return route.path.startsWith('/admin') && route.name !== 'AdminLogin' || route.path === '/commission-settings' || route.path === '/transactions-summary';\n    });\n    const isAdmin = computed(() => store.getters['auth/isAdmin']);\n    const unreadNotifications = computed(() => notifications.value.filter(n => !n.read));\n    const handleLogout = async () => {\n      await store.dispatch('auth/logout');\n      router.push('/login');\n    };\n    onMounted(() => {\n      // Vérifier l'authentification au démarrage\n      store.dispatch('auth/init');\n\n      // Connexion socket pour les notifications\n      socket.connect();\n\n      // Authentification socket\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken');\n      if (token) {\n        socket.emit('authenticate', token);\n      }\n      socket.on('authenticated', () => {\n        // Une fois authentifié, demander les notifications\n        socket.emit('getNotifications');\n      });\n\n      // Écouter les notifications\n      socket.on('notificationsUpdate', data => {\n        notifications.value = data;\n      });\n      socket.on('error', error => {\n        console.error('Erreur socket:', error);\n        if (error.message?.includes('authentification')) {\n          router.push('/login');\n        }\n      });\n    });\n    onUnmounted(() => {\n      socket.off('notificationsUpdate');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.disconnect();\n    });\n    return {\n      isAuthenticated,\n      isAdminRoute,\n      isAdmin,\n      handleLogout,\n      notifications,\n      showNotifications,\n      unreadNotifications,\n      route\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","onUnmounted","useStore","useRouter","useRoute","socket","name","setup","store","router","route","notifications","showNotifications","isAuthenticated","getters","isAdminRoute","path","startsWith","isAdmin","unreadNotifications","value","filter","n","read","handleLogout","dispatch","push","connect","token","localStorage","getItem","emit","on","data","error","console","message","includes","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div>\n    <!-- Navigation principale - cachée pour les pages admin -->\n    <nav v-if=\"!isAdminRoute\" class=\"fixed w-full top-0 z-50 bg-white shadow\">\n      <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"flex justify-between h-16\">\n          <div class=\"flex\">\n            <div class=\"flex-shrink-0 flex items-center\">\n              <router-link to=\"/\" class=\"text-xl font-bold text-indigo-600 hover:text-indigo-700 transition-colors duration-200\">\n                CryptoTrade\n              </router-link>\n            </div>\n          </div>\n          <div class=\"flex items-center space-x-2\">\n            <!-- Liens pour utilisateur non authentifié -->\n            <template v-if=\"!isAuthenticated\">\n              <router-link\n                to=\"/login\"\n                class=\"nav-link\"\n              >\n                Connexion\n              </router-link>\n              <router-link\n                to=\"/register\"\n                class=\"nav-link\"\n              >\n                Inscription\n              </router-link>\n              <router-link\n                to=\"/admin/login\"\n                class=\"nav-link\"\n              >\n                Admin\n              </router-link>\n            </template>\n            <!-- Liens pour utilisateur authentifié -->\n            <template v-else>\n              <router-link\n                to=\"/dashboard\"\n                class=\"nav-link\"\n              >\n                Dashboard\n              </router-link>\n              <router-link\n                to=\"/wallet\"\n                class=\"nav-link\"\n              >\n                Portefeuille\n              </router-link>\n              <router-link\n                to=\"/transactions\"\n                class=\"nav-link\"\n              >\n                Transactions\n              </router-link>\n              <router-link\n                to=\"/analysis\"\n                class=\"nav-link\"\n              >\n                Analyses\n              </router-link>\n              <router-link\n                to=\"/commission-analysis\"\n                class=\"nav-link\"\n              >\n                Commissions\n              </router-link>\n              <template v-if=\"isAdmin\">\n                <router-link\n                  to=\"/commission-settings\"\n                  class=\"nav-link\"\n                >\n                  Paramètres Commissions\n                </router-link>\n              </template>\n\n              <!-- Bouton Notifications -->\n              <div class=\"relative\">\n                <button \n                  @click=\"showNotifications = !showNotifications\"\n                  class=\"notification-btn relative text-gray-700 hover:text-indigo-600\"\n                >\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9\" />\n                  </svg>\n                  <span v-if=\"unreadNotifications.length\" class=\"notification-badge absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-4 w-4 flex items-center justify-center\">\n                    {{ unreadNotifications.length }}\n                  </span>\n                </button>\n\n                <!-- Menu déroulant des notifications -->\n                <div v-if=\"showNotifications\" class=\"notifications-dropdown absolute right-0 mt-2 w-80 bg-white rounded-lg py-1 z-50\">\n                  <div class=\"max-h-96 overflow-y-auto\">\n                    <div v-if=\"notifications.length === 0\" class=\"px-4 py-3 text-sm text-gray-500\">\n                      Aucune notification\n                    </div>\n                    <div v-for=\"notif in notifications\" :key=\"notif.id\" \n                         class=\"px-4 py-3 hover:bg-gray-50 transition-colors duration-200 border-b border-gray-100 last:border-b-0\">\n                      <div class=\"text-sm font-medium text-gray-900\">{{ notif.title }}</div>\n                      <div class=\"text-sm text-gray-500\">{{ notif.message }}</div>\n                      <div class=\"text-xs text-gray-400 mt-1\">\n                        {{ new Date(notif.created_at).toLocaleString('fr-FR') }}\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <button\n                @click=\"handleLogout\"\n                class=\"logout-btn\"\n              >\n                Déconnexion\n              </button>\n            </template>\n          </div>\n        </div>\n      </div>\n    </nav>\n\n    <!-- Ajout d'un espace pour compenser la navbar fixe -->\n    <div v-if=\"!isAdminRoute\" class=\"h-16\"></div>\n\n    <router-view />\n  </div>\n</template>\n\n<script>\nimport { computed, ref, onMounted, onUnmounted } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter, useRoute } from 'vue-router'\nimport { socket } from '@/socket'\n\nexport default {\n  name: 'App',\n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const route = useRoute()\n    const notifications = ref([])\n    const showNotifications = ref(false)\n    \n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated'])\n    const isAdminRoute = computed(() => {\n      return (route.path.startsWith('/admin') && route.name !== 'AdminLogin') || \n             route.path === '/commission-settings' || \n             route.path === '/transactions-summary'\n    })\n    const isAdmin = computed(() => store.getters['auth/isAdmin'])\n    const unreadNotifications = computed(() => notifications.value.filter(n => !n.read))\n    \n    const handleLogout = async () => {\n      await store.dispatch('auth/logout')\n      router.push('/login')\n    }\n\n    onMounted(() => {\n      // Vérifier l'authentification au démarrage\n      store.dispatch('auth/init')\n\n      // Connexion socket pour les notifications\n      socket.connect()\n\n      // Authentification socket\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken');\n      if (token) {\n        socket.emit('authenticate', token);\n      }\n\n      socket.on('authenticated', () => {\n        // Une fois authentifié, demander les notifications\n        socket.emit('getNotifications');\n      });\n\n      // Écouter les notifications\n      socket.on('notificationsUpdate', (data) => {\n        notifications.value = data;\n      });\n\n      socket.on('error', (error) => {\n        console.error('Erreur socket:', error);\n        if (error.message?.includes('authentification')) {\n          router.push('/login');\n        }\n      });\n    })\n\n    onUnmounted(() => {\n      socket.off('notificationsUpdate');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.disconnect();\n    })\n\n    return {\n      isAuthenticated,\n      isAdminRoute,\n      isAdmin,\n      handleLogout,\n      notifications,\n      showNotifications,\n      unreadNotifications,\n      route\n    }\n  }\n}\n</script>\n\n<style>\n/* Styles généraux pour le header */\nnav {\n  backdrop-filter: blur(10px);\n  background: rgba(255, 255, 255, 0.95) !important;\n  border-bottom: 1px solid rgba(229, 231, 235, 0.5);\n  transition: all 0.3s ease;\n}\n\nnav:hover {\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n}\n\n/* Logo styles */\n.router-link-exact-active {\n  color: #4F46E5 !important;\n  font-weight: 600;\n  position: relative;\n}\n\n.router-link-exact-active::after {\n  content: '';\n  position: absolute;\n  bottom: -2px;\n  left: 0;\n  width: 100%;\n  height: 2px;\n  background: #4F46E5;\n  border-radius: 2px;\n  transform: scaleX(1);\n  transition: transform 0.3s ease;\n}\n\n/* Navigation links */\nnav a {\n  position: relative;\n  padding: 0.5rem 1rem;\n  transition: all 0.3s ease;\n  border-radius: 0.375rem;\n}\n\nnav a:hover {\n  background: rgba(79, 70, 229, 0.05);\n  color: #4F46E5 !important;\n  transform: translateY(-1px);\n}\n\n/* Notification button styles */\n.notification-btn {\n  padding: 0.5rem;\n  border-radius: 50%;\n  transition: all 0.3s ease;\n}\n\n.notification-btn:hover {\n  background: rgba(79, 70, 229, 0.1);\n  transform: scale(1.05);\n}\n\n/* Notification badge */\n.notification-badge {\n  transform: scale(1);\n  animation: pulse 2s infinite;\n}\n\n@keyframes pulse {\n  0% {\n    transform: scale(0.95);\n    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);\n  }\n  \n  70% {\n    transform: scale(1);\n    box-shadow: 0 0 0 6px rgba(239, 68, 68, 0);\n  }\n  \n  100% {\n    transform: scale(0.95);\n    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);\n  }\n}\n\n/* Notification dropdown */\n.notifications-dropdown {\n  transform-origin: top right;\n  animation: dropdown 0.2s ease-out;\n  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n  border: 1px solid rgba(229, 231, 235, 0.5);\n}\n\n@keyframes dropdown {\n  from {\n    opacity: 0;\n    transform: scale(0.95) translateY(-10px);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n\n/* Scrollbar styles */\n.overflow-y-auto::-webkit-scrollbar {\n  width: 4px;\n}\n\n.overflow-y-auto::-webkit-scrollbar-track {\n  background: #f1f1f1;\n  border-radius: 2px;\n}\n\n.overflow-y-auto::-webkit-scrollbar-thumb {\n  background: #CBD5E0;\n  border-radius: 2px;\n  transition: background 0.3s ease;\n}\n\n.overflow-y-auto::-webkit-scrollbar-thumb:hover {\n  background: #A0AEC0;\n}\n\n/* Logout button */\nbutton.logout-btn {\n  padding: 0.5rem 1rem;\n  border-radius: 0.375rem;\n  transition: all 0.3s ease;\n  background: rgba(239, 68, 68, 0.1);\n  color: #EF4444 !important;\n}\n\nbutton.logout-btn:hover {\n  background: rgba(239, 68, 68, 0.15);\n  transform: translateY(-1px);\n}\n</style>\n"],"mappings":"AAgIA,SAASA,QAAQ,EAAEC,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAI;AAC1D,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAS,EAAEC,QAAO,QAAS,YAAW;AAC/C,SAASC,MAAK,QAAS,UAAS;AAEhC,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC;IACvB,MAAMO,MAAK,GAAIN,SAAS,CAAC;IACzB,MAAMO,KAAI,GAAIN,QAAQ,CAAC;IACvB,MAAMO,aAAY,GAAIZ,GAAG,CAAC,EAAE;IAC5B,MAAMa,iBAAgB,GAAIb,GAAG,CAAC,KAAK;IAEnC,MAAMc,eAAc,GAAIf,QAAQ,CAAC,MAAMU,KAAK,CAACM,OAAO,CAAC,sBAAsB,CAAC;IAC5E,MAAMC,YAAW,GAAIjB,QAAQ,CAAC,MAAM;MAClC,OAAQY,KAAK,CAACM,IAAI,CAACC,UAAU,CAAC,QAAQ,KAAKP,KAAK,CAACJ,IAAG,KAAM,YAAY,IAC/DI,KAAK,CAACM,IAAG,KAAM,sBAAqB,IACpCN,KAAK,CAACM,IAAG,KAAM,uBAAsB;IAC9C,CAAC;IACD,MAAME,OAAM,GAAIpB,QAAQ,CAAC,MAAMU,KAAK,CAACM,OAAO,CAAC,cAAc,CAAC;IAC5D,MAAMK,mBAAkB,GAAIrB,QAAQ,CAAC,MAAMa,aAAa,CAACS,KAAK,CAACC,MAAM,CAACC,CAAA,IAAK,CAACA,CAAC,CAACC,IAAI,CAAC;IAEnF,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,MAAMhB,KAAK,CAACiB,QAAQ,