{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nexport default {\n  name: 'Trade',\n  setup() {\n    const route = useRoute();\n    const router = useRouter();\n    const cryptoSymbol = route.params.symbol?.toUpperCase();\n    const cryptoData = ref(null);\n    const operationType = ref('buy');\n    const amount = ref(0);\n    const isAuthenticated = ref(false);\n\n    // Formatage des prix\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const formatPriceChange = change => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion du trading\n    const handleTrade = async () => {\n      try {\n        if (!isAuthenticated.value) {\n          alert('Veuillez vous connecter pour effectuer des transactions');\n          router.push('/login');\n          return;\n        }\n        if (!amount.value || amount.value <= 0) {\n          alert('Veuillez entrer un montant valide');\n          return;\n        }\n        const totalPrice = amount.value * cryptoData.value.price;\n        socket.emit('tradeCrypto', {\n          type: operationType.value,\n          symbol: cryptoSymbol,\n          amount: parseFloat(amount.value),\n          price: cryptoData.value.price\n        });\n        amount.value = 0;\n      } catch (error) {\n        console.error('Erreur lors de la transaction:', error);\n        alert(error.message || 'Erreur lors de la transaction');\n      }\n    };\n    const initializeSocket = () => {\n      if (!socket.connected) {\n        socket.connect();\n      }\n\n      // Authentifier le socket avec le token\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken') || localStorage.getItem('access_token');\n      if (token) {\n        socket.emit('authenticate', token);\n      } else {\n        console.error('Aucun token trouvé dans le localStorage');\n        router.push('/login');\n        return;\n      }\n    };\n    onMounted(() => {\n      if (!cryptoSymbol) {\n        router.push('/dashboard');\n        return;\n      }\n\n      // Initialiser le socket et l'authentification\n      initializeSocket();\n\n      // Écouter l'authentification réussie\n      socket.on('authenticated', () => {\n        console.log('Socket authentifié avec succès');\n        isAuthenticated.value = true;\n      });\n\n      // Écouter les mises à jour des prix\n      socket.on('priceUpdate', data => {\n        const crypto = data.find(c => c.symbol === cryptoSymbol);\n        if (crypto) {\n          cryptoData.value = crypto;\n        }\n      });\n\n      // Écouter les réponses de trading\n      socket.on('tradeResponse', response => {\n        if (response.success) {\n          alert(response.message);\n        } else {\n          alert(response.message || 'Erreur lors de la transaction');\n        }\n      });\n\n      // Gérer les erreurs\n      socket.on('error', error => {\n        console.error('Erreur socket:', error);\n        if (error.message.includes('authentification')) {\n          isAuthenticated.value = false;\n          router.push('/login');\n        }\n      });\n\n      // Gérer la déconnexion\n      socket.on('disconnect', () => {\n        console.log('Déconnecté du serveur');\n        isAuthenticated.value = false;\n        // Tenter de se reconnecter\n        setTimeout(initializeSocket, 1000);\n      });\n    });\n    onUnmounted(() => {\n      socket.off('priceUpdate');\n      socket.off('tradeResponse');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.off('disconnect');\n    });\n    return {\n      cryptoSymbol,\n      cryptoData,\n      operationType,\n      amount,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      handleTrade\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","useRoute","useRouter","socket","name","setup","route","router","cryptoSymbol","params","symbol","toUpperCase","cryptoData","operationType","amount","isAuthenticated","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatPriceChange","change","toFixed","getPriceChangeClass","value","priceChange","handleTrade","alert","push","totalPrice","emit","type","parseFloat","error","console","message","initializeSocket","connected","connect","token","localStorage","getItem","on","log","data","crypto","find","c","response","success","includes","setTimeout","off"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Trade.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"max-w-3xl mx-auto\">\n      <div class=\"mb-8\">\n        <button @click=\"$router.back()\" class=\"text-indigo-600 hover:text-indigo-800\">\n          ← Retour\n        </button>\n        <h1 class=\"text-3xl font-bold text-gray-900 mt-4\">\n          Trader {{ cryptoData?.name || cryptoSymbol }}\n        </h1>\n      </div>\n\n      <div class=\"bg-white rounded-lg shadow-lg p-6\">\n        <!-- Prix actuel -->\n        <div class=\"mb-8\">\n          <h2 class=\"text-lg text-gray-600\">Prix actuel</h2>\n          <div class=\"text-4xl font-bold text-gray-900\">\n            {{ formatPrice(cryptoData?.price) }}\n          </div>\n          <div :class=\"getPriceChangeClass()\" class=\"mt-2 text-sm font-medium\">\n            {{ formatPriceChange(cryptoData?.priceChange) }}% sur 24h\n          </div>\n        </div>\n\n        <!-- Formulaire de trading -->\n        <form @submit.prevent=\"handleTrade\">\n          <div class=\"space-y-6\">\n            <!-- Type d'opération -->\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700\">Type d'opération</label>\n              <div class=\"mt-2 grid grid-cols-2 gap-4\">\n                <button\n                  type=\"button\"\n                  :class=\"[\n                    'px-4 py-2 rounded-md text-sm font-medium w-full',\n                    operationType === 'buy'\n                      ? 'bg-green-600 text-white'\n                      : 'bg-gray-100 text-gray-900 hover:bg-gray-200'\n                  ]\"\n                  @click=\"operationType = 'buy'\"\n                >\n                  Acheter\n                </button>\n                <button\n                  type=\"button\"\n                  :class=\"[\n                    'px-4 py-2 rounded-md text-sm font-medium w-full',\n                    operationType === 'sell'\n                      ? 'bg-red-600 text-white'\n                      : 'bg-gray-100 text-gray-900 hover:bg-gray-200'\n                  ]\"\n                  @click=\"operationType = 'sell'\"\n                >\n                  Vendre\n                </button>\n              </div>\n            </div>\n\n            <!-- Montant -->\n            <div>\n              <label for=\"amount\" class=\"block text-sm font-medium text-gray-700\">\n                Montant ({{ cryptoSymbol }})\n              </label>\n              <div class=\"mt-2\">\n                <input\n                  type=\"number\"\n                  id=\"amount\"\n                  v-model=\"amount\"\n                  step=\"0.000001\"\n                  min=\"0\"\n                  class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\n                  required\n                />\n              </div>\n              <p class=\"mt-2 text-sm text-gray-500\">\n                ≈ {{ formatPrice(amount * (cryptoData?.price || 0)) }}\n              </p>\n            </div>\n\n            <!-- Bouton de soumission -->\n            <div>\n              <button\n                type=\"submit\"\n                :class=\"[\n                  'w-full rounded-md px-4 py-2 text-sm font-medium text-white',\n                  operationType === 'buy'\n                    ? 'bg-green-600 hover:bg-green-700'\n                    : 'bg-red-600 hover:bg-red-700'\n                ]\"\n              >\n                {{ operationType === 'buy' ? 'Acheter' : 'Vendre' }}\n                {{ cryptoSymbol }}\n              </button>\n            </div>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { socket } from '@/socket';\n\nexport default {\n  name: 'Trade',\n\n  setup() {\n    const route = useRoute();\n    const router = useRouter();\n    const cryptoSymbol = route.params.symbol?.toUpperCase();\n    const cryptoData = ref(null);\n    const operationType = ref('buy');\n    const amount = ref(0);\n    const isAuthenticated = ref(false);\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const formatPriceChange = (change) => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion du trading\n    const handleTrade = async () => {\n      try {\n        if (!isAuthenticated.value) {\n          alert('Veuillez vous connecter pour effectuer des transactions');\n          router.push('/login');\n          return;\n        }\n\n        if (!amount.value || amount.value <= 0) {\n          alert('Veuillez entrer un montant valide');\n          return;\n        }\n\n        const totalPrice = amount.value * cryptoData.value.price;\n\n        socket.emit('tradeCrypto', {\n          type: operationType.value,\n          symbol: cryptoSymbol,\n          amount: parseFloat(amount.value),\n          price: cryptoData.value.price\n        });\n\n        amount.value = 0;\n      } catch (error) {\n        console.error('Erreur lors de la transaction:', error);\n        alert(error.message || 'Erreur lors de la transaction');\n      }\n    };\n\n    const initializeSocket = () => {\n      if (!socket.connected) {\n        socket.connect();\n      }\n\n      // Authentifier le socket avec le token\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken') || localStorage.getItem('access_token');\n      if (token) {\n        socket.emit('authenticate', token);\n      } else {\n        console.error('Aucun token trouvé dans le localStorage');\n        router.push('/login');\n        return;\n      }\n    };\n\n    onMounted(() => {\n      if (!cryptoSymbol) {\n        router.push('/dashboard');\n        return;\n      }\n\n      // Initialiser le socket et l'authentification\n      initializeSocket();\n\n      // Écouter l'authentification réussie\n      socket.on('authenticated', () => {\n        console.log('Socket authentifié avec succès');\n        isAuthenticated.value = true;\n      });\n\n      // Écouter les mises à jour des prix\n      socket.on('priceUpdate', (data) => {\n        const crypto = data.find(c => c.symbol === cryptoSymbol);\n        if (crypto) {\n          cryptoData.value = crypto;\n        }\n      });\n\n      // Écouter les réponses de trading\n      socket.on('tradeResponse', (response) => {\n        if (response.success) {\n          alert(response.message);\n        } else {\n          alert(response.message || 'Erreur lors de la transaction');\n        }\n      });\n\n      // Gérer les erreurs\n      socket.on('error', (error) => {\n        console.error('Erreur socket:', error);\n        if (error.message.includes('authentification')) {\n          isAuthenticated.value = false;\n          router.push('/login');\n        }\n      });\n\n      // Gérer la déconnexion\n      socket.on('disconnect', () => {\n        console.log('Déconnecté du serveur');\n        isAuthenticated.value = false;\n        // Tenter de se reconnecter\n        setTimeout(initializeSocket, 1000);\n      });\n    });\n\n    onUnmounted(() => {\n      socket.off('priceUpdate');\n      socket.off('tradeResponse');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.off('disconnect');\n    });\n\n    return {\n      cryptoSymbol,\n      cryptoData,\n      operationType,\n      amount,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      handleTrade\n    };\n  }\n};\n</script>\n"],"mappings":"AAsGA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AACjD,SAASC,QAAQ,EAAEC,SAAQ,QAAS,YAAY;AAChD,SAASC,MAAK,QAAS,UAAU;AAEjC,eAAe;EACbC,IAAI,EAAE,OAAO;EAEbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC,CAAC;IACxB,MAAMM,MAAK,GAAIL,SAAS,CAAC,CAAC;IAC1B,MAAMM,YAAW,GAAIF,KAAK,CAACG,MAAM,CAACC,MAAM,EAAEC,WAAW,CAAC,CAAC;IACvD,MAAMC,UAAS,GAAId,GAAG,CAAC,IAAI,CAAC;IAC5B,MAAMe,aAAY,GAAIf,GAAG,CAAC,KAAK,CAAC;IAChC,MAAMgB,MAAK,GAAIhB,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMiB,eAAc,GAAIjB,GAAG,CAAC,KAAK,CAAC;;IAElC;IACA,MAAM