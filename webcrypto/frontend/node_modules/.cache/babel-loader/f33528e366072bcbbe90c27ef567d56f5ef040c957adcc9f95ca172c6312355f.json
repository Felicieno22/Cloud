{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Login',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const showPassword = ref(false);\n    const form = ref({\n      email: '',\n      password: ''\n    });\n    const verificationCode = ref('');\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification']);\n    const togglePasswordVisibility = () => {\n      showPassword.value = !showPassword.value;\n    };\n    const handleSubmit = async () => {\n      try {\n        loading.value = true;\n        await store.dispatch('auth/login', {\n          email: form.value.email,\n          password: form.value.password\n        });\n      } catch (error) {\n        alert(error.message || 'Erreur de connexion');\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handleVerification = async () => {\n      try {\n        loading.value = true;\n        await store.dispatch('auth/verify2FA', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        });\n        router.push('/dashboard');\n      } catch (error) {\n        alert(error.message || 'Erreur lors de la vérification');\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      loading,\n      form,\n      verificationCode,\n      pendingVerification,\n      showPassword,\n      handleSubmit,\n      handleVerification,\n      togglePasswordVisibility\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRouter","name","setup","store","router","loading","showPassword","form","email","password","verificationCode","pendingVerification","getters","togglePasswordVisibility","value","handleSubmit","dispatch","error","alert","message","handleVerification","code","push"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Login.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-900 to-indigo-900 py-12 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-md w-full space-y-8 bg-white/10 backdrop-blur-lg p-8 rounded-2xl shadow-2xl border border-white/20\">\n      <div>\n        <div class=\"flex justify-center\">\n          <div class=\"w-20 h-20 rounded-full bg-indigo-600 flex items-center justify-center\">\n            <svg class=\"w-12 h-12 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"></path>\n            </svg>\n          </div>\n        </div>\n        <h2 class=\"mt-6 text-center text-3xl font-extrabold bg-gradient-to-r from-indigo-200 to-white bg-clip-text text-transparent\">\n          {{ pendingVerification ? 'Vérification en deux étapes' : 'Connexion à CryptoTrade' }}\n        </h2>\n        <p v-if=\"pendingVerification\" class=\"mt-2 text-center text-sm text-gray-300\">\n          {{ pendingVerification.message }}\n        </p>\n      </div>\n\n      <!-- Formulaire de connexion -->\n      <form v-if=\"!pendingVerification\" class=\"mt-8 space-y-6\" @submit.prevent=\"handleSubmit\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div class=\"relative\">\n            <div class=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\">\n              <svg class=\"h-5 w-5 text-indigo-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207\" />\n              </svg>\n            </div>\n            <input\n              id=\"email\"\n              v-model=\"form.email\"\n              type=\"email\"\n              required\n              class=\"appearance-none rounded-t-lg relative block w-full px-3 py-3 pl-10 border border-gray-600 placeholder-gray-400 text-white bg-gray-800/50 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Email\"\n            />\n          </div>\n          <div class=\"relative\">\n            <div class=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\">\n              <svg class=\"h-5 w-5 text-indigo-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\" />\n              </svg>\n            </div>\n            <div class=\"absolute inset-y-0 right-0 pr-3 flex items-center\">\n              <button\n                type=\"button\"\n                @click=\"togglePasswordVisibility\"\n                class=\"text-indigo-400 hover:text-indigo-300 focus:outline-none\"\n              >\n                <svg v-if=\"showPassword\" class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\" />\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\" />\n                </svg>\n                <svg v-else class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21\" />\n                </svg>\n              </button>\n            </div>\n            <input\n              id=\"password\"\n              v-model=\"form.password\"\n              :type=\"showPassword ? 'text' : 'password'\"\n              required\n              class=\"appearance-none rounded-b-lg relative block w-full px-3 py-3 pl-10 border border-t-0 border-gray-600 placeholder-gray-400 text-white bg-gray-800/50 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Mot de passe\"\n            />\n          </div>\n        </div>\n\n        <div class=\"flex items-center justify-between\">\n          <div class=\"flex items-center\">\n            <input\n              id=\"remember-me\"\n              type=\"checkbox\"\n              class=\"h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-600 rounded bg-gray-800/50\"\n            />\n            <label for=\"remember-me\" class=\"ml-2 block text-sm text-gray-300\">\n              Se souvenir de moi\n            </label>\n          </div>\n\n          <div class=\"text-sm\">\n            <a href=\"#\" class=\"font-medium text-indigo-400 hover:text-indigo-300\">\n              Mot de passe oublié ?\n            </a>\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-semibold rounded-lg text-white bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transform transition-all duration-150 hover:scale-[1.02] disabled:opacity-50 disabled:cursor-not-allowed\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-300 group-hover:text-indigo-200\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-indigo-300\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Connexion...' : 'Se connecter' }}\n          </button>\n        </div>\n\n        <div class=\"text-center\">\n          <p class=\"text-sm text-gray-300\">\n            Pas encore de compte ?\n            <router-link to=\"/register\" class=\"font-medium text-indigo-400 hover:text-indigo-300\">\n              Créer un compte\n            </router-link>\n          </p>\n        </div>\n      </form>\n\n      <!-- Formulaire de vérification 2FA -->\n      <form v-else class=\"mt-8 space-y-6\" @submit.prevent=\"handleVerification\">\n        <div class=\"rounded-md shadow-sm\">\n          <div class=\"relative\">\n            <div class=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\">\n              <svg class=\"h-5 w-5 text-indigo-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\" />\n              </svg>\n            </div>\n            <input\n              id=\"verification-code\"\n              v-model=\"verificationCode\"\n              type=\"text\"\n              required\n              pattern=\"[0-9]*\"\n              inputmode=\"numeric\"\n              class=\"appearance-none rounded-lg relative block w-full px-3 py-3 pl-10 border border-gray-600 placeholder-gray-400 text-white bg-gray-800/50 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Code de vérification\"\n            />\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading || !verificationCode\"\n            class=\"group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-semibold rounded-lg text-white bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transform transition-all duration-150 hover:scale-[1.02] disabled:opacity-50 disabled:cursor-not-allowed\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-300 group-hover:text-indigo-200\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-indigo-300\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Vérification...' : 'Vérifier' }}\n          </button>\n        </div>\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  name: 'Login',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const loading = ref(false)\n    const showPassword = ref(false)\n    const form = ref({\n      email: '',\n      password: ''\n    })\n    const verificationCode = ref('')\n\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification'])\n\n    const togglePasswordVisibility = () => {\n      showPassword.value = !showPassword.value\n    }\n\n    const handleSubmit = async () => {\n      try {\n        loading.value = true\n        await store.dispatch('auth/login', {\n          email: form.value.email,\n          password: form.value.password\n        })\n      } catch (error) {\n        alert(error.message || 'Erreur de connexion')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    const handleVerification = async () => {\n      try {\n        loading.value = true\n        await store.dispatch('auth/verify2FA', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        })\n        router.push('/dashboard')\n      } catch (error) {\n        alert(error.message || 'Erreur lors de la vérification')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    return {\n      loading,\n      form,\n      verificationCode,\n      pendingVerification,\n      showPassword,\n      handleSubmit,\n      handleVerification,\n      togglePasswordVisibility\n    }\n  }\n}\n</script>\n\n<style scoped>\n.min-h-screen {\n  background-image: \n    radial-gradient(circle at 100% 100%, rgba(79, 70, 229, 0.1) 0%, transparent 50%),\n    radial-gradient(circle at 0% 0%, rgba(59, 130, 246, 0.1) 0%, transparent 50%);\n}\n\n@keyframes pulse {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.05); }\n}\n\n.animate-pulse {\n  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n}\n\n/* Glassmorphism effect */\n.bg-white\\/10 {\n  background: rgba(255, 255, 255, 0.1);\n}\n\n.backdrop-blur-lg {\n  backdrop-filter: blur(20px);\n}\n\n/* Input focus animation */\ninput:focus {\n  animation: glow 1s ease-in-out infinite alternate;\n}\n\n@keyframes glow {\n  from {\n    box-shadow: 0 0 5px #4f46e5, 0 0 10px #4f46e5, 0 0 15px #4338ca;\n  }\n  to {\n    box-shadow: 0 0 10px #4f46e5, 0 0 20px #4f46e5, 0 0 30px #4338ca;\n  }\n}\n\n/* Button hover animation */\nbutton:not(:disabled):hover {\n  transform: translateY(-2px);\n  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);\n}\n\n.from-indigo-600 {\n  --tw-gradient-from: #4f46e5;\n  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(79, 70, 229, 0));\n}\n\n.to-blue-600 {\n  --tw-gradient-to: #2563eb;\n}\n</style>\n"],"mappings":"AAmKA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,OAAO;EAEbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,OAAM,GAAIR,GAAG,CAAC,KAAK;IACzB,MAAMS,YAAW,GAAIT,GAAG,CAAC,KAAK;IAC9B,MAAMU,IAAG,GAAIV,GAAG,CAAC;MACfW,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE;IACZ,CAAC;IACD,MAAMC,gBAAe,GAAIb,GAAG,CAAC,EAAE;IAE/B,MAAMc,mBAAkB,GAAIb,QAAQ,CAAC,MAAMK,KAAK,CAACS,OAAO,CAAC,0BAA0B,CAAC;IAEpF,MAAMC,wBAAuB,GAAIA,CAAA,KAAM;MACrCP,YAAY,CAACQ,KAAI,GAAI,CAACR,YAAY,CAACQ,KAAI;IACzC;IAEA,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACFV,OAAO,CAACS,KAAI,GAAI,IAAG;QACnB,MAAMX,KAAK,CAACa,QAAQ,CAAC,YAAY,EAAE;UACjCR,KAAK,EAAED,IAAI,CAACO,KAAK,CAACN,KAAK;UACvBC,QAAQ,EAAEF,IAAI,CAACO,KAAK,CAACL;QACvB,CAAC;MACH,EAAE,OAAOQ,KAAK,EAAE;QACdC,KAAK,CAACD,KAAK,CAACE,OAAM,I