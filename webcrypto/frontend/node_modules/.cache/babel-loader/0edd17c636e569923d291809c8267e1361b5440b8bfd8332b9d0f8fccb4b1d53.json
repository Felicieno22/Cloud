{"ast":null,"code":"import { ref } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const error = ref('');\n    const form = ref({\n      email: '',\n      password: ''\n    });\n    const handleSubmit = async () => {\n      loading.value = true;\n      error.value = '';\n      try {\n        await store.dispatch('auth/login', {\n          email: form.value.email,\n          password: form.value.password\n        });\n        router.push('/dashboard');\n      } catch (err) {\n        error.value = err;\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      form,\n      loading,\n      error,\n      handleSubmit\n    };\n  }\n};","map":{"version":3,"names":["ref","useStore","useRouter","setup","store","router","loading","error","form","email","password","handleSubmit","value","dispatch","push","err"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\Login.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-md w-full space-y-8\">\n      <div>\n        <h2 class=\"mt-6 text-center text-3xl font-extrabold text-gray-900\">\n          Connexion à votre compte\n        </h2>\n      </div>\n\n      <!-- Formulaire de connexion -->\n      <form class=\"mt-8 space-y-6\" @submit.prevent=\"handleSubmit\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"email\" class=\"sr-only\">Email</label>\n            <input\n              id=\"email\"\n              v-model=\"form.email\"\n              type=\"email\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Email\"\n            />\n          </div>\n          <div>\n            <label for=\"password\" class=\"sr-only\">Mot de passe</label>\n            <input\n              id=\"password\"\n              v-model=\"form.password\"\n              type=\"password\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Mot de passe\"\n            />\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-white\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Connexion...' : 'Se connecter' }}\n          </button>\n        </div>\n\n        <div v-if=\"error\" class=\"mt-4 text-center text-sm text-red-600\">\n          {{ error }}\n        </div>\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const loading = ref(false)\n    const error = ref('')\n    const form = ref({\n      email: '',\n      password: ''\n    })\n\n    const handleSubmit = async () => {\n      loading.value = true\n      error.value = ''\n      \n      try {\n        await store.dispatch('auth/login', {\n          email: form.value.email,\n          password: form.value.password\n        })\n        router.push('/dashboard')\n      } catch (err) {\n        error.value = err\n      } finally {\n        loading.value = false\n      }\n    }\n\n    return {\n      form,\n      loading,\n      error,\n      handleSubmit\n    }\n  }\n}\n</script>\n"],"mappings":"AAgEA,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIH,QAAQ,CAAC;IACvB,MAAMI,MAAK,GAAIH,SAAS,CAAC;IACzB,MAAMI,OAAM,GAAIN,GAAG,CAAC,KAAK;IACzB,MAAMO,KAAI,GAAIP,GAAG,CAAC,EAAE;IACpB,MAAMQ,IAAG,GAAIR,GAAG,CAAC;MACfS,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE;IACZ,CAAC;IAED,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/BL,OAAO,CAACM,KAAI,GAAI,IAAG;MACnBL,KAAK,CAACK,KAAI,GAAI,EAAC;MAEf,IAAI;QACF,MAAMR,KAAK,CAACS,QAAQ,CAAC,YAAY,EAAE;UACjCJ,KAAK,EAAED,IAAI,CAACI,KAAK,CAACH,KAAK;UACvBC,QAAQ,EAAEF,IAAI,CAACI,KAAK,CAACF;QACvB,CAAC;QACDL,MAAM,CAACS,IAAI,CAAC,YAAY;MAC1B,EAAE,OAAOC,GAAG,EAAE;QACZR,KAAK,CAACK,KAAI,GAAIG,GAAE;MAClB,UAAU;QACRT,OAAO,CAACM,KAAI,GAAI,KAAI;MACtB;IACF;IAEA,OAAO;MACLJ,IAAI;MACJF,OAAO;MACPC,KAAK;MACLI;IACF;EACF;AACF","ignoreList":