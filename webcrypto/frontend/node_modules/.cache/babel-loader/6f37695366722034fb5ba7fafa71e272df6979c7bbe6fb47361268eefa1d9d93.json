{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Login',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const showPassword = ref(false);\n    const form = ref({\n      email: '',\n      password: ''\n    });\n    const verificationCode = ref('');\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification']);\n    const handleSubmit = async () => {\n      try {\n        loading.value = true;\n        await store.dispatch('auth/login', {\n          email: form.value.email,\n          password: form.value.password\n        });\n        // Ne pas rediriger, attendre la vérification 2FA\n      } catch (error) {\n        alert(error.message || 'Erreur de connexion');\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handleVerification = async () => {\n      try {\n        loading.value = true;\n        await store.dispatch('auth/verify2FA', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        });\n        router.push('/dashboard');\n      } catch (error) {\n        alert(error.message || 'Erreur lors de la vérification');\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      loading,\n      showPassword,\n      form,\n      verificationCode,\n      pendingVerification,\n      handleSubmit,\n      handleVerification\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRouter","name","setup","store","router","loading","showPassword","form","email","password","verificationCode","pendingVerification","getters","handleSubmit","value","dispatch","error","alert","message","handleVerification","code","push"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Login.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-md w-full space-y-8\">\n      <div>\n        <h2 class=\"mt-6 text-center text-3xl font-extrabold text-gray-900\">\n          {{ pendingVerification ? 'Vérification en deux étapes' : 'Connexion à votre compte' }}\n        </h2>\n        <p v-if=\"pendingVerification\" class=\"mt-2 text-center text-sm text-gray-600\">\n          {{ pendingVerification.message }}\n        </p>\n      </div>\n\n      <!-- Formulaire de connexion -->\n      <form v-if=\"!pendingVerification\" class=\"mt-8 space-y-6\" @submit.prevent=\"handleSubmit\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"email\" class=\"sr-only\">Email</label>\n            <input\n              id=\"email\"\n              v-model=\"form.email\"\n              type=\"email\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Email\"\n            />\n          </div>\n          <div>\n            <label for=\"password\" class=\"sr-only\">Mot de passe</label>\n            <div class=\"relative\">\n              <input\n                id=\"password\"\n                v-model=\"form.password\"\n                :type=\"showPassword ? 'text' : 'password'\"\n                required\n                class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n                placeholder=\"Mot de passe\"\n              />\n              <button\n                type=\"button\"\n                @click=\"showPassword = !showPassword\"\n                class=\"absolute inset-y-0 right-0 pr-3 flex items-center\"\n              >\n                <svg\n                  v-if=\"showPassword\"\n                  class=\"h-5 w-5 text-gray-500 hover:text-gray-600\"\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 20 20\"\n                  fill=\"currentColor\"\n                >\n                  <path d=\"M10 12a2 2 0 100-4 2 2 0 000 4z\" />\n                  <path fill-rule=\"evenodd\" d=\"M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z\" clip-rule=\"evenodd\" />\n                </svg>\n                <svg\n                  v-else\n                  class=\"h-5 w-5 text-gray-500 hover:text-gray-600\"\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"0 0 20 20\"\n                  fill=\"currentColor\"\n                >\n                  <path fill-rule=\"evenodd\" d=\"M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z\" clip-rule=\"evenodd\" />\n                  <path d=\"M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.065 7 9.542 7 .847 0 1.669-.105 2.454-.303z\" />\n                </svg>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-indigo-500\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Connexion...' : 'Se connecter' }}\n          </button>\n        </div>\n      </form>\n\n      <!-- Formulaire de vérification 2FA -->\n      <form v-else class=\"mt-8 space-y-6\" @submit.prevent=\"handleVerification\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"verification-code\" class=\"sr-only\">Code de vérification</label>\n            <input\n              id=\"verification-code\"\n              v-model=\"verificationCode\"\n              type=\"text\"\n              required\n              pattern=\"[0-9]*\"\n              inputmode=\"numeric\"\n              class=\"appearance-none rounded relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Code de vérification\"\n            />\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading || !verificationCode\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-indigo-500\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Vérification...' : 'Vérifier' }}\n          </button>\n        </div>\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  name: 'Login',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const loading = ref(false)\n    const showPassword = ref(false)\n    const form = ref({\n      email: '',\n      password: ''\n    })\n    const verificationCode = ref('')\n\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification'])\n\n    const handleSubmit = async () => {\n      try {\n        loading.value = true\n        await store.dispatch('auth/login', {\n          email: form.value.email,\n          password: form.value.password\n        })\n        // Ne pas rediriger, attendre la vérification 2FA\n      } catch (error) {\n        alert(error.message || 'Erreur de connexion')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    const handleVerification = async () => {\n      try {\n        loading.value = true\n        await store.dispatch('auth/verify2FA', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        })\n        router.push('/dashboard')\n      } catch (error) {\n        alert(error.message || 'Erreur lors de la vérification')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    return {\n      loading,\n      showPassword,\n      form,\n      verificationCode,\n      pendingVerification,\n      handleSubmit,\n      handleVerification\n    }\n  }\n}\n</script>\n\n<style scoped>\n.min-h-screen {\n  background: linear-gradient(135deg, #f6f9fc 0%, #edf2f7 100%);\n  position: relative;\n  overflow: hidden;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 2rem;\n}\n\n.min-h-screen::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: \n    radial-gradient(circle at 0% 0%, rgba(79, 70, 229, 0.03) 0%, transparent 50%),\n    radial-gradient(circle at 100% 100%, rgba(79, 70, 229, 0.03) 0%, transparent 50%),\n    url(\"data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3