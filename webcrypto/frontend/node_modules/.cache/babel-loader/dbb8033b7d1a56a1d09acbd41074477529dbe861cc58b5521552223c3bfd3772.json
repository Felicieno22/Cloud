{"ast":null,"code":"import { computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter, useRoute } from 'vue-router';\nimport NotificationsDropdown from '@/components/NotificationsDropdown.vue';\nexport default {\n  name: 'App',\n  components: {\n    NotificationsDropdown\n  },\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const route = useRoute();\n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated']);\n    const isAdminRoute = computed(() => {\n      return route.path.startsWith('/admin') && route.name !== 'AdminLogin' || route.path === '/commission-settings' || route.path === '/transactions-summary';\n    });\n    const handleLogout = async () => {\n      await store.dispatch('auth/logout');\n      router.push('/login');\n    };\n\n    // Vérifier l'authentification au démarrage\n    store.dispatch('auth/init');\n    return {\n      isAuthenticated,\n      isAdminRoute,\n      handleLogout,\n      route\n    };\n  }\n};","map":{"version":3,"names":["computed","useStore","useRouter","useRoute","NotificationsDropdown","name","components","setup","store","router","route","isAuthenticated","getters","isAdminRoute","path","startsWith","handleLogout","dispatch","push"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div>\n    <!-- Navigation principale - cachée pour les pages admin -->\n    <nav v-if=\"!isAdminRoute\" class=\"bg-white shadow\">\n      <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"flex justify-between h-16\">\n          <div class=\"flex\">\n            <div class=\"flex-shrink-0 flex items-center\">\n              <router-link to=\"/\" class=\"text-xl font-bold text-indigo-600\">\n                CryptoTrade\n              </router-link>\n            </div>\n          </div>\n          <div class=\"flex items-center space-x-4\">\n            <!-- Liens pour utilisateur non authentifié -->\n            <template v-if=\"!isAuthenticated\">\n              <router-link\n                to=\"/login\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Connexion\n              </router-link>\n              <router-link\n                to=\"/register\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Inscription\n              </router-link>\n              <router-link\n                to=\"/admin/login\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Admin\n              </router-link>\n            </template>\n            <!-- Liens pour utilisateur authentifié -->\n            <template v-else>\n              <router-link\n                to=\"/dashboard\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Dashboard\n              </router-link>\n              <router-link\n                to=\"/wallet\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Portefeuille\n              </router-link>\n              <router-link\n                to=\"/transactions\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Transactions\n              </router-link>\n              <router-link\n                to=\"/analysis\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Analyses\n              </router-link>\n              <router-link\n                to=\"/commission-analysis\"\n                class=\"text-gray-700 hover:text-indigo-600\"\n              >\n                Commissions\n              </router-link>\n              <template v-if=\"isAdmin\">\n                <router-link\n                  to=\"/commission-settings\"\n                  class=\"text-gray-700 hover:text-indigo-600\"\n                >\n                  Paramètres Commissions\n                </router-link>\n              </template>\n              <NotificationsDropdown />\n              <button\n                @click=\"handleLogout\"\n                class=\"text-red-600 hover:text-red-800\"\n              >\n                Déconnexion\n              </button>\n            </template>\n          </div>\n        </div>\n      </div>\n    </nav>\n\n    <router-view />\n  </div>\n</template>\n\n<script>\nimport { computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter, useRoute } from 'vue-router'\nimport NotificationsDropdown from '@/components/NotificationsDropdown.vue'\n\nexport default {\n  name: 'App',\n  components: {\n    NotificationsDropdown\n  },\n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const route = useRoute()\n    \n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated'])\n    const isAdminRoute = computed(() => {\n      return (route.path.startsWith('/admin') && route.name !== 'AdminLogin') || \n             route.path === '/commission-settings' || \n             route.path === '/transactions-summary'\n    })\n    \n    const handleLogout = async () => {\n      await store.dispatch('auth/logout')\n      router.push('/login')\n    }\n\n    // Vérifier l'authentification au démarrage\n    store.dispatch('auth/init')\n\n    return {\n      isAuthenticated,\n      isAdminRoute,\n      handleLogout,\n      route\n    }\n  }\n}\n</script>\n"],"mappings":"AA6FA,SAASA,QAAO,QAAS,KAAI;AAC7B,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAS,EAAEC,QAAO,QAAS,YAAW;AAC/C,OAAOC,qBAAoB,MAAO,wCAAuC;AAEzE,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIP,QAAQ,CAAC;IACvB,MAAMQ,MAAK,GAAIP,SAAS,CAAC;IACzB,MAAMQ,KAAI,GAAIP,QAAQ,CAAC;IAEvB,MAAMQ,eAAc,GAAIX,QAAQ,CAAC,MAAMQ,KAAK,CAACI,OAAO,CAAC,sBAAsB,CAAC;IAC5E,MAAMC,YAAW,GAAIb,QAAQ,CAAC,MAAM;MAClC,OAAQU,KAAK,CAACI,IAAI,CAACC,U