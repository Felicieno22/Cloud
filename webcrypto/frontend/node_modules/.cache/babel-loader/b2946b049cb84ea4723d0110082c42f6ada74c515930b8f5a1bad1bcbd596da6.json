{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted, watch } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nimport AdminHeader from '@/components/AdminHeader.vue';\nexport default {\n  name: 'UserTransactionsSummary',\n  components: {\n    AdminHeader\n  },\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const userSummaries = ref([]);\n    const filters = ref({\n      dateMax: new Date().toISOString().slice(0, 16) // Format YYYY-MM-DDTHH:mm\n    });\n    const isAuthenticated = ref(false);\n    const formatPrice = price => {\n      if (!price) return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const fetchUserSummaries = () => {\n      if (!isAuthenticated.value) return;\n      socket.emit('getUserTransactionsSummary', {\n        dateMax: filters.value.dateMax\n      });\n    };\n    const initializeSocket = () => {\n      // Vérifier si l'utilisateur est admin\n      const isAdmin = store.getters['auth/isAdmin'];\n      if (!isAdmin) {\n        console.log('Accès refusé : droits administrateur requis');\n        router.push('/login');\n        return;\n      }\n\n      // Récupérer le token\n      const token = localStorage.getItem('token');\n      if (!token) {\n        console.log('Token non trouvé');\n        router.push('/login');\n        return;\n      }\n\n      // Se connecter et s'authentifier\n      if (!socket.connected) {\n        socket.connect();\n      }\n      socket.emit('authenticate', token);\n\n      // Écouter les événements socket\n      socket.on('authenticated', () => {\n        console.log('Socket authentifié avec succès');\n        isAuthenticated.value = true;\n        fetchUserSummaries();\n      });\n      socket.on('userTransactionsSummary', data => {\n        console.log('Données reçues:', data);\n        userSummaries.value = data;\n      });\n      socket.on('error', error => {\n        console.error('Erreur socket:', error);\n        if (error.message.includes('authentification') || error.message.includes('droits')) {\n          isAuthenticated.value = false;\n          router.push('/login');\n        }\n      });\n      socket.on('disconnect', () => {\n        console.log('Socket déconnecté');\n        isAuthenticated.value = false;\n      });\n    };\n\n    // Initialiser au montage du composant\n    onMounted(() => {\n      initializeSocket();\n    });\n\n    // Nettoyer à la destruction du composant\n    onUnmounted(() => {\n      const events = ['authenticated', 'userTransactionsSummary', 'error', 'disconnect'];\n      events.forEach(event => socket.off(event));\n      socket.disconnect();\n    });\n\n    // Observer les changements de filtre\n    watch(() => filters.value.dateMax, () => {\n      if (isAuthenticated.value) {\n        fetchUserSummaries();\n      }\n    });\n    return {\n      userSummaries,\n      filters,\n      formatPrice\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","watch","useStore","useRouter","socket","AdminHeader","name","components","setup","store","router","userSummaries","filters","dateMax","Date","toISOString","slice","isAuthenticated","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","fetchUserSummaries","value","emit","initializeSocket","isAdmin","getters","console","log","push","token","localStorage","getItem","connected","connect","on","data","error","message","includes","events","forEach","event","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\UserTransactionsSummary.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-gray-50\">\n    <AdminHeader />\n    \n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n      <h1 class=\"text-3xl font-extrabold text-gray-900 mb-8\">Récapitulatif des Transactions par Utilisateur</h1>\n\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-200 hover:shadow-md\">\n        <!-- Filtres -->\n        <div class=\"p-6 border-b border-gray-100 bg-white\">\n          <div class=\"grid grid-cols-1 gap-6\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-2\">Date et heure max</label>\n              <input\n                type=\"datetime-local\"\n                v-model=\"filters.dateMax\"\n                class=\"w-full rounded-lg border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors duration-200\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Tableau récapitulatif -->\n        <div class=\"overflow-x-auto\">\n          <table class=\"min-w-full divide-y divide-gray-200\">\n            <thead>\n              <tr class=\"bg-gray-50\">\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Utilisateur</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Total Achat</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Total Vente</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Valeur portefeuille</th>\n              </tr>\n            </thead>\n            <tbody class=\"bg-white divide-y divide-gray-100\">\n              <tr v-for=\"summary in userSummaries\" \n                  :key=\"summary.username\" \n                  class=\"hover:bg-gray-50 transition-colors duration-150\">\n                <td class=\"px-6 py-4 whitespace-nowrap\">\n                  <div class=\"flex items-center\">\n                    <div class=\"h-8 w-8 rounded-full bg-indigo-100 flex items-center justify-center\">\n                      <span class=\"text-sm font-medium text-indigo-700\">\n                        {{ summary.username[0]?.toUpperCase() }}\n                      </span>\n                    </div>\n                    <span class=\"ml-3 text-sm text-gray-900\">{{ summary.username }}</span>\n                  </div>\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\n                  {{ formatPrice(summary.totalBuy) }}\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\n                  {{ formatPrice(summary.totalSell) }}\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900\">\n                  {{ formatPrice(summary.portfolioValue) }}\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed, onMounted, onUnmounted, watch } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\nimport { socket } from '@/socket'\nimport AdminHeader from '@/components/AdminHeader.vue'\n\nexport default {\n  name: 'UserTransactionsSummary',\n  components: {\n    AdminHeader\n  },\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const userSummaries = ref([])\n    const filters = ref({\n      dateMax: new Date().toISOString().slice(0, 16) // Format YYYY-MM-DDTHH:mm\n    })\n    const isAuthenticated = ref(false)\n\n    const formatPrice = (price) => {\n      if (!price) return '$0.00'\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price)\n    }\n\n    const fetchUserSummaries = () => {\n      if (!isAuthenticated.value) return\n      socket.emit('getUserTransactionsSummary', {\n        dateMax: filters.value.dateMax\n      })\n    }\n\n    const initializeSocket = () => {\n      // Vérifier si l'utilisateur est admin\n      const isAdmin = store.getters['auth/isAdmin']\n      if (!isAdmin) {\n        console.log('Accès refusé : droits administrateur requis')\n        router.push('/login')\n        return\n      }\n\n      // Récupérer le token\n      const token = localStorage.getItem('token')\n      if (!token) {\n        console.log('Token non trouvé')\n        router.push('/login')\n        return\n      }\n\n      // Se connecter et s'authentifier\n      if (!socket.connected) {\n        socket.connect()\n      }\n\n      socket.emit('authenticate', token)\n\n      // Écouter les événements socket\n      socket.on('authenticated', () => {\n        console.log('Socket authentifié avec succès')\n        isAuthenticated.value = true\n        fetchUserSummaries()\n      })\n\n      socket.on('userTransactionsSummary', (data) => {\n        console.log('Données reçues:', data)\n        userSummaries.value = data\n      })\n\n      socket.on('error', (error) => {\n        console.error('Erreur socket:', error)\n        if (error.message.includes('authentification') || error.message.includes('droits')) {\n          isAuthenticated.value = false\n          router.push('/login')\n        }\n      })\n\n      socket.on('disconnect', () => {\n        console.log('Socket déconnecté')\n        isAuthenticated.value = false\n      })\n    }\n\n    // Initialiser au montage du composant\n    onMounted(() => {\n      initializeSocket()\n    })\n\n    // Nettoyer à la destruction du composant\n    onUnmounted(() => {\n      const events = ['authenticated', 'userTransactionsSummary', 'error', 'disconnect']\n      events.forEach(event => socket.off(event))\n      socket.disconnect()\n    })\n\n    // Observer les changements de filtre\n    watch(() => filters.value.dateMax, () => {\n      if (isAuthenticated.value) {\n        fetchUserSummaries()\n      }\n    })\n\n    return {\n      userSummaries,\n      filters,\n      formatPrice\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: #f1f1f1;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #ddd;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #cdcdcd;\n}\n</style> "],"mappings":"AAkEA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAW,EAAEC,KAAI,QAAS,KAAI;AACjE,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,MAAK,QAAS,UAAS;AAChC,OAAOC,WAAU,MAAO,8BAA6B;AAErD,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVF;EACF,CAAC;EAEDG,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIP,QAAQ,CAAC;IACvB,MAAMQ,MAAK,GAAIP,SAAS,CAAC;IACzB,MAAMQ,aAAY,GAAId,GAAG,CAAC,EAAE;IAC5B,MAAMe,OAAM,GAAIf,GAAG,CAAC;MAClBgB,OAAO,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAE,EAAE,EAAE;IACjD,CAAC;IACD,MAAMC,eAAc,GAAIpB,GAAG,CAAC,KAAK;IAEjC,MAAMqB,WAAU,GAAKC,KAAK,IAAK;MAC7B,IAAI,CAACA,KAAK,EAAE,OAAO,OAAM;MACzB,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE,KAAK;QACfC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACP,KAAK;IACjB;IAEA,MAAMQ,kBAAiB,GAAIA,CAAA,KAAM;MAC/B,IAAI,CAACV,eAAe,CAACW,KAAK,EAAE;MAC5BxB,MAAM,CAACyB,IAAI,CAAC,4BAA4B,EAAE;QACxChB,OAAO,EAAED,OAAO,CAACgB,KAAK,CAACf;MACzB,CAAC;IACH;IAEA,MAAMiB,gBAAe,GAAIA,CAAA,KAAM;MAC7B;MACA,MAAMC,OAAM,GAAItB,KAAK,CAACuB,OAAO,CAAC,cAAc;MAC5C,IAAI,CAACD,OAAO,EAAE;QACZE,OAAO,CAACC,GAAG,CAAC,6CAA6C;QACzDxB,MAAM,CAACyB,IAAI,CAAC,QAAQ;QACpB;MACF;;MAEA;MACA,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO;MAC1C,IAAI,CAACF,KAAK,EAAE;QACVH,OAAO,CAACC,GAAG,CAAC,kBAAkB;QAC9BxB,MAAM,CAACyB,IAAI,CAAC,QAAQ;QACpB;MACF;;MAEA;MACA,IAAI,CAAC