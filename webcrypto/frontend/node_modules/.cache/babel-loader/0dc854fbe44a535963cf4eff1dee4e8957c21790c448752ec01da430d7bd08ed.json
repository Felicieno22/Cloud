{"ast":null,"code":"import { ref, onMounted, onUnmounted, computed } from 'vue';\nimport { useRoute } from 'vue-router';\nimport { socket } from '@/socket';\nimport { Chart as ChartJS, CategoryScale, LinearScale, PointElement, LineElement, TimeScale, Title, Tooltip, Legend } from 'chart.js';\nimport { Line } from 'vue-chartjs';\nChartJS.register(CategoryScale, LinearScale, PointElement, LineElement, TimeScale, Title, Tooltip, Legend);\nexport default {\n  name: 'CryptoDetail',\n  components: {\n    Line\n  },\n  setup() {\n    const route = useRoute();\n    const cryptoSymbol = route.params.symbol;\n    const cryptoData = ref(null);\n    const priceHistory = ref([]);\n    const isLoading = ref(true);\n\n    // Charger l'historique des prix\n    const loadPriceHistory = async () => {\n      try {\n        const response = await fetch(`http://localhost:3000/api/cryptocurrencies/${cryptoSymbol}/history`);\n        if (!response.ok) throw new Error('Erreur lors du chargement de l\\'historique');\n        const data = await response.json();\n        priceHistory.value = data.map(item => ({\n          price: parseFloat(item.price),\n          timestamp: new Date(item.timestamp)\n        })).reverse(); // Inverser pour avoir l'ordre chronologique\n      } catch (error) {\n        console.error('Erreur:', error);\n      } finally {\n        isLoading.value = false;\n      }\n    };\n\n    // Configuration du graphique\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      scales: {\n        x: {\n          type: 'time',\n          time: {\n            unit: 'minute',\n            displayFormats: {\n              minute: 'HH:mm'\n            }\n          },\n          title: {\n            display: true,\n            text: 'Heure'\n          }\n        },\n        y: {\n          beginAtZero: false,\n          ticks: {\n            callback: value => formatPrice(value)\n          },\n          title: {\n            display: true,\n            text: 'Prix'\n          }\n        }\n      },\n      plugins: {\n        legend: {\n          display: false\n        },\n        tooltip: {\n          callbacks: {\n            label: context => formatPrice(context.raw)\n          }\n        }\n      }\n    };\n    const chartData = computed(() => ({\n      labels: priceHistory.value.map(item => item.timestamp),\n      datasets: [{\n        label: cryptoSymbol,\n        data: priceHistory.value.map(item => item.price),\n        borderColor: '#4F46E5',\n        tension: 0.1,\n        pointRadius: 2\n      }]\n    }));\n\n    // Formatage des prix\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const formatPriceChange = change => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion des mises à jour en temps réel\n    socket.on('priceUpdate', data => {\n      const crypto = data.find(c => c.symbol === cryptoSymbol);\n      if (crypto) {\n        cryptoData.value = crypto;\n        // Ajouter le nouveau prix à l'historique\n        priceHistory.value.push({\n          price: crypto.price,\n          timestamp: new Date()\n        });\n      }\n    });\n    onMounted(() => {\n      socket.connect();\n      loadPriceHistory();\n    });\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n    return {\n      cryptoSymbol,\n      cryptoData,\n      chartData,\n      chartOptions,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      isLoading\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","computed","useRoute","socket","Chart","ChartJS","CategoryScale","LinearScale","PointElement","LineElement","TimeScale","Title","Tooltip","Legend","Line","register","name","components","setup","route","cryptoSymbol","params","symbol","cryptoData","priceHistory","isLoading","loadPriceHistory","response","fetch","ok","Error","data","json","value","map","item","price","parseFloat","timestamp","Date","reverse","error","console","chartOptions","responsive","maintainAspectRatio","scales","x","type","time","unit","displayFormats","minute","title","display","text","y","beginAtZero","ticks","callback","formatPrice","plugins","legend","tooltip","callbacks","label","context","raw","chartData","labels","datasets","borderColor","tension","pointRadius","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatPriceChange","change","toFixed","getPriceChangeClass","priceChange","on","crypto","find","c","push","connect","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\CryptoDetail.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"mb-8 flex items-center\">\n      <button @click=\"$router.push('/dashboard')\" class=\"mr-4 text-indigo-600 hover:text-indigo-800\">\n        ← Retour\n      </button>\n      <h1 class=\"text-3xl font-bold text-gray-900\">{{ cryptoSymbol }}</h1>\n    </div>\n\n    <div class=\"bg-white rounded-lg shadow-lg p-6\">\n      <div class=\"flex justify-between items-center mb-6\">\n        <div>\n          <h2 class=\"text-2xl font-bold\">{{ cryptoData?.name }}</h2>\n          <p class=\"text-gray-600\">Prix actuel: {{ formatPrice(cryptoData?.price) }}</p>\n        </div>\n        <div :class=\"getPriceChangeClass()\" class=\"text-lg font-semibold\">\n          {{ formatPriceChange(cryptoData?.priceChange) }}%\n        </div>\n      </div>\n\n      <div class=\"h-96\">\n        <Line v-if=\"chartData\" :data=\"chartData\" :options=\"chartOptions\" />\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted, computed } from 'vue';\nimport { useRoute } from 'vue-router';\nimport { socket } from '@/socket';\nimport {\n  Chart as ChartJS,\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  TimeScale,\n  Title,\n  Tooltip,\n  Legend\n} from 'chart.js';\nimport { Line } from 'vue-chartjs';\n\nChartJS.register(\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  TimeScale,\n  Title,\n  Tooltip,\n  Legend\n);\n\nexport default {\n  name: 'CryptoDetail',\n  components: { Line },\n\n  setup() {\n    const route = useRoute();\n    const cryptoSymbol = route.params.symbol;\n    const cryptoData = ref(null);\n    const priceHistory = ref([]);\n    const isLoading = ref(true);\n\n    // Charger l'historique des prix\n    const loadPriceHistory = async () => {\n      try {\n        const response = await fetch(`http://localhost:3000/api/cryptocurrencies/${cryptoSymbol}/history`);\n        if (!response.ok) throw new Error('Erreur lors du chargement de l\\'historique');\n        \n        const data = await response.json();\n        priceHistory.value = data.map(item => ({\n          price: parseFloat(item.price),\n          timestamp: new Date(item.timestamp)\n        })).reverse(); // Inverser pour avoir l'ordre chronologique\n      } catch (error) {\n        console.error('Erreur:', error);\n      } finally {\n        isLoading.value = false;\n      }\n    };\n\n    // Configuration du graphique\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      scales: {\n        x: {\n          type: 'time',\n          time: {\n            unit: 'minute',\n            displayFormats: {\n              minute: 'HH:mm'\n            }\n          },\n          title: {\n            display: true,\n            text: 'Heure'\n          }\n        },\n        y: {\n          beginAtZero: false,\n          ticks: {\n            callback: value => formatPrice(value)\n          },\n          title: {\n            display: true,\n            text: 'Prix'\n          }\n        }\n      },\n      plugins: {\n        legend: {\n          display: false\n        },\n        tooltip: {\n          callbacks: {\n            label: (context) => formatPrice(context.raw)\n          }\n        }\n      }\n    };\n\n    const chartData = computed(() => ({\n      labels: priceHistory.value.map(item => item.timestamp),\n      datasets: [{\n        label: cryptoSymbol,\n        data: priceHistory.value.map(item => item.price),\n        borderColor: '#4F46E5',\n        tension: 0.1,\n        pointRadius: 2\n      }]\n    }));\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const formatPriceChange = (change) => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion des mises à jour en temps réel\n    socket.on('priceUpdate', (data) => {\n      const crypto = data.find(c => c.symbol === cryptoSymbol);\n      if (crypto) {\n        cryptoData.value = crypto;\n        // Ajouter le nouveau prix à l'historique\n        priceHistory.value.push({\n          price: crypto.price,\n          timestamp: new Date()\n        });\n      }\n    });\n\n    onMounted(() => {\n      socket.connect();\n      loadPriceHistory();\n    });\n\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n\n    return {\n      cryptoSymbol,\n      cryptoData,\n      chartData,\n      chartOptions,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      isLoading\n    };\n  }\n};\n</script>\n"],"mappings":"AA4BA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAW,EAAEC,QAAO,QAAS,KAAK;AAC3D,SAASC,QAAO,QAAS,YAAY;AACrC,SAASC,MAAK,QAAS,UAAU;AACjC,SACEC,KAAI,IAAKC,OAAO,EAChBC,aAAa,EACbC,WAAW,EACXC,YAAY,EACZC,WAAW,EACXC,SAAS,EACTC,KAAK,EACLC,OAAO,EACPC,MAAK,QACA,UAAU;AACjB,SAASC,IAAG,QAAS,aAAa;AAElCT,OAAO,CAACU,QAAQ,CACdT,aAAa,EACbC,WAAW,EACXC,YAAY,EACZC,WAAW,EACXC,SAAS,EACTC,KAAK,EACLC,OAAO,EACPC,MACF,CAAC;AAED,eAAe;EACbG,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IAAEH;EAAK,CAAC;EAEpBI,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIjB,QAAQ,CAAC,CAAC;IACxB,MAAMkB,YAAW,GAAID,KAAK,CAACE,MAAM,CAACC,MAAM;IACxC,MAAMC,UAAS,GAAIzB,GAAG,CAAC,IAAI,CAAC;IAC5B,MAAM0B,YAAW,GAAI1B,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAM2B,SAAQ,GAAI3B,GAAG,CAAC,IAAI,CAAC;;IAE3B;IACA,MAAM4B,gBAAe,GAAI,MAAAA,CAAA,KAAY;MACnC,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAAC,8CAA8CR,YAAY,UAAU,CAAC;QAClG,IAAI,CAACO,QAAQ,CAACE,EAAE,EAAE,MAAM,IAAIC,KAAK,CAAC,4CAA4C,CAAC;QAE/E,MAAMC,IAAG,GAAI,MAAMJ,QAAQ,CAACK,IAAI,CAAC,CAAC;QAClCR,YAAY,CAACS,KAAI,GAAIF,IAAI,CAACG,GAAG,CAACC,IAAG,KAAM;UACrCC,KAAK,EAAEC,UAAU,CAACF,IAAI,CAACC,KAAK,CAAC;UAC7BE,SAAS,EAAE,IAAIC,IAAI,CAACJ,IAAI,CAACG,SAAS;QACpC,CAAC,CAAC,CAAC,CAACE,OAAO,CAAC,CAAC,EAAE;MACjB,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,SAAS,EAAEA,KAAK,CAAC;MACjC,UAAU;QACRhB,SAAS,CAACQ,KAAI,GAAI,KAAK;MACzB;IACF,CAAC;;IAED;IACA,MAAMU,YAAW,GAAI;MACnBC,UAAU,EAAE,IAAI;MAChBC,mBAAmB,EAAE,KAAK;MAC1BC,MAAM,EAAE;QACNC,CAAC,EAAE;UACDC,IAAI,EAAE,MAAM;UACZC,IAAI,EAAE;YACJC,IAAI,EAAE,QAAQ;YACdC,cAAc,EAAE;cACdC,MAAM,EAAE;YACV;UACF,CAAC;UACDC,KAAK,EAAE;YACLC,OAAO,EAAE,IAAI;YACbC,IAAI,EAAE;UACR;QACF,CAAC;QACDC,CAAC,EAAE