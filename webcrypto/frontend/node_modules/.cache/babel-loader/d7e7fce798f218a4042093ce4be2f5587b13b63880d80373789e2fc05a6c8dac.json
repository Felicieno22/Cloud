{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted, watch } from 'vue';\nimport { useStore } from 'vuex';\nimport { Line as LineChart } from 'vue-chartjs';\nimport { Chart as ChartJS, CategoryScale, LinearScale, PointElement, LineElement, Title, Tooltip, Legend } from 'chart.js';\nChartJS.register(CategoryScale, LinearScale, PointElement, LineElement, Title, Tooltip, Legend);\nexport default {\n  name: 'Dashboard',\n  components: {\n    LineChart\n  },\n  setup() {\n    const store = useStore();\n    const cryptoList = computed(() => store.getters['crypto/getCryptoList']);\n    const isConnected = computed(() => store.getters['crypto/isConnected']);\n    const selectedCrypto = computed(() => store.getters['crypto/getSelectedCrypto']);\n    const selectedCryptoName = computed(() => {\n      if (!selectedCrypto.value) return '';\n      return store.getters['crypto/getPrices'][selectedCrypto.value]?.name || '';\n    });\n\n    // Options pour les graphiques\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      scales: {\n        y: {\n          beginAtZero: false,\n          ticks: {\n            callback: value => '$' + value.toLocaleString()\n          }\n        }\n      },\n      plugins: {\n        legend: {\n          display: false\n        }\n      }\n    };\n\n    // Données du graphique\n    const chartData = computed(() => {\n      if (!selectedCrypto.value) return null;\n      const history = store.getters['crypto/getPriceHistory'](selectedCrypto.value);\n      return {\n        labels: history.map(h => {\n          const date = new Date(h.time);\n          return date.toLocaleTimeString();\n        }),\n        datasets: [{\n          label: selectedCrypto.value,\n          data: history.map(h => h.price),\n          borderColor: '#4F46E5',\n          tension: 0.1\n        }]\n      };\n    });\n\n    // Formatage des prix\n    const formatPrice = price => {\n      return price.toLocaleString(undefined, {\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      });\n    };\n\n    // Calcul de la variation de prix\n    const getPriceChange = crypto => {\n      const history = store.getters['crypto/getPriceHistory'](crypto);\n      if (history.length < 2) return '0.00';\n      const oldPrice = history[0].price;\n      const newPrice = history[history.length - 1].price;\n      const change = (newPrice - oldPrice) / oldPrice * 100;\n      return change.toFixed(2);\n    };\n\n    // Classe CSS pour la variation de prix\n    const getPriceChangeClass = crypto => {\n      const change = parseFloat(getPriceChange(crypto));\n      return {\n        'text-green-500': change > 0,\n        'text-red-500': change < 0,\n        'text-gray-500': change === 0\n      };\n    };\n\n    // Sélection d'une crypto\n    const selectCrypto = crypto => {\n      store.dispatch('crypto/selectCrypto', crypto);\n    };\n\n    // Gestion de la watchlist\n    const addToWatchlist = crypto => {\n      // TODO: Implémenter la fonctionnalité de watchlist\n      alert(`${crypto} ajouté à votre watchlist`);\n    };\n\n    // Lifecycle hooks\n    onMounted(() => {\n      store.dispatch('crypto/initializeSocket');\n    });\n    onUnmounted(() => {\n      store.dispatch('crypto/disconnect');\n    });\n    return {\n      cryptoList,\n      isConnected,\n      selectedCrypto,\n      selectedCryptoName,\n      chartOptions,\n      chartData,\n      formatPrice,\n      getPriceChange,\n      getPriceChangeClass,\n      selectCrypto,\n      addToWatchlist\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","watch","useStore","Line","LineChart","Chart","ChartJS","CategoryScale","LinearScale","PointElement","LineElement","Title","Tooltip","Legend","register","name","components","setup","store","cryptoList","getters","isConnected","selectedCrypto","selectedCryptoName","value","chartOptions","responsive","maintainAspectRatio","scales","y","beginAtZero","ticks","callback","toLocaleString","plugins","legend","display","chartData","history","labels","map","h","date","Date","time","toLocaleTimeString","datasets","label","data","price","borderColor","tension","formatPrice","undefined","minimumFractionDigits","maximumFractionDigits","getPriceChange","crypto","length","oldPrice","newPrice","change","toFixed","getPriceChangeClass","parseFloat","selectCrypto","dispatch","addToWatchlist","alert"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"mb-8\">\n      <h1 class=\"text-3xl font-bold text-gray-900\">Tableau de bord</h1>\n      <p class=\"text-gray-600\">\n        Cours des cryptomonnaies mis à jour en temps réel\n        <span :class=\"{'text-green-500': isConnected, 'text-red-500': !isConnected}\">\n          ●\n        </span>\n      </p>\n    </div>\n\n    <!-- Grille des cryptomonnaies -->\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n      <div v-for=\"crypto in cryptoList\" :key=\"crypto.symbol\" \n           @click=\"selectCrypto(crypto.symbol)\"\n           :class=\"{'ring-2 ring-indigo-500': selectedCrypto === crypto.symbol}\"\n           class=\"bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow duration-200 cursor-pointer\">\n        <div class=\"flex justify-between items-center\">\n          <div>\n            <h2 class=\"text-xl font-semibold\">{{ crypto.symbol }}</h2>\n            <p class=\"text-gray-600\">{{ crypto.name }}</p>\n          </div>\n          <div class=\"text-right\">\n            <div class=\"text-2xl font-bold\">${{ formatPrice(crypto.price) }}</div>\n            <div :class=\"getPriceChangeClass(crypto.symbol)\" class=\"text-sm\">\n              {{ getPriceChange(crypto.symbol) }}%\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Graphique pour la crypto sélectionnée -->\n    <div v-if=\"selectedCrypto\" class=\"mt-8\">\n      <div class=\"bg-white rounded-lg shadow-lg p-6\">\n        <div class=\"flex justify-between items-center mb-4\">\n          <h2 class=\"text-2xl font-bold\">{{ selectedCryptoName }}</h2>\n          <div class=\"space-x-2\">\n            <button @click=\"$router.push({ name: 'Trade', params: { crypto: selectedCrypto }})\"\n                    class=\"bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition-colors\">\n              Trader\n            </button>\n            <button @click=\"addToWatchlist(selectedCrypto)\"\n                    class=\"border border-gray-300 px-4 py-2 rounded hover:bg-gray-50 transition-colors\">\n              Suivre\n            </button>\n          </div>\n        </div>\n        <div class=\"h-96\">\n          <LineChart v-if=\"chartData\" :data=\"chartData\" :options=\"chartOptions\" />\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed, onMounted, onUnmounted, watch } from 'vue'\nimport { useStore } from 'vuex'\nimport { Line as LineChart } from 'vue-chartjs'\nimport {\n  Chart as ChartJS,\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  Title,\n  Tooltip,\n  Legend\n} from 'chart.js'\n\nChartJS.register(\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  Title,\n  Tooltip,\n  Legend\n)\n\nexport default {\n  name: 'Dashboard',\n  components: { LineChart },\n\n  setup() {\n    const store = useStore()\n    const cryptoList = computed(() => store.getters['crypto/getCryptoList'])\n    const isConnected = computed(() => store.getters['crypto/isConnected'])\n    const selectedCrypto = computed(() => store.getters['crypto/getSelectedCrypto'])\n    const selectedCryptoName = computed(() => {\n      if (!selectedCrypto.value) return ''\n      return store.getters['crypto/getPrices'][selectedCrypto.value]?.name || ''\n    })\n\n    // Options pour les graphiques\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      scales: {\n        y: {\n          beginAtZero: false,\n          ticks: {\n            callback: value => '$' + value.toLocaleString()\n          }\n        }\n      },\n      plugins: {\n        legend: {\n          display: false\n        }\n      }\n    }\n\n    // Données du graphique\n    const chartData = computed(() => {\n      if (!selectedCrypto.value) return null\n      const history = store.getters['crypto/getPriceHistory'](selectedCrypto.value)\n      return {\n        labels: history.map(h => {\n          const date = new Date(h.time)\n          return date.toLocaleTimeString()\n        }),\n        datasets: [{\n          label: selectedCrypto.value,\n          data: history.map(h => h.price),\n          borderColor: '#4F46E5',\n          tension: 0.1\n        }]\n      }\n    })\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      return price.toLocaleString(undefined, {\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      })\n    }\n\n    // Calcul de la variation de prix\n    const getPriceChange = (crypto) => {\n      const history = store.getters['crypto/getPriceHistory'](crypto)\n      if (history.length < 2) return '0.00'\n      \n      const oldPrice = history[0].price\n      const newPrice = history[history.length - 1].price\n      const change = ((newPrice - oldPrice) / oldPrice) * 100\n      \n      return change.toFixed(2)\n    }\n\n    // Classe CSS pour la variation de prix\n    const getPriceChangeClass = (crypto) => {\n      const change = parseFloat(getPriceChange(crypto))\n      return {\n        'text-green-500': change > 0,\n        'text-red-500': change < 0,\n        'text-gray-500': change === 0\n      }\n    }\n\n    // Sélection d'une crypto\n    const selectCrypto = (crypto) => {\n      store.dispatch('crypto/selectCrypto', crypto)\n    }\n\n    // Gestion de la watchlist\n    const addToWatchlist = (crypto) => {\n      // TODO: Implémenter la fonctionnalité de watchlist\n      alert(`${crypto} ajouté à votre watchlist`)\n    }\n\n    // Lifecycle hooks\n    onMounted(() => {\n      store.dispatch('crypto/initializeSocket')\n    })\n\n    onUnmounted(() => {\n      store.dispatch('crypto/disconnect')\n    })\n\n    return {\n      cryptoList,\n      isConnected,\n      selectedCrypto,\n      selectedCryptoName,\n      chartOptions,\n      chartData,\n      formatPrice,\n      getPriceChange,\n      getPriceChangeClass,\n      selectCrypto,\n      addToWatchlist\n    }\n  }\n}\n</script>\n"],"mappings":"AA0DA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAW,EAAEC,KAAI,QAAS,KAAI;AACjE,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,IAAG,IAAKC,SAAQ,QAAS,aAAY;AAC9C,SACEC,KAAI,IAAKC,OAAO,EAChBC,aAAa,EACbC,WAAW,EACXC,YAAY,EACZC,WAAW,EACXC,KAAK,EACLC,OAAO,EACPC,MAAK,QACA,UAAS;AAEhBP,OAAO,CAACQ,QAAQ,CACdP,aAAa,EACbC,WAAW,EACXC,YAAY,EACZC,WAAW,EACXC,KAAK,EACLC,OAAO,EACPC,MACF;AAEA,eAAe;EACbE,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IAAEZ;EAAU,CAAC;EAEzBa,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIhB,QAAQ,CAAC;IACvB,MAAMiB,UAAS,GAAIrB,QAAQ,CAAC,MAAMoB,KAAK,CAACE,OAAO,CAAC,sBAAsB,CAAC;IACvE,MAAMC,WAAU,GAAIvB,QAAQ,CAAC,MAAMoB,KAAK,CAACE,OAAO,CAAC,oBAAoB,CAAC;IACtE,MAAME,cAAa,GAAIxB,QAAQ,CAAC,MAAMoB,KAAK,CAACE,OAAO,CAAC,0BAA0B,CAAC;IAC/E,MAAMG,kBAAiB,GAAIzB,QAAQ,CAAC,MAAM;MACxC,IAAI,CAACwB,cAAc,CAACE,KAAK,EAAE,OAAO,EAAC;MACnC,OAAON,KAAK,CAACE,OAAO,CAAC,kBAAkB,CAAC,CAACE,cAAc,CAACE,KAAK,CAAC,EAAET,IAAG,IAAK,EAAC;IAC3E,CAAC;;IAED;IACA,MAAMU,YAAW,GAAI;MACnBC,UAAU,EAAE,IAAI;MAChBC,mBAAmB,EAAE,KAAK;MAC1BC,MAAM,EAAE;QACNC,CAAC,EAAE;UACDC,WAAW,EAAE,KAAK;UAClBC,KAAK,EAAE;YACLC,QAAQ,EAAER,KAAI,IAAK,GAAE,GAAIA,KAAK,CAACS,cAAc,CAAC;UAChD;QACF;MACF,CAAC;MACDC,OAAO,EAAE;QACPC,MAAM,EAAE;UACNC,OAAO,EAAE;QACX;MACF;IACF;;IAEA;IACA,MAAMC,SAAQ,GAAIvC,QAAQ,CAAC,MAAM;MAC/B,IAAI,CAACwB,cAAc,CAACE,KAAK,EAAE,OAAO,IAAG;MACrC,MAAMc,OAAM,GAAIpB,KAAK,CAACE,OAAO,CAAC,wBAAwB,CAAC,CAACE,cAAc,CAACE,KAAK;MAC5E,OAAO;QACLe,MAAM,EAA