{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { socket } from '@/socket';\nexport default {\n  name: 'Wallet',\n  setup() {\n    const wallet = ref({\n      balance: 0\n    });\n    const positions = ref([]);\n    const transactions = ref([]);\n    const showDepositModal = ref(false);\n    const showWithdrawModal = ref(false);\n    const depositAmount = ref('');\n    const withdrawAmount = ref('');\n    const formatPrice = price => {\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD'\n      }).format(price);\n    };\n    const formatPriceChange = change => {\n      return change.toFixed(2);\n    };\n    const formatDate = date => {\n      return new Date(date).toLocaleString('fr-FR', {\n        dateStyle: 'short',\n        timeStyle: 'short'\n      });\n    };\n    const getPriceChangeClass = change => {\n      return {\n        'text-green-500': change > 0,\n        'text-red-500': change < 0,\n        'text-gray-500': change === 0\n      };\n    };\n    const getTransactionTypeLabel = type => {\n      const labels = {\n        buy: 'Achat',\n        sell: 'Vente',\n        deposit: 'Dépôt',\n        withdrawal: 'Retrait'\n      };\n      return labels[type] || type;\n    };\n    const getTransactionPrefix = transaction => {\n      if (transaction.type === 'deposit' || transaction.type === 'buy') {\n        return '+';\n      }\n      return '-';\n    };\n    const getTransactionAmountClass = transaction => {\n      if (transaction.type === 'deposit' || transaction.type === 'buy') {\n        return 'text-green-600 font-medium';\n      }\n      return 'text-red-600 font-medium';\n    };\n    const getStatusClass = status => {\n      const classes = {\n        pending: 'text-yellow-600',\n        completed: 'text-green-600',\n        rejected: 'text-red-600'\n      };\n      return classes[status] || 'text-gray-600';\n    };\n    const getStatusLabel = status => {\n      const labels = {\n        pending: 'En attente',\n        completed: 'Terminé',\n        rejected: 'Rejeté'\n      };\n      return labels[status] || status;\n    };\n    const loadWallet = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/wallet', {\n          headers: {\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        if (!response.ok) throw new Error('Erreur lors du chargement du portefeuille');\n        const data = await response.json();\n        wallet.value = data;\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n    const loadPositions = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/wallet/positions', {\n          headers: {\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        if (!response.ok) throw new Error('Erreur lors du chargement des positions');\n        const data = await response.json();\n        positions.value = data;\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n    const loadTransactions = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/wallet/transactions', {\n          headers: {\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        if (!response.ok) throw new Error('Erreur lors du chargement des transactions');\n        const data = await response.json();\n        transactions.value = data;\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n    const handleDeposit = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/wallet/request', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json',\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          },\n          body: JSON.stringify({\n            type: 'deposit',\n            amount: parseFloat(depositAmount.value)\n          })\n        });\n        if (!response.ok) throw new Error('Erreur lors de la demande de dépôt');\n        alert('Demande de dépôt envoyée avec succès');\n        showDepositModal.value = false;\n        depositAmount.value = '';\n        await loadTransactions();\n      } catch (error) {\n        alert(error.message);\n      }\n    };\n    const handleWithdraw = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/wallet/request', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json',\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          },\n          body: JSON.stringify({\n            type: 'withdrawal',\n            amount: parseFloat(withdrawAmount.value)\n          })\n        });\n        if (!response.ok) throw new Error('Erreur lors de la demande de retrait');\n        alert('Demande de retrait envoyée avec succès');\n        showWithdrawModal.value = false;\n        withdrawAmount.value = '';\n        await loadTransactions();\n      } catch (error) {\n        alert(error.message);\n      }\n    };\n\n    // Mise à jour en temps réel des positions\n    socket.on('priceUpdate', cryptos => {\n      positions.value = positions.value.map(position => {\n        const crypto = cryptos.find(c => c.id === position.crypto_id);\n        if (crypto) {\n          position.current_price = crypto.price;\n          position.price_change_24h = crypto.priceChange;\n        }\n        return position;\n      });\n    });\n    onMounted(() => {\n      loadWallet();\n      loadPositions();\n      loadTransactions();\n      socket.connect();\n    });\n    return {\n      wallet,\n      positions,\n      transactions,\n      showDepositModal,\n      showWithdrawModal,\n      depositAmount,\n      withdrawAmount,\n      formatPrice,\n      formatPriceChange,\n      formatDate,\n      getPriceChangeClass,\n      getTransactionTypeLabel,\n      getTransactionPrefix,\n      getTransactionAmountClass,\n      getStatusClass,\n      getStatusLabel,\n      handleDeposit,\n      handleWithdraw\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","socket","name","setup","wallet","balance","positions","transactions","showDepositModal","showWithdrawModal","depositAmount","withdrawAmount","formatPrice","price","Intl","NumberFormat","style","currency","format","formatPriceChange","change","toFixed","formatDate","date","Date","toLocaleString","dateStyle","timeStyle","getPriceChangeClass","getTransactionTypeLabel","type","labels","buy","sell","deposit","withdrawal","getTransactionPrefix","transaction","getTransactionAmountClass","getStatusClass","status","classes","pending","completed","rejected","getStatusLabel","loadWallet","response","fetch","headers","localStorage","getItem","ok","Error","data","json","value","error","console","loadPositions","loadTransactions","handleDeposit","method","body","JSON","stringify","amount","parseFloat","alert","message","handleWithdraw","on","cryptos","map","position","crypto","find","c","id","crypto_id","current_price","price_change_24h","priceChange","connect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\Wallet.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"max-w-4xl mx-auto\">\n      <!-- Solde -->\n      <div class=\"bg-white rounded-lg shadow-lg p-6 mb-8\">\n        <h2 class=\"text-lg text-gray-600\">Solde disponible</h2>\n        <div class=\"text-4xl font-bold text-gray-900 mt-2\">\n          {{ formatPrice(wallet.balance) }}\n        </div>\n        <div class=\"mt-4 flex space-x-4\">\n          <button\n            @click=\"showDepositModal = true\"\n            class=\"flex-1 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors\"\n          >\n            Déposer des fonds\n          </button>\n          <button\n            @click=\"showWithdrawModal = true\"\n            class=\"flex-1 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors\"\n          >\n            Retirer des fonds\n          </button>\n        </div>\n      </div>\n\n      <!-- Portefeuille crypto -->\n      <div class=\"bg-white rounded-lg shadow-lg p-6\">\n        <h2 class=\"text-xl font-semibold text-gray-900 mb-4\">Mes cryptomonnaies</h2>\n        <div class=\"space-y-4\">\n          <div v-for=\"position in positions\" :key=\"position.crypto_id\" class=\"flex items-center justify-between p-4 bg-gray-50 rounded-lg\">\n            <div>\n              <div class=\"font-medium\">{{ position.symbol }}</div>\n              <div class=\"text-sm text-gray-500\">{{ position.quantity }} {{ position.symbol }}</div>\n            </div>\n            <div class=\"text-right\">\n              <div class=\"font-medium\">{{ formatPrice(position.quantity * position.current_price) }}</div>\n              <div :class=\"getPriceChangeClass(position.price_change_24h)\" class=\"text-sm\">\n                {{ formatPriceChange(position.price_change_24h) }}%\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Historique des transactions -->\n      <div class=\"mt-8 bg-white rounded-lg shadow-lg p-6\">\n        <h2 class=\"text-xl font-semibold text-gray-900 mb-4\">Historique des transactions</h2>\n        <div class=\"space-y-4\">\n          <div v-for=\"transaction in transactions\" :key=\"transaction.id\" \n               class=\"flex items-center justify-between p-4 bg-gray-50 rounded-lg\">\n            <div>\n              <div class=\"font-medium\">\n                {{ getTransactionTypeLabel(transaction.type) }}\n                {{ transaction.crypto_symbol ? transaction.crypto_symbol : '' }}\n              </div>\n              <div class=\"text-sm text-gray-500\">\n                {{ formatDate(transaction.created_at) }}\n              </div>\n            </div>\n            <div class=\"text-right\">\n              <div :class=\"getTransactionAmountClass(transaction)\">\n                {{ getTransactionPrefix(transaction) }}\n                {{ formatPrice(transaction.amount) }}\n              </div>\n              <div class=\"text-sm\" :class=\"getStatusClass(transaction.status)\">\n                {{ getStatusLabel(transaction.status) }}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Modal de dépôt -->\n    <div v-if=\"showDepositModal\" class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center\">\n      <div class=\"bg-white rounded-lg p-6 max-w-md w-full mx-4\">\n        <h3 class=\"text-lg font-medium text-gray-900 mb-4\">Déposer des fonds</h3>\n        <form @submit.prevent=\"handleDeposit\">\n          <div class=\"mb-4\">\n            <label class=\"block text-sm font-medium text-gray-700\">Montant (USD)</label>\n            <input\n              type=\"number\"\n              v-model=\"depositAmount\"\n              step=\"0.01\"\n              min=\"0\"\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\n              required\n            />\n          </div>\n          <div class=\"flex justify-end space-x-3\">\n            <button\n              type=\"button\"\n              @click=\"showDepositModal = false\"\n              class=\"px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-md\"\n            >\n              Annuler\n            </button>\n            <button\n              type=\"submit\"\n              class=\"px-4 py-2 text-sm font-medium text-white bg-green-600 hover:bg-green-700 rounded-md\"\n            >\n              Confirmer le dépôt\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n\n    <!-- Modal de retrait -->\n    <div v-if=\"showWithdrawModal\" class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center\">\n      <div class=\"bg-white rounded-lg p-6 max-w-md w-full mx-4\">\n        <h3 class=\"text-lg font-medium text-gray-900 mb-4\">Retirer des fonds</h3>\n        <form @submit.prevent=\"handleWithdraw\">\n          <div class=\"mb-4\">\n            <label class=\"block text-sm font-medium text-gray-700\">Montant (USD)</label>\n            <input\n              type=\"number\"\n              v-model=\"withdrawAmount\"\n              step=\"0.01\"\n              min=\"0\"\n              :max=\"wallet.balance\"\n              class=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\n              required\n            />\n          </div>\n          <div class=\"flex justify-end space-x-3\">\n            <button\n              type=\"button\"\n              @click=\"showWithdrawModal = false\"\n              class=\"px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-md\"\n            >\n              Annuler\n            </button>\n            <button\n              type=\"submit\"\n              class=\"px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-md\"\n            >\n              Confirmer le retrait\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted } from 'vue';\nimport { socket } from '@/socket';\n\nexport default {\n  name: 'Wallet',\n\n  setup() {\n    const wallet = ref({ balance: 0 });\n    const positions = ref([]);\n    const transactions = ref([]);\n    const showDepositModal = ref(false);\n    const showWithdrawModal = ref(false);\n    const depositAmount = ref('');\n    const withdrawAmount = ref('');\n\n    const formatPrice = (price) => {\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD'\n      }).format(price);\n    };\n\n    const formatPriceChange = (change) => {\n      return change.toFixed(2);\n    };\n\n    const formatDate = (date) => {\n      return new Date(date).toLocaleString('fr-FR', {\n        dateStyle: 'short',\n        timeStyle: 'short'\n      });\n    };\n\n    const getPriceChangeClass = (change) => {\n      return {\n        'text-green-500': change > 0,\n        'text-red-500': change < 0,\n        'text-gray-500': change === 0\n      };\n    };\n\n    const getTransactionTypeLabel = (type) => {\n      const labels = {\n        buy: 'Achat',\n        sell: 'Vente',\n        deposit: 'Dépôt',\n        withdrawal: 'Retrait'\n      };\n      return labels[type] || type;\n    };\n\n    const getTransactionPrefix = (transaction) => {\n      if (transaction.type === 'deposit' || transaction.type === 'buy') {\n        return '+';\n      }\n      return '-';\n    };\n\n    const getTransactionAmountClass = (transaction) => {\n      if (transaction.type === 'deposit' || transaction.type === 'buy') {\n        return 'text-green-600 font-medium';\n      }\n      return 'text-red-600 font-medium';\n    };\n\n    const getStatusClass = (status) => {\n      const classes = {\n        pending: 'text-yellow-600',\n        completed: 'text-green-600',\n        rejected: 'text-red-600'\n      };\n      return classes[status] || 'text-gray-600';\n    };\n\n    const getStatusLabel = (status) => {\n      const labels = {\n        pending: 'En attente',\n        completed: 'Terminé',\n        rejected: 'Rejeté'\n      };\n      return labels[status] || status;\n    };\n\n    const loadWallet = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/wallet', {\n          headers: {\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        if (!response.ok) throw new Error('Erreur lors du chargement du portefeuille');\n        const data = await response.json();\n        wallet.value = data;\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n\n    const loadPositions = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/wallet/positions', {\n          headers: {\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        if (!response.ok) throw new Error('Erreur lors du chargement des positions');\n        const data = await response.json();\n        positions.value = data;\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n\n    const loadTransactions = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/wallet/transactions', {\n          headers: {\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        if (!response.ok) throw new Error('Erreur lors du chargement des transactions');\n        const data = await response.json();\n        transactions.value = data;\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n\n    const handleDeposit = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/wallet/request', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json',\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          },\n          body: JSON.stringify({\n            type: 'deposit',\n            amount: parseFloat(depositAmount.value)\n          })\n        });\n\n        if (!response.ok) throw new Error('Erreur lors de la demande de dépôt');\n\n        alert('Demande de dépôt envoyée avec succès');\n        showDepositModal.value = false;\n        depositAmount.value = '';\n        await loadTransactions();\n      } catch (error) {\n        alert(error.message);\n      }\n    };\n\n    const handleWithdraw = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/wallet/request', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json',\n            'Authorization': `Bearer ${localStorage.getItem('token')}`\n          },\n          body: JSON.stringify({\n            type: 'withdrawal',\n            amount: parseFloat(withdrawAmount.value)\n          })\n        });\n\n        if (!response.ok) throw new Error('Erreur lors de la demande de retrait');\n\n        alert('Demande de retrait envoyée avec succès');\n        showWithdrawModal.value = false;\n        withdrawAmount.value = '';\n        await loadTransactions();\n      } catch (error) {\n        alert(error.message);\n      }\n    };\n\n    // Mise à jour en temps réel des positions\n    socket.on('priceUpdate', (cryptos) => {\n      positions.value = positions.value.map(position => {\n        const crypto = cryptos.find(c => c.id === position.crypto_id);\n        if (crypto) {\n          position.current_price = crypto.price;\n          position.price_change_24h = crypto.priceChange;\n        }\n        return position;\n      });\n    });\n\n    onMounted(() => {\n      loadWallet();\n      loadPositions();\n      loadTransactions();\n      socket.connect();\n    });\n\n    return {\n      wallet,\n      positions,\n      transactions,\n      showDepositModal,\n      showWithdrawModal,\n      depositAmount,\n      withdrawAmount,\n      formatPrice,\n      formatPriceChange,\n      formatDate,\n      getPriceChangeClass,\n      getTransactionTypeLabel,\n      getTransactionPrefix,\n      getTransactionAmountClass,\n      getStatusClass,\n      getStatusLabel,\n      handleDeposit,\n      handleWithdraw\n    };\n  }\n};\n</script>\n"],"mappings":"AAmJA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,MAAK,QAAS,UAAU;AAEjC,eAAe;EACbC,IAAI,EAAE,QAAQ;EAEdC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIL,GAAG,CAAC;MAAEM,OAAO,EAAE;IAAE,CAAC,CAAC;IAClC,MAAMC,SAAQ,GAAIP,GAAG,CAAC,