{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Register',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const form = ref({\n      nom: '',\n      prenom: '',\n      username: '',\n      email: '',\n      ville: '',\n      date_naissance: '',\n      passwordHash: ''\n    });\n    const verificationCode = ref('');\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification']);\n    console.log('État pendingVerification:', pendingVerification.value); // Debug log\n\n    const handleSubmit = async () => {\n      try {\n        loading.value = true;\n        const response = await store.dispatch('auth/register', form.value);\n        // Rediriger vers la page de vérification avec l'email\n        router.push({\n          name: 'verify-email',\n          query: {\n            email: form.value.email\n          }\n        });\n      } catch (error) {\n        alert(error.message || \"Erreur lors de l'inscription\");\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handleVerification = async () => {\n      try {\n        loading.value = true;\n        await store.dispatch('auth/verifyEmail', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        });\n        router.push('/login');\n      } catch (error) {\n        alert(error.message || 'Erreur de vérification');\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      form,\n      loading,\n      verificationCode,\n      pendingVerification,\n      handleSubmit,\n      handleVerification\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRouter","name","setup","store","router","loading","form","nom","prenom","username","email","ville","date_naissance","passwordHash","verificationCode","pendingVerification","getters","console","log","value","handleSubmit","response","dispatch","push","query","error","alert","message","handleVerification","code"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\Register.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-md w-full space-y-8\">\n      <div>\n        <h2 class=\"mt-6 text-center text-3xl font-extrabold text-gray-900\">\n          {{ pendingVerification ? 'Vérification du compte' : 'Inscription' }}\n        </h2>\n      </div>\n\n      <!-- Formulaire de vérification -->\n      <form v-if=\"pendingVerification\" class=\"mt-8 space-y-6\" @submit.prevent=\"handleVerification\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"verification-code\" class=\"sr-only\">Code de vérification</label>\n            <input\n              id=\"verification-code\"\n              v-model=\"verificationCode\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Entrez le code reçu par email\"\n            />\n          </div>\n        </div>\n\n        <div class=\"text-sm text-center\">\n          <p class=\"text-gray-600\">\n            Un code de vérification a été envoyé à {{ pendingVerification.email }}\n          </p>\n          <p class=\"text-gray-500 mt-2\">\n            {{ pendingVerification.message }}\n          </p>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-indigo-500\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Vérification...' : 'Vérifier le code' }}\n          </button>\n        </div>\n      </form>\n\n      <!-- Formulaire d'inscription -->\n      <form v-else class=\"mt-8 space-y-6\" @submit.prevent=\"handleSubmit\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"nom\" class=\"sr-only\">Nom</label>\n            <input\n              id=\"nom\"\n              v-model=\"form.nom\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Nom\"\n            />\n          </div>\n          <div>\n            <label for=\"prenom\" class=\"sr-only\">Prénom</label>\n            <input\n              id=\"prenom\"\n              v-model=\"form.prenom\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Prénom\"\n            />\n          </div>\n          <div>\n            <label for=\"username\" class=\"sr-only\">Nom d'utilisateur</label>\n            <input\n              id=\"username\"\n              v-model=\"form.username\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Nom d'utilisateur\"\n            />\n          </div>\n          <div>\n            <label for=\"email\" class=\"sr-only\">Email</label>\n            <input\n              id=\"email\"\n              v-model=\"form.email\"\n              type=\"email\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Email\"\n            />\n          </div>\n          <div>\n            <label for=\"ville\" class=\"sr-only\">Ville</label>\n            <input\n              id=\"ville\"\n              v-model=\"form.ville\"\n              type=\"text\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Ville\"\n            />\n          </div>\n          <div>\n            <label for=\"date_naissance\" class=\"sr-only\">Date de naissance</label>\n            <input\n              id=\"date_naissance\"\n              v-model=\"form.date_naissance\"\n              type=\"date\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n            />\n          </div>\n          <div>\n            <label for=\"password\" class=\"sr-only\">Mot de passe</label>\n            <input\n              id=\"password\"\n              v-model=\"form.passwordHash\"\n              type=\"password\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Mot de passe\"\n            />\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path d=\"M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6z\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-white\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Inscription...' : \"S'inscrire\" }}\n          </button>\n        </div>\n\n        <div class=\"text-sm text-center\">\n          <router-link to=\"/login\" class=\"font-medium text-indigo-600 hover:text-indigo-500\">\n            Déjà un compte ? Se connecter\n          </router-link>\n        </div>\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  name: 'Register',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const loading = ref(false)\n    const form = ref({\n      nom: '',\n      prenom: '',\n      username: '',\n      email: '',\n      ville: '',\n      date_naissance: '',\n      passwordHash: ''\n    })\n    const verificationCode = ref('')\n\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification'])\n    console.log('État pendingVerification:', pendingVerification.value) // Debug log\n\n    const handleSubmit = async () => {\n      try {\n        loading.value = true\n        const response = await store.dispatch('auth/register', form.value)\n        // Rediriger vers la page de vérification avec l'email\n        router.push({\n          name: 'verify-email',\n          query: { email: form.value.email }\n        })\n      } catch (error) {\n        alert(error.message || \"Erreur lors de l'inscription\")\n      } finally {\n        loading.value = false\n      }\n    }\n\n    const handleVerification = async () => {\n      try {\n        loading.value = true\n        await store.dispatch('auth/verifyEmail', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        })\n        router.push('/login')\n      } catch (error) {\n        alert(error.message || 'Erreur de vérification')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    return {\n      form,\n      loading,\n      verificationCode,\n      pendingVerification,\n      handleSubmit,\n      handleVerification\n    }\n  }\n}\n</script>\n"],"mappings":"AAqKA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,UAAU;EAEhBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,OAAM,GAAIR,GAAG,CAAC,KAAK;IACzB,MAAMS,IAAG,GAAIT,GAAG,CAAC;MACfU,GAAG,EAAE,EAAE;MACPC,MAAM,EAAE,EAAE;MACVC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE,EAAE;MACTC,cAAc,EAAE,EAAE;MAClBC,YAAY,EAAE;IAChB,CAAC;IACD,MAAMC,gBAAe,GAAIjB,GAAG,CAAC,EAAE;IAE/B,MAAMkB,mBAAkB,GAAIjB,QAAQ,CAAC,MAAMK,KAAK,CAACa,OAAO,CAAC,0BAA0B,CAAC;IACpFC,OAAO,CAACC,GAAG,CAAC,2BAA2B,EAAEH,mBAAmB,CAACI,KAAK,GAAE;;IAEpE,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACFf,OAAO,CAACc,KAAI,GAAI,IAAG;QACnB,MAAME,QAAO,GAAI,MAAMlB,KAAK,CAACmB,QAAQ,CAAC,eAAe,EAAEhB,IAAI,CAACa,KAAK;QACjE;QACAf,MAAM,CAACmB,IAAI,CAAC;UACVtB,IAAI,EAAE,cAAc;UACpBuB,KAAK,EAAE;YAAEd,KAAK,EAAEJ,IAAI,CAACa,KAAK,CAACT;UAAM;QACnC,CAAC;MACH,EAAE,OAAOe,KAAK,EAAE;QACdC,KAAK,CAACD,KAAK,CAACE,OAAM,IAAK,8BAA8B;MACvD,UAAU;QACRtB,OAAO,CAACc,KAAI,GAAI,KAAI;MACtB;IACF;IAEA,MAAMS,kBAAiB,GAAI,MAAAA,CAAA,KAAY;MACrC,IAAI;QACFvB,OAAO,CAACc,KAAI,GAAI,IAAG;QACnB,MAAMhB,KAAK,CAACmB,QAAQ,CAAC,kBAAkB,EAAE;UACvCZ,KAAK,EAAEK,mBAAmB,CAACI,KAAK,CAACT,KAAK;UACtCmB,IAAI,EAAEf,gBAAgB,CAACK;QACzB,CAAC;QACDf,MAAM,CAACmB,IAAI,CAAC,QAAQ;MACtB,EAAE,OAAOE,KAAK,EAAE;QACdC,KAAK,CAACD,KAAK,CAACE,OAAM,IAAK,wBAAwB;MACjD,UAAU;QACRtB,OAAO,CAACc,KAA