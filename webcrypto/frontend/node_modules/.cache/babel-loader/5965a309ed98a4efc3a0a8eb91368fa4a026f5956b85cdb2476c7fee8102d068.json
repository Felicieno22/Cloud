{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport { socket } from '@/socket';\nexport default {\n  name: 'Wallet',\n  setup() {\n    const wallet = ref(null);\n    const positions = ref([]);\n    const transactions = ref([]);\n    const depositAmount = ref('');\n    const withdrawalAmount = ref('');\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const requestDeposit = async () => {\n      try {\n        socket.emit('requestDeposit', {\n          type: 'DEPOSIT',\n          amount: parseFloat(depositAmount.value),\n          status: 'PENDING'\n        });\n        depositAmount.value = '';\n      } catch (error) {\n        console.error('Error requesting deposit:', error);\n        alert('Échec de la demande de dépôt');\n      }\n    };\n    const requestWithdrawal = async () => {\n      try {\n        socket.emit('requestWithdrawal', {\n          type: 'WITHDRAWAL',\n          amount: parseFloat(withdrawalAmount.value),\n          status: 'PENDING'\n        });\n        withdrawalAmount.value = '';\n      } catch (error) {\n        console.error('Error requesting withdrawal:', error);\n        alert('Échec de la demande de retrait');\n      }\n    };\n    const formatTransactionType = type => {\n      switch (type) {\n        case 'DEPOSIT':\n          return 'Dépôt';\n        case 'WITHDRAWAL':\n          return 'Retrait';\n        default:\n          return type;\n      }\n    };\n    const formatTransactionStatus = status => {\n      switch (status) {\n        case 'PENDING':\n          return 'En attente';\n        case 'COMPLETED':\n          return 'Complété';\n        case 'REJECTED':\n          return 'Rejeté';\n        default:\n          return status;\n      }\n    };\n    onMounted(() => {\n      socket.connect();\n\n      // Écouter les mises à jour du portefeuille\n      socket.emit('getWallet');\n      socket.on('walletUpdate', data => {\n        wallet.value = data;\n      });\n\n      // Écouter les mises à jour des positions\n      socket.emit('getPositions');\n      socket.on('positionsUpdate', data => {\n        positions.value = data;\n      });\n\n      // Écouter les mises à jour des transactions\n      socket.emit('getTransactions');\n      socket.on('transactionsUpdate', data => {\n        transactions.value = data;\n      });\n\n      // Écouter les réponses aux demandes\n      socket.on('depositResponse', response => {\n        if (response.success) {\n          alert('Demande de dépôt envoyée pour approbation');\n        } else {\n          alert(response.message || 'Échec de la demande de dépôt');\n        }\n      });\n      socket.on('withdrawalResponse', response => {\n        if (response.success) {\n          alert('Demande de retrait envoyée pour approbation');\n        } else {\n          alert(response.message || 'Échec de la demande de retrait');\n        }\n      });\n\n      // Écouter le traitement des demandes\n      socket.on('requestProcessed', data => {\n        const typeText = data.type === 'deposit' ? 'dépôt' : 'retrait';\n        const statusText = data.status === 'completed' ? 'approuvée' : 'rejetée';\n        alert(`Votre demande de ${typeText} de ${formatPrice(data.amount)} a été ${statusText}.`);\n      });\n    });\n    onUnmounted(() => {\n      socket.off('walletUpdate');\n      socket.off('positionsUpdate');\n      socket.off('transactionsUpdate');\n      socket.off('depositResponse');\n      socket.off('withdrawalResponse');\n      socket.off('requestProcessed');\n      socket.disconnect();\n    });\n    return {\n      wallet,\n      positions,\n      transactions,\n      depositAmount,\n      withdrawalAmount,\n      requestDeposit,\n      requestWithdrawal,\n      formatPrice,\n      formatTransactionType,\n      formatTransactionStatus\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","socket","name","setup","wallet","positions","transactions","depositAmount","withdrawalAmount","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","requestDeposit","emit","type","amount","parseFloat","value","status","error","console","alert","requestWithdrawal","formatTransactionType","formatTransactionStatus","connect","on","data","response","success","message","typeText","statusText","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Wallet.vue"],"sourcesContent":["<template>\n\t<div class=\"container mx-auto px-4 py-8\">\n\t\t<h1 class=\"text-3xl font-bold text-gray-900 mb-8\">Mon Portefeuille</h1>\n\t\t<div v-if=\"wallet\" class=\"bg-white rounded-lg shadow-lg p-6 mb-8\">\n\t\t\t<div class=\"text-2xl font-bold text-gray-900\">\n\t\t\t\tSolde: {{ formatPrice(wallet.balance) }}\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 mb-8\">\n\t\t\t<div class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h3 class=\"text-xl font-semibold text-gray-900 mb-4\">Demande de Dépôt</h3>\n\t\t\t\t<form @submit.prevent=\"requestDeposit\" class=\"space-y-4\">\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<label class=\"block text-sm font-medium text-gray-700\">Montant</label>\n\t\t\t\t\t\t<input \n\t\t\t\t\t\t\ttype=\"number\" \n\t\t\t\t\t\t\tv-model=\"depositAmount\" \n\t\t\t\t\t\t\tplaceholder=\"Montant à déposer\"\n\t\t\t\t\t\t\tmin=\"0\"\n\t\t\t\t\t\t\tstep=\"0.01\"\n\t\t\t\t\t\t\trequired\n\t\t\t\t\t\t\tclass=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t</div>\n\t\t\t\t\t<button type=\"submit\" class=\"w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition-colors\">\n\t\t\t\t\t\tDemander un Dépôt\n\t\t\t\t\t</button>\n\t\t\t\t</form>\n\t\t\t</div>\n\n\t\t\t<div class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h3 class=\"text-xl font-semibold text-gray-900 mb-4\">Demande de Retrait</h3>\n\t\t\t\t<form @submit.prevent=\"requestWithdrawal\" class=\"space-y-4\">\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<label class=\"block text-sm font-medium text-gray-700\">Montant</label>\n\t\t\t\t\t\t<input \n\t\t\t\t\t\t\ttype=\"number\" \n\t\t\t\t\t\t\tv-model=\"withdrawalAmount\" \n\t\t\t\t\t\t\tplaceholder=\"Montant à retirer\"\n\t\t\t\t\t\t\tmin=\"0\"\n\t\t\t\t\t\t\tstep=\"0.01\"\n\t\t\t\t\t\t\trequired\n\t\t\t\t\t\t\tclass=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t</div>\n\t\t\t\t\t<button type=\"submit\" class=\"w-full bg-red-600 text-white py-2 px-4 rounded-md hover:bg-red-700 transition-colors\">\n\t\t\t\t\t\tDemander un Retrait\n\t\t\t\t\t</button>\n\t\t\t\t</form>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n\t\t\t<div v-if=\"positions.length\" class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h2 class=\"text-xl font-semibold text-gray-900 mb-4\">Positions</h2>\n\t\t\t\t<ul class=\"divide-y divide-gray-200\">\n\t\t\t\t\t<li v-for=\"position in positions\" :key=\"position.id\" class=\"py-3\">\n\t\t\t\t\t\t<div class=\"flex justify-between\">\n\t\t\t\t\t\t\t<span class=\"font-medium\">{{ position.asset }}</span>\n\t\t\t\t\t\t\t<span>{{ formatPrice(position.amount) }}</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\n\t\t\t<div v-if=\"transactions.length\" class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h2 class=\"text-xl font-semibold text-gray-900 mb-4\">Transactions Récentes</h2>\n\t\t\t\t<ul class=\"divide-y divide-gray-200\">\n\t\t\t\t\t<li v-for=\"tx in transactions\" :key=\"tx.id\" class=\"py-3\">\n\t\t\t\t\t\t<div class=\"flex justify-between\">\n\t\t\t\t\t\t\t<span class=\"font-medium\">{{ formatTransactionType(tx.type) }}</span>\n\t\t\t\t\t\t\t<span :class=\"tx.type === 'DEPOSIT' ? 'text-green-600' : 'text-red-600'\">\n\t\t\t\t\t\t\t\t{{ formatPrice(tx.amount) }}\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"flex justify-between text-sm\">\n\t\t\t\t\t\t\t<span class=\"text-gray-500\">\n\t\t\t\t\t\t\t\t{{ new Date(tx.created_at).toLocaleDateString('fr-FR') }}\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t<span :class=\"{\n\t\t\t\t\t\t\t\t'text-yellow-600': tx.status === 'PENDING',\n\t\t\t\t\t\t\t\t'text-green-600': tx.status === 'COMPLETED',\n\t\t\t\t\t\t\t\t'text-red-600': tx.status === 'REJECTED'\n\t\t\t\t\t\t\t}\">\n\t\t\t\t\t\t\t\t{{ formatTransactionStatus(tx.status) }}\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<!-- Historique des transactions -->\n\t\t<div class=\"bg-white rounded-lg shadow-lg p-6 mt-8\">\n\t\t\t<h2 class=\"text-xl font-semibold text-gray-900 mb-4\">Historique des Transactions</h2>\n\t\t\t<div class=\"overflow-x-auto\">\n\t\t\t\t<table class=\"min-w-full divide-y divide-gray-200\">\n\t\t\t\t\t<thead class=\"bg-gray-50\">\n\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t<th scope=\"col\" class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n\t\t\t\t\t\t\t\tDate\n\t\t\t\t\t\t\t</th>\n\t\t\t\t\t\t\t<th scope=\"col\" class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n\t\t\t\t\t\t\t\tType\n\t\t\t\t\t\t\t</th>\n\t\t\t\t\t\t\t<th scope=\"col\" class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n\t\t\t\t\t\t\t\tMontant\n\t\t\t\t\t\t\t</th>\n\t\t\t\t\t\t\t<th scope=\"col\" class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n\t\t\t\t\t\t\t\tStatut\n\t\t\t\t\t\t\t</th>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t</thead>\n\t\t\t\t\t<tbody class=\"bg-white divide-y divide-gray-200\">\n\t\t\t\t\t\t<tr v-for=\"tx in transactions\" :key=\"tx.id\" class=\"hover:bg-gray-50\">\n\t\t\t\t\t\t\t<td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">\n\t\t\t\t\t\t\t\t{{ new Date(tx.created_at).toLocaleString('fr-FR') }}\n\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t<td class=\"px-6 py-4 whitespace-nowrap\">\n\t\t\t\t\t\t\t\t<span :class=\"{\n\t\t\t\t\t\t\t\t\t'px-2 py-1 text-xs font-semibold rounded-full': true,\n\t\t\t\t\t\t\t\t\t'bg-green-100 text-green-800': tx.type === 'DEPOSIT',\n\t\t\t\t\t\t\t\t\t'bg-red-100 text-red-800': tx.type === 'WITHDRAWAL'\n\t\t\t\t\t\t\t\t}\">\n\t\t\t\t\t\t\t\t\t{{ formatTransactionType(tx.type) }}\n\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t<td class=\"px-6 py-4 whitespace-nowrap text-sm font-medium\" :class=\"{\n\t\t\t\t\t\t\t\t'text-green-600': tx.type === 'DEPOSIT',\n\t\t\t\t\t\t\t\t'text-red-600': tx.type === 'WITHDRAWAL'\n\t\t\t\t\t\t\t}\">\n\t\t\t\t\t\t\t\t{{ formatPrice(tx.amount) }}\n\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t<td class=\"px-6 py-4 whitespace-nowrap\">\n\t\t\t\t\t\t\t\t<span :class=\"{\n\t\t\t\t\t\t\t\t\t'px-2 py-1 text-xs font-semibold rounded-full': true,\n\t\t\t\t\t\t\t\t\t'bg-yellow-100 text-yellow-800': tx.status === 'PENDING',\n\t\t\t\t\t\t\t\t\t'bg-green-100 text-green-800': tx.status === 'COMPLETED',\n\t\t\t\t\t\t\t\t\t'bg-red-100 text-red-800': tx.status === 'REJECTED'\n\t\t\t\t\t\t\t\t}\">\n\t\t\t\t\t\t\t\t\t{{ formatTransactionStatus(tx.status) }}\n\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t<tr v-if=\"transactions.length === 0\">\n\t\t\t\t\t\t\t<td colspan=\"4\" class=\"px-6 py-4 text-center text-sm text-gray-500\">\n\t\t\t\t\t\t\t\tAucune transaction à afficher\n\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t</tbody>\n\t\t\t\t</table>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted } from 'vue';\nimport { socket } from '@/socket';\n\nexport default {\n\tname: 'Wallet',\n\tsetup() {\n\t\tconst wallet = ref(null);\n\t\tconst positions = ref([]);\n\t\tconst transactions = ref([]);\n\t\tconst depositAmount = ref('');\n\t\tconst withdrawalAmount = ref('');\n\n\t\tconst formatPrice = (price) => {\n\t\t\tif (typeof price !== 'number') return '$0.00';\n\t\t\treturn new Intl.NumberFormat('fr-FR', {\n\t\t\t\tstyle: 'currency',\n\t\t\t\tcurrency: 'USD',\n\t\t\t\tminimumFractionDigits: 2,\n\t\t\t\tmaximumFractionDigits: 2\n\t\t\t}).format(price);\n\t\t};\n\n\t\tconst requestDeposit = async () => {\n\t\t\ttry {\n\t\t\t\tsocket.emit('requestDeposit', {\n\t\t\t\t\ttype: 'DEPOSIT',\n\t\t\t\t\tamount: parseFloat(depositAmount.value),\n\t\t\t\t\tstatus: 'PENDING'\n\t\t\t\t});\n\t\t\t\tdepositAmount.value = '';\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error requesting deposit:', error);\n\t\t\t\talert('Échec de la demande de dépôt');\n\t\t\t}\n\t\t};\n\n\t\tconst requestWithdrawal = async () => {\n\t\t\ttry {\n\t\t\t\tsocket.emit('requestWithdrawal', {\n\t\t\t\t\ttype: 'WITHDRAWAL',\n\t\t\t\t\tamount: parseFloat(withdrawalAmount.value),\n\t\t\t\t\tstatus: 'PENDING'\n\t\t\t\t});\n\t\t\t\twithdrawalAmount.value = '';\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error requesting withdrawal:', error);\n\t\t\t\talert('Échec de la demande de retrait');\n\t\t\t}\n\t\t};\n\n\t\tconst formatTransactionType = (type) => {\n\t\t\tswitch (type) {\n\t\t\t\tcase 'DEPOSIT':\n\t\t\t\t\treturn 'Dépôt';\n\t\t\t\tcase 'WITHDRAWAL':\n\t\t\t\t\treturn 'Retrait';\n\t\t\t\tdefault:\n\t\t\t\t\treturn type;\n\t\t\t}\n\t\t};\n\n\t\tconst formatTransactionStatus = (status) => {\n\t\t\tswitch (status) {\n\t\t\t\tcase 'PENDING':\n\t\t\t\t\treturn 'En attente';\n\t\t\t\tcase 'COMPLETED':\n\t\t\t\t\treturn 'Complété';\n\t\t\t\tcase 'REJECTED':\n\t\t\t\t\treturn 'Rejeté';\n\t\t\t\tdefault:\n\t\t\t\t\treturn status;\n\t\t\t}\n\t\t};\n\n\t\tonMounted(() => {\n\t\t\tsocket.connect();\n\n\t\t\t// Écouter les mises à jour du portefeuille\n\t\t\tsocket.emit('getWallet');\n\t\t\tsocket.on('walletUpdate', (data) => {\n\t\t\t\twallet.value = data;\n\t\t\t});\n\n\t\t\t// Écouter les mises à jour des positions\n\t\t\tsocket.emit('getPositions');\n\t\t\tsocket.on('positionsUpdate', (data) => {\n\t\t\t\tpositions.value = data;\n\t\t\t});\n\n\t\t\t// Écouter les mises à jour des transactions\n\t\t\tsocket.emit('getTransactions');\n\t\t\tsocket.on('transactionsUpdate', (data) => {\n\t\t\t\ttransactions.value = data;\n\t\t\t});\n\n\t\t\t// Écouter les réponses aux demandes\n\t\t\tsocket.on('depositResponse', (response) => {\n\t\t\t\tif (response.success) {\n\t\t\t\t\talert('Demande de dépôt envoyée pour approbation');\n\t\t\t\t} else {\n\t\t\t\t\talert(response.message || 'Échec de la demande de dépôt');\n\t\t\t\t}\n\t\t\t});\n\n\t\t\tsocket.on('withdrawalResponse', (response) => {\n\t\t\t\tif (response.success) {\n\t\t\t\t\talert('Demande de retrait envoyée pour approbation');\n\t\t\t\t} else {\n\t\t\t\t\talert(response.message || 'Échec de la demande de retrait');\n\t\t\t\t}\n\t\t\t});\n\n\t\t\t// Écouter le traitement des demandes\n\t\t\tsocket.on('requestProcessed', (data) => {\n\t\t\t\tconst typeText = data.type === 'deposit' ? 'dépôt' : 'retrait';\n\t\t\t\tconst statusText = data.status === 'completed' ? 'approuvée' : 'rejetée';\n\t\t\t\talert(`Votre demande de ${typeText} de ${formatPrice(data.amount)} a été ${statusText}.`);\n\t\t\t});\n\t\t});\n\n\t\tonUnmounted(() => {\n\t\t\tsocket.off('walletUpdate');\n\t\t\tsocket.off('positionsUpdate');\n\t\t\tsocket.off('transactionsUpdate');\n\t\t\tsocket.off('depositResponse');\n\t\t\tsocket.off('withdrawalResponse');\n\t\t\tsocket.off('requestProcessed');\n\t\t\tsocket.disconnect();\n\t\t});\n\n\t\treturn {\n\t\t\twallet,\n\t\t\tpositions,\n\t\t\ttransactions,\n\t\t\tdepositAmount,\n\t\t\twithdrawalAmount,\n\t\t\trequestDeposit,\n\t\t\trequestWithdrawal,\n\t\t\tformatPrice,\n\t\t\tformatTransactionType,\n\t\t\tformatTransactionStatus\n\t\t};\n\t}\n};\n</script>\n\n<style scoped>\n.wallet {\n\tpadding: 20px;\n}\n\n.wallet-info {\n\tmargin: 20px 0;\n\tpad