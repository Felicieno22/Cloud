{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport axios from 'axios';\nimport { socket } from '@/socket';\nimport { useStore } from 'vuex';\nconst API_URL = 'http://localhost:8081';\nexport default {\n  name: 'Wallet',\n  setup() {\n    const store = useStore();\n    const wallet = ref(null);\n    const positions = ref([]);\n    const transactions = ref([]);\n    const depositAmount = ref('');\n    const withdrawalAmount = ref('');\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const getAuthToken = () => {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        console.log('No token found');\n        return null;\n      }\n      return token;\n    };\n    const fetchWallet = async () => {\n      try {\n        const token = getAuthToken();\n        if (!token) return;\n        const response = await axios.get(`${API_URL}/api/wallet`, {\n          headers: {\n            'Authorization': `Bearer ${token}`\n          }\n        });\n        wallet.value = response.data;\n      } catch (error) {\n        console.error('Error fetching wallet:', error);\n      }\n    };\n    const fetchPositions = async () => {\n      try {\n        const token = getAuthToken();\n        if (!token) return;\n        const response = await axios.get(`${API_URL}/api/wallet/positions`, {\n          headers: {\n            'Authorization': `Bearer ${token}`\n          }\n        });\n        positions.value = response.data;\n      } catch (error) {\n        console.error('Error fetching positions:', error);\n      }\n    };\n    const fetchTransactions = async () => {\n      try {\n        const token = getAuthToken();\n        if (!token) return;\n        const response = await axios.get(`${API_URL}/api/wallet/transactions`, {\n          headers: {\n            'Authorization': `Bearer ${token}`\n          }\n        });\n        transactions.value = response.data;\n      } catch (error) {\n        console.error('Error fetching transactions:', error);\n      }\n    };\n    const requestDeposit = async () => {\n      try {\n        const token = getAuthToken();\n        if (!token) {\n          alert('Veuillez vous connecter pour effectuer un dépôt');\n          return;\n        }\n        await axios.post(`${API_URL}/api/wallet/request`, {\n          type: 'deposit',\n          amount: parseFloat(depositAmount.value)\n        }, {\n          headers: {\n            'Authorization': `Bearer ${token}`\n          }\n        });\n        alert('Demande de dépôt envoyée pour approbation');\n        depositAmount.value = '';\n        await fetchWallet();\n        await fetchTransactions();\n      } catch (error) {\n        console.error('Error requesting deposit:', error);\n        alert('Échec de la demande de dépôt');\n      }\n    };\n    const requestWithdrawal = async () => {\n      try {\n        const token = getAuthToken();\n        if (!token) {\n          alert('Veuillez vous connecter pour effectuer un retrait');\n          return;\n        }\n        await axios.post(`${API_URL}/api/wallet/request`, {\n          type: 'withdrawal',\n          amount: parseFloat(withdrawalAmount.value)\n        }, {\n          headers: {\n            'Authorization': `Bearer ${token}`\n          }\n        });\n        alert('Demande de retrait envoyée pour approbation');\n        withdrawalAmount.value = '';\n        await fetchWallet();\n        await fetchTransactions();\n      } catch (error) {\n        console.error('Error requesting withdrawal:', error);\n        alert('Échec de la demande de retrait');\n      }\n    };\n\n    // Socket.io event handlers\n    const setupSocketListeners = () => {\n      socket.on('walletUpdate', data => {\n        wallet.value = data;\n      });\n      socket.on('positionsUpdate', data => {\n        positions.value = data;\n      });\n      socket.on('transactionsUpdate', data => {\n        transactions.value = data;\n      });\n    };\n    onMounted(() => {\n      const token = getAuthToken();\n      if (!token) {\n        console.log('No token found, please login first');\n        return;\n      }\n      socket.connect();\n      setupSocketListeners();\n      fetchWallet();\n      fetchPositions();\n      fetchTransactions();\n    });\n    onUnmounted(() => {\n      socket.off('walletUpdate');\n      socket.off('positionsUpdate');\n      socket.off('transactionsUpdate');\n      socket.disconnect();\n    });\n    return {\n      wallet,\n      positions,\n      transactions,\n      depositAmount,\n      withdrawalAmount,\n      requestDeposit,\n      requestWithdrawal,\n      formatPrice\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","axios","socket","useStore","API_URL","name","setup","store","wallet","positions","transactions","depositAmount","withdrawalAmount","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","getAuthToken","token","localStorage","getItem","console","log","fetchWallet","response","get","headers","value","data","error","fetchPositions","fetchTransactions","requestDeposit","alert","post","type","amount","parseFloat","requestWithdrawal","setupSocketListeners","on","connect","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Wallet.vue"],"sourcesContent":["<template>\n\t<div class=\"container mx-auto px-4 py-8\">\n\t\t<h1 class=\"text-3xl font-bold text-gray-900 mb-8\">Mon Portefeuille</h1>\n\t\t<div v-if=\"wallet\" class=\"bg-white rounded-lg shadow-lg p-6 mb-8\">\n\t\t\t<div class=\"text-2xl font-bold text-gray-900\">\n\t\t\t\tSolde: {{ formatPrice(wallet.balance) }}\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 mb-8\">\n\t\t\t<div class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h3 class=\"text-xl font-semibold text-gray-900 mb-4\">Demande de Dépôt</h3>\n\t\t\t\t<form @submit.prevent=\"requestDeposit\" class=\"space-y-4\">\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<label class=\"block text-sm font-medium text-gray-700\">Montant</label>\n\t\t\t\t\t\t<input \n\t\t\t\t\t\t\ttype=\"number\" \n\t\t\t\t\t\t\tv-model=\"depositAmount\" \n\t\t\t\t\t\t\tplaceholder=\"Montant à déposer\"\n\t\t\t\t\t\t\tmin=\"0\"\n\t\t\t\t\t\t\tstep=\"0.01\"\n\t\t\t\t\t\t\trequired\n\t\t\t\t\t\t\tclass=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t</div>\n\t\t\t\t\t<button type=\"submit\" class=\"w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition-colors\">\n\t\t\t\t\t\tDemander un Dépôt\n\t\t\t\t\t</button>\n\t\t\t\t</form>\n\t\t\t</div>\n\n\t\t\t<div class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h3 class=\"text-xl font-semibold text-gray-900 mb-4\">Demande de Retrait</h3>\n\t\t\t\t<form @submit.prevent=\"requestWithdrawal\" class=\"space-y-4\">\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<label class=\"block text-sm font-medium text-gray-700\">Montant</label>\n\t\t\t\t\t\t<input \n\t\t\t\t\t\t\ttype=\"number\" \n\t\t\t\t\t\t\tv-model=\"withdrawalAmount\" \n\t\t\t\t\t\t\tplaceholder=\"Montant à retirer\"\n\t\t\t\t\t\t\tmin=\"0\"\n\t\t\t\t\t\t\tstep=\"0.01\"\n\t\t\t\t\t\t\trequired\n\t\t\t\t\t\t\tclass=\"mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t</div>\n\t\t\t\t\t<button type=\"submit\" class=\"w-full bg-red-600 text-white py-2 px-4 rounded-md hover:bg-red-700 transition-colors\">\n\t\t\t\t\t\tDemander un Retrait\n\t\t\t\t\t</button>\n\t\t\t\t</form>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n\t\t\t<div v-if=\"positions.length\" class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h2 class=\"text-xl font-semibold text-gray-900 mb-4\">Positions</h2>\n\t\t\t\t<ul class=\"divide-y divide-gray-200\">\n\t\t\t\t\t<li v-for=\"position in positions\" :key=\"position.id\" class=\"py-3\">\n\t\t\t\t\t\t<div class=\"flex justify-between\">\n\t\t\t\t\t\t\t<span class=\"font-medium\">{{ position.asset }}</span>\n\t\t\t\t\t\t\t<span>{{ formatPrice(position.amount) }}</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\n\t\t\t<div v-if=\"transactions.length\" class=\"bg-white rounded-lg shadow-lg p-6\">\n\t\t\t\t<h2 class=\"text-xl font-semibold text-gray-900 mb-4\">Transactions Récentes</h2>\n\t\t\t\t<ul class=\"divide-y divide-gray-200\">\n\t\t\t\t\t<li v-for=\"tx in transactions\" :key=\"tx.id\" class=\"py-3\">\n\t\t\t\t\t\t<div class=\"flex justify-between\">\n\t\t\t\t\t\t\t<span class=\"font-medium\">{{ tx.type === 'deposit' ? 'Dépôt' : 'Retrait' }}</span>\n\t\t\t\t\t\t\t<span :class=\"tx.type === 'deposit' ? 'text-green-600' : 'text-red-600'\">\n\t\t\t\t\t\t\t\t{{ formatPrice(tx.amount) }}\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"text-sm text-gray-500\">\n\t\t\t\t\t\t\t{{ new Date(tx.created_at).toLocaleDateString('fr-FR') }}\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted } from 'vue';\nimport axios from 'axios';\nimport { socket } from '@/socket';\nimport { useStore } from 'vuex';\n\nconst API_URL = 'http://localhost:8081';\n\nexport default {\n\tname: 'Wallet',\n\tsetup() {\n\t\tconst store = useStore();\n\t\tconst wallet = ref(null);\n\t\tconst positions = ref([]);\n\t\tconst transactions = ref([]);\n\t\tconst depositAmount = ref('');\n\t\tconst withdrawalAmount = ref('');\n\n\t\tconst formatPrice = (price) => {\n\t\t\tif (typeof price !== 'number') return '$0.00';\n\t\t\treturn new Intl.NumberFormat('fr-FR', {\n\t\t\t\tstyle: 'currency',\n\t\t\t\tcurrency: 'USD',\n\t\t\t\tminimumFractionDigits: 2,\n\t\t\t\tmaximumFractionDigits: 2\n\t\t\t}).format(price);\n\t\t};\n\n\t\tconst getAuthToken = () => {\n\t\t\tconst token = localStorage.getItem('token');\n\t\t\tif (!token) {\n\t\t\t\tconsole.log('No token found');\n\t\t\t\treturn null;\n\t\t\t}\n\t\t\treturn token;\n\t\t};\n\n\t\tconst fetchWallet = async () => {\n\t\t\ttry {\n\t\t\t\tconst token = getAuthToken();\n\t\t\t\tif (!token) return;\n\n\t\t\t\tconst response = await axios.get(`${API_URL}/api/wallet`, {\n\t\t\t\t\theaders: {\n\t\t\t\t\t\t'Authorization': `Bearer ${token}`\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t\twallet.value = response.data;\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error fetching wallet:', error);\n\t\t\t}\n\t\t};\n\n\t\tconst fetchPositions = async () => {\n\t\t\ttry {\n\t\t\t\tconst token = getAuthToken();\n\t\t\t\tif (!token) return;\n\n\t\t\t\tconst response = await axios.get(`${API_URL}/api/wallet/positions`, {\n\t\t\t\t\theaders: {\n\t\t\t\t\t\t'Authorization': `Bearer ${token}`\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t\tpositions.value = response.data;\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error fetching positions:', error);\n\t\t\t}\n\t\t};\n\n\t\tconst fetchTransactions = async () => {\n\t\t\ttry {\n\t\t\t\tconst token = getAuthToken();\n\t\t\t\tif (!token) return;\n\n\t\t\t\tconst response = await axios.get(`${API_URL}/api/wallet/transactions`, {\n\t\t\t\t\theaders: {\n\t\t\t\t\t\t'Authorization': `Bearer ${token}`\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t\ttransactions.value = response.data;\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error('Error fetching transactions:', error);\n\t\t\t}\n\t\t};\n\n\t\tconst requestDeposit = async () => {\n\t\t\ttry {\n\t\t\t\tconst token = getAuthToken();\n\t\t\t\tif (!token) {\n\t\t\t\t\talert('Veuillez vous connecter pour effectuer un dépôt');\n\t\t\t\t\treturn;\n\t\t\t\t}\n\n\t\t\t\tawait axios.post(`${API_URL}/api/wallet/request`, \n\t\t\t\t\t{ \n\t\t\t\t\t\tt