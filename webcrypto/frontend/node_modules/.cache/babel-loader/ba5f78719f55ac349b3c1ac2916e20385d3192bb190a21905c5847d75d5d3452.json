{"ast":null,"code":"import { computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter, useRoute } from 'vue-router';\nexport default {\n  name: 'App',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const route = useRoute();\n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated']);\n    const isAdminRoute = computed(() => {\n      // Vérifier si le chemin commence par /admin ou si la route a la méta-donnée requiresAdmin\n      return route.path.startsWith('/admin') || route.meta.requiresAdmin === true;\n    });\n    const handleLogout = async () => {\n      await store.dispatch('auth/logout');\n      router.push('/login');\n    };\n    const handleAdminLogout = async () => {\n      await store.dispatch('auth/logout');\n      router.push('/admin/login');\n    };\n\n    // Vérifier l'authentification au démarrage\n    store.dispatch('auth/init');\n    return {\n      isAuthenticated,\n      isAdminRoute,\n      handleLogout,\n      handleAdminLogout\n    };\n  }\n};","map":{"version":3,"names":["computed","useStore","useRouter","useRoute","name","setup","store","router","route","isAuthenticated","getters","isAdminRoute","path","startsWith","meta","requiresAdmin","handleLogout","dispatch","push","handleAdminLogout"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div>\n    <!-- Navigation principale - cachée pour les routes admin -->\n    <nav v-if=\"!isAdminRoute\" class=\"bg-white shadow\">\n      <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"flex justify-between h-16\">\n          <div class=\"flex\">\n            <div class=\"flex-shrink-0 flex items-center\">\n              <router-link to=\"/\" class=\"text-xl font-bold text-indigo-600\">\n                CryptoTrade\n              </router-link>\n            </div>\n          </div>\n          <div class=\"flex items-center space-x-4\">\n            <router-link\n              v-if=\"isAuthenticated\"\n              to=\"/dashboard\"\n              class=\"text-gray-700 hover:text-indigo-600\"\n            >\n              Dashboard\n            </router-link>\n            <router-link\n              v-if=\"isAuthenticated\"\n              to=\"/wallet\"\n              class=\"text-gray-700 hover:text-indigo-600\"\n            >\n              Portefeuille\n            </router-link>\n            <button\n              v-if=\"isAuthenticated\"\n              @click=\"handleLogout\"\n              class=\"text-red-600 hover:text-red-800\"\n            >\n              Déconnexion\n            </button>\n          </div>\n        </div>\n      </div>\n    </nav>\n\n    <!-- Navigation admin - visible uniquement pour les routes admin -->\n    <nav v-if=\"isAdminRoute && isAuthenticated\" class=\"bg-white shadow\">\n      <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"flex justify-between h-16\">\n          <div class=\"flex\">\n            <div class=\"flex-shrink-0 flex items-center\">\n              <router-link to=\"/admin/dashboard\" class=\"text-xl font-bold text-indigo-600\">\n                Administration\n              </router-link>\n            </div>\n          </div>\n          <div class=\"flex items-center space-x-4\">\n            <button\n              @click=\"handleAdminLogout\"\n              class=\"text-red-600 hover:text-red-800\"\n            >\n              Déconnexion\n            </button>\n          </div>\n        </div>\n      </div>\n    </nav>\n\n    <router-view />\n  </div>\n</template>\n\n<script>\nimport { computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter, useRoute } from 'vue-router'\n\nexport default {\n  name: 'App',\n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const route = useRoute()\n    \n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated'])\n    const isAdminRoute = computed(() => {\n      // Vérifier si le chemin commence par /admin ou si la route a la méta-donnée requiresAdmin\n      return route.path.startsWith('/admin') || route.meta.requiresAdmin === true\n    })\n    \n    const handleLogout = async () => {\n      await store.dispatch('auth/logout')\n      router.push('/login')\n    }\n\n    const handleAdminLogout = async () => {\n      await store.dispatch('auth/logout')\n      router.push('/admin/login')\n    }\n\n    // Vérifier l'authentification au démarrage\n    store.dispatch('auth/init')\n\n    return {\n      isAuthenticated,\n      isAdminRoute,\n      handleLogout,\n      handleAdminLogout\n    }\n  }\n}\n</script>\n"],"mappings":"AAoEA,SAASA,QAAO,QAAS,KAAI;AAC7B,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAS,EAAEC,QAAO,QAAS,YAAW;AAE/C,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC;IACvB,MAAMM,MAAK,GAAIL,SAAS,CAAC;IACzB,MAAMM,KAAI,GAAIL,QAAQ,CAAC;IAEvB,MAAMM,eAAc,GAAIT,QAAQ,CAAC,MAAMM,KAAK,CAACI,OAAO,CAAC,sBAAsB,CAAC;IAC5E,MAAMC,YAAW,GAAIX,QAAQ,CAAC,MAAM;MAClC;MACA,OAAOQ,KAAK,CAACI,IAAI,CAACC,UAAU,CAAC,QAAQ,KAAKL,KAAK,CAACM,IAAI,CAACC,aAAY,KAAM,IAAG;IAC5E,CAAC;IAED,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,MAAMV,KAAK,CAACW,QAAQ,CAAC,aAAa;MAClCV,MAAM,CAACW,IAAI,CAAC,QAAQ;IACtB;IAEA,MAAMC,iBAAgB,GAAI,MAAAA,CAAA,KAAY;MACpC,MAAMb,KAAK,CAACW,QAAQ,CAAC,aAAa;MAClCV,MAAM,CAACW,IAAI,CAAC,cAAc;IAC5B;;IAEA;IACAZ,KAAK,CAACW,QAAQ,CAAC,WAAW;IAE1B,OAAO;MACLR,eAAe;MACfE,YAAY;MACZK,YAAY;MACZG;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}