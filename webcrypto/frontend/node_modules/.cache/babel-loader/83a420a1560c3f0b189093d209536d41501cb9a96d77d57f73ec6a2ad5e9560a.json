{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted } from 'vue';\nimport { socket } from '@/socket';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'TransactionsList',\n  setup() {\n    const router = useRouter();\n    const transactions = ref([]);\n    const cryptoList = ref([]);\n    const currentPage = ref(1);\n    const itemsPerPage = 10;\n\n    // Filtres\n    const filters = ref({\n      type: '',\n      symbol: ''\n    });\n\n    // Formatage des nombres\n    const formatPrice = price => {\n      if (!price) return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const formatQuantity = quantity => {\n      if (!quantity) return '0.000000';\n      return new Intl.NumberFormat('fr-FR', {\n        minimumFractionDigits: 6,\n        maximumFractionDigits: 6\n      }).format(quantity);\n    };\n\n    // Filtrage des transactions\n    const filteredTransactions = computed(() => {\n      if (!transactions.value) return [];\n      return transactions.value.filter(tx => {\n        if (!tx) return false;\n        if (filters.value.type && tx.type !== filters.value.type) return false;\n        if (filters.value.symbol && tx.symbol !== filters.value.symbol) return false;\n        return true;\n      });\n    });\n\n    // Pagination\n    const totalPages = computed(() => Math.ceil((filteredTransactions.value?.length || 0) / itemsPerPage));\n    const paginatedTransactions = computed(() => {\n      if (!filteredTransactions.value) return [];\n      const start = (currentPage.value - 1) * itemsPerPage;\n      const end = start + itemsPerPage;\n      return filteredTransactions.value.slice(start, end);\n    });\n    const paginationStart = computed(() => (currentPage.value - 1) * itemsPerPage);\n    const paginationEnd = computed(() => Math.min(currentPage.value * itemsPerPage, filteredTransactions.value?.length || 0));\n\n    // Affichage des numéros de page\n    const displayedPages = computed(() => {\n      const pages = [];\n      const maxDisplayed = 5;\n      let start = Math.max(1, currentPage.value - Math.floor(maxDisplayed / 2));\n      let end = Math.min(totalPages.value, start + maxDisplayed - 1);\n      if (end - start + 1 < maxDisplayed) {\n        start = Math.max(1, end - maxDisplayed + 1);\n      }\n      for (let i = start; i <= end; i++) {\n        pages.push(i);\n      }\n      return pages;\n    });\n    onMounted(() => {\n      socket.connect();\n\n      // Authentification\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken') || localStorage.getItem('access_token');\n      if (!token) {\n        router.push('/login');\n        return;\n      }\n      socket.emit('authenticate', token);\n      socket.on('authenticated', () => {\n        // Demander la liste des transactions et des cryptos\n        socket.emit('getAllTransactions');\n        socket.emit('getCryptoList');\n      });\n      socket.on('allTransactionsUpdate', data => {\n        if (!data) {\n          transactions.value = [];\n          return;\n        }\n        transactions.value = data.map(tx => ({\n          ...tx,\n          quantity: parseFloat(tx.quantity) || 0,\n          price: parseFloat(tx.price) || 0,\n          created_at: new Date(tx.created_at)\n        }));\n      });\n      socket.on('cryptoListUpdate', data => {\n        cryptoList.value = data || [];\n      });\n      socket.on('error', error => {\n        console.error('Erreur socket:', error);\n        if (error.message.includes('authentification')) {\n          router.push('/login');\n        }\n      });\n    });\n    onUnmounted(() => {\n      socket.off('allTransactionsUpdate');\n      socket.off('cryptoListUpdate');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.disconnect();\n    });\n    return {\n      transactions,\n      cryptoList,\n      filters,\n      currentPage,\n      totalPages,\n      paginatedTransactions,\n      paginationStart,\n      paginationEnd,\n      displayedPages,\n      formatPrice,\n      formatQuantity\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","socket","useRouter","name","setup","router","transactions","cryptoList","currentPage","itemsPerPage","filters","type","symbol","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatQuantity","quantity","filteredTransactions","value","filter","tx","totalPages","Math","ceil","length","paginatedTransactions","start","end","slice","paginationStart","paginationEnd","min","displayedPages","pages","maxDisplayed","max","floor","i","push","connect","token","localStorage","getItem","emit","on","data","map","parseFloat","created_at","Date","error","console","message","includes","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\TransactionsList.vue"],"sourcesContent":["<template>\r\n  <div class=\"container mx-auto px-4 py-8\">\r\n    <h1 class=\"text-3xl font-bold text-gray-900 mb-8\">Historique des Transactions</h1>\r\n\r\n    <div class=\"bg-white shadow-lg rounded-lg overflow-hidden\">\r\n      <!-- Filtres -->\r\n      <div class=\"p-4 border-b border-gray-200 bg-gray-50 flex flex-wrap gap-4 items-center\">\r\n        <div class=\"flex-1 min-w-[200px]\">\r\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Type</label>\r\n          <select \r\n            v-model=\"filters.type\" \r\n            class=\"w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n          >\r\n            <option value=\"\">Tous</option>\r\n            <option value=\"buy\">Achats</option>\r\n            <option value=\"sell\">Ventes</option>\r\n          </select>\r\n        </div>\r\n        <div class=\"flex-1 min-w-[200px]\">\r\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Crypto</label>\r\n          <select \r\n            v-model=\"filters.symbol\" \r\n            class=\"w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n          >\r\n            <option value=\"\">Toutes</option>\r\n            <option v-for=\"crypto in cryptoList\" :key=\"crypto.symbol\" :value=\"crypto.symbol\">\r\n              {{ crypto.name }} ({{ crypto.symbol }})\r\n            </option>\r\n          </select>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Tableau des transactions -->\r\n      <div class=\"overflow-x-auto\">\r\n        <table class=\"min-w-full divide-y divide-gray-200\">\r\n          <thead class=\"bg-gray-50\">\r\n            <tr>\r\n              <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">Date</th>\r\n              <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">Utilisateur</th>\r\n              <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">Type</th>\r\n              <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">Crypto</th>\r\n              <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">Quantité</th>\r\n              <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">Prix</th>\r\n              <th class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">Total</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody class=\"bg-white divide-y divide-gray-200\">\r\n            <tr v-for=\"tx in paginatedTransactions\" :key=\"tx.id\" class=\"hover:bg-gray-50\">\r\n              <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">\r\n                {{ new Date(tx.created_at).toLocaleString('fr-FR') }}\r\n              </td>\r\n              <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\r\n                {{ tx.username }}\r\n              </td>\r\n              <td class=\"px-6 py-4 whitespace-nowrap\">\r\n                <span :class=\"{\r\n                  'px-2 py-1 text-xs font-semibold rounded-full': true,\r\n                  'bg-green-100 text-green-800': tx.type === 'buy',\r\n                  'bg-red-100 text-red-800': tx.type === 'sell'\r\n                }\">\r\n                  {{ tx.type === 'buy' ? 'Achat' : 'Vente' }}\r\n                </span>\r\n              </td>\r\n              <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\r\n                {{ tx.symbol }}\r\n              </td>\r\n              <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\r\n                {{ formatQuantity(tx.quantity) }}\r\n              </td>\r\n              <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\r\n                {{ formatPrice(tx.price) }}\r\n              </td>\r\n              <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\r\n                {{ formatPrice(tx.quantity * tx.price) }}\r\n              </td>\r\n            </tr>\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n\r\n      <!-- Pagination -->\r\n      <div class=\"px-6 py-4 bg-gray-50 border-t border-gray-200\">\r\n        <div class=\"flex items-center justify-between\">\r\n          <div class=\"flex items-center\">\r\n            <span class=\"text-sm text-gray-700\">\r\n              Affichage de {{ paginationStart + 1 }} à {{ paginationEnd }} sur {{ filteredTransactions.length }} transactions\r\n            </span>\r\n          </div>\r\n          <div class=\"flex items-center space-x-2\">\r\n            <button \r\n              @click=\"currentPage--\" \r\n              :disabled=\"currentPage === 1\"\r\n              class=\"px-3 py-1 rounded-md bg-white border border-gray-300 text-gray-700 disabled:opacity-50 hover:bg-gray-50\"\r\n            >\r\n              Précédent\r\n            </button>\r\n            <div class=\"flex items-center space-x-1\">\r\n              <button \r\n                v-for=\"page in displayedPages\" \r\n                :key=\"page\"\r\n                @click=\"currentPage = page\"\r\n                :class=\"{\r\n                  'px-3 py-1 rounded-md': true,\r\n                  'bg-indigo-600 text-white': currentPage === page,\r\n                  'bg-white border border-gray-300 text-gray-700 hover:bg-gray-50': currentPage !== page\r\n                }\"\r\n              >\r\n                {{ page }}\r\n              </button>\r\n            </div>\r\n            <button \r\n              @click=\"currentPage++\" \r\n              :disabled=\"currentPage >= totalPages\"\r\n              class=\"px-3 py-1 rounded-md bg-white border border-gray-300 text-gray-700 disabled:opacity-50 hover:bg-gray-50\"\r\n            >\r\n              Suivant\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, onUnmounted } from 'vue';\r\nimport { socket } from '@/socket';\r\nimport { useRouter } from 'vue-router';\r\n\r\nexport default {\r\n  name: 'TransactionsList',\r\n  \r\n  setup() {\r\n    const router = useRouter();\r\n    const transactions = ref([]);\r\n    const cryptoList = ref([]);\r\n    const currentPage = ref(1);\r\n    const itemsPerPage = 10;\r\n\r\n    // Filtres\r\n    const filters = ref({\r\n      type: '',\r\n      symbol: ''\r\n    });\r\n\r\n    // Formatage des nombres\r\n    const formatPrice = (price) => {\r\n      if (!price) return '$0.00';\r\n      return new Intl.NumberFormat('fr-FR', {\r\n        style: 'currency',\r\n        currency: 'USD',\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2\r\n      }).format(price);\r\n    };\r\n\r\n    const formatQuantity = (quantity) => {\r\n      if (!quantity) return '0.000000';\r\n      return new Intl.NumberFormat('fr-FR', {\r\n        minimumFractionDigits: 6,\r\n        maximumFractionDigits: 6\r\n      }).format(quantity);\r\n    };\r\n\r\n    // Filtrage des transactions\r\n    const filteredTransactions = computed(() => {\r\n      if (!transactions.value) return [];\r\n      return transactions.value.filter(tx => {\r\n        if (!tx) return false;\r\n        if (filters.value.type && tx.type !== filters.value.type) return false;\r\n        if (filters.value.symbol && tx.symbol !== filters.value.symbol) return false;\r\n        return true;\r\n      });\r\n    });\r\n\r\n    // Pagination\r\n    const totalPages = computed(() => Math.ceil((filteredTransactions.value?.length || 0) / itemsPerPage));\r\n    \r\n    const paginatedTransactions = computed(() => {\r\n      if (!filteredTransactions.value) return [];\r\n      const start = (currentPage.value - 1) * itemsPerPage;\r\n      const end = start + itemsPerPage;\r\n      return filteredTransactions.value.slice(start, end);\r\n    });\r\n\r\n    const paginationStart = computed(() => (currentPage.value - 1) * itemsPerPage);\r\n    const paginationEnd = computed(() => Math.min(currentPage.value * itemsPerPage, filteredTransactions.value?.length || 0));\r\n\r\n    // Affichage des numéros de page\r\n    const displayedPages = computed(() => {\r\n      const pages = [];\r\n      const maxDisplayed = 5;\r\n      let start = Math.max(1, currentPage.value - Math.floor(maxDisplayed / 2));\r\n      let end = Math.min(totalPages.value, start + maxDisplayed - 1);\r\n      \r\n      if (end - start + 1 < maxDisplayed) {\r\n        start = Math.max(1, end - maxDisplayed + 1);\r\n      }\r\n      \r\n      for (let i = start; i <= end; i++) {\r\n        pages.push(i);\r\n      }\r\n      return pages;\r\n    });\r\n\r\n    onMounted(() => {\r\n      socket.connect();\r\n\r\n      // Authentification\r\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken') || localStorage.getItem('access_token');\r\n      if (!token) {\r\n        router.push('/login');\r\n        return;\r\n      }\r\n\r\n      socket.emit('authenticate', token);\r\n\r\n      socket.on('authenticated', () => {\r\n        // Demander la liste des transactions et des cryptos\r\n        socket.emit('getAllTransactions');\r\n        socket.emit('getCryptoList');\r\n      });\r\n\r\n      socket.on('allTransactionsUpdate', (data) => {\r\n        if (!data) {\r\n          transactions.value = [];\r\n          return;\r\n        }\r\n        transactions.value = data.map(tx => ({\r\n          ...tx,\r\n          quantity: parseFloat(tx.quantity) || 0,\r\n          price: parseFloat(tx.price) || 0,\r\n          created_at: new Date(tx.created_at)\r\n        }));\r\n      });\r\n\r\n      socket.on('cryptoListUpdate', (data) => {\r\n        cryptoList.value = data || [];\r\n      });\r\n\r\n      socket.on('error', (error) => {\r\n        console.error('Erreur socket:', error);\r\n        if (error.message.includes('authentification')) {\r\n          router.push('/login');\r\n        }\r\n      });\r\n    });\r\n\r\n    onUnmounted(() => {\r\n      socket.off('allTransactionsUpdate');\r\n      socket.off('cryptoListUpdate');\r\n      socket.off('authenticated');\r\n      socket.off('error');\r\n      socket.disconnect();\r\n    });\r\n\r\n    return {\r\n      transactions,\r\n      cryptoList,\r\n      filters,\r\n      currentPage,\r\n      totalPages,\r\n      paginatedTransactions,\r\n      paginationStart,\r\n      paginationEnd,\r\n      displayedPages,\r\n      formatPrice,\r\n      formatQuantity\r\n    };\r\n  }\r\n};\r\n</script> "],"mappings":"AA6HA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AAC3D,SAASC,MAAK,QAAS,UAAU;AACjC,SAASC,SAAQ,QAAS,YAAY;AAEtC,eAAe;EACbC,IAAI,EAAE,kBAAkB;EAExBC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAA