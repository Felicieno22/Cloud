{"ast":null,"code":"import { ref, computed, onMounted } from 'vue';\nexport default {\n  name: 'AdminTransactions',\n  setup() {\n    const transactions = ref([]);\n    const statusFilter = ref('pending');\n    const typeFilter = ref('all');\n\n    // Filtrer les transactions\n    const filteredTransactions = computed(() => {\n      return transactions.value.filter(tx => {\n        const matchStatus = statusFilter.value === 'all' || tx.status === statusFilter.value;\n        const matchType = typeFilter.value === 'all' || tx.type === typeFilter.value;\n        return matchStatus && matchType;\n      });\n    });\n\n    // Charger les transactions\n    const loadTransactions = async () => {\n      try {\n        const response = await fetch('/api/admin/pending-transactions');\n        if (!response.ok) throw new Error('Erreur lors du chargement des transactions');\n        transactions.value = await response.json();\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n\n    // Formatage des données\n    const formatDate = date => {\n      return new Date(date).toLocaleString('fr-FR', {\n        dateStyle: 'short',\n        timeStyle: 'short'\n      });\n    };\n    const formatPrice = price => {\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const formatTransactionType = type => {\n      const types = {\n        deposit: 'Dépôt',\n        withdrawal: 'Retrait'\n      };\n      return types[type] || type;\n    };\n    const getTransactionTypeClass = type => {\n      const classes = {\n        deposit: 'text-blue-600',\n        withdrawal: 'text-orange-600'\n      };\n      return classes[type] || 'text-gray-600';\n    };\n    const formatStatus = status => {\n      const statuses = {\n        pending: 'En attente',\n        completed: 'Complété',\n        rejected: 'Rejeté'\n      };\n      return statuses[status] || status;\n    };\n    const getStatusClass = status => {\n      const classes = {\n        pending: 'bg-yellow-100 text-yellow-800',\n        completed: 'bg-green-100 text-green-800',\n        rejected: 'bg-red-100 text-red-800'\n      };\n      return `px-2 py-1 rounded-full text-xs font-medium ${classes[status] || 'bg-gray-100 text-gray-800'}`;\n    };\n\n    // Gérer les actions sur les transactions\n    const handleAction = async (transactionId, action) => {\n      try {\n        const response = await fetch(`/api/admin/validate-transaction/${transactionId}`, {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            action\n          })\n        });\n        if (!response.ok) throw new Error(`Erreur lors de l'action ${action}`);\n\n        // Recharger les transactions\n        await loadTransactions();\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n    onMounted(() => {\n      loadTransactions();\n    });\n    return {\n      transactions,\n      statusFilter,\n      typeFilter,\n      filteredTransactions,\n      formatDate,\n      formatPrice,\n      formatTransactionType,\n      getTransactionTypeClass,\n      formatStatus,\n      getStatusClass,\n      handleAction\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","name","setup","transactions","statusFilter","typeFilter","filteredTransactions","value","filter","tx","matchStatus","status","matchType","type","loadTransactions","response","fetch","ok","Error","json","error","console","formatDate","date","Date","toLocaleString","dateStyle","timeStyle","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatTransactionType","types","deposit","withdrawal","getTransactionTypeClass","classes","formatStatus","statuses","pending","completed","rejected","getStatusClass","handleAction","transactionId","action","method","headers","body","JSON","stringify"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\AdminTransactions.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"bg-white rounded-lg shadow-lg p-6\">\n      <h1 class=\"text-2xl font-bold text-gray-900 mb-6\">Gestion des transactions</h1>\n\n      <!-- Filtres -->\n      <div class=\"mb-6 flex space-x-4\">\n        <select v-model=\"statusFilter\" class=\"rounded-lg border-gray-300\">\n          <option value=\"all\">Tous les statuts</option>\n          <option value=\"pending\">En attente</option>\n          <option value=\"completed\">Complétés</option>\n          <option value=\"rejected\">Rejetés</option>\n        </select>\n        <select v-model=\"typeFilter\" class=\"rounded-lg border-gray-300\">\n          <option value=\"all\">Tous les types</option>\n          <option value=\"deposit\">Dépôts</option>\n          <option value=\"withdrawal\">Retraits</option>\n        </select>\n      </div>\n\n      <!-- Liste des transactions -->\n      <div class=\"overflow-x-auto\">\n        <table class=\"min-w-full\">\n          <thead>\n            <tr class=\"border-b\">\n              <th class=\"text-left py-3 px-4\">Date</th>\n              <th class=\"text-left py-3 px-4\">Utilisateur</th>\n              <th class=\"text-left py-3 px-4\">Type</th>\n              <th class=\"text-right py-3 px-4\">Montant</th>\n              <th class=\"text-center py-3 px-4\">Statut</th>\n              <th class=\"text-right py-3 px-4\">Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr v-for=\"tx in filteredTransactions\" :key=\"tx.id\" class=\"border-b\">\n              <td class=\"py-3 px-4\">\n                {{ formatDate(tx.created_at) }}\n              </td>\n              <td class=\"py-3 px-4\">\n                {{ tx.username }}\n              </td>\n              <td class=\"py-3 px-4\">\n                <span :class=\"getTransactionTypeClass(tx.type)\">\n                  {{ formatTransactionType(tx.type) }}\n                </span>\n              </td>\n              <td class=\"text-right py-3 px-4\">\n                {{ formatPrice(tx.amount) }}\n              </td>\n              <td class=\"text-center py-3 px-4\">\n                <span :class=\"getStatusClass(tx.status)\">\n                  {{ formatStatus(tx.status) }}\n                </span>\n              </td>\n              <td class=\"text-right py-3 px-4\">\n                <div v-if=\"tx.status === 'pending'\" class=\"flex justify-end space-x-2\">\n                  <button\n                    @click=\"handleAction(tx.id, 'approve')\"\n                    class=\"px-3 py-1 bg-green-600 text-white rounded hover:bg-green-700\"\n                  >\n                    Approuver\n                  </button>\n                  <button\n                    @click=\"handleAction(tx.id, 'reject')\"\n                    class=\"px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700\"\n                  >\n                    Rejeter\n                  </button>\n                </div>\n                <span v-else>-</span>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <!-- Message si aucune transaction -->\n      <div v-if=\"filteredTransactions.length === 0\" class=\"text-center py-8 text-gray-500\">\n        Aucune transaction à afficher\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed, onMounted } from 'vue';\n\nexport default {\n  name: 'AdminTransactions',\n\n  setup() {\n    const transactions = ref([]);\n    const statusFilter = ref('pending');\n    const typeFilter = ref('all');\n\n    // Filtrer les transactions\n    const filteredTransactions = computed(() => {\n      return transactions.value.filter(tx => {\n        const matchStatus = statusFilter.value === 'all' || tx.status === statusFilter.value;\n        const matchType = typeFilter.value === 'all' || tx.type === typeFilter.value;\n        return matchStatus && matchType;\n      });\n    });\n\n    // Charger les transactions\n    const loadTransactions = async () => {\n      try {\n        const response = await fetch('/api/admin/pending-transactions');\n        if (!response.ok) throw new Error('Erreur lors du chargement des transactions');\n        transactions.value = await response.json();\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n\n    // Formatage des données\n    const formatDate = (date) => {\n      return new Date(date).toLocaleString('fr-FR', {\n        dateStyle: 'short',\n        timeStyle: 'short'\n      });\n    };\n\n    const formatPrice = (price) => {\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const formatTransactionType = (type) => {\n      const types = {\n        deposit: 'Dépôt',\n        withdrawal: 'Retrait'\n      };\n      return types[type] || type;\n    };\n\n    const getTransactionTypeClass = (type) => {\n      const classes = {\n        deposit: 'text-blue-600',\n        withdrawal: 'text-orange-600'\n      };\n      return classes[type] || 'text-gray-600';\n    };\n\n    const formatStatus = (status) => {\n      const statuses = {\n        pending: 'En attente',\n        completed: 'Complété',\n        rejected: 'Rejeté'\n      };\n      return statuses[status] || status;\n    };\n\n    const getStatusClass = (status) => {\n      const classes = {\n        pending: 'bg-yellow-100 text-yellow-800',\n        completed: 'bg-green-100 text-green-800',\n        rejected: 'bg-red-100 text-red-800'\n      };\n      return `px-2 py-1 rounded-full text-xs font-medium ${classes[status] || 'bg-gray-100 text-gray-800'}`;\n    };\n\n    // Gérer les actions sur les transactions\n    const handleAction = async (transactionId, action) => {\n      try {\n        const response = await fetch(`/api/admin/validate-transaction/${transactionId}`, {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({ action })\n        });\n\n        if (!response.ok) throw new Error(`Erreur lors de l'action ${action}`);\n\n        // Recharger les transactions\n        await loadTransactions();\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n\n    onMounted(() => {\n      loadTransactions();\n    });\n\n    return {\n      transactions,\n      statusFilter,\n      typeFilter,\n      filteredTransactions,\n      formatDate,\n      formatPrice,\n      formatTransactionType,\n      getTransactionTypeClass,\n      formatStatus,\n      getStatusClass,\n      handleAction\n    };\n  }\n};\n</script>\n"],"mappings":"AAqFA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AAE9C,eAAe;EACbC,IAAI,EAAE,mBAAmB;EAEzBC,KAAKA,CAAA,EAAG;IACN,MAAMC,YAAW,GAAIL,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMM,YAAW,GAAIN,GAAG,CAAC,SAAS,CAAC;IACnC,MAAMO,UAAS,GAAIP,GAAG,CAAC,KAAK,CAAC;;IAE7B;IACA,MAAMQ,oBAAmB,GAAIP,QAAQ,CAAC,MAAM;MAC1C,OAAOI,YAAY,CAACI,KAAK,CAACC,MAAM,CAACC,EAAC,IAAK;QACrC,MAAMC,WAAU,GAAIN,YAAY,CAACG,KAAI,KAAM,KAAI,IAAKE,EAAE,CAACE,MAAK,KAAMP,YAAY,CAACG,KAAK;QACpF,MAAMK,SAAQ,GAAIP,UAAU,CAACE,KAAI,KAAM,KAAI,IAAKE,EAAE,CAACI,IAAG,KAAMR,UAAU,CAACE,KAAK;QAC5E,OAAOG,WAAU,IAAKE,SAAS;MACjC,CAAC,CAAC;IACJ,CAAC,CAAC;;IAEF;IACA,MAAME,gBAAe,GAAI,MAAAA,CAAA,KAAY;MACnC,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAAC,iCAAiC,CAAC;QAC/D,IAAI,CAACD,QAAQ,CAACE,EAAE,EAAE,MAAM,IAAIC,KAAK,CAAC,4CAA4C,CAAC;QAC/Ef,YAAY,CAACI,KAAI,GAAI,MAAMQ,QAAQ,CAACI,IAAI,CAAC,CAAC;MAC5C,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,SAAS,EAAEA,KAAK,CAAC;MACjC;IACF,CAAC;;IAED;IACA,MAAME,UAAS,GAAKC,IAAI,IAAK;MAC3B,OAAO,IAAIC,IAAI,CAACD,IAAI,CAAC,CAACE,