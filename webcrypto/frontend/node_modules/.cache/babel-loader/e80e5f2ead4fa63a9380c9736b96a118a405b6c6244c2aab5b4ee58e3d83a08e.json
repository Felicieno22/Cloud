{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Trade',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const operationType = ref('buy');\n    const amount = ref('');\n    const getCurrentPrice = () => {\n      const prices = store.getters['crypto/getPrices'];\n      return prices[router.currentRoute.value.params.crypto] || 0;\n    };\n    const formatPrice = price => {\n      return Number(price).toLocaleString(undefined, {\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      });\n    };\n    const isValid = computed(() => {\n      return amount.value > 0;\n    });\n    const handleTrade = async () => {\n      try {\n        // TODO: Implémenter la logique de trading réelle\n        alert(`Transaction ${operationType.value} effectuée avec succès !`);\n        router.push('/dashboard');\n      } catch (error) {\n        alert(error.message || 'Erreur lors de la transaction');\n      }\n    };\n    return {\n      operationType,\n      amount,\n      getCurrentPrice,\n      formatPrice,\n      isValid,\n      handleTrade\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRouter","name","setup","store","router","operationType","amount","getCurrentPrice","prices","getters","currentRoute","value","params","crypto","formatPrice","price","Number","toLocaleString","undefined","minimumFractionDigits","maximumFractionDigits","isValid","handleTrade","alert","push","error","message"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\Trade.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"max-w-3xl mx-auto\">\n      <div class=\"mb-8\">\n        <button @click=\"$router.back()\" class=\"text-indigo-600 hover:text-indigo-800\">\n          ← Retour\n        </button>\n        <h1 class=\"text-3xl font-bold text-gray-900 mt-4\">\n          Trader {{ $route.params.crypto }}\n        </h1>\n      </div>\n\n      <div class=\"bg-white rounded-lg shadow-lg p-6\">\n        <!-- Prix actuel -->\n        <div class=\"mb-8\">\n          <h2 class=\"text-lg text-gray-600\">Prix actuel</h2>\n          <div class=\"text-4xl font-bold text-gray-900\">\n            ${{ formatPrice(getCurrentPrice()) }}\n          </div>\n        </div>\n\n        <!-- Formulaire de trading -->\n        <form @submit.prevent=\"handleTrade\">\n          <div class=\"space-y-6\">\n            <!-- Type d'opération -->\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700\">Type d'opération</label>\n              <div class=\"mt-2 grid grid-cols-2 gap-4\">\n                <button\n                  type=\"button\"\n                  :class=\"[\n                    'px-4 py-2 rounded-md text-sm font-medium w-full',\n                    operationType === 'buy'\n                      ? 'bg-green-600 text-white'\n                      : 'bg-gray-100 text-gray-900 hover:bg-gray-200'\n                  ]\"\n                  @click=\"operationType = 'buy'\"\n                >\n                  Acheter\n                </button>\n                <button\n                  type=\"button\"\n                  :class=\"[\n                    'px-4 py-2 rounded-md text-sm font-medium w-full',\n                    operationType === 'sell'\n                      ? 'bg-red-600 text-white'\n                      : 'bg-gray-100 text-gray-900 hover:bg-gray-200'\n                  ]\"\n                  @click=\"operationType = 'sell'\"\n                >\n                  Vendre\n                </button>\n              </div>\n            </div>\n\n            <!-- Montant -->\n            <div>\n              <label for=\"amount\" class=\"block text-sm font-medium text-gray-700\">\n                Montant ({{ operationType === 'buy' ? 'USD' : $route.params.crypto }})\n              </label>\n              <div class=\"mt-1\">\n                <input\n                  type=\"number\"\n                  step=\"0.01\"\n                  min=\"0\"\n                  v-model=\"amount\"\n                  class=\"shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md\"\n                />\n              </div>\n            </div>\n\n            <!-- Aperçu de la transaction -->\n            <div class=\"bg-gray-50 p-4 rounded-md\">\n              <h3 class=\"text-sm font-medium text-gray-700\">Aperçu de la transaction</h3>\n              <div class=\"mt-2 space-y-2\">\n                <div class=\"flex justify-between\">\n                  <span class=\"text-gray-500\">Montant</span>\n                  <span class=\"text-gray-900\">{{ amount }} {{ operationType === 'buy' ? 'USD' : $route.params.crypto }}</span>\n                </div>\n                <div class=\"flex justify-between\">\n                  <span class=\"text-gray-500\">Prix unitaire</span>\n                  <span class=\"text-gray-900\">${{ formatPrice(getCurrentPrice()) }}</span>\n                </div>\n                <div class=\"flex justify-between font-medium\">\n                  <span class=\"text-gray-500\">Total estimé</span>\n                  <span class=\"text-gray-900\">\n                    {{ operationType === 'buy' \n                      ? formatPrice(amount / getCurrentPrice()) + ' ' + $route.params.crypto\n                      : '$' + formatPrice(amount * getCurrentPrice()) }}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            <!-- Bouton de confirmation -->\n            <button\n              type=\"submit\"\n              :disabled=\"!isValid\"\n              :class=\"[\n                'w-full px-4 py-2 rounded-md text-sm font-medium text-white',\n                isValid\n                  ? operationType === 'buy'\n                    ? 'bg-green-600 hover:bg-green-700'\n                    : 'bg-red-600 hover:bg-red-700'\n                  : 'bg-gray-400 cursor-not-allowed'\n              ]\"\n            >\n              Confirmer la transaction\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  name: 'Trade',\n\n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const operationType = ref('buy')\n    const amount = ref('')\n\n    const getCurrentPrice = () => {\n      const prices = store.getters['crypto/getPrices']\n      return prices[router.currentRoute.value.params.crypto] || 0\n    }\n\n    const formatPrice = (price) => {\n      return Number(price).toLocaleString(undefined, {\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      })\n    }\n\n    const isValid = computed(() => {\n      return amount.value > 0\n    })\n\n    const handleTrade = async () => {\n      try {\n        // TODO: Implémenter la logique de trading réelle\n        alert(`Transaction ${operationType.value} effectuée avec succès !`)\n        router.push('/dashboard')\n      } catch (error) {\n        alert(error.message || 'Erreur lors de la transaction')\n      }\n    }\n\n    return {\n      operationType,\n      amount,\n      getCurrentPrice,\n      formatPrice,\n      isValid,\n      handleTrade\n    }\n  }\n}\n</script>\n"],"mappings":"AAqHA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,OAAO;EAEbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,aAAY,GAAIR,GAAG,CAAC,KAAK;IAC/B,MAAMS,MAAK,GAAIT,GAAG,CAAC,EAAE;IAErB,MAAMU,eAAc,GAAIA,CAAA,KAAM;MAC5B,MAAMC,MAAK,GAAIL,KAAK,CAACM,OAAO,CAAC,kBAAkB;MAC/C,OAAOD,MAAM,CAACJ,MAAM,CAACM,YAAY,CAACC,KAAK,CAACC,MAAM,CAACC,MAAM,KAAK;IAC5