{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Login',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const form = ref({\n      email: '',\n      password: ''\n    });\n    const verificationCode = ref('');\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification']);\n    const handleSubmit = async () => {\n      try {\n        loading.value = true;\n        await store.dispatch('auth/login', {\n          email: form.value.email,\n          password: form.value.password\n        });\n        // Ne pas rediriger, attendre la vérification 2FA\n      } catch (error) {\n        alert(error.message || 'Erreur de connexion');\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handleVerification = async () => {\n      try {\n        loading.value = true;\n        await store.dispatch('auth/verify2FA', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        });\n        router.push('/dashboard');\n      } catch (error) {\n        alert(error.message || 'Erreur lors de la vérification');\n      } finally {\n        loading.value = false;\n      }\n    };\n    return {\n      loading,\n      form,\n      verificationCode,\n      pendingVerification,\n      handleSubmit,\n      handleVerification\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRouter","name","setup","store","router","loading","form","email","password","verificationCode","pendingVerification","getters","handleSubmit","value","dispatch","error","alert","message","handleVerification","code","push"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Login.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-md w-full space-y-8\">\n      <div>\n        <h2 class=\"mt-6 text-center text-3xl font-extrabold text-gray-900\">\n          {{ pendingVerification ? 'Vérification en deux étapes' : 'Connexion à votre compte' }}\n        </h2>\n        <p v-if=\"pendingVerification\" class=\"mt-2 text-center text-sm text-gray-600\">\n          {{ pendingVerification.message }}\n        </p>\n      </div>\n\n      <!-- Formulaire de connexion -->\n      <form v-if=\"!pendingVerification\" class=\"mt-8 space-y-6\" @submit.prevent=\"handleSubmit\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"email\" class=\"sr-only\">Email</label>\n            <input\n              id=\"email\"\n              v-model=\"form.email\"\n              type=\"email\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Email\"\n            />\n          </div>\n          <div>\n            <label for=\"password\" class=\"sr-only\">Mot de passe</label>\n            <input\n              id=\"password\"\n              v-model=\"form.password\"\n              type=\"password\"\n              required\n              class=\"appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Mot de passe\"\n            />\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-indigo-500\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Connexion...' : 'Se connecter' }}\n          </button>\n        </div>\n      </form>\n\n      <!-- Formulaire de vérification 2FA -->\n      <form v-else class=\"mt-8 space-y-6\" @submit.prevent=\"handleVerification\">\n        <div class=\"rounded-md shadow-sm -space-y-px\">\n          <div>\n            <label for=\"verification-code\" class=\"sr-only\">Code de vérification</label>\n            <input\n              id=\"verification-code\"\n              v-model=\"verificationCode\"\n              type=\"text\"\n              required\n              pattern=\"[0-9]*\"\n              inputmode=\"numeric\"\n              class=\"appearance-none rounded relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm\"\n              placeholder=\"Code de vérification\"\n            />\n          </div>\n        </div>\n\n        <div>\n          <button\n            type=\"submit\"\n            :disabled=\"loading || !verificationCode\"\n            class=\"group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n          >\n            <span class=\"absolute left-0 inset-y-0 flex items-center pl-3\">\n              <svg v-if=\"!loading\" class=\"h-5 w-5 text-indigo-500 group-hover:text-indigo-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clip-rule=\"evenodd\" />\n              </svg>\n              <svg v-else class=\"animate-spin h-5 w-5 text-indigo-500\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n              </svg>\n            </span>\n            {{ loading ? 'Vérification...' : 'Vérifier' }}\n          </button>\n        </div>\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  name: 'Login',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const loading = ref(false)\n    const form = ref({\n      email: '',\n      password: ''\n    })\n    const verificationCode = ref('')\n\n    const pendingVerification = computed(() => store.getters['auth/pendingVerification'])\n\n    const handleSubmit = async () => {\n      try {\n        loading.value = true\n        await store.dispatch('auth/login', {\n          email: form.value.email,\n          password: form.value.password\n        })\n        // Ne pas rediriger, attendre la vérification 2FA\n      } catch (error) {\n        alert(error.message || 'Erreur de connexion')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    const handleVerification = async () => {\n      try {\n        loading.value = true\n        await store.dispatch('auth/verify2FA', {\n          email: pendingVerification.value.email,\n          code: verificationCode.value\n        })\n        router.push('/dashboard')\n      } catch (error) {\n        alert(error.message || 'Erreur lors de la vérification')\n      } finally {\n        loading.value = false\n      }\n    }\n\n    return {\n      loading,\n      form,\n      verificationCode,\n      pendingVerification,\n      handleSubmit,\n      handleVerification\n    }\n  }\n}\n</script>\n"],"mappings":"AAqGA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,OAAO;EAEbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,OAAM,GAAIR,GAAG,CAAC,KAAK;IACzB,MAAMS,IAAG,GAAIT,GAAG,CAAC;MACfU,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE;IACZ,CAAC;IACD,MAAMC,gBAAe,GAAIZ,GAAG,CAAC,EAAE;IAE/B,MAAMa,mBAAkB,GAAIZ,QAAQ,CAAC,MAAMK,KAAK,CAACQ,OAAO,CAAC,0BAA0B,CAAC;IAEpF,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACFP,OAAO,CAACQ,KAAI,GAAI,IAAG;QACnB,MAAMV,KAAK,CAACW,QAAQ,CAAC,YAAY,EAAE;UACjCP,KAAK,EAAED,IAAI,CAACO,KAAK,CAACN,KAAK;UACvBC,QAAQ,EAAEF,IAAI,CAACO,KAAK,CAACL;QACvB,CAAC;QACD;MACF,EAAE,OAAOO,KAAK,EAAE;QACdC,KAAK,CAACD,KAAK,CAACE,OAAM,IAAK,qBAAqB;MAC9C,UAAU;QACRZ,OAAO,CAACQ,KAAI,GAAI,KAAI;MACtB;IACF;IAEA,MAAMK,kBAAiB,GAAI,MAAAA,CAAA,KAAY;MACrC,IAAI;QACFb,OAAO,CAACQ,KAAI,GAAI,IAAG;QACnB,MAAMV,KAAK,CAACW,QAAQ