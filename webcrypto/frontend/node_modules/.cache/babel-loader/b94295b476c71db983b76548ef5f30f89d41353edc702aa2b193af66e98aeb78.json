{"ast":null,"code":"import { ref, onMounted, onUnmounted, watch } from 'vue';\nimport { socket } from '@/socket';\nimport { useRouter } from 'vue-router';\nimport AdminHeader from '@/components/AdminHeader.vue';\nexport default {\n  name: 'UserTransactionsSummary',\n  components: {\n    AdminHeader\n  },\n  setup() {\n    const router = useRouter();\n    const userSummaries = ref([]);\n    const loading = ref(false);\n    const error = ref('');\n    const filters = ref({\n      dateMax: new Date().toISOString().slice(0, 16) // Format YYYY-MM-DDTHH:mm\n    });\n    const formatPrice = price => {\n      if (!price) return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const fetchUserSummaries = () => {\n      loading.value = true;\n      error.value = '';\n      socket.emit('getUserTransactionsSummary', {\n        dateMax: filters.value.dateMax\n      });\n    };\n    onMounted(async () => {\n      try {\n        loading.value = true;\n        error.value = '';\n        socket.connect();\n        const token = localStorage.getItem('token');\n        if (!token) {\n          router.push('/login');\n          return;\n        }\n        socket.emit('authenticate', token);\n        socket.on('authenticated', () => {\n          console.log('Socket authentifié, récupération des données...');\n          fetchUserSummaries();\n        });\n        socket.on('userTransactionsSummary', data => {\n          console.log('Données reçues:', data);\n          userSummaries.value = data;\n          loading.value = false;\n        });\n        socket.on('error', err => {\n          console.error('Erreur socket:', err);\n          error.value = err.message || 'Une erreur est survenue';\n          loading.value = false;\n          if (err.message.includes('authentification') || err.message.includes('autorisé')) {\n            router.push('/login');\n          }\n        });\n\n        // Surveiller les changements de filtre\n        watch(() => filters.value.dateMax, () => {\n          fetchUserSummaries();\n        });\n      } catch (err) {\n        console.error('Erreur lors de l\\'initialisation:', err);\n        error.value = err.message || 'Une erreur est survenue lors de l\\'initialisation';\n        loading.value = false;\n        router.push('/login');\n      }\n    });\n    onUnmounted(() => {\n      socket.off('userTransactionsSummary');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.disconnect();\n    });\n    return {\n      userSummaries,\n      filters,\n      loading,\n      error,\n      formatPrice\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","watch","socket","useRouter","AdminHeader","name","components","setup","router","userSummaries","loading","error","filters","dateMax","Date","toISOString","slice","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","fetchUserSummaries","value","emit","connect","token","localStorage","getItem","push","on","console","log","data","err","message","includes","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\UserTransactionsSummary.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-gray-50\">\n    <AdminHeader />\n    \n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n      <h1 class=\"text-3xl font-extrabold text-gray-900 mb-8\">Récapitulatif des Transactions par Utilisateur</h1>\n\n      <!-- Message d'erreur -->\n      <div v-if=\"error\" class=\"mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700\">\n        {{ error }}\n      </div>\n\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-200 hover:shadow-md\">\n        <!-- Filtres -->\n        <div class=\"p-6 border-b border-gray-100 bg-white\">\n          <div class=\"grid grid-cols-1 gap-6\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-2\">Date et heure max</label>\n              <input\n                type=\"datetime-local\"\n                v-model=\"filters.dateMax\"\n                class=\"w-full rounded-lg border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors duration-200\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- État de chargement -->\n        <div v-if=\"loading\" class=\"p-8 text-center\">\n          <div class=\"inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-500\"></div>\n          <p class=\"mt-2 text-gray-600\">Chargement des données...</p>\n        </div>\n\n        <!-- Message si aucune donnée -->\n        <div v-else-if=\"!userSummaries.length\" class=\"p-8 text-center text-gray-500\">\n          Aucune donnée disponible pour la période sélectionnée\n        </div>\n\n        <!-- Tableau récapitulatif -->\n        <div v-else class=\"overflow-x-auto\">\n          <table class=\"min-w-full divide-y divide-gray-200\">\n            <thead>\n              <tr class=\"bg-gray-50\">\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Utilisateur</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Total Achat</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Total Vente</th>\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Valeur portefeuille</th>\n              </tr>\n            </thead>\n            <tbody class=\"bg-white divide-y divide-gray-100\">\n              <tr v-for=\"summary in userSummaries\" \n                  :key=\"summary.username\" \n                  class=\"hover:bg-gray-50 transition-colors duration-150\">\n                <td class=\"px-6 py-4 whitespace-nowrap\">\n                  <div class=\"flex items-center\">\n                    <div class=\"h-8 w-8 rounded-full bg-indigo-100 flex items-center justify-center\">\n                      <span class=\"text-sm font-medium text-indigo-700\">\n                        {{ summary.username[0]?.toUpperCase() }}\n                      </span>\n                    </div>\n                    <span class=\"ml-3 text-sm text-gray-900\">{{ summary.username }}</span>\n                  </div>\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\n                  {{ formatPrice(summary.total_buy) }}\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\n                  {{ formatPrice(summary.total_sell) }}\n                </td>\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900\">\n                  {{ formatPrice(summary.portfolio_value) }}\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted, watch } from 'vue';\nimport { socket } from '@/socket';\nimport { useRouter } from 'vue-router';\nimport AdminHeader from '@/components/AdminHeader.vue';\n\nexport default {\n  name: 'UserTransactionsSummary',\n  components: {\n    AdminHeader\n  },\n  \n  setup() {\n    const router = useRouter();\n    const userSummaries = ref([]);\n    const loading = ref(false);\n    const error = ref('');\n    const filters = ref({\n      dateMax: new Date().toISOString().slice(0, 16) // Format YYYY-MM-DDTHH:mm\n    });\n\n    const formatPrice = (price) => {\n      if (!price) return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const fetchUserSummaries = () => {\n      loading.value = true;\n      error.value = '';\n      socket.emit('getUserTransactionsSummary', {\n        dateMax: filters.value.dateMax\n      });\n    };\n\n    onMounted(async () => {\n      try {\n        loading.value = true;\n        error.value = '';\n        socket.connect();\n\n        const token = localStorage.getItem('token');\n        if (!token) {\n          router.push('/login');\n          return;\n        }\n\n        socket.emit('authenticate', token);\n\n        socket.on('authenticated', () => {\n          console.log('Socket authentifié, récupération des données...');\n          fetchUserSummaries();\n        });\n\n        socket.on('userTransactionsSummary', (data) => {\n          console.log('Données reçues:', data);\n          userSummaries.value = data;\n          loading.value = false;\n        });\n\n        socket.on('error', (err) => {\n          console.error('Erreur socket:', err);\n          error.value = err.message || 'Une erreur est survenue';\n          loading.value = false;\n          if (err.message.includes('authentification') || err.message.includes('autorisé')) {\n            router.push('/login');\n          }\n        });\n\n        // Surveiller les changements de filtre\n        watch(() => filters.value.dateMax, () => {\n          fetchUserSummaries();\n        });\n\n      } catch (err) {\n        console.error('Erreur lors de l\\'initialisation:', err);\n        error.value = err.message || 'Une erreur est survenue lors de l\\'initialisation';\n        loading.value = false;\n        router.push('/login');\n      }\n    });\n\n    onUnmounted(() => {\n      socket.off('userTransactionsSummary');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.disconnect();\n    });\n\n    return {\n      userSummaries,\n      filters,\n      loading,\n      error,\n      formatPrice\n    };\n  }\n};\n</script>\n\n<style scoped>\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: #f1f1f1;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #ddd;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #cdcdcd;\n}\n</style> "],"mappings":"AAkFA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAW,EAAEC,KAAI,QAAS,KAAK;AACxD,SAASC,MAAK,QAAS,UAAU;AACjC,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,WAAU,MAAO,8BAA8B;AAEtD,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVF;EACF,CAAC;EAEDG,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIL,SAAS,CAAC,CAAC;IAC1B,MAAMM,aAAY,GAAIX,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAMY,OAAM,GAAIZ,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMa,KAAI,GAAIb,GAAG,CAAC,EAAE,CAAC;IACrB,MAAMc,OAAM,GAAId,GAAG,CAAC;MAClBe,OAAO,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAE,EAAE,EAAE;IACjD,CAAC,CAAC;IAEF,MAAMC,WAAU,GAAKC,KAAK,IAAK;MAC7B,IAAI,CAACA,KAAK,EAAE,OAAO,OAAO;MAC1B,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE,KAAK;QACfC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACP,KAAK,CAAC;IAClB,CAAC;IAED,MAAMQ,kBAAiB,GAAIA,CAAA,KAAM;MAC/BhB,OAAO,CAACiB,KAAI,GAAI,IAAI;MACpBhB,KAAK,CAACgB,KAAI,GAAI,EAAE;MAChBzB,MAAM,CAAC0B,IAAI,CAAC,4BAA4B,EAAE;QACxCf,OAAO,EAAED,OAAO,CAACe,KAAK,CAACd;MACzB,CAAC,CAAC;IACJ,CAAC;IAEDd,SAAS,CAAC,YAAY;MACpB,IAAI;QACFW,OAAO,CAACiB,KAAI,GAAI,IAAI;QACpBhB,KAAK,CAACgB,KAAI,GAAI,EAAE;QAChBzB,MAAM,CAAC2B,OAAO,CAAC,CAAC;QAEhB,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACVtB,MAAM,CAACyB,IAAI,CAAC,QAAQ,CAAC;UACrB;QACF;QAEA/B,MAAM,CAAC0B,IAAI,CAAC,cAAc,EAAEE,KAAK,CAAC;QAElC5B,MAAM,CAACgC,EAAE,CAAC,eAAe,EAAE,MAAM;UAC/BC,OAAO,CAACC,GAAG,CAAC,iDAAiD,CAAC;UAC9DV,kBAAkB,CAAC,CAAC;QACtB,CAAC,CAAC;QAEFxB,MAAM,CAACgC,EAAE,CAAC,yBA