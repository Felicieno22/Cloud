pe: \"col\",\n    class: \"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\"\n  }, \" Cryptomonnaie \"), _createElementVNode(\"th\", {\n    scope: \"col\",\n    class: \"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\"\n  }, \" Valeur \"), _createElementVNode(\"th\", {\n    scope: \"col\",\n    class: \"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\"\n  }, \" Période analysée \")])], -1 /* HOISTED */)), _createElementVNode(\"tbody\", _hoisted_16, [$setup.results && Object.keys($setup.results).length > 0 ? (_openBlock(true), _createElementBlock(_Fragment, {\n    key: 0\n  }, _renderList($setup.results, (value, crypto) => {\n    return _openBlock(), _createElementBlock(\"tr\", {\n      key: crypto,\n      class: \"hover:bg-gray-50\"\n    }, [_createElementVNode(\"td\", _hoisted_17, [_createElementVNode(\"div\", _hoisted_18, [_createElementVNode(\"div\", _hoisted_19, [_createElementVNode(\"span\", _hoisted_20, _toDisplayString(crypto[0]), 1 /* TEXT */)]), _createElementVNode(\"div\", null, [_createElementVNode(\"div\", _hoisted_21, _toDisplayString(crypto), 1 /* TEXT */), _createElementVNode(\"div\", _hoisted_22, _toDisplayString($setup.getCryptoName(crypto)), 1 /* TEXT */)])])]), _createElementVNode(\"td\", _hoisted_23, [_createElementVNode(\"div\", _hoisted_24, _toDisplayString($setup.formatValue(value)), 1 /* TEXT */)]), _createElementVNode(\"td\", _hoisted_25, [_createElementVNode(\"div\", _hoisted_26, _toDisplayString($setup.formatDateRange($setup.dateMin, $setup.dateMax)), 1 /* TEXT */)])]);\n  }), 128 /* KEYED_FRAGMENT */)) : (_openBlock(), _createElementBlock(\"tr\", _hoisted_27, _cache[13] || (_cache[13] = [_createElementVNode(\"td\", {\n    colspan: \"3\",\n    class: \"px-6 py-4 text-center text-sm text-gray-500\"\n  }, \" Aucun résultat disponible. Veuillez sélectionner les paramètres et cliquer sur Valider. \", -1 /* HOISTED */)])))])])])])])])])]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","_hoisted_3","_createCommentVNode","_hoisted_4","_cache","$event","$setup","analysisType","_createStaticVNode","_hoisted_5","_hoisted_6","type","selectAllCryptos","onChange","args","toggleAllCryptos","_hoisted_7","_Fragment","_renderList","cryptoList","crypto","symbol","selectedCryptos","value","_hoisted_8","_hoisted_9","_toDisplayString","name","_hoisted_10","dateMin","dateMax","_hoisted_11","onClick","performAnalysis","_hoisted_12","_hoisted_13","_hoisted_14","_hoisted_15","scope","_hoisted_16","results","Object","keys","length","_hoisted_17","_hoisted_18","_hoisted_19","_hoisted_20","_hoisted_21","_hoisted_22","getCryptoName","_hoisted_23","_hoisted_24","formatValue","_hoisted_25","_hoisted_26","formatDateRange","_hoisted_27","colspan"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Analysis.vue"],"sourcesContent":["<template>\r\n  <div class=\"min-h-screen bg-gray-50 py-8\">\r\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\r\n      <h1 class=\"text-3xl font-extrabold text-gray-900 mb-8\">Analyse des Transactions</h1>\r\n\r\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-200 hover:shadow-md\">\r\n        <!-- Formulaire d'analyse -->\r\n        <div class=\"p-6 space-y-6\">\r\n          <!-- Type d'analyse -->\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-2\">Type d'analyse</label>\r\n            <select \r\n              v-model=\"analysisType\"\r\n              class=\"w-full rounded-lg border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors duration-200\"\r\n            >\r\n              <option value=\"quartile1\">1er Quartile</option>\r\n              <option value=\"max\">Maximum</option>\r\n              <option value=\"min\">Minimum</option>\r\n              <option value=\"mean\">Moyenne</option>\r\n              <option value=\"stddev\">Écart-type</option>\r\n            </select>\r\n          </div>\r\n\r\n          <!-- Sélection des cryptos -->\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-2\">Cryptomonnaies</label>\r\n            <div class=\"space-y-2\">\r\n              <div class=\"flex items-center\">\r\n                <input\r\n                  type=\"checkbox\"\r\n                  v-model=\"selectAllCryptos\"\r\n                  @change=\"toggleAllCryptos\"\r\n                  class=\"h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded transition-colors duration-200\"\r\n                />\r\n                <label class=\"ml-2 text-sm text-gray-700\">Toutes les cryptos</label>\r\n              </div>\r\n              <div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mt-2\">\r\n                <div v-for=\"crypto in cryptoList\" :key=\"crypto.symbol\" class=\"flex items-center\">\r\n                  <input\r\n                    type=\"checkbox\"\r\n                    v-model=\"selectedCryptos\"\r\n                    :value=\"crypto.symbol\"\r\n                    class=\"h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded transition-colors duration-200\"\r\n                  />\r\n                  <label class=\"ml-2 text-sm text-gray-700\">{{ crypto.name }}</label>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Période -->\r\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\r\n            <div>\r\n              <label class=\"block text-sm font-medium text-gray-700 mb-2\">Date et heure min</label>\r\n              <input\r\n                type=\"datetime-local\"\r\n                v-model=\"dateMin\"\r\n                class=\"w-full rounded-lg border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors duration-200\"\r\n              />\r\n            </div>\r\n            <div>\r\n              <label class=\"block text-sm font-medium text-gray-700 mb-2\">Date et heure max</label>\r\n              <input\r\n                type=\"datetime-local\"\r\n                v-model=\"dateMax\"\r\n                class=\"w-full rounded-lg border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors duration-200\"\r\n              />\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Bouton Valider -->\r\n          <div class=\"flex justify-end\">\r\n            <button\r\n              @click=\"performAnalysis\"\r\n              class=\"inline-flex items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-200\"\r\n            >\r\n              Valider\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Résultats -->\r\n        <div class=\"border-t border-gray-100\">\r\n          <div class=\"p-6\">\r\n            <h2 class=\"text-lg font-semibold text-gray-900 mb-4\">Résultats de l'analyse</h2>\r\n            <div class=\"overflow-x-auto\">\r\n              <table class=\"min-w-full divide-y divide-gray-200\">\r\n                <thead class=\"bg-gray-50\">\r\n                  <tr>\r\n                    <th scope=\"col\" class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\r\n                      Cryptomonnaie\r\n                    </th>\r\n                    <th scope=\"col\" class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\r\n                      Valeur\r\n                    </th>\r\n                    <th scope=\"col\" class=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\r\n                      Période analysée\r\n                    </th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody class=\"bg-white divide-y divide-gray-200\">\r\n                  <template v-if=\"results && Object.keys(results).length > 0\">\r\n                    <tr v-for=\"(value, crypto) in results\" :key=\"crypto\" class=\"hover:bg-gray-50\">\r\n                      <td class=\"px-6 py-4 whitespace-nowrap\">\r\n                        <div class=\"flex items-center space-x-3\">\r\n                          <div class=\"flex-shrink-0 w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center\">\r\n                            <span class=\"text-sm font-bold text-indigo-700\">{{ crypto[0] }}</span>\r\n                          </div>\r\n                          <div>\r\n                            <div class=\"text-sm font-medium text-gray-900\">{{ crypto }}</div>\r\n                            <div class=\"text-xs text-gray-500\">{{ getCryptoName(crypto) }}</div>\r\n                          </div>\r\n                        </div>\r\n                      </td>\r\n                      <td class=\"px-6 py-4 whitespace-nowrap\">\r\n                        <div class=\"text-sm text-indigo-600 font-semibold\">{{ formatValue(value) }}</div>\r\n                      </td>\r\n                      <td class=\"px-6 py-4 whitespace-nowrap\">\r\n                        <div class=\"text-sm text-gray-500\">\r\n                          {{ formatDateRange(dateMin, dateMax) }}\r\n                        </div>\r\n                      </td>\r\n                    </tr>\r\n                  </template>\r\n                  <tr v-else>\r\n                    <td colspan=\"3\" class=\"px-6 py-4 text-center text-sm text-gray-500\">\r\n                      Aucun résultat disponible. Veuillez sélectionner les paramètres et cliquer sur Valider.\r\n                    </td>\r\n                  </tr>\r\n                </tbody>\r\n              </table>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, onUnmounted } from 'vue';\r\nimport { socket } from '@/socket';\r\nimport { useRouter } from 'vue-router';\r\n\r\nexport default {\r\n  name: 'Analysis',\r\n  \r\n  setup() {\r\n    const router = useRouter();\r\n    const analysisType = ref('mean');\r\n    const cryptoList = ref([]);\r\n    const selectedCryptos = ref([]);\r\n    const selectAllCryptos = ref(false);\r\n    const dateMin = ref('');\r\n    const dateMax = ref('');\r\n    const results = ref(null);\r\n\r\n    // Toggle toutes les cryptos\r\n    const toggleAllCryptos = () => {\r\n      if (selectAllCryptos.value) {\r\n        selectedCryptos.value = cryptoList.value.map(c => c.symbol);\r\n      } else {\r\n        selectedCryptos.value = [];\r\n      }\r\n    };\r\n\r\n    // Formater les valeurs selon le type d'analyse\r\n    const formatValue = (value) => {\r\n      if (typeof value !== 'number') return 'N/A';\r\n      \r\n      if (analysisType.value === 'stddev' || analysisType.value === 'mean' || analysisType.value === 'quartile1') {\r\n        return new Intl.NumberFormat('fr-FR', {\r\n          style: 'currency',\r\n          currency: 'USD',\r\n          minimumFractionDigits: 2,\r\n          maximumFractionDigits: 2\r\n        }).format(value);\r\n      }\r\n      \r\n      return new Intl.NumberFormat('fr-FR', {\r\n        style: 'currency',\r\n        currency: 'USD',\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2\r\n      }).format(value);\r\n    };\r\n\r\n    // Formater la plage de dates\r\n    const formatDateRange = (start, end) => {\r\n      if (!start || !end) return 'Période non spécifiée';\r\n      const startDate = new Date(start);\r\n      const endDate = new Date(end);\r\n      return `Du ${startDate.toLocaleString('fr-FR')} au ${endDate.toLocaleString('fr-FR')}`;\r\n    };\r\n\r\n    // Effectuer l'analyse\r\n    const performAnalysis = () => {\r\n      if (selectedCryptos.value.length === 0) {\r\n        alert('Veuillez sélectionner au moins une cryptomonnaie');\r\n        return;\r\n      }\r\n\r\n      if (!dateMin.value || !dateMax.value) {\r\n        alert('Veuillez spécifier une période d\\'analyse');\r\n        return;\r\n      }\r\n\r\n      socket.emit('performAnalysis', {\r\n        type: analysisType.value,\r\n        cryptos: selectedCryptos.value,\r\n        dateMin: dateMin.value,\r\n        dateMax: dateMax.value\r\n      });\r\n    };\r\n\r\n    const getCryptoName = (symbol) => {\r\n      const crypto = cryptoList.value.find(c => c.symbol === symbol);\r\n      return crypto ? crypto.name : symbol;\r\n    };\r\n\r\n    onMounted(async () => {\r\n      try {\r\n        socket.connect();\r\n\r\n        const token = localStorage.getItem('token') || localStorage.getItem('sessionToken') || localStorage.getItem('access_token');\r\n        if (!token) {\r\n          router.push('/login');\r\n          return;\r\n        }\r\n\r\n        socket.emit('authenticate', token);\r\n\r\n        socket.on('authenticated', () => {\r\n          socket.emit('getCryptoList');\r\n        });\r\n\r\n        socket.on('cryptoListUpdate', (data) => {\r\n          cryptoList.value = Array.isArray(data) ? data : [];\r\n        });\r\n\r\n        socket.on('analysisResults', (data) => {\r\n          results.value = data;\r\n        });\r\n\r\n        socket.on('error', (error) => {\r\n          console.error('Erreur socket:', error);\r\n          if (error.message.includes('authentification')) {\r\n            router.push('/login');\r\n          }\r\n        });\r\n\r\n      } catch (error) {\r\n        console.error('Erreur lors de l\\'initialisation:', error);\r\n        router.push('/login');\r\n      }\r\n    });\r\n\r\n    onUnmounted(() => {\r\n      socket.off('cryptoListUpdate');\r\n      socket.off('analysisResults');\r\n      socket.off('authenticated');\r\n      socket.off('error');\r\n      socket.disconnect();\r\n    });\r\n\r\n    return {\r\n      analysisType,\r\n      cryptoList,\r\n      selectedCryptos,\r\n      selectAllCryptos,\r\n      dateMin,\r\n      dateMax,\r\n      results,\r\n      toggleAllCryptos,\r\n      performAnalysis,\r\n      formatValue,\r\n      formatDateRange,\r\n      getCryptoName\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Conteneur principal */\r\n.min-h-screen {\r\n  background: linear-gradient(135deg, #f6f9fc 0%, #edf2f7 100%);\r\n}\r\n\r\n/* Carte principale */\r\n.bg-white {\r\n  backdrop-filter: blur(10px);\r\n  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);\r\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n}\r\n\r\n.bg-white:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n/* Formulaire et inputs */\r\nselect, input[type=\"datetime-local\"] {\r\n  transition: all 0.3s ease;\r\n  border-radius: 8px;\r\n  border: 2px solid #e2e8f0;\r\n  padding: 0.75rem;\r\n  background-color: #ffffff;\r\n}\r\n\r\nselect:hover, input[type=\"datetime-local\"]:hover {\r\n  border-color: #cbd5e0;\r\n}\r\n\r\nselect:focus, input[type=\"datetime-local\"]:focus {\r\n  border-color: #4f46e5;\r\n  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);\r\n}\r\n\r\n/* Checkboxes stylisées */\r\ninput[type=\"checkbox\"] {\r\n  position: relative;\r\n  width: 1.25rem;\r\n  height: 1.25rem;\r\n  margin-right: 0.5rem;\r\n  cursor: pointer;\r\n  border: 2px solid #e2e8f0;\r\n  border-radius: 0.25rem;\r\n  transition: all 0.2s ease;\r\n  appearance: none;\r\n  -webkit-appearance: none;\r\n  background-color: white;\r\n}\r\n\r\ninput[type=\"checkbox\"]:checked {\r\n  background-color: #4f46e5;\r\n  border-color: #4f46e5;\r\n}\r\n\r\ninput[type=\"checkbox\"]:checked::after {\r\n  content: '✓';\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  color: white;\r\n  font-size: 0.875rem;\r\n}\r\n\r\ninput[type=\"checkbox\"]:hover {\r\n  border-color: #4f46e5;\r\n}\r\n\r\ninput[type=\"checkbox\"]:focus {\r\n  outline: none;\r\n  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);\r\n}\r\n\r\n/* Style pour le label des checkboxes */\r\n.flex.items-center label {\r\n  cursor: pointer;\r\n  user-select: none;\r\n  padding: 0.25rem 0;\r\n}\r\n\r\n.flex.items-center:hover label {\r\n  color: #4f46e5;\r\n}\r\n\r\n/* Animation pour les checkboxes */\r\n@keyframes checkmark {\r\n  0% {\r\n    transform: translate(-50%, -50%) scale(0);\r\n    opacity: 0;\r\n  }\r\n  100% {\r\n    transform: translate(-50%, -50%) scale(1);\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\ninput[type=\"checkbox\"]:checked::after {\r\n  animation: checkmark 0.2s ease-out forwards;\r\n}\r\n\r\n/* Bouton Valider */\r\nbutton {\r\n  transition: all 0.3s ease;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\nbutton:after {\r\n  content: '';\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  width: 0;\r\n  height: 0;\r\n  background: rgba(255, 255, 255, 0.2);\r\n  border-radius: 50%;\r\n  transform: translate(-50%, -50%);\r\n  transition: width 0.6s ease, height 0.6s ease;\r\n}\r\n\r\nbutton:active:after {\r\n  width: 200px;\r\n  height: 200px;\r\n  opacity: 0;\r\n}\r\n\r\n/* Tableau des résultats */\r\ntable {\r\n  border-collapse: separate;\r\n  border-spacing: 0;\r\n  width: 100%;\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n}\r\n\r\nthead {\r\n  background: linear-gradient(90deg, #f8fafc 0%, #f1f5f9 100%);\r\n}\r\n\r\nth {\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n  background-color: #f8fafc;\r\n  padding: 1rem;\r\n  border-bottom: 2px solid #e2e8f0;\r\n}\r\n\r\ntd {\r\n  padding: 1rem;\r\n  transition: background-color 0.2s ease;\r\n}\r\n\r\ntbody tr {\r\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n}\r\n\r\ntbody tr:hover {\r\n  background-color: #f8fafc