{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport axios from 'axios';\nimport { socket } from '@/socket';\n\n// Configure Axios\naxios.defaults.baseURL = 'http://localhost:3000';\n\n// Add token to all requests\naxios.interceptors.request.use(config => {\n  const token = localStorage.getItem('token');\n  if (token) {\n    config.headers.Authorization = `Bearer ${token}`;\n  }\n  return config;\n});\n\n// Handle 401 responses\naxios.interceptors.response.use(response => response, error => {\n  if (error.response?.status === 401) {\n    // Redirect to login if unauthorized\n    window.location.href = '/login';\n  }\n  return Promise.reject(error);\n});\nexport default {\n  name: 'Wallet',\n  setup() {\n    const wallet = ref(null);\n    const positions = ref([]);\n    const transactions = ref([]);\n    const depositAmount = ref('');\n    const withdrawalAmount = ref('');\n    const fetchWallet = async () => {\n      try {\n        const response = await axios.get('/api/wallet');\n        wallet.value = response.data;\n      } catch (error) {\n        console.error('Error fetching wallet:', error);\n      }\n    };\n    const fetchPositions = async () => {\n      try {\n        const response = await axios.get('/api/wallet/positions');\n        positions.value = response.data;\n      } catch (error) {\n        console.error('Error fetching positions:', error);\n      }\n    };\n    const fetchTransactions = async () => {\n      try {\n        const response = await axios.get('/api/wallet/transactions');\n        transactions.value = response.data;\n      } catch (error) {\n        console.error('Error fetching transactions:', error);\n      }\n    };\n    const requestDeposit = async () => {\n      try {\n        await axios.post('/api/wallet/request', {\n          type: 'deposit',\n          amount: parseFloat(depositAmount.value)\n        });\n        alert('Deposit request sent to admin for approval');\n        depositAmount.value = '';\n        await fetchWallet();\n        await fetchTransactions();\n      } catch (error) {\n        console.error('Error requesting deposit:', error);\n        alert(error.response?.data?.error || 'Failed to send deposit request');\n      }\n    };\n    const requestWithdrawal = async () => {\n      try {\n        await axios.post('/api/wallet/request', {\n          type: 'withdrawal',\n          amount: parseFloat(withdrawalAmount.value)\n        });\n        alert('Withdrawal request sent to admin for approval');\n        withdrawalAmount.value = '';\n        await fetchWallet();\n        await fetchTransactions();\n      } catch (error) {\n        console.error('Error requesting withdrawal:', error);\n        alert(error.response?.data?.error || 'Failed to send withdrawal request');\n      }\n    };\n\n    // Socket.io event handlers\n    socket.on('walletUpdate', data => {\n      wallet.value = data;\n    });\n    socket.on('positionsUpdate', data => {\n      positions.value = data;\n    });\n    socket.on('transactionsUpdate', data => {\n      transactions.value = data;\n    });\n    onMounted(() => {\n      socket.connect();\n      socket.emit('getWalletData');\n      fetchWallet();\n      fetchPositions();\n      fetchTransactions();\n    });\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n    return {\n      wallet,\n      positions,\n      transactions,\n      depositAmount,\n      withdrawalAmount,\n      requestDeposit,\n      requestWithdrawal\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","axios","socket","defaults","baseURL","interceptors","request","use","config","token","localStorage","getItem","headers","Authorization","response","error","status","window","location","href","Promise","reject","name","setup","wallet","positions","transactions","depositAmount","withdrawalAmount","fetchWallet","get","value","data","console","fetchPositions","fetchTransactions","requestDeposit","post","type","amount","parseFloat","alert","requestWithdrawal","on","connect","emit","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Wallet.vue"],"sourcesContent":["<template>\r\n\t<div class=\"wallet\">\r\n\t\t<h1>Wallet</h1>\r\n\t\t<div v-if=\"wallet\" class=\"wallet-info\">\r\n\t\t\t<div class=\"balance\">\r\n\t\t\t\tBalance: {{ wallet.balance }}\r\n\t\t\t</div>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"transaction-forms\">\r\n\t\t\t<div class=\"deposit-form\">\r\n\t\t\t\t<h3>Request Deposit</h3>\r\n\t\t\t\t<form @submit.prevent=\"requestDeposit\">\r\n\t\t\t\t\t<input \r\n\t\t\t\t\t\ttype=\"number\" \r\n\t\t\t\t\t\tv-model=\"depositAmount\" \r\n\t\t\t\t\t\tplaceholder=\"Amount to deposit\"\r\n\t\t\t\t\t\tmin=\"0\"\r\n\t\t\t\t\t\tstep=\"0.01\"\r\n\t\t\t\t\t\trequired\r\n\t\t\t\t\t/>\r\n\t\t\t\t\t<button type=\"submit\">Request Deposit</button>\r\n\t\t\t\t</form>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"withdrawal-form\">\r\n\t\t\t\t<h3>Request Withdrawal</h3>\r\n\t\t\t\t<form @submit.prevent=\"requestWithdrawal\">\r\n\t\t\t\t\t<input \r\n\t\t\t\t\t\ttype=\"number\" \r\n\t\t\t\t\t\tv-model=\"withdrawalAmount\" \r\n\t\t\t\t\t\tplaceholder=\"Amount to withdraw\"\r\n\t\t\t\t\t\tmin=\"0\"\r\n\t\t\t\t\t\tstep=\"0.01\"\r\n\t\t\t\t\t\trequired\r\n\t\t\t\t\t/>\r\n\t\t\t\t\t<button type=\"submit\">Request Withdrawal</button>\r\n\t\t\t\t</form>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\r\n\t\t<div v-if=\"positions.length\" class=\"positions\">\r\n\t\t\t<h2>Positions</h2>\r\n\t\t\t<ul>\r\n\t\t\t\t<li v-for=\"position in positions\" :key=\"position.id\">\r\n\t\t\t\t\t{{ position.asset }}: {{ position.amount }}\r\n\t\t\t\t</li>\r\n\t\t\t</ul>\r\n\t\t</div>\r\n\t\t<div v-if=\"transactions.length\" class=\"transactions\">\r\n\t\t\t<h2>Recent Transactions</h2>\r\n\t\t\t<ul>\r\n\t\t\t\t<li v-for=\"tx in transactions\" :key=\"tx.id\">\r\n\t\t\t\t\t{{ tx.type }}: {{ tx.amount }}\r\n\t\t\t\t</li>\r\n\t\t\t</ul>\r\n\t\t</div>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted } from 'vue';\r\nimport axios from 'axios';\r\nimport { socket } from '@/socket';\r\n\r\n// Configure Axios\r\naxios.defaults.baseURL = 'http://localhost:3000';\r\n\r\n// Add token to all requests\r\naxios.interceptors.request.use(config => {\r\n\tconst token = localStorage.getItem('token');\r\n\tif (token) {\r\n\t\tconfig.headers.Authorization = `Bearer ${token}`;\r\n\t}\r\n\treturn config;\r\n});\r\n\r\n// Handle 401 responses\r\naxios.interceptors.response.use(\r\n\tresponse => response,\r\n\terror => {\r\n\t\tif (error.response?.status === 401) {\r\n\t\t\t// Redirect to login if unauthorized\r\n\t\t\twindow.location.href = '/login';\r\n\t\t}\r\n\t\treturn Promise.reject(error);\r\n\t}\r\n);\r\n\r\nexport default {\r\n\tname: 'Wallet',\r\n\tsetup() {\r\n\t\tconst wallet = ref(null);\r\n\t\tconst positions = ref([]);\r\n\t\tconst transactions = ref([]);\r\n\t\tconst depositAmount = ref('');\r\n\t\tconst withdrawalAmount = ref('');\r\n\r\n\t\tconst fetchWallet = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tconst response = await axios.get('/api/wallet');\r\n\t\t\t\twallet.value = response.data;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error fetching wallet:', error);\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst fetchPositions = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tconst response = await axios.get('/api/wallet/positions');\r\n\t\t\t\tpositions.value = response.data;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error fetching positions:', error);\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst fetchTransactions = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tconst response = await axios.get('/api/wallet/transactions');\r\n\t\t\t\ttransactions.value = response.data;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error fetching transactions:', error);\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst requestDeposit = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tawait axios.post('/api/wallet/request', {\r\n\t\t\t\t\ttype: 'deposit',\r\n\t\t\t\t\tamount: parseFloat(depositAmount.value)\r\n\t\t\t\t});\r\n\t\t\t\talert('Deposit request sent to admin for approval');\r\n\t\t\t\tdepositAmount.value = '';\r\n\t\t\t\tawait fetchWallet();\r\n\t\t\t\tawait fetchTransactions();\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error requesting deposit:', error);\r\n\t\t\t\talert(error.response?.data?.error || 'Failed to send deposit request');\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst requestWithdrawal = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tawait axios.post('/api/wallet/request', {\r\n\t\t\t\t\ttype: 'withdrawal',\r\n\t\t\t\t\tamount: parseFloat(withdrawalAmount.value)\r\n\t\t\t\t});\r\n\t\t\t\talert('Withdrawal request sent to admin for approval');\r\n\t\t\t\twithdrawalAmount.value = '';\r\n\t\t\t\tawait fetchWallet();\r\n\t\t\t\tawait fetchTransactions();\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error requesting withdrawal:', error);\r\n\t\t\t\talert(error.response?.data?.error || 'Failed to send withdrawal request');\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\t// Socket.io event handlers\r\n\t\tsocket.on('walletUpdate', (data) => {\r\n\t\t\twallet.value = data;\r\n\t\t});\r\n\r\n\t\tsocket.on('positionsUpdate', (data) => {\r\n\t\t\tpositions.value = data;\r\n\t\t});\r\n\r\n\t\tsocket.on('transactionsUpdate', (data) => {\r\n\t\t\ttransactions.value = data;\r\n\t\t});\r\n\r\n\t\tonMounted(() => {\r\n\t\t\tsocket.connect();\r\n\t\t\tsocket.emit('getWalletData');\r\n\t\t\tfetchWallet();\r\n\t\t\tfetchPositions();\r\n\t\t\tfetchTransactions();\r\n\t\t});\r\n\r\n\t\tonUnmounted(() => {\r\n\t\t\tsocket.disconnect();\r\n\t\t});\r\n\r\n\t\treturn {\r\n\t\t\twallet,\r\n\t\t\tpositions,\r\n\t\t\ttransactions,\r\n\t\t\tdepositAmount,\r\n\t\t\twithdrawalAmount,\r\n\t\t\trequestDeposit,\r\n\t\t\trequestWithdrawal\r\n\t\t};\r\n\t}\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.wallet {\r\n\tpadding: 20px;\r\n}\r\n\r\n.wallet-info {\r\n\tmargin-bottom: 20px;\r\n}\r\n\r\n.balance {\r\n\tfont-size: 24px;\r\n\tfont-weight: bold;\r\n}\r\n\r\n.transaction-forms {\r\n\tdisplay: flex;\r\n\tgap: 20px;\r\n\tmargin-bottom: 20px;\r\n}\r\n\r\n.deposit-form,\r\n.withdrawal-form {\r\n\tflex: 1;\r\n\tpadding: 20px;\r\n\tborder: 1px solid #ddd;\r\n\tborder-radius: 8px;\r\n}\r\n\r\nform {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\tgap: 10px;\r\n}\r\n\r\ninput {\r\n\tpadding: 8px;\r\n\tborder: 1px solid #ddd;\r\n\tborder-radius: 4px;\r\n}\r\n\r\nbutton {\r\n\tpadding: 8px 16px;\r\n\tbackground-color: #4CAF50;\r\n\tcolor: white;\r\n\tborder: none;\r\n\tborder-radius: 4px;\r\n\tcursor: pointer;\r\n}\r\n\r\nbutton:hover {\r\n\tbackground-color: #45a049;\r\n}\r\n\r\n.positions,\r\n.transactions {\r\n\tmargin-top: 20px;\r\n}\r\n\r\nul {\r\n\tlist-style: none;\r\n\tpadding: 0;\r\n}\r\n\r\nli {\r\n\tpadding: 8px;\r\n\tborder-bottom: 1px solid #ddd;\r\n}\r\n\r\nli:last-child {\r\n\tborder-bottom: none;\r\n}\r\n</style>"],"mappings":"AA6DA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AACjD,OAAOC,KAAI,MAAO,OAAO;AACzB,SAASC,MAAK,QAAS,UAAU;;AAEjC;AACAD,KAAK,CAACE,QAAQ,CAACC,OAAM,GAAI,uBAAuB;;AAEhD;AACAH,KAAK,CAACI,YAAY,CAACC,OAAO,CAACC,GAAG,CAACC,MAAK,IAAK;EACxC,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;EAC3C,IAAIF,KAAK,EAAE;IACVD,MAAM,CAACI,OAAO,CAACC,aAAY,GAAI,UAAUJ,KAAK,EAAE;EACjD;EACA,OAAOD,MAAM;AACd,CAAC,CAAC;;AAEF;AACAP,KAAK,CAACI,YAAY,CAACS,QAAQ,CAACP,GAAG,CAC9BO,QAAO,IAAKA,QAAQ,EACpBC,KAAI,IAAK;EACR,IAAIA,KAAK,CAACD,QAAQ,EAAEE,MAAK,KAAM,GAAG,EAAE;IACnC;IACAC,MAAM,CAACC,QAAQ,CAACC,IAAG,GAAI,QAAQ;EAChC;EACA,OAAOC,OAAO,CAACC,MAAM,CAACN,KAAK,CAAC;AAC7B,CACD,CAAC;AAED,eAAe;EACdO,IAAI,EAAE,QAAQ;EACdC,KAAKA,CAAA,EAAG;IACP,MAAMC,MAAK,GAAI1B,GAAG,CAAC,IAAI,CAAC;IACxB,MAAM2B,SAAQ,GAAI3B,GAAG,CAAC,EAAE,CAAC;IACzB,MAAM4B,YAAW,GAAI5B,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAM6B,aAAY,GAAI7B,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAM8B,gBAAe,GAAI9B,GAAG,CAAC,EAAE,CAAC;IAEhC,MAAM+B,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACH,MAAMf,QAAO,GAAI,MAAMb,KAAK,CAAC6B,GAAG,CAAC,aAAa,CAAC;QAC/CN,MAAM,CAACO,KAAI,GAAIjB,QAAQ,CAACkB,IAAI;MAC7B,EAAE,OA