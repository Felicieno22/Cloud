{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { socket } from '@/socket';\nexport default {\n  name: 'Portfolio',\n  setup() {\n    const balance = ref(0);\n    const portfolio = ref([]);\n    const transactions = ref([]);\n    const showDepositModal = ref(false);\n    const depositAmount = ref('');\n    const selectedPosition = ref(null);\n    const sellQuantity = ref('');\n\n    // Charger les données initiales\n    const loadData = async () => {\n      try {\n        const [balanceRes, portfolioRes, transactionsRes] = await Promise.all([fetch('/api/wallet/balance'), fetch('/api/portfolio'), fetch('/api/transactions')]);\n        const balanceData = await balanceRes.json();\n        balance.value = balanceData.balance;\n        const portfolioData = await portfolioRes.json();\n        portfolio.value = portfolioData;\n        const transactionsData = await transactionsRes.json();\n        transactions.value = transactionsData;\n      } catch (error) {\n        console.error('Erreur lors du chargement des données:', error);\n      }\n    };\n\n    // Formatage des données\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const formatQuantity = quantity => {\n      if (typeof quantity !== 'number') return '0';\n      return quantity.toFixed(6);\n    };\n    const formatDate = date => {\n      return new Date(date).toLocaleString('fr-FR', {\n        dateStyle: 'short',\n        timeStyle: 'short'\n      });\n    };\n    const formatProfitLoss = value => {\n      if (typeof value !== 'number') return '$0.00';\n      return `${value >= 0 ? '+' : ''}${formatPrice(value)}`;\n    };\n    const getProfitLossClass = value => {\n      return {\n        'text-green-500': value > 0,\n        'text-red-500': value < 0,\n        'text-gray-500': value === 0\n      };\n    };\n    const formatTransactionType = type => {\n      const types = {\n        buy: 'Achat',\n        sell: 'Vente',\n        deposit: 'Dépôt',\n        withdrawal: 'Retrait'\n      };\n      return types[type] || type;\n    };\n    const getTransactionTypeClass = type => {\n      const classes = {\n        buy: 'text-green-600',\n        sell: 'text-red-600',\n        deposit: 'text-blue-600',\n        withdrawal: 'text-orange-600'\n      };\n      return classes[type] || 'text-gray-600';\n    };\n    const formatStatus = status => {\n      const statuses = {\n        pending: 'En attente',\n        completed: 'Complété',\n        rejected: 'Rejeté'\n      };\n      return statuses[status] || status;\n    };\n    const getStatusClass = status => {\n      const classes = {\n        pending: 'bg-yellow-100 text-yellow-800',\n        completed: 'bg-green-100 text-green-800',\n        rejected: 'bg-red-100 text-red-800'\n      };\n      return `px-2 py-1 rounded-full text-xs font-medium ${classes[status] || 'bg-gray-100 text-gray-800'}`;\n    };\n\n    // Gestion des actions\n    const handleDeposit = async () => {\n      try {\n        const response = await fetch('/api/wallet/deposit', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            amount: parseFloat(depositAmount.value)\n          })\n        });\n        if (!response.ok) throw new Error('Erreur lors du dépôt');\n        showDepositModal.value = false;\n        depositAmount.value = '';\n        await loadData();\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n    const showSellModal = position => {\n      selectedPosition.value = position;\n      sellQuantity.value = '';\n    };\n    const handleSell = async () => {\n      try {\n        const response = await fetch('/api/trade/sell', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            cryptoId: selectedPosition.value.crypto_id,\n            quantity: parseFloat(sellQuantity.value)\n          })\n        });\n        if (!response.ok) throw new Error('Erreur lors de la vente');\n        selectedPosition.value = null;\n        sellQuantity.value = '';\n        await loadData();\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n\n    // Mise à jour en temps réel des prix\n    socket.on('priceUpdate', data => {\n      portfolio.value = portfolio.value.map(position => {\n        const crypto = data.find(c => c.symbol === position.symbol);\n        if (crypto) {\n          return {\n            ...position,\n            price: crypto.price,\n            current_value: crypto.price * position.quantity,\n            profit_loss: crypto.price * position.quantity - position.total_invested\n          };\n        }\n        return position;\n      });\n    });\n    onMounted(() => {\n      loadData();\n      socket.connect();\n    });\n    return {\n      balance,\n      portfolio,\n      transactions,\n      showDepositModal,\n      depositAmount,\n      selectedPosition,\n      sellQuantity,\n      formatPrice,\n      formatQuantity,\n      formatDate,\n      formatProfitLoss,\n      getProfitLossClass,\n      formatTransactionType,\n      getTransactionTypeClass,\n      formatStatus,\n      getStatusClass,\n      handleDeposit,\n      showSellModal,\n      handleSell\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","socket","name","setup","balance","portfolio","transactions","showDepositModal","depositAmount","selectedPosition","sellQuantity","loadData","balanceRes","portfolioRes","transactionsRes","Promise","all","fetch","balanceData","json","value","portfolioData","transactionsData","error","console","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatQuantity","quantity","toFixed","formatDate","date","Date","toLocaleString","dateStyle","timeStyle","formatProfitLoss","getProfitLossClass","formatTransactionType","type","types","buy","sell","deposit","withdrawal","getTransactionTypeClass","classes","formatStatus","status","statuses","pending","completed","rejected","getStatusClass","handleDeposit","response","method","headers","body","JSON","stringify","amount","parseFloat","ok","Error","showSellModal","position","handleSell","cryptoId","crypto_id","on","data","map","crypto","find","c","symbol","current_value","profit_loss","total_invested","connect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\Portfolio.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <!-- En-tête avec solde -->\n    <div class=\"bg-white rounded-lg shadow-lg p-6 mb-8\">\n      <h2 class=\"text-xl font-semibold text-gray-700 mb-4\">Mon portefeuille</h2>\n      <div class=\"flex justify-between items-center\">\n        <div>\n          <p class=\"text-gray-600\">Solde disponible</p>\n          <p class=\"text-3xl font-bold\">{{ formatPrice(balance) }}</p>\n        </div>\n        <button @click=\"showDepositModal = true\"\n                class=\"px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors\">\n          Déposer des fonds\n        </button>\n      </div>\n    </div>\n\n    <!-- Positions -->\n    <div class=\"bg-white rounded-lg shadow-lg p-6 mb-8\">\n      <h2 class=\"text-xl font-semibold text-gray-700 mb-4\">Mes positions</h2>\n      <div class=\"overflow-x-auto\">\n        <table class=\"min-w-full\">\n          <thead>\n            <tr class=\"border-b\">\n              <th class=\"text-left py-3 px-4\">Crypto</th>\n              <th class=\"text-right py-3 px-4\">Quantité</th>\n              <th class=\"text-right py-3 px-4\">Prix moyen</th>\n              <th class=\"text-right py-3 px-4\">Valeur actuelle</th>\n              <th class=\"text-right py-3 px-4\">Profit/Perte</th>\n              <th class=\"text-right py-3 px-4\">Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr v-for=\"position in portfolio\" :key=\"position.symbol\" class=\"border-b\">\n              <td class=\"py-3 px-4\">\n                <div class=\"font-medium\">{{ position.symbol }}</div>\n                <div class=\"text-sm text-gray-500\">{{ position.name }}</div>\n              </td>\n              <td class=\"text-right py-3 px-4\">\n                {{ formatQuantity(position.quantity) }}\n              </td>\n              <td class=\"text-right py-3 px-4\">\n                {{ formatPrice(position.average_buy_price) }}\n              </td>\n              <td class=\"text-right py-3 px-4\">\n                {{ formatPrice(position.current_value) }}\n              </td>\n              <td :class=\"getProfitLossClass(position.profit_loss)\" class=\"text-right py-3 px-4\">\n                {{ formatProfitLoss(position.profit_loss) }}\n              </td>\n              <td class=\"text-right py-3 px-4\">\n                <button @click=\"showSellModal(position)\"\n                        class=\"px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors\">\n                  Vendre\n                </button>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- Historique des transactions -->\n    <div class=\"bg-white rounded-lg shadow-lg p-6\">\n      <h2 class=\"text-xl font-semibold text-gray-700 mb-4\">Historique des transactions</h2>\n      <div class=\"overflow-x-auto\">\n        <table class=\"min-w-full\">\n          <thead>\n            <tr class=\"border-b\">\n              <th class=\"text-left py-3 px-4\">Date</th>\n              <th class=\"text-left py-3 px-4\">Type</th>\n              <th class=\"text-left py-3 px-4\">Crypto</th>\n              <th class=\"text-right py-3 px-4\">Montant</th>\n              <th class=\"text-right py-3 px-4\">Quantité</th>\n              <th class=\"text-right py-3 px-4\">Prix</th>\n              <th class=\"text-center py-3 px-4\">Statut</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr v-for=\"tx in transactions\" :key=\"tx.id\" class=\"border-b\">\n              <td class=\"py-3 px-4\">\n                {{ formatDate(tx.created_at) }}\n              </td>\n              <td class=\"py-3 px-4\">\n                <span :class=\"getTransactionTypeClass(tx.type)\">\n                  {{ formatTransactionType(tx.type) }}\n                </span>\n              </td>\n              <td class=\"py-3 px-4\">\n                {{ tx.symbol || '-' }}\n              </td>\n              <td class=\"text-right py-3 px-4\">\n                {{ formatPrice(tx.amount) }}\n              </td>\n              <td class=\"text-right py-3 px-4\">\n                {{ tx.quantity ? formatQuantity(tx.quantity) : '-' }}\n              </td>\n              <td class=\"text-right py-3 px-4\">\n                {{ tx.price ? formatPrice(tx.price) : '-' }}\n              </td>\n              <td class=\"text-center py-3 px-4\">\n                <span :class=\"getStatusClass(tx.status)\">\n                  {{ formatStatus(tx.status) }}\n                </span>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- Modal de dépôt -->\n    <div v-if=\"showDepositModal\" class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center\">\n      <div class=\"bg-white rounded-lg p-6 w-full max-w-md\">\n        <h3 class=\"text-xl font-semibold mb-4\">Déposer des fonds</h3>\n        <form @submit.prevent=\"handleDeposit\">\n          <div class=\"mb-4\">\n            <label class=\"block text-sm font-medium text-gray-700 mb-2\">\n              Montant (USD)\n            </label>\n            <input\n              type=\"number\"\n              v-model=\"depositAmount\"\n              step=\"0.01\"\n              min=\"0\"\n              class=\"w-full px-3 py-2 border rounded-lg\"\n              required\n            />\n          </div>\n          <div class=\"flex justify-end space-x-3\">\n            <button\n              type=\"button\"\n              @click=\"showDepositModal = false\"\n              class=\"px-4 py-2 text-gray-600 hover:text-gray-800\"\n            >\n              Annuler\n            </button>\n            <button\n              type=\"submit\"\n              class=\"px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700\"\n            >\n              Déposer\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n\n    <!-- Modal de vente -->\n    <div v-if=\"selectedPosition\" class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center\">\n      <div class=\"bg-white rounded-lg p-6 w-full max-w-md\">\n        <h3 class=\"text-xl font-semibold mb-4\">\n          Vendre {{ selectedPosition.symbol }}\n        </h3>\n        <form @submit.prevent=\"handleSell\">\n          <div class=\"mb-4\">\n            <label class=\"block text-sm font-medium text-gray-700 mb-2\">\n              Quantité (max: {{ formatQuantity(selectedPosition.quantity) }})\n            </label>\n            <input\n              type=\"number\"\n              v-model=\"sellQuantity\"\n              :max=\"selectedPosition.quantity\"\n              step=\"0.000001\"\n              min=\"0\"\n              class=\"w-full px-3 py-2 border rounded-lg\"\n              required\n            />\n            <p class=\"mt-2 text-sm text-gray-500\">\n              ≈ {{ formatPrice(sellQuantity * selectedPosition.price) }}\n            </p>\n          </div>\n          <div class=\"flex justify-end space-x-3\">\n            <button\n              type=\"button\"\n              @click=\"selectedPosition = null\"\n              class=\"px-4 py-2 text-gray-600 hover:text-gray-800\"\n            >\n              Annuler\n            </button>\n            <button\n              type=\"submit\"\n              class=\"px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700\"\n            >\n              Vendre\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted } from 'vue';\nimport { socket } from '@/socket';\n\nexport default {\n  name: 'Portfolio',\n\n  setup() {\n    const balance = ref(0);\n    const portfolio = ref([]);\n    const transactions = ref([]);\n    const showDepositModal = ref(false);\n    const depositAmount = ref('');\n    const selectedPosition = ref(null);\n    const sellQuantity = ref('');\n\n    // Charger les données initiales\n    const loadData = async () => {\n      try {\n        const [balanceRes, portfolioRes, transactionsRes] = await Promise.all([\n          fetch('/api/wallet/balance'),\n          fetch('/api/portfolio'),\n          fetch('/api/transactions')\n        ]);\n\n        const balanceData = await balanceRes.json();\n        balance.value = balanceData.balance;\n\n        const portfolioData = await portfolioRes.json();\n        portfolio.value = portfolioData;\n\n        const transactionsData = await transactionsRes.json();\n        transactions.value = transactionsData;\n      } catch (error) {\n        console.error('Erreur lors du chargement des données:', error);\n      }\n    };\n\n    // Formatage des données\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const formatQuantity = (quantity) => {\n      if (typeof quantity !== 'number') return '0';\n      return quantity.toFixed(6);\n    };\n\n    const formatDate = (date) => {\n      return new Date(date).toLocaleString('fr-FR', {\n        dateStyle: 'short',\n        timeStyle: 'short'\n      });\n    };\n\n    const formatProfitLoss = (value) => {\n      if (typeof value !== 'number') return '$0.00';\n      return `${value >= 0 ? '+' : ''}${formatPrice(value)}`;\n    };\n\n    const getProfitLossClass = (value) => {\n      return {\n        'text-green-500': value > 0,\n        'text-red-500': value < 0,\n        'text-gray-500': value === 0\n      };\n    };\n\n    const formatTransactionType = (type) => {\n      const types = {\n        buy: 'Achat',\n        sell: 'Vente',\n        deposit: 'Dépôt',\n        withdrawal: 'Retrait'\n      };\n      return types[type] || type;\n    };\n\n    const getTransactionTypeClass = (type) => {\n      const classes = {\n        buy: 'text-green-600',\n        sell: 'text-red-600',\n        deposit: 'text-blue-600',\n        withdrawal: 'text-orange-600'\n      };\n      return classes[type] || 'text-gray-600';\n    };\n\n    const formatStatus = (status) => {\n      const statuses = {\n        pending: 'En attente',\n        completed: 'Complété',\n        rejected: 'Rejeté'\n      };\n      return statuses[status] || status;\n    };\n\n    const getStatusClass = (status) => {\n      const classes = {\n        pending: 'bg-yellow-100 text-yellow-800',\n        completed: 'bg-green-100 text-green-800',\n        rejected: 'bg-red-100 text-red-800'\n      };\n      return `px-2 py-1 rounded-full text-xs font-medium ${classes[status] || 'bg-gray-100 text-gray-800'}`;\n    };\n\n    // Gestion des actions\n    const handleDeposit = async () => {\n      try {\n        const response = await fetch('/api/wallet/deposit', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            amount: parseFloat(depositAmount.value)\n          })\n        });\n\n        if (!response.ok) throw new Error('Erreur lors du dépôt');\n\n        showDepositModal.value = false;\n        depositAmount.value = '';\n        await loadData();\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n\n    const showSellModal = (position) => {\n      selectedPosition.value = position;\n      sellQuantity.value = '';\n    };\n\n    const handleSell = async () => {\n      try {\n        const response = await fetch('/api/trade/sell', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            cryptoId: selectedPosition.value.crypto_id,\n            quantity: parseFloat(sellQuantity.value)\n          })\n        });\n\n        if (!response.ok) throw new Error('Erreur lors de la vente');\n\n        selectedPosition.value = null;\n        sellQuantity.value = '';\n        await loadData();\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    };\n\n    // Mise à jour en temps réel des prix\n    socket.on('priceUpdate', (data) => {\n      portfolio.value = portfolio.value.map(position => {\n        const crypto = data.find(c => c.symbol === position.symbol);\n        if (crypto) {\n          return {\n            ...position,\n            price: crypto.price,\n            current_value: crypto.price * position.quantity,\n            profit_loss: (crypto.price * position.quantity) - position.total_invested\n          };\n        }\n        return position;\n      });\n    });\n\n    onMounted(() => {\n      loadData();\n      socket.connect();\n    });\n\n    return {\n      balance,\n      portfolio,\n      transactions,\n      showDepositModal,\n      depositAmount,\n      selectedPosition,\n      sellQuantity,\n      formatPrice,\n      formatQuantity,\n      formatDate,\n      formatProfitLoss,\n      getProfitLossClass,\n      formatTransactionType,\n      getTransactionTypeClass,\n      formatStatus,\n      getStatusClass,\n      handleDeposit,\n      showSellModal,\n      handleSell\n    };\n  }\n};\n</script>\n"],"mappings":"AAkMA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,MAAK,QAAS,UAAU;AAEjC,eAAe;EACbC,IAAI,EAAE,WAAW;EAEjBC,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIL,GAAG,CAAC,CAAC,CAAC;IACtB,MAAMM,SAAQ,GAAIN,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMO,YAAW,GAAIP,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMQ,gBAAe,GAAIR,GAAG,CAAC,KAAK,CAAC;IACnC,MAAMS,aAAY,GAAIT,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAMU,gBAAe,GAAIV,GAAG,CAAC,IAAI,CAAC;IAClC,MAAMW,YAAW,GAAIX,GAAG,CAAC,EAAE,CAAC;;IAE5B;IACA,MAAMY,QAAO,GAAI,MAAAA,CAAA,KAAY;MAC3B,IAAI;QACF,MAAM,CAACC,UAAU,EAAEC,YAAY,EAAEC,eAAe,IAAI,MAAMC,OAAO,CAACC,GAAG,CAAC,CACpEC,KAAK,CAAC,qBAAqB,CAAC,EAC5BA,KAAK,CAAC,gBAAgB,CAAC,EACvBA,KAAK,CAAC,mBAAmB,EAC1B,CAAC;QAEF,MAAMC,WAAU,GAAI,MAAMN,UAAU,CAACO,IAAI,CAAC,CAAC;QAC3Cf,OAAO,CAACgB,KAAI,GAAIF,WAAW,CAACd,OAAO;QAEnC,MAAMiB,aAAY,GAAI,MAAMR,YAAY,CAACM,IAAI,CAAC,CAAC;QAC/Cd,SAAS,CAACe,KAAI,GAAIC,aAAa;QAE/B,MAAMC,gBAAe,GAAI,MAAMR,eAAe,CAACK,IAAI,CAAC,CAAC;QACrDb,YAAY,CAACc,KAAI,GAAIE,gBAAgB;MACvC,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,wCAAwC,EAAEA,KAAK,CAAC;MAChE;IACF,CAAC;;IAED;IACA,MAAME,WAAU,GAAKC,KAAK,IAAK;MAC7B,IAAI,OAAOA,KAAI,KAAM,QAAQ,EAAE,OAAO,OAAO;MAC7C,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE,KAAK;QACfC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACP,KAAK,CAAC;IAClB,CAAC;IAED,MAAMQ,cAAa,GAAKC,QAAQ,IAAK;MACnC,IAAI,OAAOA,QAAO,KAAM,QAAQ,EAAE,OAAO,GAAG;MAC5C,OAAOA,QAAQ,CAACC,OAAO,CAAC,CAAC,CAAC;IAC5B,CAAC;IAED,MAAMC,UAAS,GAAKC,IAAI,IAAK;MAC3B,OAAO,IAAIC,IAAI,CAACD,IAAI,CAAC,CAACE,cAAc,CAAC,OAAO,EAAE;QAC5CC,SAAS,EAAE,OAAO;QAClBC,SAAS,EAAE;MACb,CAAC,CAAC;IACJ,CAAC;IAED,MAAMC,gBAAe,GAAKvB,KAAK,IAAK;MAClC,IAAI,OAAOA,KAAI,KAAM,QAAQ,EAAE,OAAO,OAAO;MAC7C,OAAO,GAAGA,KAAI,IAAK,IAAI,GAAE,GAAI,EAAE,GAAGK,WAAW,CAACL,KAAK,CAAC,EAAE;IACxD,CAAC;IAED,MAAMwB,kBAAiB,GAAKxB,KAAK,IAAK;MACpC,OAAO;QACL,gBAAgB,EAAEA,KAAI,GAAI,CAAC;QAC3B,cAAc,EAAEA,KAAI,GAAI,CAAC;QAC