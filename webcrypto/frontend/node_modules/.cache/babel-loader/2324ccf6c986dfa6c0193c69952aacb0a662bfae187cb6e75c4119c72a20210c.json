{"ast":null,"code":"import { computed } from 'vue';\nimport { useStore } from 'vuex';\nexport default {\n  name: 'App',\n  setup() {\n    const store = useStore();\n    const isAuthenticated = computed(() => store.state.auth.isAuthenticated);\n    const logout = () => {\n      store.dispatch('auth/logout');\n    };\n    return {\n      isAuthenticated,\n      logout\n    };\n  }\n};","map":{"version":3,"names":["computed","useStore","name","setup","store","isAuthenticated","state","auth","logout","dispatch"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-gray-100\">\n    <nav class=\"bg-white shadow-lg\">\n      <div class=\"max-w-7xl mx-auto px-4\">\n        <div class=\"flex justify-between h-16\">\n          <div class=\"flex\">\n            <router-link to=\"/\" class=\"flex-shrink-0 flex items-center\">\n              CryptoTrade\n            </router-link>\n          </div>\n          <div class=\"flex items-center\">\n            <router-link v-if=\"!isAuthenticated\" to=\"/login\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n              Connexion\n            </router-link>\n            <router-link v-if=\"!isAuthenticated\" to=\"/register\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n              Inscription\n            </router-link>\n            <template v-else>\n              <router-link to=\"/dashboard\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n                Dashboard\n              </router-link>\n              <router-link to=\"/wallet\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n                Portefeuille\n              </router-link>\n              <button @click=\"logout\" class=\"text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium\">\n                Déconnexion\n              </button>\n            </template>\n          </div>\n        </div>\n      </div>\n    </nav>\n\n    <main class=\"max-w-7xl mx-auto py-6 sm:px-6 lg:px-8\">\n      <router-view></router-view>\n    </main>\n  </div>\n</template>\n\n<script>\nimport { computed } from 'vue'\nimport { useStore } from 'vuex'\n\nexport default {\n  name: 'App',\n  setup() {\n    const store = useStore()\n    \n    const isAuthenticated = computed(() => store.state.auth.isAuthenticated)\n    \n    const logout = () => {\n      store.dispatch('auth/logout')\n    }\n\n    return {\n      isAuthenticated,\n      logout\n    }\n  }\n}\n</script>\n"],"mappings":"AAwCA,SAASA,QAAO,QAAS,KAAI;AAC7B,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIH,QAAQ,CAAC;IAEvB,MAAMI,eAAc,GAAIL,QAAQ,CAAC,MAAMI,KAAK,CAACE,KAAK,CAACC,IAAI,CAACF,eAAe;IAEvE,MAAMG,MAAK,GAAIA,CAAA,KAAM;MACnBJ,KAAK,CAACK,QAAQ,CAAC,aAAa;IAC9B;IAEA,OAAO;MACLJ,eAAe;MACfG;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}