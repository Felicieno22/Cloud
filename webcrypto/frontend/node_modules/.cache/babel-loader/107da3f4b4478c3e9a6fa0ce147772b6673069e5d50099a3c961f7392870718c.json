{"ast":null,"code":"import axios from 'axios';\nimport { ref, onMounted } from 'vue';\n\n// Création d'une instance axios avec la configuration de base\nconst api = axios.create({\n  baseURL: 'http://localhost:3000/api'\n});\n\n// Ajout de l'intercepteur pour le token\napi.interceptors.request.use(config => {\n  const token = localStorage.getItem('token');\n  if (token) {\n    config.headers.Authorization = `Bearer ${token}`;\n  }\n  return config;\n});\nexport default {\n  name: 'Wallet',\n  setup() {\n    const wallet = ref({\n      balance: 0\n    });\n    const positions = ref([]);\n    const transactions = ref([]);\n    const showDepositModal = ref(false);\n    const showWithdrawModal = ref(false);\n    const showBuyModal = ref(false);\n    const showSellModal = ref(false);\n    const depositAmount = ref(0);\n    const withdrawAmount = ref(0);\n    const buyAmount = ref(0);\n    const sellAmount = ref(0);\n    const selectedCrypto = ref(null);\n    const selectedPosition = ref(null);\n    const fetchWallet = async () => {\n      const token = localStorage.getItem('token');\n      console.log('Token:', token);\n      try {\n        const response = await api.get('/wallet');\n        wallet.value = response.data;\n      } catch (error) {\n        console.error('Erreur lors de la récupération du portefeuille:', error);\n        console.error('Détails de l erreur:', error.response);\n        alert('Erreur lors de la récupération du portefeuille: ' + (error.response?.data?.error || error.message));\n      }\n    };\n    const fetchPositions = async () => {\n      const token = localStorage.getItem('token');\n      console.log('Token:', token);\n      try {\n        const response = await api.get('/wallet/positions');\n        positions.value = response.data;\n      } catch (error) {\n        console.error('Erreur lors de la récupération des positions:', error);\n        console.error('Détails de l erreur:', error.response);\n        alert('Erreur lors de la récupération des positions: ' + (error.response?.data?.error || error.message));\n      }\n    };\n    const fetchTransactions = async () => {\n      try {\n        const response = await api.get('/wallet/transactions');\n        transactions.value = response.data;\n      } catch (error) {\n        console.error('Erreur lors de la récupération des transactions:', error);\n        console.error('Détails de l erreur:', error.response);\n        alert('Erreur lors de la récupération des transactions: ' + (error.response?.data?.error || error.message));\n      }\n    };\n    const submitDeposit = async () => {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('Veuillez vous connecter pour effectuer un dépôt.');\n        return;\n      }\n      try {\n        await api.post('/wallet/request', {\n          type: 'deposit',\n          amount: depositAmount.value\n        });\n        showDepositModal.value = false;\n        depositAmount.value = 0;\n        alert('Demande de dépôt envoyée avec succès');\n      } catch (error) {\n        console.error('Erreur lors de la demande de dépôt:', error);\n        alert(error.response?.data?.error || 'Erreur lors de la demande de dépôt');\n      }\n    };\n    const submitWithdraw = async () => {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('Veuillez vous connecter pour effectuer un retrait.');\n        return;\n      }\n      try {\n        await api.post('/wallet/request', {\n          type: 'withdraw',\n          amount: withdrawAmount.value\n        });\n        showWithdrawModal.value = false;\n        withdrawAmount.value = 0;\n        alert('Demande de retrait envoyée avec succès');\n      } catch (error) {\n        console.error('Erreur lors de la demande de retrait:', error);\n        alert(error.response?.data?.error || 'Erreur lors de la demande de retrait');\n      }\n    };\n    const submitBuy = async () => {\n      try {\n        await api.post('/wallet/buy', {\n          cryptoId: selectedCrypto.value.id,\n          amount: buyAmount.value\n        });\n        showBuyModal.value = false;\n        buyAmount.value = 0;\n        selectedCrypto.value = null;\n        await Promise.all([fetchWallet(), fetchPositions(), fetchTransactions()]);\n      } catch (error) {\n        console.error('Erreur lors de l\\'achat:', error);\n        alert(error.response?.data?.error || 'Erreur lors de l\\'achat');\n      }\n    };\n    const submitSell = async () => {\n      try {\n        await api.post('/wallet/sell', {\n          cryptoId: selectedCrypto.value.id,\n          amount: sellAmount.value\n        });\n        showSellModal.value = false;\n        sellAmount.value = 0;\n        selectedCrypto.value = null;\n        selectedPosition.value = null;\n        await Promise.all([fetchWallet(), fetchPositions(), fetchTransactions()]);\n      } catch (error) {\n        console.error('Erreur lors de la vente:', error);\n        alert(error.response?.data?.error || 'Erreur lors de la vente');\n      }\n    };\n    const handleBuyClick = crypto => {\n      selectedCrypto.value = crypto;\n      buyAmount.value = 0;\n      showBuyModal.value = true;\n    };\n    const handleSellClick = position => {\n      selectedCrypto.value = position;\n      selectedPosition.value = position;\n      sellAmount.value = 0;\n      showSellModal.value = true;\n    };\n    const formatCurrency = value => {\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'EUR'\n      }).format(value);\n    };\n    const formatNumber = value => {\n      return new Intl.NumberFormat('fr-FR').format(value);\n    };\n    const formatPercentage = value => {\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'percent',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(value / 100);\n    };\n    const formatDate = date => {\n      return new Date(date).toLocaleString('fr-FR');\n    };\n    const getCryptoIcon = symbol => {\n      return `https://cryptoicons.org/api/icon/${symbol.toLowerCase()}/50`;\n    };\n    onMounted(async () => {\n      await Promise.all([fetchWallet(), fetchPositions(), fetchTransactions()]);\n    });\n    return {\n      wallet,\n      positions,\n      transactions,\n      showDepositModal,\n      showWithdrawModal,\n      showBuyModal,\n      showSellModal,\n      depositAmount,\n      withdrawAmount,\n      buyAmount,\n      sellAmount,\n      selectedCrypto,\n      selectedPosition,\n      submitDeposit,\n      submitWithdraw,\n      submitBuy,\n      submitSell,\n      handleBuyClick,\n      handleSellClick,\n      formatCurrency,\n      formatNumber,\n      formatPercentage,\n      formatDate,\n      getCryptoIcon\n    };\n  }\n};","map":{"version":3,"names":["axios","ref","onMounted","api","create","baseURL","interceptors","request","use","config","token","localStorage","getItem","headers","Authorization","name","setup","wallet","balance","positions","transactions","showDepositModal","showWithdrawModal","showBuyModal","showSellModal","depositAmount","withdrawAmount","buyAmount","sellAmount","selectedCrypto","selectedPosition","fetchWallet","console","log","response","get","value","data","error","alert","message","fetchPositions","fetchTransactions","submitDeposit","post","type","amount","submitWithdraw","submitBuy","cryptoId","id","Promise","all","submitSell","handleBuyClick","crypto","handleSellClick","position","formatCurrency","Intl","NumberFormat","style","currency","format","formatNumber","formatPercentage","minimumFractionDigits","maximumFractionDigits","formatDate","date","Date","toLocaleString","getCryptoIcon","symbol","toLowerCase"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\Wallet.vue"],"sourcesContent":["<template>\n  <div class=\"wallet-container\">\n    <div class=\"wallet-header\">\n      <h1>Mon Portefeuille</h1>\n      <div class=\"wallet-balance\">\n        <h2>Solde disponible</h2>\n        <p class=\"balance\">{{ formatCurrency(wallet.balance) }}</p>\n        <div class=\"wallet-actions\">\n          <button @click=\"showDepositModal = true\" class=\"btn btn-primary\">Dépôt</button>\n          <button @click=\"showWithdrawModal = true\" class=\"btn btn-secondary\">Retrait</button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"positions-section\">\n      <h2>Mes Positions</h2>\n      <div class=\"positions-grid\">\n        <div v-for=\"position in positions\" :key=\"position.crypto_id\" class=\"position-card\">\n          <div class=\"position-header\">\n            <img :src=\"getCryptoIcon(position.symbol)\" :alt=\"position.symbol\">\n            <h3>{{ position.name }}</h3>\n          </div>\n          <div class=\"position-details\">\n            <p>Quantité: {{ formatNumber(position.quantity) }} {{ position.symbol }}</p>\n            <p>Prix moyen: {{ formatCurrency(position.average_buy_price) }}</p>\n            <p>Valeur totale: {{ formatCurrency(position.quantity * position.current_price) }}</p>\n            <p :class=\"{'text-success': position.price_change_24h > 0, 'text-danger': position.price_change_24h < 0}\">\n              24h: {{ formatPercentage(position.price_change_24h) }}\n            </p>\n          </div>\n          <div class=\"position-actions\">\n            <button @click=\"handleBuyClick(position)\" class=\"btn btn-success\">Acheter</button>\n            <button @click=\"handleSellClick(position)\" class=\"btn btn-danger\">Vendre</button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"transactions-section\">\n      <h2>Historique des Transactions</h2>\n      <div class=\"transactions-table\">\n        <table>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Type</th>\n              <th>Crypto</th>\n              <th>Quantité</th>\n              <th>Prix</th>\n              <th>Montant</th>\n              <th>Statut</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr v-for=\"tx in transactions\" :key=\"tx.id\">\n              <td>{{ formatDate(tx.created_at) }}</td>\n              <td :class=\"{'text-success': tx.type === 'buy', 'text-danger': tx.type === 'sell'}\">\n                {{ tx.type === 'buy' ? 'Achat' : 'Vente' }}\n              </td>\n              <td>{{ tx.crypto_symbol }}</td>\n              <td>{{ formatNumber(tx.quantity) }}</td>\n              <td>{{ formatCurrency(tx.price) }}</td>\n              <td>{{ formatCurrency(tx.amount) }}</td>\n              <td>{{ tx.status }}</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- Modal de dépôt -->\n    <div v-if=\"showDepositModal\" class=\"modal\">\n      <div class=\"modal-content\">\n        <h2>Effectuer un dépôt</h2>\n        <form @submit.prevent=\"submitDeposit\">\n          <div class=\"form-group\">\n            <label>Montant</label>\n            <input v-model.number=\"depositAmount\" type=\"number\" min=\"0\" step=\"0.01\" required>\n          </div>\n          <div class=\"modal-actions\">\n            <button type=\"button\" @click=\"showDepositModal = false\" class=\"btn btn-secondary\">Annuler</button>\n            <button type=\"submit\" class=\"btn btn-primary\">Confirmer</button>\n          </div>\n        </form>\n      </div>\n    </div>\n\n    <!-- Modal de retrait -->\n    <div v-if=\"showWithdrawModal\" class=\"modal\">\n      <div class=\"modal-content\">\n        <h2>Effectuer un retrait</h2>\n        <form @submit.prevent=\"submitWithdraw\">\n          <div class=\"form-group\">\n            <label>Montant</label>\n            <input v-model.number=\"withdrawAmount\" type=\"number\" min=\"0\" step=\"0.01\" :max=\"wallet.balance\" required>\n          </div>\n          <div class=\"modal-actions\">\n            <button type=\"button\" @click=\"showWithdrawModal = false\" class=\"btn btn-secondary\">Annuler</button>\n            <button type=\"submit\" class=\"btn btn-primary\">Confirmer</button>\n          </div>\n        </form>\n      </div>\n    </div>\n\n    <!-- Modal d'achat -->\n    <div v-if=\"showBuyModal\" class=\"modal\">\n      <div class=\"modal-content\">\n        <h2>Acheter {{ selectedCrypto?.name }}</h2>\n        <form @submit.prevent=\"submitBuy\">\n          <div class=\"form-group\">\n            <label>Quantité</label>\n            <input v-model.number=\"buyAmount\" type=\"number\" min=\"0\" step=\"0.000001\" required>\n            <p>Coût total: {{ formatCurrency(buyAmount * selectedCrypto?.current_price || 0) }}</p>\n          </div>\n          <div class=\"modal-actions\">\n            <button type=\"button\" @click=\"showBuyModal = false\" class=\"btn btn-secondary\">Annuler</button>\n            <button type=\"submit\" class=\"btn btn-primary\">Confirmer</button>\n          </div>\n        </form>\n      </div>\n    </div>\n\n    <!-- Modal de vente -->\n    <div v-if=\"showSellModal\" class=\"modal\">\n      <div class=\"modal-content\">\n        <h2>Vendre {{ selectedCrypto?.name }}</h2>\n        <form @submit.prevent=\"submitSell\">\n          <div class=\"form-group\">\n            <label>Quantité</label>\n            <input v-model.number=\"sellAmount\" type=\"number\" min=\"0\" :max=\"selectedPosition?.quantity\" step=\"0.000001\" required>\n            <p>Montant estimé: {{ formatCurrency(sellAmount * selectedCrypto?.current_price || 0) }}</p>\n          </div>\n          <div class=\"modal-actions\">\n            <button type=\"button\" @click=\"showSellModal = false\" class=\"btn btn-secondary\">Annuler</button>\n            <button type=\"submit\" class=\"btn btn-primary\">Confirmer</button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\nimport { ref, onMounted } from 'vue';\n\n// Création d'une instance axios avec la configuration de base\nconst api = axios.create({\n  baseURL: 'http://localhost:3000/api'\n});\n\n// Ajout de l'intercepteur pour le token\napi.interceptors.request.use(config => {\n  const token = localStorage.getItem('token');\n  if (token) {\n    config.headers.Authorization = `Bearer ${token}`;\n  }\n  return config;\n});\n\nexport default {\n  name: 'Wallet',\n  setup() {\n    const wallet = ref({ balance: 0 });\n    const positions = ref([]);\n    const transactions = ref([]);\n    const showDepositModal = ref(false);\n    const showWithdrawModal = ref(false);\n    const showBuyModal = ref(false);\n    const showSellModal = ref(false);\n    const depositAmount = ref(0);\n    const withdrawAmount = ref(0);\n    const buyAmount = ref(0);\n    const sellAmount = ref(0);\n    const selectedCrypto = ref(null);\n    const selectedPosition = ref(null);\n\n    const fetchWallet = async () => {\n      const token = localStorage.getItem('token');\n      console.log('Token:', token);\n      try {\n        const response = await api.get('/wallet');\n        wallet.value = response.data;\n      } catch (error) {\n        console.error('Erreur lors de la récupération du portefeuille:', error);\n        console.error('Détails de l erreur:', error.response);\n        alert('Erreur lors de la récupération du portefeuille: ' + (error.response?.data?.error || error.message));\n      }\n    };\n\n    const fetchPositions = async () => {\n      const token = localStorage.getItem('token');\n      console.log('Token:', token);\n      try {\n        const response = await api.get('/wallet/positions');\n        positions.value = response.data;\n      } catch (error) {\n        console.error('Erreur lors de la récupération des positions:', error);\n        console.error('Détails de l erreur:', error.response);\n        alert('Erreur lors de la récupération des positions: ' + (error.response?.data?.error || error.message));\n      }\n    };\n\n    const fetchTransactions = async () => {\n      try {\n        const response = await api.get('/wallet/transactions');\n        transactions.value = response.data;\n      } catch (error) {\n        console.error('Erreur lors de la récupération des transactions:', error);\n        console.error('Détails de l erreur:', error.response);\n        alert('Erreur lors de la récupération des transactions: ' + (error.response?.data?.error || error.message));\n      }\n    };\n\n    const submitDeposit = async () => {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('Veuillez vous connecter pour effectuer un dépôt.');\n        return;\n      }\n      try {\n        await api.post('/wallet/request', {\n          type: 'deposit',\n          amount: depositAmount.value\n        });\n        showDepositModal.value = false;\n        depositAmount.value = 0;\n        alert('Demande de dépôt envoyée avec succès');\n      } catch (error) {\n        console.error('Erreur lors de la demande de dépôt:', error);\n        alert(error.response?.data?.error || 'Erreur lors de la demande de dépôt');\n      }\n    };\n\n    const submitWithdraw = async () => {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('Veuillez vous connecter pour effectuer un retrait.');\n        return;\n      }\n      try {\n        await api.post('/wallet/request', {\n          type: 'withdraw',\n          amount: withdrawAmount.value\n        });\n        showWithdrawModal.value = false;\n        withdrawAmount.value = 0;\n        alert('Demande de retrait envoyée avec succès');\n      } catch (error) {\n        console.error('Erreur lors de la demande de retrait:', error);\n        alert(error.response?.data?.error || 'Erreur lors de la demande de retrait');\n      }\n    };\n\n    const submitBuy = async () => {\n      try {\n        await api.post('/wallet/buy', {\n          cryptoId: selectedCrypto.value.id,\n          amount: buyAmount.value\n        });\n        showBuyModal.value = false;\n        buyAmount.value = 0;\n        selectedCrypto.value = null;\n        await Promise.all([fetchWallet(), fetchPositions(), fetchTransactions()]);\n      } catch (error) {\n        console.error('Erreur lors de l\\'achat:', error);\n        alert(error.response?.data?.error || 'Erreur lors de l\\'achat');\n      }\n    };\n\n    const submitSell = async () => {\n      try {\n        await api.post('/wallet/sell', {\n          cryptoId: selectedCrypto.value.id,\n          amount: sellAmount.value\n        });\n        showSellModal.value = false;\n        sellAmount.value = 0;\n        selectedCrypto.value = null;\n        selectedPosition.value = null;\n        await Promise.all([fetchWallet(), fetchPositions(), fetchTransactions()]);\n      } catch (error) {\n        console.error('Erreur lors de la vente:', error);\n        alert(error.response?.data?.error || 'Erreur lors de la vente');\n      }\n    };\n\n    const handleBuyClick = (crypto) => {\n      selectedCrypto.value = crypto;\n      buyAmount.value = 0;\n      showBuyModal.value = true;\n    };\n\n    const handleSellClick = (position) => {\n      selectedCrypto.value = position;\n      selectedPosition.value = position;\n      sellAmount.value = 0;\n      showSellModal.value = true;\n    };\n\n    const formatCurrency = (value) => {\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'EUR'\n      }).format(value);\n    };\n\n    const formatNumber = (value) => {\n      return new Intl.NumberFormat('fr-FR').format(value);\n    };\n\n    const formatPercentage = (value) => {\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'percent',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(value / 100);\n    };\n\n    const formatDate = (date) => {\n      return new Date(date).toLocaleString('fr-FR');\n    };\n\n    const getCryptoIcon = (symbol) => {\n      return `https://cryptoicons.org/api/icon/${symbol.toLowerCase()}/50`;\n 