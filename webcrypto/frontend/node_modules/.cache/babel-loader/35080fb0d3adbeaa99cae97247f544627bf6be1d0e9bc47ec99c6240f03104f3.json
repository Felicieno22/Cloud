{"ast":null,"code":"import { ref, computed, onMounted, watch } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Account',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loading = ref(false);\n    const error = ref('');\n    const user = computed(() => store.getters['auth/user']);\n    const form = ref({\n      username: '',\n      nom: '',\n      prenom: '',\n      date_naissance: '',\n      ville: '',\n      currentPassword: ''\n    });\n    const editingField = ref({\n      username: false,\n      nom: false,\n      prenom: false,\n      date_naissance: false,\n      ville: false\n    });\n\n    // Fonction pour formater la date\n    const formatDate = date => {\n      if (!date) return '';\n      try {\n        const d = new Date(date);\n        if (isNaN(d.getTime())) return ''; // Vérifie si la date est valide\n        return d.toLocaleDateString('fr-FR', {\n          year: 'numeric',\n          month: 'long',\n          day: 'numeric'\n        });\n      } catch (err) {\n        console.error('Erreur lors du formatage de la date:', err);\n        return '';\n      }\n    };\n\n    // Fonction pour récupérer les données utilisateur depuis le store\n    const getUserData = computed(() => {\n      const userData = store.getters['auth/user'];\n      if (!userData) return null;\n\n      // Vérifier et nettoyer les données\n      const cleanData = {\n        username: userData.username === 'Non renseigné' ? '' : userData.username,\n        prenom: userData.prenom || '',\n        nom: userData.nom || '',\n        date_naissance: userData.date_naissance ? formatDate(userData.date_naissance) : '',\n        ville: userData.ville || '',\n        email: userData.email || '',\n        createdAt: userData.created_at ? formatDate(userData.created_at) : ''\n      };\n\n      // Filtrer les valeurs vides pour l'affichage\n      const displayData = {\n        username: cleanData.username || userData.email?.split('@')[0] || 'Utilisateur',\n        prenom: cleanData.prenom || '',\n        nom: cleanData.nom || '',\n        date_naissance: cleanData.date_naissance || '',\n        ville: cleanData.ville || '',\n        email: cleanData.email || '',\n        createdAt: cleanData.createdAt || 'Date inconnue'\n      };\n      console.log('Données nettoyées:', cleanData);\n      console.log('Données pour affichage:', displayData);\n      return displayData;\n    });\n\n    // Fonction pour récupérer les données utilisateur depuis l'API\n    const fetchUserData = async () => {\n      try {\n        loading.value = true;\n        const token = localStorage.getItem('token');\n        if (!token) {\n          throw new Error('Token non trouvé');\n        }\n\n        // Récupérer les données depuis le store\n        const userData = getUserData.value;\n        if (!userData) {\n          throw new Error('Aucune donnée utilisateur trouvée');\n        }\n        console.log('Données utilisateur formatées:', userData);\n\n        // Mettre à jour le store avec les données reçues\n        await store.dispatch('auth/updateUser', userData);\n\n        // Initialiser le formulaire avec les nouvelles données\n        initializeForm();\n      } catch (err) {\n        console.error('Erreur lors de la récupération des données:', err);\n        error.value = err.message;\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // Initialiser le formulaire avec les données de l'utilisateur\n    const initializeForm = () => {\n      const userData = getUserData.value;\n      if (userData) {\n        form.value = {\n          username: userData.username,\n          nom: userData.nom,\n          prenom: userData.prenom,\n          date_naissance: userData.date_naissance,\n          ville: userData.ville,\n          currentPassword: ''\n        };\n        console.log('Formulaire initialisé avec:', form.value);\n      }\n    };\n\n    // Surveiller les changements de l'utilisateur\n    watch(user, newUser => {\n      if (newUser) {\n        initializeForm();\n      }\n    });\n    onMounted(async () => {\n      if (!localStorage.getItem('token')) {\n        router.push('/login');\n        return;\n      }\n      try {\n        // Récupérer les données utilisateur depuis l'API\n        await fetchUserData();\n      } catch (err) {\n        console.error('Erreur lors de l\\'initialisation:', err);\n        error.value = 'Erreur lors du chargement des données utilisateur';\n      }\n    });\n    const startEditing = field => {\n      editingField.value[field] = true;\n      // Réinitialiser le formulaire avec les valeurs actuelles\n      form.value[field] = user.value[field] || '';\n    };\n    const cancelEdit = field => {\n      editingField.value[field] = false;\n      form.value[field] = user.value[field] || '';\n      error.value = '';\n    };\n    const saveField = async field => {\n      try {\n        loading.value = true;\n        error.value = '';\n\n        // Validation spécifique pour la date de naissance\n        if (field === 'date_naissance') {\n          const inputDate = new Date(form.value[field]);\n          if (isNaN(inputDate.getTime())) {\n            throw new Error('Date de naissance invalide');\n          }\n          // Vérifier que la date n'est pas dans le futur\n          if (inputDate > new Date()) {\n            throw new Error('La date de naissance ne peut pas être dans le futur');\n          }\n        }\n\n        // Validation pour la ville\n        if (field === 'ville' && form.value[field].trim() === '') {\n          throw new Error('La ville ne peut pas être vide');\n        }\n\n        // Demander le mot de passe pour la validation\n        const password = await promptPassword();\n        if (!password) {\n          loading.value = false;\n          return;\n        }\n\n        // Préparer les données à envoyer\n        const updateData = {\n          ...user.value,\n          [field]: form.value[field].trim(),\n          password: password\n        };\n\n        // Formater la date si nécessaire\n        if (field === 'date_naissance' && form.value[field]) {\n          const formattedDate = new Date(form.value[field]).toISOString().split('T')[0];\n          updateData[field] = formattedDate;\n        }\n        console.log('Données à envoyer:', updateData);\n\n        // Mettre à jour dans le store\n        await store.dispatch('auth/updateUser', updateData);\n\n        // Fermer le modal d'édition\n        editingField.value[field] = false;\n\n        // Recharger le formulaire avec les nouvelles données\n        initializeForm();\n      } catch (err) {\n        console.error('Erreur lors de la sauvegarde:', err);\n        error.value = err.message || 'Erreur lors de la mise à jour';\n      } finally {\n        loading.value = false;\n      }\n    };\n    const promptPassword = () => {\n      return new Promise(resolve => {\n        const password = window.prompt('Veuillez entrer votre mot de passe pour confirmer la modification');\n        resolve(password);\n      });\n    };\n    const getFieldLabel = () => {\n      if (editingField.value.username) return \"le nom d'utilisateur\";\n      if (editingField.value.prenom) return \"le prénom\";\n      if (editingField.value.nom) return \"le nom\";\n      if (editingField.value.date_naissance) return \"la date de naissance\";\n      if (editingField.value.ville) return \"la ville\";\n      return \"\";\n    };\n    const getEditingField = () => {\n      return Object.entries(editingField.value).find(([_, value]) => value)?.[0];\n    };\n    const getFieldPlaceholder = field => {\n      switch (field) {\n        case 'username':\n          return \"Entrez votre nom d'utilisateur\";\n        case 'prenom':\n          return \"Entrez votre prénom\";\n        case 'nom':\n          return \"Entrez votre nom\";\n        case 'ville':\n          return \"Entrez votre ville\";\n        default:\n          return \"\";\n      }\n    };\n    return {\n      user: getUserData,\n      form,\n      loading,\n      error,\n      editingField,\n      formatDate,\n      startEditing,\n      cancelEdit,\n      saveField,\n      getFieldLabel,\n      getEditingField,\n      getFieldPlaceholder\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","watch","useStore","useRouter","name","setup","store","router","loading","error","user","getters","form","username","nom","prenom","date_naissance","ville","currentPassword","editingField","formatDate","date","d","Date","isNaN","getTime","toLocaleDateString","year","month","day","err","console","getUserData","userData","cleanData","email","createdAt","created_at","displayData","split","log","fetchUserData","value","token","localStorage","getItem","Error","dispatch","initializeForm","message","newUser","push","startEditing","field","cancelEdit","saveField","inputDate","trim","password","promptPassword","updateData","formattedDate","toISOString","Promise","resolve","window","prompt","getFieldLabel","getEditingField","Object","entries","find","_","getFieldPlaceholder"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Account.vue"],"sourcesContent":["<template>\r\n  <div class=\"min-h-screen bg-gray-50 py-12\">\r\n    <div class=\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\">\r\n      <div class=\"bg-white rounded-lg shadow-sm overflow-hidden\">\r\n        <!-- En-tête -->\r\n        <div class=\"px-6 py-4 border-b border-gray-200 flex justify-between items-center\">\r\n          <div>\r\n            <h2 class=\"text-2xl font-bold text-gray-900\">Mon Compte</h2>\r\n            <p class=\"mt-1 text-sm text-gray-500\">Gérez vos informations personnelles</p>\r\n          </div>\r\n          <button\r\n            @click=\"$router.push('/dashboard')\"\r\n            class=\"text-gray-600 hover:text-gray-800 flex items-center gap-2\"\r\n          >\r\n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 19l-7-7m0 0l7-7m-7 7h18\" />\r\n            </svg>\r\n            Retour\r\n          </button>\r\n        </div>\r\n\r\n        <div class=\"p-6 space-y-8\">\r\n          <!-- Avatar et informations principales -->\r\n          <div class=\"flex items-start space-x-6\">\r\n            <div class=\"w-24 h-24 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0\">\r\n              <span class=\"text-3xl font-medium text-indigo-700\">\r\n                {{ user?.username?.[0]?.toUpperCase() || 'U' }}\r\n              </span>\r\n            </div>\r\n            <div class=\"flex-1 space-y-1\">\r\n              <div class=\"text-xl font-semibold text-gray-900\">{{ user?.username }}</div>\r\n              <div class=\"text-sm text-gray-500\">Membre depuis {{ user?.createdAt }}</div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Sections d'informations -->\r\n          <div v-if=\"user\" class=\"space-y-6\">\r\n            <!-- Nom d'utilisateur -->\r\n            <div class=\"bg-gray-50 rounded-lg p-4\">\r\n              <div class=\"flex justify-between items-center\">\r\n                <div>\r\n                  <div class=\"text-sm font-medium text-gray-700\">Nom d'utilisateur</div>\r\n                  <div class=\"text-gray-900\">{{ user.username }}</div>\r\n                </div>\r\n                <button\r\n                  @click=\"startEditing('username')\"\r\n                  class=\"text-indigo-600 hover:text-indigo-800\"\r\n                >\r\n                  Modifier\r\n                </button>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Prénom -->\r\n            <div class=\"bg-gray-50 rounded-lg p-4\">\r\n              <div class=\"flex justify-between items-center\">\r\n                <div>\r\n                  <div class=\"text-sm font-medium text-gray-700\">Prénom</div>\r\n                  <div class=\"text-gray-900\">\r\n                    <span v-if=\"user.prenom\">{{ user.prenom }}</span>\r\n                    <span v-else class=\"text-gray-400 italic\">Non renseigné</span>\r\n                  </div>\r\n                </div>\r\n                <button\r\n                  @click=\"startEditing('prenom')\"\r\n                  class=\"text-indigo-600 hover:text-indigo-800\"\r\n                >\r\n                  {{ user.prenom ? 'Modifier' : 'Ajouter' }}\r\n                </button>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Nom -->\r\n            <div class=\"bg-gray-50 rounded-lg p-4\">\r\n              <div class=\"flex justify-between items-center\">\r\n                <div>\r\n                  <div class=\"text-sm font-medium text-gray-700\">Nom</div>\r\n                  <div class=\"text-gray-900\">\r\n                    <span v-if=\"user.nom\">{{ user.nom }}</span>\r\n                    <span v-else class=\"text-gray-400 italic\">Non renseigné</span>\r\n                  </div>\r\n                </div>\r\n                <button\r\n                  @click=\"startEditing('nom')\"\r\n                  class=\"text-indigo-600 hover:text-indigo-800\"\r\n                >\r\n                  {{ user.nom ? 'Modifier' : 'Ajouter' }}\r\n                </button>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Date de naissance -->\r\n            <div class=\"bg-gray-50 rounded-lg p-4\">\r\n              <div class=\"flex justify-between items-center\">\r\n                <div>\r\n                  <div class=\"text-sm font-medium text-gray-700\">Date de naissance</div>\r\n                  <div class=\"text-gray-900\">\r\n                    <span v-if=\"user.date_naissance\">{{ user.date_naissance }}</span>\r\n                    <span v-else class=\"text-gray-400 italic\">Non renseignée</span>\r\n                  </div>\r\n                </div>\r\n                <button\r\n                  @click=\"startEditing('date_naissance')\"\r\n                  class=\"text-indigo-600 hover:text-indigo-800\"\r\n                >\r\n                  {{ user.date_naissance ? 'Modifier' : 'Ajouter' }}\r\n                </button>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Ville -->\r\n            <div class=\"bg-gray-50 rounded-lg p-4\">\r\n              <div class=\"flex justify-between items-center\">\r\n                <div>\r\n                  <div class=\"text-sm font-medium text-gray-700\">Ville</div>\r\n                  <div class=\"text-gray-900\">\r\n                    <span v-if=\"user.ville\">{{ user.ville }}</span>\r\n                    <span v-else class=\"text-gray-400 italic\">Non renseignée</span>\r\n                  </div>\r\n                </div>\r\n                <button\r\n                  @click=\"startEditing('ville')\"\r\n                  class=\"text-indigo-600 hover:text-indigo-800\"\r\n                >\r\n                  {{ user.ville ? 'Modifier' : 'Ajouter' }}\r\n                </button>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Email -->\r\n            <div class=\"bg-gray-50 rounded-lg p-4\">\r\n              <div class=\"flex justify-between items-center\">\r\n                <div>\r\n                  <div class=\"text-sm font-medium text-gray-700\">Email</div>\r\n                  <div class=\"text-gray-900\">{{ user.email }}</div>\r\n                  <p class=\"text-xs text-gray-500\">L'adresse email ne peut pas être modifiée</p>\r\n                </div>\r\n                <div class=\"text-gray-400\">\r\n                  <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\r\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\" />\r\n                  </svg>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Message d'erreur -->\r\n          <div v-if=\"error\" class=\"rounded-md bg-red-50 p-4\">\r\n            <div class=\"flex\">\r\n              <div class=\"flex-shrink-0\">\r\n                <svg class=\"h-5 w-5 text-red-400\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\r\n                  <path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z\" clip-rule=\"evenodd\" />\r\n                </svg>\r\n              </div>\r\n              <div class=\"ml-3\">\r\n                <p class=\"text-sm text-red-700\">{{ error }}</p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Modal d'édition -->\r\n    <div v-if=\"Object.values(editingField).some(v => v)\" class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center\">\r\n      <div class=\"bg-white rounded-lg p-6 w-full max-w-md\">\r\n        <h3 class=\"text-lg font-medium text-gray-900 mb-4\">Modifier {{ getFieldLabel() }}</h3>\r\n        <div class=\"space-y-4\">\r\n          <div>\r\n            <input\r\n              v-if=\"editingField.date_naissance\"\r\n              type=\"date\"\r\n              v-model=\"form[getEditingField()]\"\r\n              class=\"w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n            />\r\n            <input\r\n              v-else\r\n              type=\"text\"\r\n              v-model=\"form[getEditingField()]\"\r\n              :placeholder=\"getFieldPlaceholder(getEditingField())\"\r\n              class=\"w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500\"\r\n            />\r\n          </div>\r\n          <div class=\"flex justify-end gap-3\">\r\n            <button\r\n              @click=\"cancelEdit(getEditingField())\"\r\n              class=\"px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50\"\r\n            >\r\n              Annuler\r\n            </button>\r\n            <button\r\n              @click=\"saveField(getEditingField())\"\r\n              class=\"px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700\"\r\n            >\r\n              Enregistrer\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, watch } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { useRouter } from 'vue-router'\r\n\r\nexport default {\r\n  name: 'Account',\r\n  \r\n  setup() {\r\n    const store = useStore()\r\n    const router = useRouter()\r\n    const loading = ref(false)\r\n    const error = ref('')\r\n    \r\n    const user = computed(() => store.getters['auth/user'])\r\n    \r\n    const form = ref({\r\n      username: '',\r\n      nom: '',\r\n      prenom: '',\r\n      date_naissance: '',\r\n      ville: '',\r\n      currentPassword: ''\r\n    })\r\n\r\n    const editingField = ref({\r\n      username: false,\r\n      nom: false,\r\n      prenom: false,\r\n      date_naissance: false,\r\n      ville: false\r\n    })\r\n\r\n    // Fonction pour formater la date\r\n    const formatDate = (date) => {\r\n      if (!date) return ''\r\n      try {\r\n        const d = new Date(date)\r\n        if (isNaN(d.getTime())) return '' // Vérifie si la date est valide\r\n        return d.toLocaleDateString('fr-FR', {\r\n          year: 'numeric',\r\n          month: 'long',\r\n          day: 'numeric'\r\n        })\r\n      } catch (err) {\r\n        console.error('Erreur lors du formatage de la date:', err)\r\n        return ''\r\n      }\r\n    }\r\n\r\n    // Fonction pour récupérer les données utilisateur depuis le store\r\n    const getUserData = computed(() => {\r\n      const userData = store.getters['auth/user']\r\n      if (!userData) return null\r\n\r\n      // Vérifier et nettoyer les données\r\n      const cleanData = {\r\n        username: userData.username === 'Non renseigné' ? '' : userData.username,\r\n        prenom: userData.prenom || '',\r\n        nom: userData.nom || '',\r\n        date_naissance: userData.date_naissance ? formatDate(userData.date_naissance) : '',\r\n        ville: userData.ville || '',\r\n        email: userData.email || '',\r\n        createdAt: userData.created_at ? formatDate(userData.created_at) : ''\r\n      }\r\n\r\n      // Filtrer les valeurs vides pour l'affichage\r\n      const displayData = {\r\n        username: cleanData.username || userData.email?.split('@')[0] || 'Utilisateur',\r\n        prenom: cleanData.prenom || '',\r\n        nom: cleanData.nom || '',\r\n        date_naissance: cleanData.date_naissance || '',\r\n        ville: cleanData.ville || '',\r\n        email: cleanData.email || '',\r\n        createdAt: cleanData.createdAt || 'Date inconnue'\r\n      }\r\n\r\n      console.log('Données nettoyées:', cleanData)\r\n      console.log('Données pour affichage:', displayData)\r\n\r\n      return displayData\r\n    })\r\n\r\n    // Fonction pour récupérer les données utilisateur depuis l'API\r\n    const fetchUserData = async () => {\r\n      try {\r\n        loading.value = true\r\n        const token = localStorage.getItem('token')\r\n        if (!token) {\r\n          throw new Error('Token non trouvé')\r\n        }\r\n\r\n        // Récupérer les données depuis le store\r\n        const userData = getUserData.value\r\n        if (!userData) {\r\n          throw new Error('Aucune donnée utilisateur trouvée')\r\n        }\r\n\r\n        console.log('Données utilisateur formatées:', userData)\r\n\r\n        // Mettre à jour le store avec les données reçues\r\n        await store.dispatch('auth/updateUser', userData)\r\n        \r\n        // Initialiser le formulaire avec les nouvelles données\r\n        initializeForm()\r\n      } catch (err) {\r\n        console.error('Erreur lors de la récupération des données:', err)\r\n        error.value = err.message\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    // Initialiser le formulaire avec les données de l'utilisateur\r\n    const initializeForm = () => {\r\n      const userData = getUserData.value\r\n      if (userData) {\r\n        form.value = {\r\n          username: userData.username,\r\n          nom: userData.nom,\r\n          prenom: userData.prenom,\r\n          date_naissance: userData.date_naissance,\r\n          ville: userData.ville,\r\n          currentPassword: ''\r\n        }\r\n        console.log('Formulaire initialisé avec:', form.value)\r\n      }\r\n    }\r\n\r\n    // Surveiller les changements de l'utilisateur\r\n    watch(user, (newUser) => {\r\n      if (newUser) {\r\n        initializeForm()\r\n      }\r\n    })\r\n\r\n    onMounted(async () => {\r\n      if (!localStorage.getItem('token')) {\r\n        router.push('/login')\r\n        return\r\n      }\r\n\r\n      try {\r\n        // Récupérer les données utilisateur depuis l'API\r\n        await fetchUserData()\r\n      } catch (err) {\r\n        console.error('Erreur lors de l\\'initialisation:', err)\r\n        error.value = 'Erreur lors du chargement des données utilisateur'\r\n      }\r\n    })\r\n\r\n    const startEditing = (field) => {\r\n      editingField.value[field] = true\r\n      // Réinitialiser le formulaire avec les valeurs actuelles\r\n      form.value[field] = user.value[field] || ''\r\n    }\r\n\r\n    const cancelEdit = (field) => {\r\n      editingField.value[field] = false\r\n      form.value[field] = user.value[field] || ''\r\n      error.value = ''\r\n    }\r\n\r\n    const saveField = async (field) => {\r\n      try {\r\n        loading.value = true\r\n        error.value = ''\r\n\r\n        // Validation spécifique pour la date de naissance\r\n        if (field === 'date_naissance') {\r\n          const inputDate = new Date(form.value[field])\r\n          if (isNaN(inputDate.getTime())) {\r\n            throw new Error('Date de naissance invalide')\r\n          }\r\n          // Vérifier que la date n'est pas dans le futur\r\n          if (inputDate > new Date()) {\r\n            throw new Error('La date de naissance ne peut pas être dans le futur')\r\n          }\r\n        }\r\n\r\n        // Validation pour la ville\r\n        if (field === 'ville' && form.value[field].trim() === '') {\r\n          throw new Error('La ville ne peut pas être vide')\r\n        }\r\n\r\n        // Demander le mot de passe pour la validation\r\n        const password = await promptPassword()\r\n        if (!password) {\r\n          loading.value = false\r\n          return\r\n        }\r\n\r\n        // Préparer les données à envoyer\r\n        const updateData = {\r\n          ...user.value,\r\n          [field]: form.value[field].trim(),\r\n          password: password\r\n        }\r\n\r\n        // Formater la date si nécessaire\r\n        if (field === 'date_naissance' && form.value[field]) {\r\n          const formattedDate = new Date(form.value[field]).toISOString().split('T')[0]\r\n          updateData[field] = formattedDate\r\n        }\r\n\r\n        console.log('Données à envoyer:', updateData)\r\n\r\n        // Mettre à jour dans le store\r\n        await store.dispatch('auth/updateUser', updateData)\r\n        \r\n        // Fermer le modal d'édition\r\n        editingField.value[field] = false\r\n\r\n        // Recharger le formulaire avec les nouvelles données\r\n        initializeForm()\r\n      } catch (err) {\r\n        console.error('Erreur lors de la sauvegarde:', err)\r\n        error.value = err.message || 'Erreur lors de la mise à jour'\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    const promptPassword = () => {\r\n      return new Promise((resolve) => {\r\n        const password = window.prompt('Veuillez entrer votre mot de passe pour confirmer la modification')\r\n        resolve(password)\r\n      })\r\n    }\r\n\r\n    const getFieldLabel = () => {\r\n      if (editingField.value.username) return \"le nom d'utilisateur\"\r\n      if (editingField.value.prenom) return \"le prénom\"\r\n      if (editingField.value.nom) return \"le nom\"\r\n      if (editingField.value.date_naissance) return \"la date de naissance\"\r\n      if (editingField.value.ville) return \"la ville\"\r\n      return \"\"\r\n    }\r\n\r\n    const getEditingField = () => {\r\n      return Object.entries(editingField.value).find(([_, value]) => value)?.[0]\r\n    }\r\n\r\n    const getFieldPlaceholder = (field) => {\r\n      switch (field) {\r\n        case 'username':\r\n          return \"Entrez votre nom d'utilisateur\"\r\n        case 'prenom':\r\n          return \"Entrez votre prénom\"\r\n        case 'nom':\r\n          return \"Entrez votre nom\"\r\n        case 'ville':\r\n          return \"Entrez votre ville\"\r\n        default:\r\n          return \"\"\r\n      }\r\n    }\r\n\r\n    return {\r\n      user: getUserData,\r\n      form,\r\n      loading,\r\n      error,\r\n      editingField,\r\n      formatDate,\r\n      startEditing,\r\n      cancelEdit,\r\n      saveField,\r\n      getFieldLabel,\r\n      getEditingField,\r\n      getFieldPlaceholder\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.bg-gray-50 {\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.bg-gray-50:hover {\r\n  background-color: #f8fafc;\r\n}\r\n\r\nbutton {\r\n  transition: all 0.2s ease;\r\n}\r\n\r\nbutton:hover {\r\n  transform: translateY(-1px);\r\n}\r\n\r\ninput {\r\n  transition: all 0.2s ease;\r\n}\r\n\r\ninput:focus {\r\n  transform: translateY(-1px);