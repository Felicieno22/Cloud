{"ast":null,"code":"import { ref, onMounted, onUnmounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { socket } from '@/socket';\nexport default {\n  name: 'Trade',\n  setup() {\n    const route = useRoute();\n    const router = useRouter();\n    const cryptoSymbol = route.params.symbol?.toUpperCase();\n    const cryptoData = ref(null);\n    const operationType = ref('buy');\n    const amount = ref(0);\n    const isLoading = ref(true);\n\n    // Chargement initial des données\n    const loadInitialData = async () => {\n      try {\n        const response = await fetch(`http://localhost:3000/api/cryptocurrencies/${cryptoSymbol}`);\n        if (!response.ok) throw new Error('Erreur lors du chargement des données');\n        const data = await response.json();\n        cryptoData.value = data;\n      } catch (error) {\n        console.error('Erreur:', error);\n        alert('Erreur lors du chargement des données');\n      } finally {\n        isLoading.value = false;\n      }\n    };\n\n    // Formatage des prix\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const formatPriceChange = change => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion du trading\n    const handleTrade = async () => {\n      try {\n        if (!amount.value || amount.value <= 0) {\n          alert('Veuillez entrer un montant valide');\n          return;\n        }\n        const totalPrice = amount.value * cryptoData.value.price;\n        socket.emit('tradeCrypto', {\n          type: operationType.value,\n          symbol: cryptoSymbol,\n          amount: parseFloat(amount.value),\n          price: cryptoData.value.price\n        });\n        amount.value = 0;\n      } catch (error) {\n        console.error('Erreur lors de la transaction:', error);\n        alert(error.message || 'Erreur lors de la transaction');\n      }\n    };\n    onMounted(() => {\n      if (!cryptoSymbol) {\n        router.push('/dashboard');\n        return;\n      }\n\n      // Charger les données initiales\n      loadInitialData();\n      socket.connect();\n\n      // Authentifier le socket avec le token\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken') || localStorage.getItem('access_token');\n      if (token) {\n        socket.emit('authenticate', token);\n      } else {\n        console.error('Aucun token trouvé dans le localStorage');\n        alert('Erreur d\\'authentification: veuillez vous reconnecter');\n        router.push('/login');\n        return;\n      }\n\n      // Écouter les mises à jour\n      socket.on('authenticated', () => {\n        console.log('Socket authentifié avec succès');\n      });\n      socket.on('error', error => {\n        console.error('Erreur socket:', error);\n        if (error.message.includes('authentification')) {\n          alert('Erreur d\\'authentification: veuillez vous reconnecter');\n          router.push('/login');\n        } else {\n          alert(error.message || 'Erreur de connexion au serveur');\n        }\n      });\n\n      // Écouter les mises à jour des prix\n      socket.on('priceUpdate', data => {\n        const crypto = data.find(c => c.symbol === cryptoSymbol);\n        if (crypto) {\n          cryptoData.value = crypto;\n        }\n      });\n\n      // Écouter les réponses de trading\n      socket.on('tradeResponse', response => {\n        if (response.success) {\n          alert(response.message);\n        } else {\n          alert(response.message || 'Erreur lors de la transaction');\n        }\n      });\n    });\n    onUnmounted(() => {\n      socket.off('tradeResponse');\n      socket.off('priceUpdate');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.disconnect();\n    });\n    return {\n      cryptoSymbol,\n      cryptoData,\n      operationType,\n      amount,\n      isLoading,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      handleTrade\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","useRoute","useRouter","socket","name","setup","route","router","cryptoSymbol","params","symbol","toUpperCase","cryptoData","operationType","amount","isLoading","loadInitialData","response","fetch","ok","Error","data","json","value","error","console","alert","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatPriceChange","change","toFixed","getPriceChangeClass","priceChange","handleTrade","totalPrice","emit","type","parseFloat","message","push","connect","token","localStorage","getItem","on","log","includes","crypto","find","c","success","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\Trade.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"max-w-3xl mx-auto\">\n      <div class=\"mb-8\">\n        <button @click=\"$router.back()\" class=\"text-indigo-600 hover:text-indigo-800\">\n          ← Retour\n        </button>\n        <h1 class=\"text-3xl font-bold text-gray-900 mt-4\">\n          Trader {{ cryptoData?.name || cryptoSymbol }}\n        </h1>\n      </div>\n\n      <!-- État de chargement -->\n      <div v-if=\"isLoading\" class=\"bg-white rounded-lg shadow-lg p-6 flex items-center justify-center min-h-[300px]\">\n        <div class=\"animate-pulse flex flex-col items-center\">\n          <div class=\"h-8 w-8 mb-4\">\n            <svg class=\"animate-spin h-8 w-8 text-indigo-600\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n              <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n              <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n            </svg>\n          </div>\n          <p class=\"text-gray-600\">Chargement des données...</p>\n        </div>\n      </div>\n\n      <!-- Contenu principal -->\n      <div v-else class=\"bg-white rounded-lg shadow-lg p-6\">\n        <!-- Prix actuel -->\n        <div class=\"mb-8\">\n          <h2 class=\"text-lg text-gray-600\">Prix actuel</h2>\n          <div class=\"text-4xl font-bold text-gray-900\">\n            {{ formatPrice(cryptoData?.price) }}\n          </div>\n          <div :class=\"getPriceChangeClass()\" class=\"mt-2 text-sm font-medium\">\n            {{ formatPriceChange(cryptoData?.priceChange) }}% sur 24h\n          </div>\n        </div>\n\n        <!-- Formulaire de trading -->\n        <form @submit.prevent=\"handleTrade\">\n          <div class=\"space-y-6\">\n            <!-- Type d'opération -->\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700\">Type d'opération</label>\n              <div class=\"mt-2 grid grid-cols-2 gap-4\">\n                <button\n                  type=\"button\"\n                  :class=\"[\n                    'px-4 py-2 rounded-md text-sm font-medium w-full',\n                    operationType === 'buy'\n                      ? 'bg-green-600 text-white'\n                      : 'bg-gray-100 text-gray-900 hover:bg-gray-200'\n                  ]\"\n                  @click=\"operationType = 'buy'\"\n                >\n                  Acheter\n                </button>\n                <button\n                  type=\"button\"\n                  :class=\"[\n                    'px-4 py-2 rounded-md text-sm font-medium w-full',\n                    operationType === 'sell'\n                      ? 'bg-red-600 text-white'\n                      : 'bg-gray-100 text-gray-900 hover:bg-gray-200'\n                  ]\"\n                  @click=\"operationType = 'sell'\"\n                >\n                  Vendre\n                </button>\n              </div>\n            </div>\n\n            <!-- Montant -->\n            <div>\n              <label for=\"amount\" class=\"block text-sm font-medium text-gray-700\">\n                Montant ({{ cryptoSymbol }})\n              </label>\n              <div class=\"mt-2\">\n                <input\n                  type=\"number\"\n                  id=\"amount\"\n                  v-model=\"amount\"\n                  step=\"0.000001\"\n                  min=\"0\"\n                  class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm\"\n                  required\n                />\n              </div>\n              <p class=\"mt-2 text-sm text-gray-500\">\n                ≈ {{ formatPrice(amount * (cryptoData?.price || 0)) }}\n              </p>\n            </div>\n\n            <!-- Bouton de soumission -->\n            <div>\n              <button\n                type=\"submit\"\n                :class=\"[\n                  'w-full rounded-md px-4 py-2 text-sm font-medium text-white',\n                  operationType === 'buy'\n                    ? 'bg-green-600 hover:bg-green-700'\n                    : 'bg-red-600 hover:bg-red-700'\n                ]\"\n              >\n                {{ operationType === 'buy' ? 'Acheter' : 'Vendre' }}\n                {{ cryptoSymbol }}\n              </button>\n            </div>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { socket } from '@/socket';\n\nexport default {\n  name: 'Trade',\n\n  setup() {\n    const route = useRoute();\n    const router = useRouter();\n    const cryptoSymbol = route.params.symbol?.toUpperCase();\n    const cryptoData = ref(null);\n    const operationType = ref('buy');\n    const amount = ref(0);\n    const isLoading = ref(true);\n\n    // Chargement initial des données\n    const loadInitialData = async () => {\n      try {\n        const response = await fetch(`http://localhost:3000/api/cryptocurrencies/${cryptoSymbol}`);\n        if (!response.ok) throw new Error('Erreur lors du chargement des données');\n        const data = await response.json();\n        cryptoData.value = data;\n      } catch (error) {\n        console.error('Erreur:', error);\n        alert('Erreur lors du chargement des données');\n      } finally {\n        isLoading.value = false;\n      }\n    };\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const formatPriceChange = (change) => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion du trading\n    const handleTrade = async () => {\n      try {\n        if (!amount.value || amount.value <= 0) {\n          alert('Veuillez entrer un montant valide');\n          return;\n        }\n\n        const totalPrice = amount.value * cryptoData.value.price;\n\n        socket.emit('tradeCrypto', {\n          type: operationType.value,\n          symbol: cryptoSymbol,\n          amount: parseFloat(amount.value),\n          price: cryptoData.value.price\n        });\n\n        amount.value = 0;\n      } catch (error) {\n        console.error('Erreur lors de la transaction:', error);\n        alert(error.message || 'Erreur lors de la transaction');\n      }\n    };\n\n    onMounted(() => {\n      if (!cryptoSymbol) {\n        router.push('/dashboard');\n        return;\n      }\n      \n      // Charger les données initiales\n      loadInitialData();\n      \n      socket.connect();\n\n      // Authentifier le socket avec le token\n      const token = localStorage.getItem('token') || localStorage.getItem('sessionToken') || localStorage.getItem('access_token');\n      \n      if (token) {\n        socket.emit('authenticate', token);\n      } else {\n        console.error('Aucun token trouvé dans le localStorage');\n        alert('Erreur d\\'authentification: veuillez vous reconnecter');\n        router.push('/login');\n        return;\n      }\n\n      // Écouter les mises à jour\n      socket.on('authenticated', () => {\n        console.log('Socket authentifié avec succès');\n      });\n\n      socket.on('error', (error) => {\n        console.error('Erreur socket:', error);\n        if (error.message.includes('authentification')) {\n          alert('Erreur d\\'authentification: veuillez vous reconnecter');\n          router.push('/login');\n        } else {\n          alert(error.message || 'Erreur de connexion au serveur');\n        }\n      });\n\n      // Écouter les mises à jour des prix\n      socket.on('priceUpdate', (data) => {\n        const crypto = data.find(c => c.symbol === cryptoSymbol);\n        if (crypto) {\n          cryptoData.value = crypto;\n        }\n      });\n\n      // Écouter les réponses de trading\n      socket.on('tradeResponse', (response) => {\n        if (response.success) {\n          alert(response.message);\n        } else {\n          alert(response.message || 'Erreur lors de la transaction');\n        }\n      });\n    });\n\n    onUnmounted(() => {\n      socket.off('tradeResponse');\n      socket.off('priceUpdate');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.disconnect();\n    });\n\n    return {\n      cryptoSymbol,\n      cryptoData,\n      operationType,\n      amount,\n      isLoading,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass,\n      handleTrade\n    };\n  }\n};\n</script>\n"],"mappings":"AAoHA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AACjD,SAASC,QAAQ,EAAEC,SAAQ,QAAS,YAAY;AAChD,SAASC,MAAK,QAAS,UAAU;AAEjC,eAAe;EACbC,IAAI,EAAE,OAAO;EAEbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC,CAAC;IACxB,MAAMM,MAAK,GAAIL,SAAS,CAAC,CAAC;IAC1B,MAAMM,YAAW,GAAIF,KAAK,CAACG,MAAM,CAACC,MAAM,EAAEC,WAAW,CAAC,CAAC;IACvD,MAAMC,UAAS,GAAId,GAAG,CAAC,IAAI,CAAC;IAC5B,MAAMe,aAAY,GAAIf,GAAG,CAAC,KAAK,CAAC;IAChC,MAAMgB,MAAK,GAAIhB,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMiB,SAAQ,GAAIjB,GAAG,CAAC,IAAI,CAAC;;IAE3B;IACA,MAAMkB,eAAc,GAAI,MAAAA,CAAA,KAAY;MAClC,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAAC,8CAA8CV,YAAY,EAAE,CAAC;QAC1F,IAAI,CAACS,QAAQ,CAACE,EAAE,EAAE,MAAM,IAAIC,KAAK,CAAC,uCAAuC,CAAC;QAC1E,MAAMC,IAAG,GAAI,MAAMJ,QAAQ,CAACK,IAAI,CAAC,CAAC;QAClCV,UAAU,CAACW,KAAI,GAAIF,IAAI;MACzB,EAAE,OAAOG,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,SAAS,EAAEA,KAAK,CAAC;QAC/BE,KAAK,CAAC,uCAAuC,CAAC;MAChD,UAAU;QACRX,SAAS,CAACQ,KAAI,GAAI,KAAK;MACzB;IACF,CAAC;;IAED;IACA,MAAMI,WAAU,GAAKC,KAAK,IAAK;MAC7B,IAAI,OAAOA,KAAI,KAAM,QAAQ,EAAE,OAAO,OAAO;MAC7C,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE,KAAK;QACfC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACP,KAAK,CAAC;IAClB,CAAC;IAED,MAAMQ,iBAAgB,GAAKC,MAAM,IAAK;MACpC,IAAI,OAAOA,MAAK,KAAM,QAAQ,EAAE,OAAO,MAAM;MAC7C,OAAOA,MAAM,CAACC,OAAO,CAAC,CAAC,CAAC;IAC1B,CAAC;IAED,MAAMC,mBAAkB,GAAIA,CAAA,KAAM;MAChC,IAAI,CAAC3B,UAAU,CAACW,KAAK,EAAE,OAAO,eAAe;MAC7C,OAAO;QACL,gBAAgB,EAAEX,UAAU,CAACW,KAAK,CAACiB,WAAU,GAAI,CAAC;QAClD,cAAc,EAAE5B,UAAU,CAACW,KAAK,CAACiB,WAAU,GAAI,CAAC;QAChD,eAAe,EAAE5B,UAAU,CAACW,KAAK,CAACiB,WAAU,KAAM;MACpD,CAAC;IACH,CAAC;;IAED;IACA,MAAMC,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC9B,IAAI;QACF,IAAI,CAAC3B,MAAM,CAACS,KAAI,IAAKT,MAAM,CAACS,KAAI,IAAK,CAAC,EAAE;UACtCG,KAAK,CAAC,mCAAmC,CAAC;UAC1C;QACF;QAEA,MAAMgB,UAAS,GAAI5B,MAAM,CAACS,KAAI,GAAIX,UAAU,CAACW,KAAK,CAACK,KAAK;QAExDzB,MAAM,CAACwC,IAAI,CAAC,aAAa,EAAE;UACzBC,IAAI,EAAE/B,aAAa,CAACU,KAAK;UACzBb,MAAM,EAAEF,YAAY;UACpBM,MAAM,EAAE+B,UAAU,CAAC/B,MAAM,CAACS,KAAK,CAAC;UAChCK,KAAK,EAAEhB,UAAU,CAACW,KAAK,CAACK;QAC1B,CAAC,CAAC;QAEFd,MAAM,CAACS,KAAI,GAAI,CAAC;MAClB,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,gCAAgC,EAAEA,KAAK,CAAC;QACtDE,KAAK,CAACF,KAAK,CAACsB,OAAM,IAAK,+BAA+B,CAAC;MACzD;IACF,CAAC;IAED/C,SAAS,CAAC,MAAM;MACd,IAAI,CAACS,YAAY,EAAE;QACjBD,MAAM,CAACwC,IAAI,CAAC,YAAY,CAAC;QACzB;MACF;;MAEA;MACA/B,eAAe,CAAC,CAAC;MAEjBb,MAAM,CAAC6C,OAAO,CAAC,CAAC;;MAEhB;MACA,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,KAAKD,YAAY,CAACC,OAAO,CAAC,cAAc,KAAKD,YAAY,CAACC,OAAO,CAAC,cAAc,CAAC;MAE3H,IAAIF,KAAK,EAAE;QACT9C,MAAM,CAACwC,IAAI,CAAC,cAAc,EAAEM,KAAK,CAAC;MACpC,OAAO;QACLxB,OAAO,CAACD,KAAK,CAAC,yCAAyC,CAAC;QACxDE,KAAK,CAAC,uDAAuD,CAAC;QAC9DnB,MAAM,CAACwC,IAAI,CAAC,QAAQ,CAAC;QACrB;MACF;;MAEA;MACA5C,MAAM,CAACiD,EAAE,CAAC,eAAe,EAAE,MAAM;QAC/B3B,OAAO,CAAC4B,GAAG,CAAC,gCAAgC,CAAC;MAC/C,CAAC,CAAC;MAEFlD,MAAM,CAACiD,EAAE,CAAC,OAAO,EAAG5B,KAAK,IAAK;QAC5BC,OAAO,CAACD,KAAK,CAAC,gBAAgB,EAAEA,KAAK,CAAC;QACtC,IAAIA,KAAK,CAACsB,OAAO,CAACQ,QAAQ,CAAC,kBAAkB,CAAC,EAAE;UAC9C5B,KAAK,CAAC,uDAAuD,CAAC;UAC9DnB,MAAM,CAACwC,IAAI,CAAC,QAAQ,CAAC;QACvB,OAAO;UACLrB,KAAK,CAACF,KAAK,CAACsB,OAAM,IAAK,gCAAgC,CAAC;QAC1D;MACF,CAAC,CAAC;;MAEF;MACA3C,MAAM,CAACiD,EAAE,CAAC,aAAa,EAAG/B,IAAI,IAAK;QACjC,MAAMkC,MAAK,GAAIlC,IAAI,CAACmC,IAAI,CAACC,CAAA,IAAKA,CAAC,CAAC/C,MAAK,KAAMF,YAAY,CAAC;QACxD,IAAI+C,MAAM,EAAE;UACV3C,UAAU,CAACW,KAAI,GAAIgC,MAAM;QAC3B;MACF,CAAC,CAAC;;MAEF;MACApD,MAAM,CAACiD,EAAE,CAAC,eAAe,EAAGnC,QAAQ,IAAK;QACvC,IAAIA,QAAQ,CAACyC,OAAO,EAAE;UACpBhC,KAAK,CAACT,QAAQ,CAAC6B,OAAO,CAAC;QACzB,OAAO;UACLpB,KAAK,CAACT,QAAQ,CAAC6B,OAAM,IAAK,+BAA+B,CAAC;QAC5D;MACF,CAAC,CAAC;IACJ,CAAC,CAAC;IAEF9C,WAAW,CAAC,MAAM;MAChBG,MAAM,CAACwD,GAAG,CAAC,eAAe,CAAC;MAC3BxD,MAAM,CAACwD,GAAG,CAAC,aAAa,CAAC;MACzBxD,MAAM,CAACwD,GAAG,CAAC,eAAe,CAAC;MAC3BxD,MAAM,CAACwD,GAAG,CAAC,OAAO,CAAC;MACnBxD,MAAM,CAACyD,UAAU,CAAC,CAAC;IACrB,CAAC,CAAC;IAEF,OAAO;MACLpD,YAAY;MACZI,UAAU;MACVC,aAAa;MACbC,MAAM;MACNC,SAAS;MACTY,WAAW;MACXS,iBAAiB;MACjBG,mBAAmB;MACnBE;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}