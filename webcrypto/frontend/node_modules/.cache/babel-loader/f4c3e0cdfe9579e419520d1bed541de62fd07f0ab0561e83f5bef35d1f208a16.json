\t\t</div>\r\n\t\t</div>\r\n\r\n\t\t<div v-if=\"positions.length\" class=\"positions\">\r\n\t\t\t<h2>Positions</h2>\r\n\t\t\t<ul>\r\n\t\t\t\t<li v-for=\"position in positions\" :key=\"position.id\">\r\n\t\t\t\t\t{{ position.asset }}: {{ position.amount }}\r\n\t\t\t\t</li>\r\n\t\t\t</ul>\r\n\t\t</div>\r\n\t\t<div v-if=\"transactions.length\" class=\"transactions\">\r\n\t\t\t<h2>Recent Transactions</h2>\r\n\t\t\t<ul>\r\n\t\t\t\t<li v-for=\"tx in transactions\" :key=\"tx.id\">\r\n\t\t\t\t\t{{ tx.type }}: {{ tx.amount }}\r\n\t\t\t\t</li>\r\n\t\t\t</ul>\r\n\t\t</div>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted } from 'vue';\r\nimport { socket } from '@/socket';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport api from '@/api';\r\n\r\nexport default {\r\n\tname: 'Wallet',\r\n\tsetup() {\r\n\t\tconst store = useStore();\r\n\t\tconst router = useRouter();\r\n\t\tconst wallet = ref(null);\r\n\t\tconst positions = ref([]);\r\n\t\tconst transactions = ref([]);\r\n\t\tconst depositAmount = ref('');\r\n\t\tconst withdrawalAmount = ref('');\r\n\r\n\t\tconst fetchWallet = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tconst response = await api.get('/wallet');\r\n\t\t\t\twallet.value = response.data;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error fetching wallet:', error);\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst fetchPositions = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tconst response = await api.get('/wallet/positions');\r\n\t\t\t\tpositions.value = response.data;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error fetching positions:', error);\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst fetchTransactions = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tconst response = await api.get('/wallet/transactions');\r\n\t\t\t\ttransactions.value = response.data;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error fetching transactions:', error);\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst requestDeposit = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tawait api.post('/wallet/deposit-request', {\r\n\t\t\t\t\tamount: parseFloat(depositAmount.value)\r\n\t\t\t\t});\r\n\t\t\t\talert('Deposit request sent to admin for approval');\r\n\t\t\t\tdepositAmount.value = '';\r\n\t\t\t\tawait fetchWallet();\r\n\t\t\t\tawait fetchTransactions();\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error requesting deposit:', error);\r\n\t\t\t\talert('Failed to send deposit request');\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\tconst requestWithdrawal = async () => {\r\n\t\t\ttry {\r\n\t\t\t\tawait api.post('/wallet/withdrawal-request', {\r\n\t\t\t\t\tamount: parseFloat(withdrawalAmount.value)\r\n\t\t\t\t});\r\n\t\t\t\talert('Withdrawal request sent to admin for approval');\r\n\t\t\t\twithdrawalAmount.value = '';\r\n\t\t\t\tawait fetchWallet();\r\n\t\t\t\tawait fetchTransactions();\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error requesting withdrawal:', error);\r\n\t\t\t\talert('Failed to send withdrawal request');\r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\t// Socket event handlers\r\n\t\tsocket.on('connect', () => {\r\n\t\t\tconsole.log('Socket connected, fetching data...');\r\n\t\t\tfetchWallet();\r\n\t\t\tfetchPositions();\r\n\t\t\tfetchTransactions();\r\n\t\t});\r\n\r\n\t\tsocket.on('connect_error', (error) => {\r\n\t\t\tconsole.error('Socket connection error:', error);\r\n\t\t\tif (error.message === 'Authentication error') {\r\n\t\t\t\trouter.push('/login');\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\t// Socket data update handlers\r\n\t\tsocket.on('walletUpdate', (data) => {\r\n\t\t\twallet.value = data;\r\n\t\t});\r\n\r\n\t\tsocket.on('positionsUpdate', (data) => {\r\n\t\t\tpositions.value = data;\r\n\t\t});\r\n\r\n\t\tsocket.on('transactionsUpdate', (data) => {\r\n\t\t\ttransactions.value = data;\r\n\t\t});\r\n\r\n\t\tonMounted(() => {\r\n\t\t\tsocket.connect();\r\n\t\t\tfetchWallet();\r\n\t\t\tfetchPositions();\r\n\t\t\tfetchTransactions();\r\n\t\t});\r\n\r\n\t\tonUnmounted(() => {\r\n\t\t\tsocket.disconnect();\r\n\t\t});\r\n\r\n\t\treturn {\r\n\t\t\twallet,\r\n\t\t\tpositions,\r\n\t\t\ttransactions,\r\n\t\t\tdepositAmount,\r\n\t\t\twithdrawalAmount,\r\n\t\t\trequestDeposit,\r\n\t\t\trequestWithdrawal\r\n\t\t};\r\n\t}\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.wallet {\r\n\tpadding: 20px;\r\n}\r\n\r\n.wallet-info {\r\n\tmargin: 20px 0;\r\n\tpadding: 15px;\r\n\tborder: 1px solid #ddd;\r\n\tborder-radius: 4px;\r\n}\r\n\r\n.transaction-forms {\r\n\tdisplay: flex;\r\n\tgap: 20px;\r\n\tmargin: 20px 0;\r\n}\r\n\r\n.deposit-form, .withdrawal-form {\r\n\tflex: 1;\r\n\tpadding: 15px;\r\n\tborder: 1px solid #ddd;\r\n\tborder-radius: 4px;\r\n}\r\n\r\nform {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\tgap: 10px;\r\n}\r\n\r\ninput {\r\n\tpadding: 8px;\r\n\tborder: 1px solid #ddd;\r\n\tborder-radius: 4px;\r\n}\r\n\r\nbutton {\r\n\tpadding: 8px;\r\n\tbackground-color: #4CAF50;\r\n\tcolor: white;\r\n\tborder: none;\r\n\tborder-radius: 4px;\r\n\tcursor: pointer;\r\n}\r\n\r\nbutton:hover {\r\n\tbackground-color: #45a049;\r\n}\r\n\r\n.positions, .transactions {\r\n\tmargin-top: 20px;\r\n}\r\n\r\nul {\r\n\tlist-style: none;\r\n\tpadding: 0;\r\n}\r\n\r\nli {\r\n\tpadding: 10px;\r\n\tborder-bottom: 1px solid #eee;\r\n}\r\n\r\nli:last-child {\r\n\tborder-bottom: none;\r\n}\r\n</style>"],"mappings":";;EACMA,KAAK,EAAC;AAAQ;;EADpBC,GAAA;EAGqBD,KAAK,EAAC;;;EACnBA,KAAK,EAAC;AAAS;;EAKhBA,KAAK,EAAC;AAAmB;;EACxBA,KAAK,EAAC;AAAc;;EAepBA,KAAK,EAAC;AAAiB;;EAzB/BC,GAAA;EAyC+BD,KAAK,EAAC;;;EAzCrCC,GAAA;EAiDkCD,KAAK,EAAC;;;uBAhDvCE,mBAAA,CAwDM,OAxDNC,UAwDM,G,4BAvDLC,mBAAA,CAAe,YAAX,QAAM,sBACCC,MAAA,CAAAC,MAAM,I,cAAjBJ,mBAAA,CAIM,OAJNK,UAIM,GAHLH,mBAAA,CAEM,OAFNI,UAEM,EAFe,YACX,GAAAC,gBAAA,CAAGJ,MAAA,CAAAC,MAAM,CAACI,OAAO,iB,KAL9BC,mBAAA,gBASEP,mBAAA,CA8BM,OA9BNQ,UA8BM,GA7BLR,mBAAA,CAaM,OAbNS,UAaM,G,0BAZLT,mBAAA,CAAwB,YAApB,iBAAe,sBACnBA,mBAAA,CAUO;IAVAU,QAAM,EAAAC,MAAA,QAAAA,MAAA,MAZjBC,cAAA,KAAAC,IAAA,KAY2BZ,MAAA,CAAAa,cAAA,IAAAb,MAAA,CAAAa,cAAA,IAAAD,IAAA,CAAc;sBACpCb,mBAAA,CAOE;IANDe,IAAI,EAAC,Q