{"ast":null,"code":"import { ref } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRoute, useRouter } from 'vue-router';\nexport default {\n  setup() {\n    const store = useStore();\n    const route = useRoute();\n    const router = useRouter();\n    const verificationCode = ref('');\n    const confirmWithdrawal = async () => {\n      try {\n        const result = await store.dispatch('wallet/confirmWithdrawal', {\n          transactionId: route.query.transactionId,\n          code: verificationCode.value\n        });\n        if (result.success) {\n          alert(result.message);\n          router.push('/wallet');\n        }\n      } catch (error) {\n        alert(error.message || 'Erreur lors de la confirmation');\n      }\n    };\n    return {\n      verificationCode,\n      confirmWithdrawal\n    };\n  }\n};","map":{"version":3,"names":["ref","useStore","useRoute","useRouter","setup","store","route","router","verificationCode","confirmWithdrawal","result","dispatch","transactionId","query","code","value","success","alert","message","push","error"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\VerifyWithdrawal.vue"],"sourcesContent":["<template>\r\n  <div class=\"verify-withdrawal\">\r\n    <h2>Vérification du retrait</h2>\r\n    <div class=\"verification-form\">\r\n      <p>Un code de vérification a été envoyé à votre adresse email.</p>\r\n      <div class=\"form-group\">\r\n        <label>Code de vérification</label>\r\n        <input \r\n          v-model=\"verificationCode\" \r\n          type=\"text\" \r\n          class=\"form-control\" \r\n          placeholder=\"Entrez le code\"\r\n        >\r\n      </div>\r\n      <button \r\n        @click=\"confirmWithdrawal\" \r\n        class=\"btn btn-primary\"\r\n      >\r\n        Confirmer le retrait\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRoute, useRouter } from 'vue-router';\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore();\r\n    const route = useRoute();\r\n    const router = useRouter();\r\n    const verificationCode = ref('');\r\n\r\n    const confirmWithdrawal = async () => {\r\n      try {\r\n        const result = await store.dispatch('wallet/confirmWithdrawal', {\r\n          transactionId: route.query.transactionId,\r\n          code: verificationCode.value\r\n        });\r\n        \r\n        if (result.success) {\r\n          alert(result.message);\r\n          router.push('/wallet');\r\n        }\r\n      } catch (error) {\r\n        alert(error.message || 'Erreur lors de la confirmation');\r\n      }\r\n    };\r\n\r\n    return {\r\n      verificationCode,\r\n      confirmWithdrawal\r\n    };\r\n  }\r\n};\r\n</script> "],"mappings":"AAyBA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAQ,QAAS,YAAY;AAEhD,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC,CAAC;IACxB,MAAMK,KAAI,GAAIJ,QAAQ,CAAC,CAAC;IACxB,MAAMK,MAAK,GAAIJ,SAAS,CAAC,CAAC;IAC1B,MAAMK,gBAAe,GAAIR,GAAG,CAAC,EAAE,CAAC;IAEhC,MAAMS,iBAAgB,GAAI,MAAAA,CAAA,KAAY;MACpC,IAAI;QACF,MAAMC,MAAK,GAAI,MAAML,KAAK,CAACM,QAAQ,CAAC,0BAA0B,EAAE;UAC9DC,aAAa,EAAEN,KAAK,CAACO,KAAK,CAACD,aAAa;UACxCE,IAAI,EAAEN,gBAAgB,CAACO;QACzB,CAAC,CAAC;QAEF,IAAIL,MAAM,CAACM,OAAO,EAAE;UAClBC,KAAK,CAACP,MAAM,CAACQ,OAAO,CAAC;UACrBX,MAAM,CAACY,IAAI,CAAC,SAAS,CAAC;QACxB;MACF,EAAE,OAAOC,KAAK,EAAE;QACdH,KAAK,CAACG,KAAK,CAACF,OAAM,IAAK,gCAAgC,CAAC;MAC1D;IACF,CAAC;IAED,OAAO;MACLV,gBAAgB;MAChBC;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}