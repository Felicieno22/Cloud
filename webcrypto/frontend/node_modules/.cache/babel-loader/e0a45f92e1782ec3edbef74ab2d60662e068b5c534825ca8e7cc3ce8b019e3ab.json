{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'Navbar',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const mobileMenuOpen = ref(false);\n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated']);\n    const user = computed(() => store.getters['auth/user']);\n    const handleLogout = async () => {\n      try {\n        await store.dispatch('auth/logout');\n        router.push('/login');\n      } catch (error) {\n        console.error('Erreur lors de la déconnexion:', error);\n      }\n    };\n    return {\n      mobileMenuOpen,\n      isAuthenticated,\n      user,\n      handleLogout\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRouter","name","setup","store","router","mobileMenuOpen","isAuthenticated","getters","user","handleLogout","dispatch","push","error","console"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\components\\Navbar.vue"],"sourcesContent":["<template>\n  <nav class=\"bg-gray-800\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"flex items-center justify-between h-16\">\n        <!-- Logo et liens de navigation -->\n        <div class=\"flex items-center\">\n          <div class=\"flex-shrink-0\">\n            <router-link to=\"/\" class=\"text-white font-bold text-xl\">IDENTITER</router-link>\n          </div>\n          <div class=\"hidden md:block\">\n            <div class=\"ml-10 flex items-baseline space-x-4\">\n              <router-link\n                to=\"/\"\n                class=\"text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium\"\n                active-class=\"bg-gray-900 text-white\"\n              >\n                Accueil\n              </router-link>\n              <router-link\n                v-if=\"isAuthenticated\"\n                to=\"/dashboard\"\n                class=\"text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium\"\n                active-class=\"bg-gray-900 text-white\"\n              >\n                Dashboard\n              </router-link>\n              <router-link\n                v-if=\"isAuthenticated\"\n                to=\"/profile\"\n                class=\"text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium\"\n                active-class=\"bg-gray-900 text-white\"\n              >\n                Profil\n              </router-link>\n            </div>\n          </div>\n        </div>\n\n        <!-- Boutons de connexion/inscription ou profil utilisateur -->\n        <div class=\"hidden md:block\">\n          <div class=\"ml-4 flex items-center md:ml-6\">\n            <!-- Afficher ces liens si non connecté -->\n            <template v-if=\"!isAuthenticated\">\n              <router-link\n                to=\"/login\"\n                class=\"text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium\"\n              >\n                Connexion\n              </router-link>\n              <router-link\n                to=\"/register\"\n                class=\"bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-md text-sm font-medium ml-2\"\n              >\n                Inscription\n              </router-link>\n            </template>\n\n            <!-- Menu utilisateur si connecté -->\n            <div v-else class=\"ml-3 relative\">\n              <div class=\"flex items-center\">\n                <!-- Username avec badge -->\n                <div class=\"flex items-center bg-gray-900 text-white px-4 py-2 rounded-md mr-2\">\n                  <svg class=\"h-5 w-5 text-indigo-400 mr-2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                    <path fill-rule=\"evenodd\" d=\"M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z\" clip-rule=\"evenodd\" />\n                  </svg>\n                  <span class=\"text-sm font-medium\">{{ user.username || user.prenom }}</span>\n                </div>\n\n                <!-- Bouton de déconnexion -->\n                <button\n                  @click=\"handleLogout\"\n                  class=\"bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-md text-sm font-medium flex items-center\"\n                >\n                  <svg class=\"h-4 w-4 mr-1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                    <path fill-rule=\"evenodd\" d=\"M3 3a1 1 0 011 1v12a1 1 0 11-2 0V4a1 1 0 011-1zm7.707 3.293a1 1 0 010 1.414L9.414 9H17a1 1 0 110 2H9.414l1.293 1.293a1 1 0 01-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0z\" clip-rule=\"evenodd\" />\n                  </svg>\n                  Déconnexion\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Bouton menu mobile -->\n        <div class=\"-mr-2 flex md:hidden\">\n          <button\n            @click=\"mobileMenuOpen = !mobileMenuOpen\"\n            class=\"bg-gray-800 inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-white hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-white\"\n          >\n            <svg\n              :class=\"{'hidden': mobileMenuOpen, 'block': !mobileMenuOpen }\"\n              class=\"h-6 w-6\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              fill=\"none\"\n              viewBox=\"0 0 24 24\"\n              stroke=\"currentColor\"\n            >\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\" />\n            </svg>\n            <svg\n              :class=\"{'block': mobileMenuOpen, 'hidden': !mobileMenuOpen }\"\n              class=\"h-6 w-6\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              fill=\"none\"\n              viewBox=\"0 0 24 24\"\n              stroke=\"currentColor\"\n            >\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\" />\n            </svg>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- Menu mobile -->\n    <div :class=\"{'block': mobileMenuOpen, 'hidden': !mobileMenuOpen}\" class=\"md:hidden\">\n      <div class=\"px-2 pt-2 pb-3 space-y-1 sm:px-3\">\n        <router-link\n          to=\"/\"\n          class=\"text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium\"\n          active-class=\"bg-gray-900 text-white\"\n        >\n          Accueil\n        </router-link>\n        <router-link\n          v-if=\"isAuthenticated\"\n          to=\"/dashboard\"\n          class=\"text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium\"\n          active-class=\"bg-gray-900 text-white\"\n        >\n          Dashboard\n        </router-link>\n        <router-link\n          v-if=\"isAuthenticated\"\n          to=\"/profile\"\n          class=\"text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium\"\n          active-class=\"bg-gray-900 text-white\"\n        >\n          Profil\n        </router-link>\n      </div>\n\n      <!-- Actions mobile -->\n      <div class=\"pt-4 pb-3 border-t border-gray-700\">\n        <template v-if=\"!isAuthenticated\">\n          <div class=\"px-2 space-y-1\">\n            <router-link\n              to=\"/login\"\n              class=\"block px-3 py-2 rounded-md text-base font-medium text-gray-400 hover:text-white hover:bg-gray-700\"\n            >\n              Connexion\n            </router-link>\n            <router-link\n              to=\"/register\"\n              class=\"block px-3 py-2 rounded-md text-base font-medium text-gray-400 hover:text-white hover:bg-gray-700\"\n            >\n              Inscription\n            </router-link>\n          </div>\n        </template>\n        <template v-else>\n          <div class=\"flex items-center px-5\">\n            <div class=\"flex-shrink-0\">\n              <svg class=\"h-10 w-10 text-gray-400\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                <path fill-rule=\"evenodd\" d=\"M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z\" clip-rule=\"evenodd\" />\n              </svg>\n            </div>\n            <div class=\"ml-3\">\n              <div class=\"text-base font-medium leading-none text-white\">{{ user.username || user.prenom }}</div>\n              <div class=\"text-sm font-medium leading-none text-gray-400\">{{ user.email }}</div>\n            </div>\n          </div>\n          <div class=\"mt-3 px-2 space-y-1\">\n            <button\n              @click=\"handleLogout\"\n              class=\"block w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-400 hover:text-white hover:bg-gray-700\"\n            >\n              Déconnexion\n            </button>\n          </div>\n        </template>\n      </div>\n    </div>\n  </nav>\n</template>\n\n<script>\nimport { ref, computed } from 'vue'\nimport { useStore } from 'vuex'\nimport { useRouter } from 'vue-router'\n\nexport default {\n  name: 'Navbar',\n  \n  setup() {\n    const store = useStore()\n    const router = useRouter()\n    const mobileMenuOpen = ref(false)\n\n    const isAuthenticated = computed(() => store.getters['auth/isAuthenticated'])\n    const user = computed(() => store.getters['auth/user'])\n\n    const handleLogout = async () => {\n      try {\n        await store.dispatch('auth/logout')\n        router.push('/login')\n      } catch (error) {\n        console.error('Erreur lors de la déconnexion:', error)\n      }\n    }\n\n    return {\n      mobileMenuOpen,\n      isAuthenticated,\n      user,\n      handleLogout\n    }\n  }\n}\n</script>\n"],"mappings":"AA2LA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,QAAQ;EAEdC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,cAAa,GAAIR,GAAG,CAAC,KAAK;IAEhC,MAAMS,eAAc,GAAIR,QAAQ,CAAC,MAAMK,KAAK,CAACI,OAAO,CAAC,sBAAsB,CAAC;IAC5E,MAAMC,IAAG,GAAIV,QAAQ,CAAC,MAAMK,KAAK,CAACI,OAAO,CAAC,WAAW,CAAC;IAEtD,MAAME,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACF,MAAMN,KAAK,CAACO,QAAQ,CAAC,aAAa;QAClCN,MAAM,CAACO,IAAI,CAAC,QAAQ;MACtB,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,gCAAgC,EAAEA,KAAK;MACvD;IACF;IAEA,OAAO;MACLP,cAAc;MACdC,eAAe;MACfE,IAAI;MACJC;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}