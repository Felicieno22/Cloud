{"ast":null,"code":"import { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'AdminLogin',\n  setup() {\n    const router = useRouter();\n    const username = ref('admin');\n    const password = ref('admin123');\n    const handleLogin = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/admin/login', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            username: username.value,\n            password: password.value\n          })\n        });\n        if (!response.ok) {\n          throw new Error('Identifiants invalides');\n        }\n        const data = await response.json();\n        localStorage.setItem('adminToken', data.token);\n        router.push('/admin/dashboard');\n      } catch (error) {\n        alert(error.message);\n      }\n    };\n    return {\n      username,\n      password,\n      handleLogin\n    };\n  }\n};","map":{"version":3,"names":["ref","useRouter","name","setup","router","username","password","handleLogin","response","fetch","method","headers","body","JSON","stringify","value","ok","Error","data","json","localStorage","setItem","token","push","error","alert","message"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\AdminLogin.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen bg-gray-100 flex flex-col justify-center py-12 sm:px-6 lg:px-8\">\n    <div class=\"sm:mx-auto sm:w-full sm:max-w-md\">\n      <h2 class=\"mt-6 text-center text-3xl font-extrabold text-gray-900\">\n        Administration\n      </h2>\n    </div>\n\n    <div class=\"mt-8 sm:mx-auto sm:w-full sm:max-w-md\">\n      <div class=\"bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10\">\n        <form class=\"space-y-6\" @submit.prevent=\"handleLogin\">\n          <div>\n            <label for=\"username\" class=\"block text-sm font-medium text-gray-700\">\n              Nom d'utilisateur\n            </label>\n            <div class=\"mt-1\">\n              <input\n                id=\"username\"\n                v-model=\"username\"\n                type=\"text\"\n                required\n                class=\"appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label for=\"password\" class=\"block text-sm font-medium text-gray-700\">\n              Mot de passe\n            </label>\n            <div class=\"mt-1\">\n              <input\n                id=\"password\"\n                v-model=\"password\"\n                type=\"password\"\n                required\n                class=\"appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <button\n              type=\"submit\"\n              class=\"w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500\"\n            >\n              Se connecter\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\n\nexport default {\n  name: 'AdminLogin',\n  \n  setup() {\n    const router = useRouter();\n    const username = ref('admin');\n    const password = ref('admin123');\n\n    const handleLogin = async () => {\n      try {\n        const response = await fetch('http://localhost:3000/api/admin/login', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json',\n          },\n          body: JSON.stringify({\n            username: username.value,\n            password: password.value,\n          }),\n        });\n\n        if (!response.ok) {\n          throw new Error('Identifiants invalides');\n        }\n\n        const data = await response.json();\n        localStorage.setItem('adminToken', data.token);\n        router.push('/admin/dashboard');\n      } catch (error) {\n        alert(error.message);\n      }\n    };\n\n    return {\n      username,\n      password,\n      handleLogin,\n    };\n  },\n};\n</script>\n"],"mappings":"AAwDA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,SAAQ,QAAS,YAAY;AAEtC,eAAe;EACbC,IAAI,EAAE,YAAY;EAElBC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIH,SAAS,CAAC,CAAC;IAC1B,MAAMI,QAAO,GAAIL,GAAG,CAAC,OAAO,CAAC;IAC7B,MAAMM,QAAO,GAAIN,GAAG,CAAC,UAAU,CAAC;IAEhC,MAAMO,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC9B,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAAC,uCAAuC,EAAE;UACpEC,MAAM,EAAE,MAAM;UACdC,OAAO,EAAE;YACP,cAAc,EAAE;UAClB,CAAC;UACDC,IAAI,EAAEC,IAAI,CAACC,SAAS,CAAC;YACnBT,QAAQ,EAAEA,QAAQ,CAACU,KAAK;YACxBT,QAAQ,EAAEA,QAAQ,CAACS;UACrB,CAAC;QACH,CAAC,CAAC;QAEF,IAAI,CAACP,QAAQ,CAACQ,EAAE,EAAE;UAChB,MAAM,IAAIC,KAAK,CAAC,wBAAwB,CAAC;QAC3C;QAEA,MAAMC,IAAG,GAAI,MAAMV,QAAQ,CAACW,IAAI,CAAC,CAAC;QAClCC,YAAY,CAACC,OAAO,CAAC,YAAY,EAAEH,IAAI,CAACI,KAAK,CAAC;QAC9ClB,MAAM,CAACmB,IAAI,CAAC,kBAAkB,CAAC;MACjC,EAAE,OAAOC,KAAK,EAAE;QACdC,KAAK,CAACD,KAAK,CAACE,OAAO,CAAC;MACtB;IACF,CAAC;IAED,OAAO;MACLrB,QAAQ;MACRC,QAAQ;MACRC;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}