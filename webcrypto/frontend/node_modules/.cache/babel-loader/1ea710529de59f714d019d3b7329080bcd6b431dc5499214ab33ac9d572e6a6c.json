{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nexport default {\n  name: 'Navigation',\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n    const showUserMenu = ref(false);\n    const username = computed(() => store.state.auth.user?.username || '');\n    const isAdmin = computed(() => {\n      const user = store.state.auth.user;\n      return user?.roles?.includes('admin') || false;\n    });\n    const handleLogout = async () => {\n      await store.dispatch('auth/logout');\n      router.push('/login');\n    };\n    return {\n      showUserMenu,\n      username,\n      isAdmin,\n      handleLogout\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useRouter","useStore","name","setup","router","store","showUserMenu","username","state","auth","user","isAdmin","roles","includes","handleLogout","dispatch","push"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\components\\Navigation.vue"],"sourcesContent":["<template>\n  <nav class=\"bg-white shadow\">\n    <div class=\"container mx-auto px-4\">\n      <div class=\"flex justify-between h-16\">\n        <div class=\"flex\">\n          <!-- Logo -->\n          <div class=\"flex-shrink-0 flex items-center\">\n            <router-link to=\"/\" class=\"text-xl font-bold text-indigo-600\">\n              CryptoTrade\n            </router-link>\n          </div>\n\n          <!-- Navigation principale -->\n          <div class=\"hidden sm:ml-6 sm:flex sm:space-x-8\">\n            <router-link\n              to=\"/dashboard\"\n              class=\"inline-flex items-center px-1 pt-1 text-sm font-medium\"\n              :class=\"[$route.path === '/dashboard' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-gray-500 hover:text-gray-700']\"\n            >\n              Tableau de bord\n            </router-link>\n\n            <router-link\n              to=\"/portfolio\"\n              class=\"inline-flex items-center px-1 pt-1 text-sm font-medium\"\n              :class=\"[$route.path === '/portfolio' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-gray-500 hover:text-gray-700']\"\n            >\n              Portefeuille\n            </router-link>\n\n            <!-- Liens admin -->\n            <router-link\n              v-if=\"isAdmin\"\n              to=\"/admin/transactions\"\n              class=\"inline-flex items-center px-1 pt-1 text-sm font-medium\"\n              :class=\"[$route.path === '/admin/transactions' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-gray-500 hover:text-gray-700']\"\n            >\n              Gestion des transactions\n            </router-link>\n          </div>\n        </div>\n\n        <!-- Menu utilisateur -->\n        <div class=\"flex items-center\">\n          <div class=\"relative\">\n            <button\n              @click=\"showUserMenu = !showUserMenu\"\n              class=\"flex items-center space-x-2 text-gray-500 hover:text-gray-700\"\n            >\n              <span>{{ username }}</span>\n              <svg\n                class=\"h-5 w-5\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n                viewBox=\"0 0 20 20\"\n                fill=\"currentColor\"\n              >\n                <path\n                  fill-rule=\"evenodd\"\n                  d=\"M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z\"\n                  clip-rule=\"evenodd\"\n                />\n              </svg>\n            </button>\n\n            <!-- Menu déroulant -->\n            <div\n              v-if=\"showUserMenu\"\n              class=\"absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5\"\n            >\n              <div class=\"py-1\">\n                <router-link\n                  to=\"/profile\"\n                  class=\"block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100\"\n                >\n                  Mon profil\n                </router-link>\n                <button\n                  @click=\"handleLogout\"\n                  class=\"block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100\"\n                >\n                  Déconnexion\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </nav>\n</template>\n\n<script>\nimport { ref, computed } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\n\nexport default {\n  name: 'Navigation',\n\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n    const showUserMenu = ref(false);\n\n    const username = computed(() => store.state.auth.user?.username || '');\n    const isAdmin = computed(() => {\n      const user = store.state.auth.user;\n      return user?.roles?.includes('admin') || false;\n    });\n\n    const handleLogout = async () => {\n      await store.dispatch('auth/logout');\n      router.push('/login');\n    };\n\n    return {\n      showUserMenu,\n      username,\n      isAdmin,\n      handleLogout\n    };\n  }\n};\n</script>\n"],"mappings":"AA4FA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAK;AACnC,SAASC,SAAQ,QAAS,YAAY;AACtC,SAASC,QAAO,QAAS,MAAM;AAE/B,eAAe;EACbC,IAAI,EAAE,YAAY;EAElBC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIJ,SAAS,CAAC,CAAC;IAC1B,MAAMK,KAAI,GAAIJ,QAAQ,CAAC,CAAC;IACxB,MAAMK,YAAW,GAAIR,GAAG,CAAC,KAAK,CAAC;IAE/B,MAAMS,QAAO,GAAIR,QAAQ,CAAC,MAAMM,KAAK,CAACG,KAAK,CAACC,IAAI,CAACC,IAAI,EAAEH,QAAO,IAAK,EAAE,CAAC;IACtE,MAAMI,OAAM,GAAIZ,QAAQ,CAAC,MAAM;MAC7B,MAAMW,IAAG,GAAIL,KAAK,CAACG,KAAK,CAACC,IAAI,CAACC,IAAI;MAClC,OAAOA,IAAI,EAAEE,KAAK,EAAEC,QAAQ,CAAC,OAAO,KAAK,KAAK;IAChD,CAAC,CAAC;IAEF,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,MAAMT,KAAK,CAACU,QAAQ,CAAC,aAAa,CAAC;MACnCX,MAAM,CAACY,IAAI,CAAC,QAAQ,CAAC;IACvB,CAAC;IAED,OAAO;MACLV,YAAY;MACZC,QAAQ;MACRI,OAAO;MACPG;IACF,CAAC;EACH;AACF