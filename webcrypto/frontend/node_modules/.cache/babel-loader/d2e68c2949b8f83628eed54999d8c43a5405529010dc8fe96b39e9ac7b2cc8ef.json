sted_15, [!$setup.editingField[key] ? (_openBlock(), _createElementBlock(\"button\", {\n      key: 0,\n      type: \"button\",\n      onClick: $event => $setup.startEditing(key),\n      class: \"text-indigo-600 hover:text-indigo-800 focus:outline-none\"\n    }, \" Modifier \", 8 /* PROPS */, _hoisted_16)) : (_openBlock(), _createElementBlock(\"div\", _hoisted_17, [_createElementVNode(\"button\", {\n      type: \"button\",\n      onClick: $event => $setup.promptPasswordAndSave(key),\n      class: \"text-green-600 hover:text-green-800 focus:outline-none\"\n    }, \" Sauvegarder \", 8 /* PROPS */, _hoisted_18), _createElementVNode(\"button\", {\n      type: \"button\",\n      onClick: $event => $setup.cancelEditing(key),\n      class: \"text-red-600 hover:text-red-800 focus:outline-none\"\n    }, \" Annuler \", 8 /* PROPS */, _hoisted_19)]))])) : _createCommentVNode(\"v-if\", true)])]);\n  }), 128 /* KEYED_FRAGMENT */))]), _createCommentVNode(\" Message d'erreur \"), $setup.error ? (_openBlock(), _createElementBlock(\"div\", _hoisted_20, [_cache[5] || (_cache[5] = _createElementVNode(\"svg\", {\n    class: \"h-5 w-5 text-red-500\",\n    fill: \"none\",\n    stroke: \"currentColor\",\n    viewBox: \"0 0 24 24\"\n  }, [_createElementVNode(\"path\", {\n    \"stroke-linecap\": \"round\",\n    \"stroke-linejoin\": \"round\",\n    \"stroke-width\": \"2\",\n    d: \"M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"\n  })], -1 /* HOISTED */)), _createElementVNode(\"span\", _hoisted_21, _toDisplayString($setup.error), 1 /* TEXT */)])) : _createCommentVNode(\"v-if\", true), _createCommentVNode(\" Message de succès \"), $setup.successMessage ? (_openBlock(), _createElementBlock(\"div\", _hoisted_22, [_cache[6] || (_cache[6] = _createElementVNode(\"svg\", {\n    class: \"h-5 w-5 text-green-500\",\n    fill: \"none\",\n    stroke: \"currentColor\",\n    viewBox: \"0 0 24 24\"\n  }, [_createElementVNode(\"path\", {\n    \"stroke-linecap\": \"round\",\n    \"stroke-linejoin\": \"round\",\n    \"stroke-width\": \"2\",\n    d: \"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"\n  })], -1 /* HOISTED */)), _createElementVNode(\"span\", _hoisted_23, _toDisplayString($setup.successMessage), 1 /* TEXT */)])) : _createCommentVNode(\"v-if\", true)])])]), _createCommentVNode(\" Modal de mot de passe \"), $setup.showPasswordModal ? (_openBlock(), _createElementBlock(\"div\", _hoisted_24, [_createElementVNode(\"div\", _hoisted_25, [_cache[8] || (_cache[8] = _createElementVNode(\"h3\", {\n    class: \"text-lg font-bold text-gray-900 mb-4\"\n  }, \"Confirmation requise\", -1 /* HOISTED */)), _cache[9] || (_cache[9] = _createElementVNode(\"p\", {\n    class: \"text-sm text-gray-600 mb-4\"\n  }, \" Veuillez entrer votre mot de passe pour confirmer la modification \", -1 /* HOISTED */)), _withDirectives(_createElementVNode(\"input\", {\n    type: \"password\",\n    \"onUpdate:modelValue\": _cache[0] || (_cache[0] = $event => $setup.password = $event),\n    class: \"w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 mb-4\",\n    placeholder: \"Votre mot de passe\",\n    onKeyup: _cache[1] || (_cache[1] = _withKeys((...args) => $setup.confirmPasswordAndSave && $setup.confirmPasswordAndSave(...args), [\"enter\"]))\n  }, null, 544 /* NEED_HYDRATION, NEED_PATCH */), [[_vModelText, $setup.password]]), _createElementVNode(\"div\", _hoisted_26, [_createElementVNode(\"button\", {\n    onClick: _cache[2] || (_cache[2] = (...args) => $setup.cancelPasswordModal && $setup.cancelPasswordModal(...args)),\n    class: \"px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors duration-200\"\n  }, \" Annuler \"), _createElementVNode(\"button\", {\n    onClick: _cache[3] || (_cache[3] = (...args) => $setup.confirmPasswordAndSave && $setup.confirmPasswordAndSave(...args)),\n    class: \"px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-c