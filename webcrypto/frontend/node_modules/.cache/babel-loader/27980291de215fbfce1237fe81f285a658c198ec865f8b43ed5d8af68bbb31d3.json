{"ast":null,"code":"import { ref, onMounted, onUnmounted, computed } from 'vue';\nimport { useRoute } from 'vue-router';\nimport { socket } from '@/socket';\nimport { Chart as ChartJS, CategoryScale, LinearScale, PointElement, LineElement, Title, Tooltip, Legend } from 'chart.js';\nimport { Line } from 'vue-chartjs';\nChartJS.register(CategoryScale, LinearScale, PointElement, LineElement, Title, Tooltip, Legend);\nexport default {\n  name: 'CryptoDetail',\n  components: {\n    Line\n  },\n  setup() {\n    const route = useRoute();\n    const cryptoSymbol = route.params.symbol;\n    const cryptoData = ref(null);\n    const priceHistory = ref([]);\n\n    // Configuration du graphique\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      scales: {\n        y: {\n          beginAtZero: false,\n          ticks: {\n            callback: value => formatPrice(value)\n          }\n        }\n      },\n      plugins: {\n        legend: {\n          display: false\n        },\n        tooltip: {\n          callbacks: {\n            label: context => formatPrice(context.raw)\n          }\n        }\n      }\n    };\n    const chartData = computed(() => ({\n      labels: priceHistory.value.map(item => new Date(item.timestamp).toLocaleTimeString()),\n      datasets: [{\n        label: cryptoSymbol,\n        data: priceHistory.value.map(item => item.price),\n        borderColor: '#4F46E5',\n        tension: 0.1\n      }]\n    }));\n\n    // Formatage des prix\n    const formatPrice = price => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const formatPriceChange = change => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion des mises à jour\n    socket.on('priceUpdate', data => {\n      const crypto = data.find(c => c.symbol === cryptoSymbol);\n      if (crypto) {\n        cryptoData.value = crypto;\n        priceHistory.value.push({\n          price: crypto.price,\n          timestamp: new Date()\n        });\n\n        // Garder seulement les 30 derniers points\n        if (priceHistory.value.length > 30) {\n          priceHistory.value.shift();\n        }\n      }\n    });\n    onMounted(() => {\n      socket.connect();\n    });\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n    return {\n      cryptoSymbol,\n      cryptoData,\n      chartData,\n      chartOptions,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","computed","useRoute","socket","Chart","ChartJS","CategoryScale","LinearScale","PointElement","LineElement","Title","Tooltip","Legend","Line","register","name","components","setup","route","cryptoSymbol","params","symbol","cryptoData","priceHistory","chartOptions","responsive","maintainAspectRatio","scales","y","beginAtZero","ticks","callback","value","formatPrice","plugins","legend","display","tooltip","callbacks","label","context","raw","chartData","labels","map","item","Date","timestamp","toLocaleTimeString","datasets","data","price","borderColor","tension","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","formatPriceChange","change","toFixed","getPriceChangeClass","priceChange","on","crypto","find","c","push","length","shift","connect","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10\\frontend\\src\\views\\CryptoDetail.vue"],"sourcesContent":["<template>\n  <div class=\"container mx-auto px-4 py-8\">\n    <div class=\"mb-8 flex items-center\">\n      <button @click=\"$router.push('/dashboard')\" class=\"mr-4 text-indigo-600 hover:text-indigo-800\">\n        ← Retour\n      </button>\n      <h1 class=\"text-3xl font-bold text-gray-900\">{{ cryptoSymbol }}</h1>\n    </div>\n\n    <div class=\"bg-white rounded-lg shadow-lg p-6\">\n      <div class=\"flex justify-between items-center mb-6\">\n        <div>\n          <h2 class=\"text-2xl font-bold\">{{ cryptoData?.name }}</h2>\n          <p class=\"text-gray-600\">Prix actuel: {{ formatPrice(cryptoData?.price) }}</p>\n        </div>\n        <div :class=\"getPriceChangeClass()\" class=\"text-lg font-semibold\">\n          {{ formatPriceChange(cryptoData?.priceChange) }}%\n        </div>\n      </div>\n\n      <div class=\"h-96\">\n        <Line v-if=\"chartData\" :data=\"chartData\" :options=\"chartOptions\" />\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted, onUnmounted, computed } from 'vue';\nimport { useRoute } from 'vue-router';\nimport { socket } from '@/socket';\nimport {\n  Chart as ChartJS,\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  Title,\n  Tooltip,\n  Legend\n} from 'chart.js';\nimport { Line } from 'vue-chartjs';\n\nChartJS.register(\n  CategoryScale,\n  LinearScale,\n  PointElement,\n  LineElement,\n  Title,\n  Tooltip,\n  Legend\n);\n\nexport default {\n  name: 'CryptoDetail',\n  components: { Line },\n\n  setup() {\n    const route = useRoute();\n    const cryptoSymbol = route.params.symbol;\n    const cryptoData = ref(null);\n    const priceHistory = ref([]);\n\n    // Configuration du graphique\n    const chartOptions = {\n      responsive: true,\n      maintainAspectRatio: false,\n      scales: {\n        y: {\n          beginAtZero: false,\n          ticks: {\n            callback: value => formatPrice(value)\n          }\n        }\n      },\n      plugins: {\n        legend: {\n          display: false\n        },\n        tooltip: {\n          callbacks: {\n            label: (context) => formatPrice(context.raw)\n          }\n        }\n      }\n    };\n\n    const chartData = computed(() => ({\n      labels: priceHistory.value.map(item => \n        new Date(item.timestamp).toLocaleTimeString()\n      ),\n      datasets: [{\n        label: cryptoSymbol,\n        data: priceHistory.value.map(item => item.price),\n        borderColor: '#4F46E5',\n        tension: 0.1\n      }]\n    }));\n\n    // Formatage des prix\n    const formatPrice = (price) => {\n      if (typeof price !== 'number') return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n\n    const formatPriceChange = (change) => {\n      if (typeof change !== 'number') return '0.00';\n      return change.toFixed(2);\n    };\n\n    const getPriceChangeClass = () => {\n      if (!cryptoData.value) return 'text-gray-500';\n      return {\n        'text-green-500': cryptoData.value.priceChange > 0,\n        'text-red-500': cryptoData.value.priceChange < 0,\n        'text-gray-500': cryptoData.value.priceChange === 0\n      };\n    };\n\n    // Gestion des mises à jour\n    socket.on('priceUpdate', (data) => {\n      const crypto = data.find(c => c.symbol === cryptoSymbol);\n      if (crypto) {\n        cryptoData.value = crypto;\n        priceHistory.value.push({\n          price: crypto.price,\n          timestamp: new Date()\n        });\n\n        // Garder seulement les 30 derniers points\n        if (priceHistory.value.length > 30) {\n          priceHistory.value.shift();\n        }\n      }\n    });\n\n    onMounted(() => {\n      socket.connect();\n    });\n\n    onUnmounted(() => {\n      socket.disconnect();\n    });\n\n    return {\n      cryptoSymbol,\n      cryptoData,\n      chartData,\n      chartOptions,\n      formatPrice,\n      formatPriceChange,\n      getPriceChangeClass\n    };\n  }\n};\n</script>\n"],"mappings":"AA4BA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAW,EAAEC,QAAO,QAAS,KAAK;AAC3D,SAASC,QAAO,QAAS,YAAY;AACrC,SAASC,MAAK,QAAS,UAAU;AACjC,SACEC,KAAI,IAAKC,OAAO,EAChBC,aAAa,EACbC,WAAW,EACXC,YAAY,EACZC,WAAW,EACXC,KAAK,EACLC,OAAO,EACPC,MAAK,QACA,UAAU;AACjB,SAASC,IAAG,QAAS,aAAa;AAElCR,OAAO,CAACS,QAAQ,CACdR,aAAa,EACbC,WAAW,EACXC,YAAY,EACZC,WAAW,EACXC,KAAK,EACLC,OAAO,EACPC,MACF,CAAC;AAED,eAAe;EACbG,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IAAEH;EAAK,CAAC;EAEpBI,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIhB,QAAQ,CAAC,CAAC;IACxB,MAAMiB,YAAW,GAAID,KAAK,CAACE,MAAM,CAACC,MAAM;IACxC,MAAMC,UAAS,GAAIxB,GAAG,CAAC,IAAI,CAAC;IAC5B,MAAMyB,YAAW,GAAIzB,GAAG,CAAC,EAAE,CAAC;;IAE5B;IACA,MAAM0B,YAAW,GAAI;MACnBC,UAAU,EAAE,IAAI;MAChBC,mBAAmB,EAAE,KAAK;MAC1BC,MAAM,EAAE;QACNC,CAAC,EAAE;UACDC,WAAW,EAAE,KAAK;UAClBC,KAAK,EAAE;YACLC,QAAQ,EAAEC,KAAI,IAAKC,WAAW,CAACD,KAAK;UACtC;QACF;MACF,CAAC;MACDE,OAAO,EAAE;QACPC,MAAM,EAAE;UACNC,OAAO,EAAE;QACX,CAAC;QACDC,OAAO,EAAE;UACPC,SAAS,EAAE;YACTC,KAAK,EAAGC,OAAO,IAAKP,WAAW,CAACO,OAAO,CAACC,GAAG;UAC7C;QACF;MACF;IACF,CAAC;IAED,MAAMC,SAAQ,GAAIzC,QAAQ,CAAC,OAAO;MAChC0C,MAAM,EAAEpB,YAAY,CAACS,KAAK,CAACY,GAAG,CAACC,IAAG,IAChC,IAAIC,IAAI,CAACD,IAAI,CAACE,SAAS,CAAC,CAACC,kBAAkB,CAAC,CAC9C,CAAC;MACDC,QAAQ,EAAE,CAAC;QACTV,KAAK,EAAEpB,YAAY;QACnB+B,IAAI,EAAE3B,YAAY,CAACS,KAAK,CAACY,GAAG,CAACC,IAAG,IAAKA,IAAI,CAACM,KAAK,CAAC;QAChDC,WAAW,EAAE,SAAS;QACtBC,OAAO,EAAE;MACX,CAAC;IACH,CAAC,CAAC,CAAC;;IAEH;IACA,MAAMpB,WAAU,GAAKkB,KAAK,IAAK;MAC7B,IAAI,OAAOA,KAAI,KAAM,QAAQ,EAAE,OAAO,OAAO;MAC7C,OAAO,IAAIG,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE,KAAK;QACfC,qBAAqB,EAAE,CAAC;QACxBC,qBAAqB,EAAE;MACzB,CAAC,CAAC,CAACC,MAAM,CAACT,KAAK,CAAC;IAClB,CAAC;IAED,MAAMU,iBAAgB,GAAKC,MAAM,IAAK;MACpC,IAAI,OAAOA,MAAK,KAAM,QAAQ,EAAE,OAAO,MAAM;MAC7C,OAAOA,MAAM,CAACC,OAAO,CAAC,CAAC,CAAC;IAC1B,CAAC;IAED,MAAMC,mBAAkB,GAAIA,CAAA,KAAM;MAChC,IAAI,CAAC1C,UAAU,CAACU,KAAK,EAAE,O