{"ast":null,"code":"export default {\n  name: 'Pagination',\n  props: {\n    modelValue: {\n      type: Number,\n      required: true\n    },\n    totalItems: {\n      type: Number,\n      required: true\n    },\n    perPage: {\n      type: Number,\n      required: true\n    }\n  },\n  computed: {\n    currentPage: {\n      get() {\n        return this.modelValue;\n      },\n      set(value) {\n        this.$emit('update:modelValue', value);\n      }\n    },\n    totalPages() {\n      return Math.ceil(this.totalItems / this.perPage);\n    },\n    startItem() {\n      return (this.currentPage - 1) * this.perPage + 1;\n    },\n    endItem() {\n      return Math.min(this.currentPage * this.perPage, this.totalItems);\n    },\n    displayedPages() {\n      const pages = [];\n      const maxDisplayed = 7; // Nombre maximum de pages à afficher\n\n      if (this.totalPages <= maxDisplayed) {\n        // Si le nombre total de pages est inférieur au maximum, afficher toutes les pages\n        for (let i = 1; i <= this.totalPages; i++) {\n          pages.push(i);\n        }\n      } else {\n        // Toujours afficher la première page\n        pages.push(1);\n\n        // Calculer les pages autour de la page courante\n        let start = Math.max(2, this.currentPage - 2);\n        let end = Math.min(this.totalPages - 1, this.currentPage + 2);\n\n        // Ajuster si on est proche du début\n        if (this.currentPage <= 4) {\n          end = 5;\n        }\n\n        // Ajuster si on est proche de la fin\n        if (this.currentPage >= this.totalPages - 3) {\n          start = this.totalPages - 4;\n        }\n\n        // Ajouter des points de suspension si nécessaire\n        if (start > 2) {\n          pages.push('...');\n        }\n\n        // Ajouter les pages du milieu\n        for (let i = start; i <= end; i++) {\n          pages.push(i);\n        }\n\n        // Ajouter des points de suspension si nécessaire\n        if (end < this.totalPages - 1) {\n          pages.push('...');\n        }\n\n        // Toujours afficher la dernière page\n        pages.push(this.totalPages);\n      }\n      return pages;\n    }\n  }\n};","map":{"version":3,"names":["name","props","modelValue","type","Number","required","totalItems","perPage","computed","currentPage","get","set","value","$emit","totalPages","Math","ceil","startItem","endItem","min","displayedPages","pages","maxDisplayed","i","push","start","max","end"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\components\\Pagination.vue"],"sourcesContent":["<template>\r\n  <div class=\"flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6\">\r\n    <div class=\"flex flex-1 justify-between sm:hidden\">\r\n      <button\r\n        @click=\"$emit('update:modelValue', currentPage - 1)\"\r\n        :disabled=\"currentPage === 1\"\r\n        class=\"relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50\"\r\n        :class=\"{ 'opacity-50 cursor-not-allowed': currentPage === 1 }\"\r\n      >\r\n        Précédent\r\n      </button>\r\n      <button\r\n        @click=\"$emit('update:modelValue', currentPage + 1)\"\r\n        :disabled=\"currentPage >= totalPages\"\r\n        class=\"relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50\"\r\n        :class=\"{ 'opacity-50 cursor-not-allowed': currentPage >= totalPages }\"\r\n      >\r\n        Suivant\r\n      </button>\r\n    </div>\r\n    <div class=\"hidden sm:flex sm:flex-1 sm:items-center sm:justify-between\">\r\n      <div>\r\n        <p class=\"text-sm text-gray-700\">\r\n          Affichage de <span class=\"font-medium\">{{ startItem }}</span> à\r\n          <span class=\"font-medium\">{{ endItem }}</span> sur\r\n          <span class=\"font-medium\">{{ totalItems }}</span> éléments\r\n        </p>\r\n      </div>\r\n      <div>\r\n        <nav class=\"isolate inline-flex -space-x-px rounded-md shadow-sm\" aria-label=\"Pagination\">\r\n          <button\r\n            @click=\"$emit('update:modelValue', currentPage - 1)\"\r\n            :disabled=\"currentPage === 1\"\r\n            class=\"relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0\"\r\n            :class=\"{ 'opacity-50 cursor-not-allowed': currentPage === 1 }\"\r\n          >\r\n            <span class=\"sr-only\">Précédent</span>\r\n            <svg class=\"h-5 w-5\" viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\">\r\n              <path fill-rule=\"evenodd\" d=\"M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z\" clip-rule=\"evenodd\" />\r\n            </svg>\r\n          </button>\r\n          \r\n          <template v-for=\"page in displayedPages\" :key=\"page\">\r\n            <button\r\n              v-if=\"page === '...'\"\r\n              class=\"relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 focus:outline-offset-0\"\r\n            >\r\n              ...\r\n            </button>\r\n            <button\r\n              v-else\r\n              @click=\"$emit('update:modelValue', page)\"\r\n              :class=\"[\r\n                page === currentPage\r\n                  ? 'relative z-10 inline-flex items-center bg-indigo-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600'\r\n                  : 'relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0'\r\n              ]\"\r\n            >\r\n              {{ page }}\r\n            </button>\r\n          </template>\r\n\r\n          <button\r\n            @click=\"$emit('update:modelValue', currentPage + 1)\"\r\n            :disabled=\"currentPage >= totalPages\"\r\n            class=\"relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0\"\r\n            :class=\"{ 'opacity-50 cursor-not-allowed': currentPage >= totalPages }\"\r\n          >\r\n            <span class=\"sr-only\">Suivant</span>\r\n            <svg class=\"h-5 w-5\" viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\">\r\n              <path fill-rule=\"evenodd\" d=\"M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z\" clip-rule=\"evenodd\" />\r\n            </svg>\r\n          </button>\r\n        </nav>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'Pagination',\r\n  props: {\r\n    modelValue: {\r\n      type: Number,\r\n      required: true\r\n    },\r\n    totalItems: {\r\n      type: Number,\r\n      required: true\r\n    },\r\n    perPage: {\r\n      type: Number,\r\n      required: true\r\n    }\r\n  },\r\n  computed: {\r\n    currentPage: {\r\n      get() {\r\n        return this.modelValue;\r\n      },\r\n      set(value) {\r\n        this.$emit('update:modelValue', value);\r\n      }\r\n    },\r\n    totalPages() {\r\n      return Math.ceil(this.totalItems / this.perPage);\r\n    },\r\n    startItem() {\r\n      return ((this.currentPage - 1) * this.perPage) + 1;\r\n    },\r\n    endItem() {\r\n      return Math.min(this.currentPage * this.perPage, this.totalItems);\r\n    },\r\n    displayedPages() {\r\n      const pages = [];\r\n      const maxDisplayed = 7; // Nombre maximum de pages à afficher\r\n      \r\n      if (this.totalPages <= maxDisplayed) {\r\n        // Si le nombre total de pages est inférieur au maximum, afficher toutes les pages\r\n        for (let i = 1; i <= this.totalPages; i++) {\r\n          pages.push(i);\r\n        }\r\n      } else {\r\n        // Toujours afficher la première page\r\n        pages.push(1);\r\n        \r\n        // Calculer les pages autour de la page courante\r\n        let start = Math.max(2, this.currentPage - 2);\r\n        let end = Math.min(this.totalPages - 1, this.currentPage + 2);\r\n        \r\n        // Ajuster si on est proche du début\r\n        if (this.currentPage <= 4) {\r\n          end = 5;\r\n        }\r\n        \r\n        // Ajuster si on est proche de la fin\r\n        if (this.currentPage >= this.totalPages - 3) {\r\n          start = this.totalPages - 4;\r\n        }\r\n        \r\n        // Ajouter des points de suspension si nécessaire\r\n        if (start > 2) {\r\n          pages.push('...');\r\n        }\r\n        \r\n        // Ajouter les pages du milieu\r\n        for (let i = start; i <= end; i++) {\r\n          pages.push(i);\r\n        }\r\n        \r\n        // Ajouter des points de suspension si nécessaire\r\n        if (end < this.totalPages - 1) {\r\n          pages.push('...');\r\n        }\r\n        \r\n        // Toujours afficher la dernière page\r\n        pages.push(this.totalPages);\r\n      }\r\n      \r\n      return pages;\r\n    }\r\n  }\r\n};\r\n</script> "],"mappings":"AAgFA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,UAAU,EAAE;MACVH,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDE,OAAO,EAAE;MACPJ,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDG,QAAQ,EAAE;IACRC,WAAW,EAAE;MACXC,GAAGA,CAAA,EAAG;QACJ,OAAO,IAAI,CAACR,UAAU;MACxB,CAAC;MACDS,GAAGA,CAACC,KAAK,EAAE;QACT,IAAI,CAACC,KAAK,CAAC,mBAAmB,EAAED,KAAK,CAAC;MACxC;IACF,CAAC;IACDE,UAAUA,CAAA,EAAG;MACX,OAAOC,IAAI,CAACC,IAAI,CAAC,IAAI,CAACV,UAAS,GAAI,IAAI,CAACC,OAAO,CAAC;IAClD,CAAC;IACDU,SAASA,CAAA,EAAG;MACV,OAAQ,CAAC,IAAI,CAACR,WAAU,GAAI,CAAC,I