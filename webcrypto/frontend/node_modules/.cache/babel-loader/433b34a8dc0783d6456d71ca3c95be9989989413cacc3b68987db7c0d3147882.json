{"ast":null,"code":"import { ref, onMounted, onUnmounted, watch } from 'vue';\nimport { socket } from '@/socket';\nimport { useRouter } from 'vue-router';\nimport store from '../store';\nexport default {\n  name: 'UserTransactionsSummary',\n  setup() {\n    const router = useRouter();\n    const userSummaries = ref([]);\n    const filters = ref({\n      dateMax: new Date().toISOString().slice(0, 16) // Format YYYY-MM-DDTHH:mm\n    });\n    const logout = async () => {\n      try {\n        await store.dispatch('auth/logout');\n        router.push('/admin/login');\n      } catch (error) {\n        console.error('Erreur lors de la déconnexion:', error);\n      }\n    };\n    const formatPrice = price => {\n      if (!price) return '$0.00';\n      return new Intl.NumberFormat('fr-FR', {\n        style: 'currency',\n        currency: 'USD',\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      }).format(price);\n    };\n    const fetchUserSummaries = () => {\n      socket.emit('getUserTransactionsSummary', {\n        dateMax: filters.value.dateMax\n      });\n    };\n    onMounted(async () => {\n      try {\n        socket.connect();\n        const token = localStorage.getItem('token') || localStorage.getItem('sessionToken') || localStorage.getItem('access_token');\n        if (!token) {\n          router.push('/login');\n          return;\n        }\n        socket.emit('authenticate', token);\n        socket.on('authenticated', () => {\n          fetchUserSummaries();\n        });\n        socket.on('userTransactionsSummary', data => {\n          userSummaries.value = data;\n        });\n        socket.on('error', error => {\n          console.error('Erreur socket:', error);\n          if (error.message.includes('authentification')) {\n            router.push('/login');\n          }\n        });\n\n        // Surveiller les changements de filtre\n        watch(() => filters.value.dateMax, () => {\n          fetchUserSummaries();\n        });\n      } catch (error) {\n        console.error('Erreur lors de l\\'initialisation:', error);\n        router.push('/login');\n      }\n    });\n    onUnmounted(() => {\n      socket.off('userTransactionsSummary');\n      socket.off('authenticated');\n      socket.off('error');\n      socket.disconnect();\n    });\n    return {\n      userSummaries,\n      filters,\n      formatPrice,\n      logout\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","watch","socket","useRouter","store","name","setup","router","userSummaries","filters","dateMax","Date","toISOString","slice","logout","dispatch","push","error","console","formatPrice","price","Intl","NumberFormat","style","currency","minimumFractionDigits","maximumFractionDigits","format","fetchUserSummaries","emit","value","connect","token","localStorage","getItem","on","data","message","includes","off","disconnect"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\views\\UserTransactionsSummary.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <!-- Header principal avec \"Administration\" -->\r\n    <nav class=\"bg-white shadow\">\r\n      <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\r\n        <div class=\"flex justify-between h-16\">\r\n          <div class=\"flex items-center\">\r\n            <div class=\"text-xl font-bold text-indigo-600\">Administration</div>\r\n          </div>\r\n          <div class=\"flex items-center\">\r\n            <button\r\n              @click=\"logout\"\r\n              class=\"text-red-600 hover:text-red-800 px-3 py-2 rounded-md text-sm font-medium\"\r\n            >\r\n              Déconnexion\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </nav>\r\n\r\n    <!-- Header de navigation -->\r\n    <nav class=\"bg-indigo-600\">\r\n      <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\r\n        <div class=\"flex justify-between h-16\">\r\n          <div class=\"flex items-center space-x-4\">\r\n            <router-link\r\n              to=\"/admin/dashboard\"\r\n              class=\"text-white hover:bg-indigo-500 px-3 py-2 rounded-md text-sm font-medium\"\r\n              :class=\"{ 'bg-indigo-500': $route.path === '/admin/dashboard' }\"\r\n            >\r\n              Tableau de bord\r\n            </router-link>\r\n            <router-link\r\n              to=\"/commission-settings\"\r\n              class=\"text-white hover:bg-indigo-500 px-3 py-2 rounded-md text-sm font-medium\"\r\n              :class=\"{ 'bg-indigo-500': $route.path === '/commission-settings' }\"\r\n            >\r\n              Paramètres des Commissions\r\n            </router-link>\r\n            <router-link\r\n              to=\"/transactions-summary\"\r\n              class=\"text-white hover:bg-indigo-500 px-3 py-2 rounded-md text-sm font-medium\"\r\n              :class=\"{ 'bg-indigo-500': $route.path === '/transactions-summary' }\"\r\n            >\r\n              Récapitulatif Transactions\r\n            </router-link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </nav>\r\n    \r\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\r\n      <h1 class=\"text-3xl font-extrabold text-gray-900 mb-8\">Récapitulatif des Transactions par Utilisateur</h1>\r\n\r\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-200 hover:shadow-md\">\r\n        <!-- Filtres -->\r\n        <div class=\"p-6 border-b border-gray-100 bg-white\">\r\n          <div class=\"grid grid-cols-1 gap-6\">\r\n            <div>\r\n              <label class=\"block text-sm font-medium text-gray-700 mb-2\">Date et heure max</label>\r\n              <input\r\n                type=\"datetime-local\"\r\n                v-model=\"filters.dateMax\"\r\n                class=\"w-full rounded-lg border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors duration-200\"\r\n              />\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Tableau récapitulatif -->\r\n        <div class=\"overflow-x-auto\">\r\n          <table class=\"min-w-full divide-y divide-gray-200\">\r\n            <thead>\r\n              <tr class=\"bg-gray-50\">\r\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Utilisateur</th>\r\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Total Achat</th>\r\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Total Vente</th>\r\n                <th scope=\"col\" class=\"px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider\">Valeur portefeuille</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody class=\"bg-white divide-y divide-gray-100\">\r\n              <tr v-for=\"summary in userSummaries\" \r\n                  :key=\"summary.username\" \r\n                  class=\"hover:bg-gray-50 transition-colors duration-150\">\r\n                <td class=\"px-6 py-4 whitespace-nowrap\">\r\n                  <div class=\"flex items-center\">\r\n                    <div class=\"h-8 w-8 rounded-full bg-indigo-100 flex items-center justify-center\">\r\n                      <span class=\"text-sm font-medium text-indigo-700\">\r\n                        {{ summary.username[0]?.toUpperCase() }}\r\n                      </span>\r\n                    </div>\r\n                    <span class=\"ml-3 text-sm text-gray-900\">{{ summary.username }}</span>\r\n                  </div>\r\n                </td>\r\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\r\n                  {{ formatPrice(summary.totalBuy) }}\r\n                </td>\r\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">\r\n                  {{ formatPrice(summary.totalSell) }}\r\n                </td>\r\n                <td class=\"px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900\">\r\n                  {{ formatPrice(summary.portfolioValue) }}\r\n                </td>\r\n              </tr>\r\n            </tbody>\r\n          </table>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted, watch } from 'vue';\r\nimport { socket } from '@/socket';\r\nimport { useRouter } from 'vue-router';\r\nimport store from '../store';\r\n\r\nexport default {\r\n  name: 'UserTransactionsSummary',\r\n  \r\n  setup() {\r\n    const router = useRouter();\r\n    const userSummaries = ref([]);\r\n    const filters = ref({\r\n      dateMax: new Date().toISOString().slice(0, 16) // Format YYYY-MM-DDTHH:mm\r\n    });\r\n\r\n    const logout = async () => {\r\n      try {\r\n        await store.dispatch('auth/logout');\r\n        router.push('/admin/login');\r\n      } catch (error) {\r\n        console.error('Erreur lors de la déconnexion:', error);\r\n      }\r\n    };\r\n\r\n    const formatPrice = (price) => {\r\n      if (!price) return '$0.00';\r\n      return new Intl.NumberFormat('fr-FR', {\r\n        style: 'currency',\r\n        currency: 'USD',\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2\r\n      }).format(price);\r\n    };\r\n\r\n    const fetchUserSummaries = () => {\r\n      socket.emit('getUserTransactionsSummary', {\r\n        dateMax: filters.value.dateMax\r\n      });\r\n    };\r\n\r\n    onMounted(async () => {\r\n      try {\r\n        socket.connect();\r\n\r\n        const token = localStorage.getItem('token') || localStorage.getItem('sessionToken') || localStorage.getItem('access_token');\r\n        if (!token) {\r\n          router.push('/login');\r\n          return;\r\n        }\r\n\r\n        socket.emit('authenticate', token);\r\n\r\n        socket.on('authenticated', () => {\r\n          fetchUserSummaries();\r\n        });\r\n\r\n        socket.on('userTransactionsSummary', (data) => {\r\n          userSummaries.value = data;\r\n        });\r\n\r\n        socket.on('error', (error) => {\r\n          console.error('Erreur socket:', error);\r\n          if (error.message.includes('authentification')) {\r\n            router.push('/login');\r\n          }\r\n        });\r\n\r\n        // Surveiller les changements de filtre\r\n        watch(() => filters.value.dateMax, () => {\r\n          fetchUserSummaries();\r\n        });\r\n\r\n      } catch (error) {\r\n        console.error('Erreur lors de l\\'initialisation:', error);\r\n        router.push('/login');\r\n      }\r\n    });\r\n\r\n    onUnmounted(() => {\r\n      socket.off('userTransactionsSummary');\r\n      socket.off('authenticated');\r\n      socket.off('error');\r\n      socket.disconnect();\r\n    });\r\n\r\n    return {\r\n      userSummaries,\r\n      filters,\r\n      formatPrice,\r\n      logout\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Custom scrollbar */\r\n::-webkit-scrollbar {\r\n  width: 8px;\r\n  height: 8px;\r\n}\r\n\r\n::-webkit-scrollbar-track {\r\n  background: #f1f1f1;\r\n  border-radius: 4px;\r\n}\r\n\r\n::-webkit-scrollbar-thumb {\r\n  background: #ddd;\r\n  border-radius: 4px;\r\n}\r\n\r\n::-webkit-scrollbar-thumb:hover {\r\n  background: #cdcdcd;\r\n}\r\n</style> "],"mappings":"AAkHA,SAASA,GAAG,EAAEC,SAAS,EAAEC,WAAW,EAAEC,KAAI,QAAS,KAAK;AACxD,SAASC,MAAK,QAAS,UAAU;AACjC,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,KAAI,MAAO,UAAU;AAE5B,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAE/BC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIJ,SAAS,CAAC,CAAC;IAC1B,MAAMK,aAAY,GAAIV,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAMW,OAAM,GAAIX,GAAG,CAAC;MAClBY,OAAO,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAE,EAAE,EAAE;IACjD,CAAC,CAAC;IAEF,MAAMC,MAAK,GAAI,MAAAA,CAAA,KAAY;MACzB,IAAI;QACF,MAAMV,KAAK,CAACW,QAAQ,CAAC,aAAa,CAAC;QACnCR