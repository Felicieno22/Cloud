transition-colors duration-150',\r\n                       { 'bg-indigo-50': !notification.read }]\"\r\n               @click=\"markAsRead(notification.id)\">\r\n            <div class=\"flex items-start space-x-3\">\r\n              <div class=\"flex-shrink-0\">\r\n                <div :class=\"['h-8 w-8 rounded-full flex items-center justify-center',\r\n                              notification.read ? 'bg-gray-100' : 'bg-indigo-100']\">\r\n                  <svg class=\"h-4 w-4 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\r\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\r\n                  </svg>\r\n                </div>\r\n              </div>\r\n              <div class=\"flex-1 min-w-0\">\r\n                <p class=\"text-sm font-medium text-gray-900\">\r\n                  {{ notification.title }}\r\n                </p>\r\n                <p class=\"text-sm text-gray-500 mt-1\">\r\n                  {{ notification.message }}\r\n                </p>\r\n                <p class=\"text-xs text-gray-400 mt-1\">\r\n                  {{ formatDate(notification.created_at) }}\r\n                </p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, onUnmounted } from 'vue';\r\nimport { socket } from '@/socket';\r\n\r\nexport default {\r\n  name: 'NotificationsDropdown',\r\n\r\n  setup() {\r\n    const notifications = ref([]);\r\n    const isOpen = ref(false);\r\n\r\n    const unreadCount = computed(() => {\r\n      return notifications.value.filter(n => !n.read).length;\r\n    });\r\n\r\n    const toggleDropdown = () => {\r\n      isOpen.value = !isOpen.value;\r\n    };\r\n\r\n    const formatDate = (date) => {\r\n      const d = new Date(date);\r\n      return d.toLocaleString('fr-FR', {\r\n        day: 'numeric',\r\n        month: 'short',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      });\r\n    };\r\n\r\n    const markAsRead = (notificationId) => {\r\n      socket.emit('markNotificationAsRead', notificationId);\r\n    };\r\n\r\n    const markAllAsRead = () => {\r\n      socket.emit('markAllNotificationsAsRead');\r\n    };\r\n\r\n    onMounted(() => {\r\n      // Écouter les mises à jour des notifications\r\n      socket.on('notificationsUpdate', (data) => {\r\n        notifications.value = data;\r\n      });\r\n\r\n      // Demander les notifications initiales\r\n      socket.emit('getNotifications');\r\n    });\r\n\r\n    onUnmounted(() => {\r\n      socket.off('notificationsUpdate');\r\n    });\r\n\r\n    return {\r\n      notifications,\r\n      isOpen,\r\n      unreadCount,\r\n      toggleDropdown,\r\n      formatDate,\r\n      markAsRead,\r\n      markAllAsRead\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Animation du dropdown */\r\n.absolute {\r\n  transition: opacity 0.2s ease, transform 0.2s ease;\r\n}\r\n\r\n/* Scrollbar personnalisée */\r\n.max-h-96 {\r\n  scrollbar-width: thin;\r\n  scrollbar-color: #cbd5e0 #f7fafc;\r\n}\r\n\r\n.max-h-96::-webkit-scrollbar {\r\n  width: 6px;\r\n}\r\n\r\n.max-h-96::-webkit-scrollbar-track {\r\n  background: #f7fafc;\r\n}\r\n\r\n.max-h-96::-webkit-scrollbar-thumb {\r\n  background-color: #cbd5e0;\r\n  border-radius: 3px;\r\n}\r\n\r\n.max-h-96::-webkit-scrollbar-thumb:hover {\r\n  background-color: #a0aec0;\r\n}\r\n</style> "],"mappings":"AAuEA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AAC3D,SAASC,MAAK,QAAS,UAAU;AAEjC,eAAe;EACbC,IAAI,EAAE,uBAAuB;EAE7BC,KAAKA,CAAA,EAAG;IACN,MAAMC,aAAY,GAAIP,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAMQ,MAAK,GAAIR,GAAG,CAAC,KAAK,CAAC;IAEzB,MAAMS,WAAU,GAAIR,QAAQ,CAAC,MAAM;MACjC,OAAOM,aAAa,CAACG,KAAK,CAACC,MAAM,CAACC,CAAA,IAAK,CAACA,CAAC,CAACC,IAAI,CAAC,CAACC,MAAM;IACxD,CAAC,CAAC;IAEF,MAAMC,cAAa,GAAIA,CAAA,KAAM;MAC3BP,MAA