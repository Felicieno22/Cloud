{"ast":null,"code":"import { ref, computed, onMounted, onUnmounted } from 'vue';\nimport { socket } from '@/socket';\nexport default {\n  name: 'NotificationsDropdown',\n  setup() {\n    const notifications = ref([]);\n    const isOpen = ref(false);\n    const unreadCount = computed(() => {\n      return notifications.value.filter(n => !n.read).length;\n    });\n    const toggleDropdown = () => {\n      isOpen.value = !isOpen.value;\n    };\n    const formatDate = date => {\n      const d = new Date(date);\n      return d.toLocaleString('fr-FR', {\n        day: 'numeric',\n        month: 'short',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    };\n    const markAsRead = notificationId => {\n      socket.emit('markNotificationAsRead', notificationId);\n    };\n    const markAllAsRead = () => {\n      socket.emit('markAllNotificationsAsRead');\n    };\n    onMounted(() => {\n      // Écouter les mises à jour des notifications\n      socket.on('notificationsUpdate', data => {\n        notifications.value = data;\n      });\n\n      // Demander les notifications initiales\n      socket.emit('getNotifications');\n    });\n    onUnmounted(() => {\n      socket.off('notificationsUpdate');\n    });\n    return {\n      notifications,\n      isOpen,\n      unreadCount,\n      toggleDropdown,\n      formatDate,\n      markAsRead,\n      markAllAsRead\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","socket","name","setup","notifications","isOpen","unreadCount","value","filter","n","read","length","toggleDropdown","formatDate","date","d","Date","toLocaleString","day","month","hour","minute","markAsRead","notificationId","emit","markAllAsRead","on","data","off"],"sources":["D:\\itucedric\\L3\\S5\\Mr Rojo\\Projet\\10 - Copie - Copie\\frontend\\src\\components\\NotificationsDropdown.vue"],"sourcesContent":["<template>\r\n  <div class=\"relative\">\r\n    <!-- Bouton de notification avec badge -->\r\n    <button \r\n    